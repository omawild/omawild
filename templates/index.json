        "about_ViCPCW": {
          "type": "ow-about",
          "settings": {
            "heading": "Omawild began during an expedition across Bali when we plunged our entire life savings into conservation",
            "body": "Until we went broke and realised nature needed a better business model...",
            "cta_text": "Follow our rabbit hole",
            "cta_link": "shopify://pages/about",
            "c1_alt": "Bali expedition",
            "c1_caption": "It started in 2023 with a one-way ticket to Bali. Forget \"Eat, Pray, Love\" — more Dig, Sweat, Build.",
            "c2_alt": "Conservation work",
            "c2_caption": "Into forests, reefs, and degraded land being brought back to life. One cup at a time.",
            "c3_alt": "West Java farm",
            "c3_caption": "Found a farm in West Java that grows the best coffee I've ever tasted — and runs on regenerative principles.",
            "c4_alt": "Omawild launch",
            "c4_caption": "Omawild is the business model conservation never had."
