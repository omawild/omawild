{%- style -%}
  .section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1.5px solid {{ section.settings.divider_color }};
  }

  .container-{{ section.id }} {
    max-width: 1280px;
    margin: 0 auto;
    padding-left: {{ section.settings.mobile_padding_horizontal }}px;
    padding-right: {{ section.settings.mobile_padding_horizontal }}px;
    box-sizing: border-box;
  }

  .crumbs-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 0 6px;
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
    font: 700 11px/1.4 var(--font-heading-family);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: {{ section.settings.heading_color }};
  }

  .crumbs-{{ section.id }} li { display: flex; gap: 6px; }
  .crumbs-{{ section.id }} a { color: inherit; text-decoration: none; }
  .crumbs-{{ section.id }} a:hover { opacity: 0.75; }

  .title-row-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 40px;
  }

  .title-{{ section.id }} {
    margin: 0;
    font: 900 clamp(40px, 7vw, 88px)/0.95 var(--font-heading-family);
    letter-spacing: -0.03em;
    color: {{ section.settings.heading_color }};
  }

  .aside-{{ section.id }} {
    padding-bottom: 8px;
    font: 800 clamp(20px, 2vw, 26px)/1.1 var(--font-heading-family);
    letter-spacing: -0.02em;
    color: {{ section.settings.heading_color }};
  }

  .body-{{ section.id }} {
    margin: 20px 0 0;
    max-width: 62ch;
    font: 400 16.5px/1.6 var(--font-body-family);
    color: {{ section.settings.text_color }};
  }

  .body-{{ section.id }} p { margin: 0; }

  .toc-{{ section.id }} {
    margin: 34px 0 0;
    padding: 0;
    list-style: none;
  }

  .toc-row-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 24px;
    padding: 16px 12px;
    border-top: 1.5px solid {{ section.settings.divider_color }};
    text-decoration: none;
    color: {{ section.settings.heading_color }};
    transition: background-color 0.2s ease;
  }

  .toc-row-{{ section.id }}:hover {
    background-color: color-mix(in srgb, {{ section.settings.divider_color }} 8%, transparent);
  }

  .toc-num-{{ section.id }} {
    flex: none;
    width: 32px;
    font: 800 14px/1 var(--font-heading-family);
  }

  .toc-title-{{ section.id }} {
    flex: 1 1 220px;
    min-width: 0;
    font: 800 clamp(24px, 3vw, 36px)/1 var(--font-heading-family);
    letter-spacing: -0.02em;
  }

  .toc-thumbs-{{ section.id }} {
    display: flex;
    padding-left: 14px;
  }

  .toc-thumb-{{ section.id }} {
    width: 44px;
    height: 44px;
    margin-left: -14px;
    box-sizing: border-box;
    object-fit: cover;
    border: 1.5px solid {{ section.settings.heading_color }};
    border-radius: 100px;
    background: {{ section.settings.thumb_background }};
    display: block;
  }

  .toc-count-{{ section.id }} {
    flex: none;
    min-width: 84px;
    text-align: right;
    font: 700 13px/1 var(--font-body-family);
    color: {{ section.settings.text_color }};
  }

  .toc-arrow-{{ section.id }} {
    flex: none;
    font: 800 18px/1 var(--font-heading-family);
  }

  @media screen and (min-width: 750px) {
    .container-{{ section.id }} {
      padding-left: {{ section.settings.desktop_padding_horizontal }}px;
      padding-right: {{ section.settings.desktop_padding_horizontal }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}">
  <div class="container-{{ section.id }}">
    {%- if section.settings.show_breadcrumb -%}
      <ul class="crumbs-{{ section.id }}">
        <li><a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t | default: 'Home' }}</a></li>
        <li aria-hidden="true">/</li>
        <li>{{ section.settings.heading }}</li>
      </ul>
    {%- endif -%}

    <div class="title-row-{{ section.id }}">
      <h1 class="title-{{ section.id }}">{{ section.settings.heading }}</h1>
      {%- if template.name == 'cart' and cart.item_count > 0 -%}
        <div class="aside-{{ section.id }}">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.body != blank -%}
      <div class="body-{{ section.id }} rte">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if section.settings.show_collection_list and section.blocks.size > 0 -%}
      <ul class="toc-{{ section.id }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'collection_row' -%}
              {%- liquid
                assign toc_collection = block.settings.collection
                assign toc_title = block.settings.title_override | default: toc_collection.title
                assign toc_anchor = block.settings.anchor_override | default: toc_collection.handle
                assign toc_count = toc_collection.all_products_count
                assign toc_count_label = block.settings.count_label_override
                if toc_count_label == blank
                  if toc_count == 1
                    assign toc_count_label = toc_count | append: ' product'
                  else
                    assign toc_count_label = toc_count | append: ' products'
                  endif
                endif
              -%}
              {%- if toc_collection != blank -%}
                <li {{ block.shopify_attributes }}>
                  <a class="toc-row-{{ section.id }}" href="#{{ toc_anchor }}">
                    <span class="toc-num-{{ section.id }}">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
                    <span class="toc-title-{{ section.id }}">{{ toc_title }}</span>
                    <span class="toc-thumbs-{{ section.id }}">
                      {%- for toc_product in toc_collection.products limit: block.settings.thumbnail_count -%}
                        {%- if toc_product.featured_image != blank -%}
                          <img
                            class="toc-thumb-{{ section.id }}"
                            src="{{ toc_product.featured_image | image_url: width: 88 }}"
                            width="44"
                            height="44"
                            alt=""
                            loading="lazy"
                          >
                        {%- endif -%}
                      {%- endfor -%}
                    </span>
                    <span class="toc-count-{{ section.id }}">{{ toc_count_label }}</span>
                    <span class="toc-arrow-{{ section.id }}" aria-hidden="true">&#8595;</span>
                  </a>
                </li>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "OMA Page Header",
  "settings": [
    { "type": "text", "id": "heading", "label": "Title", "default": "Shop" },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "richtext", "id": "body", "label": "Lead paragraph" },
    { "type": "header", "content": "Collection overview list" },
    { "type": "checkbox", "id": "show_collection_list", "label": "Show collection overview list", "default": true, "info": "Add one 'Collection row' block below per collection you want listed." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFE4E7" },
    { "type": "color", "id": "heading_color", "label": "Heading & link color", "default": "#FF3F00" },
    { "type": "color", "id": "text_color", "label": "Body text color", "default": "#00180C" },
    { "type": "color", "id": "divider_color", "label": "Divider & thumbnail border color", "default": "#FF3F00" },
    { "type": "color", "id": "thumb_background", "label": "Thumbnail fallback background", "default": "#FBB925" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "mobile_padding_horizontal", "label": "Mobile side gutter", "min": 10, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "desktop_padding_horizontal", "label": "Desktop side gutter", "min": 10, "max": 100, "step": 2, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "collection_row",
      "name": "Collection row",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title_override", "label": "Title override", "info": "Blank uses the collection's own title." },
        { "type": "text", "id": "anchor_override", "label": "Anchor ID override", "info": "Blank uses the collection's handle. Must match the \"Anchor ID\" setting on that collection's OD Collection Showcase section further down the page." },
        { "type": "range", "id": "thumbnail_count", "label": "Thumbnails to show", "min": 1, "max": 6, "step": 1, "default": 3 },
        { "type": "text", "id": "count_label_override", "label": "Product count label override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OMA Page Header",
      "blocks": [{ "type": "collection_row" }, { "type": "collection_row" }]
    }
  ]
}
{% endschema %}
