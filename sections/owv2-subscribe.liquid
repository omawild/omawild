{%- comment -%}
  owv2-subscribe — OWV2 Subscription spot.

  Data source
  - Roasts are NOT typed in by the merchant. They are every product in
    `section.settings.collection` that has at least one selling plan
    (product.selling_plan_groups.size > 0) — add or remove a product from
    that collection and this section updates on its own, no theme-editor
    edits needed. This mirrors sections/owv2-product-main.liquid's rule:
    subscription data always comes from the product, never typed twice.
  - Step 02 (quantity) is that roast's FIRST option (options_with_values.first)
    — normally "Size" — deduplicated to one pill per distinct value. A roast
    with only 200g in stock only shows a 200g pill; a roast with a second
    option (e.g. Grind) has that second axis ignored, same simplification
    owv2-product-main does not need to make since it only ever shows one
    product at a time.
  - Step 03 (frequency) is that roast's own product.selling_plan_groups,
    flattened across groups exactly like owv2-product-main's plan pills.
    Two roasts can offer different frequencies; switching roasts rebuilds
    steps 02 and 03 from scratch.
  - Only step 01 (the roast list) is known at render time, so it's the only
    step Liquid renders. Steps 02/03 and the summary are empty shells filled
    in by assets/owv2-subscribe.js from the embedded JSON, same
    render-after-connect approach the previous static version already used.
  - The CTA is a real /cart/add form (id + selling_plan), not a link —
    same pattern as owv2-product-main's form, hand-written here since a
    single form must be able to submit any of several products rather than
    one `{% form 'product', product %}`-bound product.
{%- endcomment -%}

{% assign owid = section.id | replace: '-', '' | replace: '_', '' %}
{% style %}
.owv2-subscribe-{{ owid }} {
  box-sizing: border-box;
  --bg: {{ section.settings.background_color }};
  --ink: {{ section.settings.text_color }};
  --surface: {{ section.settings.card_background }};
  background: var(--bg);
  color: var(--ink);
  padding: {{ section.settings.padding_top }}px max(20px, 5vw) {{ section.settings.padding_bottom }}px;
  font-family: var(--font-body-family);
  font-size: 16px;
  line-height: 1.5;
  }
.owv2-subscribe-{{ owid }} *, .owv2-subscribe-{{ owid }} *::before, .owv2-subscribe-{{ owid }} *::after {
  box-sizing: border-box;
  }
.owv2-subscribe-{{ owid }} h1, .owv2-subscribe-{{ owid }} h2, .owv2-subscribe-{{ owid }} h3 {
  font-family: var(--font-heading-family);
  color: inherit;
  font-weight: 900;
  letter-spacing: -.035em;
  line-height: 1.05;
  text-transform: none;
  margin: 0;
  overflow-wrap: anywhere;
  }
.owv2-subscribe-{{ owid }} h2 {
  font-size: clamp(30px, 4vw, 58px);
  }
.owv2-subscribe-{{ owid }} h3 {
  font-size: 26px;
  }
.owv2-subscribe-{{ owid }} p {
  margin: 0 0 16px;
  }
.owv2-subscribe-{{ owid }} p:last-child {
  margin-bottom: 0;
  }
.owv2-subscribe-{{ owid }} a {
  color: inherit;
  }
.owv2-subscribe-{{ owid }} img, .owv2-subscribe-{{ owid }} svg {
  display: block;
  max-width: 100%;
  height: auto;
  }
.owv2-subscribe-{{ owid }} .inner {
  max-width: 1320px;
  margin-inline: auto;
  min-width: 0;
  }
.owv2-subscribe-{{ owid }} .intro {
  max-width: 760px;
  margin-bottom: 32px;
  }
.owv2-subscribe-{{ owid }} .intro > * + * {
  margin-top: 20px;
  }
.owv2-subscribe-{{ owid }} .eyebrow {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  }
.owv2-subscribe-{{ owid }} .owv2-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 48px;
  padding: 12px 24px;
  border: 1px solid var(--ink);
  border-radius: 999px;
  background: var(--ink);
  color: var(--bg);
  font: 700 16px var(--font-body-family);
  text-decoration: none;
  text-align: center;
  cursor: pointer;
  transition: filter .2s ease, opacity .2s ease;
  }
.owv2-subscribe-{{ owid }} .owv2-button:hover {
  filter: brightness(.88);
  }
.owv2-subscribe-{{ owid }} .owv2-button:disabled {
  cursor: not-allowed;
  opacity: .55;
  filter: none;
  }
.owv2-subscribe-{{ owid }} :focus-visible {
  outline: 3px solid currentColor;
  outline-offset: 4px;
  }
@media (prefers-reduced-motion: reduce) {
  .owv2-subscribe-{{ owid }} * {
  scroll-behavior: auto !important;
  scroll-snap-type: none !important;
  }
}
.owv2-subscribe-{{ owid }} owv2-subscribe {
  display:block;
  }
.owv2-subscribe-{{ owid }} .columns {
  display:grid;
  grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);
  gap:64px;
  align-items:start;
  }
.owv2-subscribe-{{ owid }} .pill {
  display:inline-block;
  background:var(--ink);
  color:var(--bg);
  border-radius:999px;
  padding:7px 12px;
  font-size:10px;
  font-weight:800;
  letter-spacing:.1em;
  }
.owv2-subscribe-{{ owid }} fieldset {
  border:0;
  border-top:1px solid color-mix(in srgb, var(--ink) 25%, transparent);
  padding:20px 0 0;
  margin:0 0 24px;
  min-width:0;
  }
.owv2-subscribe-{{ owid }} legend {
  font-size:10px;
  text-transform:uppercase;
  letter-spacing:.14em;
  font-weight:800;
  margin-bottom:12px;
  }
.owv2-subscribe-{{ owid }} .options {
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  }
.owv2-subscribe-{{ owid }} .option {
  position:relative;
  cursor:pointer;
  }
.owv2-subscribe-{{ owid }} .option input {
  position:absolute;
  width:1px;
  height:1px;
  opacity:0;
  }
.owv2-subscribe-{{ owid }} .option span {
  display:flex;
  align-items:center;
  gap:8px;
  border:1.5px solid var(--ink);
  border-radius:999px;
  padding:10px 18px;
  min-height:44px;
  background:var(--surface);
  font-weight:700;
  font-size:14px;
  transition:background .2s ease, color .2s ease;
  }
.owv2-subscribe-{{ owid }} .option:hover span {
  background:var(--ink);
  color:var(--bg);
  }
.owv2-subscribe-{{ owid }} input:checked + span:hover {
  background:var(--ink);
  color:var(--bg);
  }
.owv2-subscribe-{{ owid }} .option img {
  width:32px;
  height:32px;
  object-fit:cover;
  border-radius:50%;
  }
.owv2-subscribe-{{ owid }} input:checked + span {
  background:var(--ink);
  color:var(--bg);
  }
.owv2-subscribe-{{ owid }} input:focus-visible + span {
  outline:3px solid var(--ink);
  outline-offset:3px;
  }
.owv2-subscribe-{{ owid }} .option.is-unavailable span {
  text-decoration: line-through;
  opacity: .55;
  }
.owv2-subscribe-{{ owid }} .summary {
  position:sticky;
  top:24px;
  background:var(--surface);
  border:1.5px solid var(--ink);
  border-radius:10px;
  padding:24px;
  }
.owv2-subscribe-{{ owid }} .summary .eyebrow {
  font-size:10px;
  letter-spacing:.14em;
  }
.owv2-subscribe-{{ owid }} .summary h3 {
  font-size:22px;
  font-weight:800;
  letter-spacing:-.02em;
  line-height:1.1;
  margin-bottom:7px;
  }
.owv2-subscribe-{{ owid }} .summary [data-description] {
  font-size:12.5px;
  line-height:1.4;
  font-weight:500;
  }
.owv2-subscribe-{{ owid }} .prices {
  margin-top:16px;
  padding-top:16px;
  border-top:1px solid color-mix(in srgb, var(--ink) 25%, transparent);
  }
.owv2-subscribe-{{ owid }} .prices strong {
  font-size:36px;
  font-weight:900;
  letter-spacing:-.02em;
  }
.owv2-subscribe-{{ owid }} .prices s {
  font-size:13px;
  font-weight:600;
  opacity:.65;
  }
.owv2-subscribe-{{ owid }} .prices s {
  margin-left:10px;
  }
.owv2-subscribe-{{ owid }} .saving {
  display:inline-block;
  margin-top:14px;
  background:var(--sunbrella, #FBB925);
  color:var(--midnight, #00180C);
  font-weight:800;
  font-size:12px;
  padding:8px 14px;
  border-radius:999px;
  }
.owv2-subscribe-{{ owid }} .summary form {
  margin:16px 0 12px;
  }
.owv2-subscribe-{{ owid }} .shipping {
  font-size:13px;
  text-align:left;
  }
@media(max-width:749px) {
  .owv2-subscribe-{{ owid }} .columns {
  grid-template-columns:1fr;
  gap:8px;
  }
.owv2-subscribe-{{ owid }} .summary {
  position:static;
  }
}
{% endstyle %}

{%- liquid
  assign product_limit = section.settings.product_limit | default: 12
  assign roast_total = 0
  for p in section.settings.collection.products
    if roast_total >= product_limit
      break
    endif
    if p.selling_plan_groups.size > 0
      assign roast_total = roast_total | plus: 1
    endif
  endfor
  assign has_roasts = false
  if roast_total > 0
    assign has_roasts = true
  endif
-%}

<div class="owv2-subscribe-{{ owid }}">
<div class="inner">
<div class="intro">
<span class="pill">{{ section.settings.badge_text | escape }}</span>
<h2>{{ section.settings.heading }}</h2>
<div>{{ section.settings.body }}</div>
</div>
</div>

{%- if has_roasts -%}
<owv2-subscribe
  class="inner"
  data-owv2-id="{{ section.id }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
  data-locale="{{ request.locale.iso_code | escape }}"
  data-savings="{{ section.settings.savings_template | escape }}"
  data-cta="{{ section.settings.cta_label | escape }}"
  data-sold-out="{{ section.settings.cta_sold_out_label | escape }}"
>
<div class="columns">
<div>
<fieldset>
<legend>01 — {{ section.settings.step1_label | escape }}</legend>
<div class="options">
{%- assign roast_index = 0 -%}
{%- for roast in section.settings.collection.products -%}
  {%- if roast_index >= product_limit -%}{%- break -%}{%- endif -%}
  {%- if roast.selling_plan_groups.size == 0 -%}{%- continue -%}{%- endif -%}
  {%- assign roast_index = roast_index | plus: 1 -%}
<label class="option">
<input type="radio" name="owv2-roast-{{ section.id }}" value="{{ roast.id }}" data-owv2-roast {% if roast_index == 1 %}checked{% endif %}>
<span>
{%- if roast.featured_image -%}{{ roast.featured_image | image_url: width: 100 | image_tag: loading: 'lazy', alt: roast.featured_image.alt | default: roast.title }}{%- endif -%}{{- roast.title -}}</span>
</label>
{%- endfor -%}
</div>
</fieldset>
<fieldset>
<legend>02 — {{ section.settings.step2_label | escape }}</legend>
<div class="options" data-owv2-sizes></div>
</fieldset>
<fieldset>
<legend>03 — {{ section.settings.step3_label | escape }}</legend>
<div class="options" data-owv2-plans></div>
</fieldset>
</div>
<aside class="summary">
<p class="eyebrow">{{ section.settings.summary_title | escape }}</p>
<div aria-live="polite" aria-atomic="true">
<h3 data-roast>
</h3>
<p data-description>{{ section.settings.empty_message | escape }}</p>
<p class="prices" hidden>
<strong data-total>
</strong> <s data-original>
</s>
</p>
<p class="saving" data-saving>
</p>
</div>
<form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" data-owv2-form>
<input type="hidden" name="id" value="" data-owv2-variant>
<input type="hidden" name="selling_plan" value="" data-owv2-plan>
<input type="hidden" name="quantity" value="1">
<button type="submit" name="add" class="owv2-button" data-owv2-cta disabled>{{ section.settings.cta_label | escape }}</button>
</form>
<p class="shipping">{{ section.settings.shipping_note | escape }}</p>
</aside>
</div>

<script type="application/json" data-owv2-subscribe-json>
{
  "moneyFormat": {{ shop.money_format | json }},
  "products": [
    {%- assign json_index = 0 -%}
    {%- for roast in section.settings.collection.products -%}
      {%- if json_index >= product_limit -%}{%- break -%}{%- endif -%}
      {%- if roast.selling_plan_groups.size == 0 -%}{%- continue -%}{%- endif -%}
      {%- assign json_index = json_index | plus: 1 -%}
      {%- assign opt = roast.options_with_values.first -%}
      {
        "id": {{ roast.id | json }},
        "title": {{ roast.title | json }},
        "optionName": {{ opt.name | json }},
        "variants": [
          {%- for v in roast.variants -%}
            {
              "id": {{ v.id }},
              "value": {{ v.options.first | json }},
              "available": {{ v.available | json }},
              "price": {{ v.price }},
              "compare": {{ v.compare_at_price | default: 0 }},
              "plans": {
                {%- for alloc in v.selling_plan_allocations -%}
                  "{{ alloc.selling_plan.id }}": {{ alloc.price }}{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              }
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "sellingPlans": [
          {%- assign total_plans = 0 -%}
          {%- for group in roast.selling_plan_groups -%}
            {%- assign total_plans = total_plans | plus: group.selling_plans.size -%}
          {%- endfor -%}
          {%- assign plan_index = 0 -%}
          {%- for group in roast.selling_plan_groups -%}
            {%- for plan in group.selling_plans -%}
              {%- assign plan_index = plan_index | plus: 1 -%}
              { "id": {{ plan.id | json }}, "name": {{ plan.name | json }} }{% unless plan_index == total_plans %},{% endunless %}
            {%- endfor -%}
          {%- endfor -%}
        ]
      }{% unless json_index == roast_total %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
</owv2-subscribe>
<script src="{{ 'owv2-subscribe.js' | asset_url }}" defer="defer">
</script>
{%- else -%}
<div class="inner">
<p>{{ section.settings.empty_message | escape }}</p>
</div>
{%- endif -%}
</div>
{% schema %}
{
  "name": "OWV2 Subscription spot",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "SUBSCRIBE & SAVE"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Keep the ritual going and never run low on energy"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Fresh roast on your schedule. Save on every delivery. And each subscription helps us do more for you and our planet. Skip, swap or cancel any time.</p>"
    },
    {
      "type": "header",
      "content": "Roasts"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Subscribable coffees",
      "info": "Every product in this collection that offers a subscription (has a selling plan from the Subscriptions app) appears automatically. Add or remove a product from the collection to change what's shown here — no other edit needed."
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Maximum roasts shown",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "header",
      "content": "Steps"
    },
    {
      "type": "text",
      "id": "step1_label",
      "label": "Step1 label",
      "default": "Pick your roast"
    },
    {
      "type": "text",
      "id": "step2_label",
      "label": "Step2 label",
      "default": "Select your quantity"
    },
    {
      "type": "text",
      "id": "step3_label",
      "label": "Step3 label",
      "default": "Set your frequency"
    },
    {
      "type": "header",
      "content": "Summary"
    },
    {
      "type": "text",
      "id": "summary_title",
      "label": "Summary title",
      "default": "YOUR SUBSCRIPTION"
    },
    {
      "type": "text",
      "id": "shipping_note",
      "label": "Shipping note",
      "default": "Freshly roasted. Delivered on your schedule."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Cta label",
      "default": "Start subscription"
    },
    {
      "type": "text",
      "id": "cta_sold_out_label",
      "label": "Cta label — sold out",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "savings_template",
      "label": "Savings template",
      "default": "Save [amount] every delivery",
      "info": "Use [amount] for the calculated saving. The saving is read from the roast's own selling plan, never typed in."
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty message",
      "info": "Shown before a selection loads, and instead of the whole widget if no product in the collection has a subscription plan.",
      "default": "Choose your coffee options to get started."
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFE4E7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FF3F00"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "OWV2 Subscription spot"
    }
  ]
}
{% endschema %}
