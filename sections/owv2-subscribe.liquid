      "default": "#FFE4E7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FF3F00"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "OWV2 Subscription spot",
      "blocks": [
        {
          "type": "roast",
          "settings": {
            "label": "Wild Bloom",
            "price": 560
          }
        },
        {
          "type": "roast",
          "settings": {
            "label": "Forest Trail",
            "price": 540
          }
        },
        {
          "type": "roast",
          "settings": {
            "label": "Limited Reserve",
