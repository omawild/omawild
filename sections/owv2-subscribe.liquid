          }
        },
        {
          "type": "size",
          "settings": {
            "label": "200 g",
            "price_modifier": 0
          }
        },
        {
          "type": "size",
          "settings": {
            "label": "400 g",
            "price_modifier": 560
          }
        },
        {
          "type": "frequency",
          "settings": {
            "label": "Every month"
          }
        },
        {
          "type": "frequency",
          "settings": {
            "label": "Every 2 weeks"
          }
        },
        {
          "type": "frequency",
          "settings": {
            "label": "Every 2 months"
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "roast",
      "name": "Roast",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "number",
          "id": "price",
