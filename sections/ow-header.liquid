{%- comment -%}
  ow-header — OW Navbar: Omawild's site-wide nav + menu modal. Despite the
  filename (kept for continuity with header-group.json and the CSS/JS below,
  all still named after "header"), this section renders no bars of its own
  any more -- it is just the navbar. Promo bars are the vendor's own Timer
  (sections/announcement-bar.liquid) and Announcement Bar
  (sections/scrolling-promotion.liquid) sections, placed BEFORE this one in
  the header group and pinned fixed above it by ow-chrome.css/js, which
  measure their real height and stack: Timer, then Announcement Bar, then
  this navbar. Previously this section carried its own Countdown bar /
  Scrolling bar blocks doing the same job independently of those vendor
  sections -- removed by request, so there is exactly one mechanism for
  promo bars, not two.

  WHY #top-chrome IS STILL A FIXED CONTAINER even with just the navbar in
  it: ow-chrome.js needs one stable element to measure and to fade
  in/out on scroll, and the vendor bars' own fixed positioning (see
  ow-chrome.css) is keyed off that same script's height math via
  --ow-timer-h / --ow-promo-h.

  CONSEQUENCE OF REPLACING THE VENDOR HEADER: Be Yours' <cart-drawer> lives
  inside sections/header.liquid, so it is no longer rendered. assets/product-form.js
  already guards for this and falls back to redirecting to the cart page
  (see its `else if (!this.cart)` branch). Verify that flow on staging.

  Loads the shared base + chrome CSS and JS for every page. ow-chrome.js must
  load before ow-landing.js — it is included here, in the header group, which
  renders before section content.
{%- endcomment -%}

{{ 'ow-base.css' | asset_url | stylesheet_tag }}
{{ 'ow-chrome.css' | asset_url | stylesheet_tag }}
{%- if section.settings.show_region_selector -%}
  {{ 'ow-flags.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- comment -%} Organization + WebSite JSON-LD — see snippet header. Restores the
  structured data the vendor header carried before ow-header replaced it. {%- endcomment -%}
{%- render 'ow-schema-org' -%}

{%- comment -%}
  `fixed-header` carries no styles anywhere in this theme. It is there purely as
  a hook for the vendor scrollspy nav (assets/content-scrollspy.js), whose
  calculateScrollOffsets() looks for a fixed header among
  ['header','.header','.sticky-header','.fixed-header'] so that clicking one of
  its links lands the heading below the chrome instead of underneath it. None of
  those matched #top-chrome, so that offset was silently 0. Claiming the class
  here fixes the jump without editing the vendor script.
{%- endcomment -%}
<div id="top-chrome" class="fixed-header">
  <nav class="navbar" id="navbar" aria-label="Site navigation">
    <a class="navbar-logo" href="{{ routes.root_url }}">
      <img src="{{ 'ow-logo.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="480" height="80">
    </a>
    <ul class="navbar-links">
      {%- for link in section.settings.menu.links -%}
        {%- comment -%}
          The design keeps the first link in sentence case while the rest are
          uppercased by CSS — navbar-link--plain opts that one out.
        {%- endcomment -%}
        {%- if link.links.size > 0 -%}
          <li class="navbar-link-dropdown">
            <a href="{{ link.url }}" class="navbar-link-toggle">
              {{ link.title }}
              <img class="navbar-link-chevron" src="{{ 'ow-chevron-link.svg' | asset_url }}" alt="" width="14" height="14">
            </a>
            <div class="navbar-dropdown">
              {%- for child in link.links -%}
                <a href="{{ child.url }}">{{ child.title }}</a>
              {%- endfor -%}
            </div>
          </li>
        {%- else -%}
          <li><a href="{{ link.url }}"{% if forloop.first %} class="navbar-link--plain"{% endif %}>{{ link.title }}</a></li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    <div class="navbar-right">
      {%- if section.settings.show_region_selector -%}
        {% render 'ow-region-selector',
             id_suffix: 'header',
             inline: false,
             country_filter: section.settings.region_countries %}
      {%- endif -%}
      <div class="navbar-icons">
        {%- comment -%}
          Search and account are plain links to Shopify's own routes — no
          bespoke drawer, no vendor JS. routes.* resolves per-locale, so these
          stay correct under every market the region selector can switch to;
          a hardcoded '/search' would not.
        {%- endcomment -%}
        {%- if section.settings.show_search -%}
          <a href="{{ routes.search_url }}" aria-label="{{ 'general.search.search' | t }}">
            <img src="{{ 'ow-icon-search.svg' | asset_url }}" alt="" width="30" height="30">
          </a>
        {%- endif -%}

        {%- comment -%}
          Guarded on customer_accounts_enabled: with accounts off, every account
          route redirects to the homepage, so the icon would be a dead control.
          Logged in goes to the account page, logged out to login — which is
          also where Shopify puts the "create account" link, so one icon covers
          sign in and sign up.
        {%- endcomment -%}
        {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
          <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
             aria-label="{% if customer %}{{ 'customer.account.title' | t }}{% else %}{{ 'customer.login_page.sign_in' | t }}{% endif %}">
            <img src="{{ 'ow-icon-account.svg' | asset_url }}" alt="" width="30" height="30">
          </a>
        {%- endif -%}

        <a href="{{ routes.cart_url }}" class="navbar-cart" aria-label="{{ 'templates.cart.cart' | t }} ({{ cart.item_count }})">
          <img src="{{ 'ow-icon-cart.svg' | asset_url }}" alt="" width="30" height="30">
          {%- if cart.item_count > 0 -%}
            <span class="navbar-cart-count" aria-hidden="true">{{ cart.item_count }}</span>
          {%- endif -%}
        </a>
      </div>
      <button class="navbar-menu-btn" id="menuBtn" aria-label="Open menu">
        <svg width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M5 6.25C4.30965 6.25 3.75 6.80965 3.75 7.5C3.75 8.19035 4.30965 8.75 5 8.75H25C25.6904 8.75 26.25 8.19035 26.25 7.5C26.25 6.80965 25.6904 6.25 25 6.25H5ZM3.75 15C3.75 14.3096 4.30965 13.75 5 13.75H25C25.6904 13.75 26.25 14.3096 26.25 15C26.25 15.6904 25.6904 16.25 25 16.25H5C4.30965 16.25 3.75 15.6904 3.75 15ZM3.75 22.5C3.75 21.8096 4.30965 21.25 5 21.25H25C25.6904 21.25 26.25 21.8096 26.25 22.5C26.25 23.1904 25.6904 23.75 25 23.75H5C4.30965 23.75 3.75 23.1904 3.75 22.5Z" fill="#FF3F00"/>
        </svg>
      </button>
    </div>
  </nav>
</div><!-- /#top-chrome -->

{%- comment -%}
  Menu modal. The nav list is populated at runtime by ow-chrome.js from
  #navbar .navbar-links, so the markup here stays empty on purpose — one
  source of truth for the menu.
{%- endcomment -%}
<div class="menu-modal" id="menuModal" role="dialog" aria-modal="true" aria-label="Navigation menu">
  <div class="menu-modal-head">
    <a href="{{ routes.root_url }}"><img class="logo" src="{{ 'ow-logo.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="480" height="80"></a>
    <button class="menu-close" id="menuClose" aria-label="Close menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M18 6L6 18M6 6l12 12" stroke="#FF3F00" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
  <nav class="menu-nav"></nav>
  <div class="menu-bottom">
    {%- if section.settings.show_region_selector -%}
      {% render 'ow-region-selector',
           id_suffix: 'menu',
           inline: true,
           country_filter: section.settings.region_countries %}
    {%- endif -%}
    <div class="menu-bottom-links">
      {%- for link in section.settings.menu_bottom.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </div>
  </div>
</div>

<script src="{{ 'ow-chrome.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "OW Navbar",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu" },
    { "type": "link_list", "id": "menu_bottom", "label": "Menu modal footer links" },
    { "type": "checkbox", "id": "show_search", "label": "Show search icon", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show account icon", "default": true, "info": "Hidden automatically if customer accounts are disabled in Settings > Customer accounts." },
    { "type": "header", "content": "Country selector" },
    { "type": "checkbox", "id": "show_region_selector", "label": "Show country selector", "default": true },
    { "type": "text", "id": "region_countries", "label": "Countries to show", "info": "Comma-separated ISO codes, e.g. HK, TW, GB, US. Leave blank to show every country your Markets settings publish. This can only narrow that list — to ADD a country, publish it in Settings > Markets first. Codes Markets does not publish are ignored, and the shopper's current country always appears." }
  ],
  "presets": [
    {
      "name": "OW Navbar"
    }
  ]
}
{% endschema %}
