{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: 30px;
    padding-bottom: 20px;
  }

  /* 1px Increase for Inputs, Textareas, and Dropdowns */
  #shopify-section-{{ section.id }} .field__input,
  #shopify-section-{{ section.id }} .select__select {
    font-size: calc(var(--font-body-scale, 1) * 1.5rem + 1px) !important;
  }

  /* Fix for Dropdown Placeholder vs Selected Color */
  #shopify-section-{{ section.id }} .select__select:invalid {
    color: rgba(var(--color-foreground), 0.5);
  }
  #shopify-section-{{ section.id }} .select__select option {
    color: rgb(var(--color-foreground));
    background-color: rgb(var(--color-background));
  }
  #shopify-section-{{ section.id }} .select__select:focus,
  #shopify-section-{{ section.id }} .select__select:not(:invalid) {
    color: rgb(var(--color-foreground)) !important;
  }

  #shopify-section-{{ section.id }} .contact__description {
    line-height: 1.25 !important;
    margin-top: 1rem;
    margin-bottom: 0.8rem;
  }

  /* Single-column row stack configuration */
  #shopify-section-{{ section.id }} .contact__fields,
  #shopify-section-{{ section.id }} .field,
  #shopify-section-{{ section.id }} .contact-form__input {
    display: flex !important;
    flex-direction: column !important;
    width: 100% !important;
    max-width: 100% !important;
    margin-bottom: 1.2rem;
  }
  #shopify-section-{{ section.id }} .field__input,
  #shopify-section-{{ section.id }} .select,
  #shopify-section-{{ section.id }} .select__select {
    width: 100% !important;
  }

  /* Mobile Viewport Configuration */
  @media screen and (min-width: 749px) {
    #shopify-section-{{ section.id }} {
    padding-left: {{ section.settings.padding_horizontal_mobile }}px;
    padding-right: {{ section.settings.padding_horizontal_mobile }}px;
    }
  }

  /* THE FIX FOR MASSIVE VIEWPORTS (1400px+) */
    @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding-right: 0 !important;
      padding-left: 0 !important;      
      display: block !important;
      width: 100% !important;
    }

    /* Force theme containers to break centering mechanisms */
    #shopify-section-{{ section.id }} .contact.page-width--inner {
      padding-left: 0 !important;
      max-width: 600px !important; 
    }

    #shopify-section-{{ section.id }} .title-wrapper {
      padding-left: 0 !important;
      text-align: left !important;
    }
  }
{%- endstyle -%}

{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- assign custom_fields = section.blocks | where: "type", "custom_field" -%}
<div class="section--padding{% if section.settings.show_divider %} section--divider{% endif %}">
  <div class="contact page-width{% unless section.blocks.size > 0 and section.blocks.size > custom_fields.size %} page-width--inner{% endunless %}">
    {%- if section.blocks.size > 0 and section.blocks.size > custom_fields.size -%}
      <div class="flex-grid">
        <div class="flex-grid__item flex-grid__item--two-third">
    {%- endif -%}

      <div class="title-wrapper{% if section.settings.heading == blank %} title-wrapper--no-heading{% endif %}">
        <{{ section.settings.heading_tag }} class="title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</{{ section.settings.heading_tag }}>
        
        {%- if section.settings.description != blank -%}
          <div class="rte contact__description">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>
      
      <form-state>
        {%- assign form_id = 'WholesaleForm-' | append: section.id -%}
        {%- assign return_url = section.settings.return_url | default: 'back' | append: '' -%}
        
        {%- form 'contact', id: form_id, return_to: return_url -%}
          {%- if form.posted_successfully? -%}
            <div class="form-status form-status-list form__message" tabindex="-1" autofocus>
              {% render 'icon', icon: 'success' %}
              {{ 'templates.contact.form.post_success' | t }}
            </div>
          {%- endif -%}

          {% comment %} Stacks cleanly as individual vertical rows {% endcomment %}
          <div class="field">
            <input id="{{ form_id }}-name" class="field__input" autocomplete="name" type="text" name="contact[{{ 'templates.contact.form.name' | t }}]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="{{ 'templates.contact.form.name' | t }}" required="required"/>
            <label class="visually-hidden" for="{{ form_id }}-name">{{ 'templates.contact.form.name' | t }}</label>
          </div>

          <div class="field field--with-error">
            <input
              id="{{ form_id }}-email"
              autocomplete="email"
              type="email"
              class="field__input required{% if form.errors contains 'email' %} invalid{% endif %}"
              name="contact[email]"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="WholesaleForm-email-error-{{ section.id }}"
              {% endif %}
              placeholder="{{ 'templates.contact.form.email' | t }}"
              required="required"
            />
            <label class="visually-hidden" for="{{ form_id }}-email">{{ 'templates.contact.form.email' | t }} <span aria-hidden="true">*</span></label>
            {%- if form.errors contains 'email' -%}
              <small id="WholesaleForm-email-error-{{ section.id }}">
                <span class="form__message errors">
                  {% render 'icon', icon: 'error' %}
                  {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
                </span>
              </small>
            {%- endif -%}
          </div>

          <div class="field">
            <input id="{{ form_id }}-company" class="field__input" type="text" name="contact[Company Name]" placeholder="Company / Organisational Name" required="required"/>
            <label class="visually-hidden" for="{{ form_id }}-company">Company / Organisational Name *</label>
          </div>

          <div class="field">
            <input id="{{ form_id }}-phone" type="tel" class="field__input" autocomplete="tel" name="contact[Direct Phone Number]" pattern="[0-9\-]*" placeholder="Direct Contact Number" required="required"/>
            <label class="visually-hidden" for="{{ form_id }}-phone">Direct Contact Number *</label>
          </div>

          <div class="field contact-form__input">
            <select-wrapper class="select">
              <select class="select__select" id="{{ form_id }}-interests" name="contact[Interested In]" required="required">
                <option value="" disabled selected hidden>I'm interested in...</option>
                <optgroup label="We would like to work with Omawild on...">
                  <option value="Offices">Offices</option>
                  <option value="Gifting & Sponsorships">Gifting & Sponsorships</option>
                  <option value="Retail / Wholesale">Retail / Wholesale</option>
                  <option value="Café / Hospitality">Café & Hospitality</option>
                  <option value="Impact / Emergency Reflief">Impact / Emergency Reflief</option>
                  <option value="Something else">Something else</option>
                </optgroup>
              </select>
              {% render 'icon', icon: 'caret' %}
            </select-wrapper>
            <label class="visually-hidden" for="{{ form_id }}-interests">I'm interested in... *</label>
          </div>

          {%- if custom_fields.size > 0 -%}
            {%- for block in custom_fields -%}
              <div class="field contact-form__input" {{ block.shopify_attributes }}>
                {%- if block.settings.type == 'checkbox' -%}
                  <label for="line-item-{{ section.id }}-{{ block.id }}" class="form__facet-checkbox">
                    <input type="hidden" name="contact[{{ block.settings.label | escape }}]" value="{{ block.settings.unchecked_value | escape }}" />
                    <input id="line-item-{{ section.id }}-{{ block.id }}" type="checkbox" name="contact[{{ block.settings.label | escape }}]" value="{{ block.settings.checked_value | escape }}"{% if block.settings.required %} required{% endif %} />
                    {% render 'icon', icon: 'checkmark' %}
                    {{ block.settings.label | escape }}
                  </label>
                {%- else -%}
                  <label class="form__label{% if block.settings.type == 'text' or block.settings.type == 'textarea' or block.settings.type == 'select' %} visually-hidden{% endif %}" for="line-item-{{ section.id }}-{{ block.id }}">{{ block.settings.label | escape }}</label>
                  {%- case block.settings.type -%}
                    {%- when 'text' -%}
                      <input class="field__input" id="line-item-{{ section.id }}-{{ block.id }}" type="text" name="contact[{{ block.settings.label | escape }}]"{% if block.settings.required %} required{% endif %} placeholder="{{ block.settings.label | escape }}" />
                    {%- when 'textarea' -%}
                      <textarea class="text-area field__input" id="line-item-{{ section.id }}-{{ block.id }}" name="contact[{{ block.settings.label | escape }}]"{% if block.settings.required %} required{% endif %} placeholder="{{ block.settings.label | escape }}"></textarea>
                    {%- when 'radio' -%}
                      {%- assign options = block.settings.radio_options | split: ',' -%}
                      {%- if options.size > 1 -%}
                        <fieldset class="contact-form__input">
                          {%- for option in options -%}
                            <label class="form__facet-radio" for="line-item-{{ section.id }}-{{ block.id }}-{{ forloop.index0 }}">
                              <input id="line-item-{{ section.id }}-{{ block.id }}-{{ forloop.index0 }}" type="radio" name="contact[{{ block.settings.label | escape }}]" value="{{ option | strip | escape }}"{% if block.settings.required %} required{% endif %} />
                              <span class="icon"></span>
                              {{ option | strip | escape }}
                            </label>
                          {%- endfor -%}
                        </fieldset>
                      {%- endif -%}
                    {%- when 'select' -%}
                      {%- assign options = block.settings.select_options | split: ',' -%}
                      {%- if options.size > 1 -%}
                        <select-wrapper class="select">
                          <select class="select__select" id="line-item-{{ section.id }}-{{ block.id }}" name="contact[{{ block.settings.label | escape }}]"{% if block.settings.required %} required{% endif %}>
                            <option value="" disabled selected hidden>{{ block.settings.label | escape }}</option>
                            <optgroup label="{{ block.settings.label | escape }}">
                              {%- for option in options -%}
                                <option value="{{ option | strip | escape }}">
                                  {{ option | strip | escape }}
                                </option>
                              {%- endfor -%}
                            </optgroup>
                          </select>
                          {% render 'icon', icon: 'caret' %}
                        </select-wrapper>
                      {%- endif -%}
                  {%- endcase-%}
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endif -%}

          <div class="field">
            <textarea
              id="{{ form_id }}-body"
              rows="6"
              class="text-area field__input"
              name="contact[Tell us about your project]"
              placeholder="Tell us about your organisation, what you're looking for, or how you'd like to partner together."
            >{{- form.body -}}</textarea>
            <label class="visually-hidden" for="{{ form_id }}-body">Tell us about your project</label>
          </div>

          <div class="contact__button">
            <button type="submit" class="button">
              {{ section.settings.button_label | escape }}
            </button>
          </div>

          <div class="rte">
            {{ 'shopify.online_store.spam_detection.disclaimer_html' | t }}
          </div>
        {%- endform -%}
      </form-state>

    {%- if section.blocks.size > 0 and section.blocks.size > custom_fields.size -%}
        </div>
        <div class="flex-grid__item flex-grid__item--one-third">
          <ul class="contact__list list-unstyled">
            {%- for block in section.blocks -%}
              {%- if block.type != 'custom_field' -%}
                <li {{ block.shopify_attributes }}>
                  <p class="h3">{{ block.settings.heading | escape }}</p>

                  {%- case block.type -%}
                    {%- when 'contact' -%}
                      {%- if block.settings.link != blank -%}
                        <a class="link" href="{{ block.settings.link }}">
                      {%- endif -%}
                        {{ block.settings.text | escape }}
                      {%- if block.settings.link != blank -%}
                        </a>
                      {%- endif -%}

                    {%- when 'media' -%}
                      <ul class="list-unstyled list-social" role="lsit">
                        {%- render 'social-icons' -%}
                      </ul>
                  {%- endcase -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Wholesale Inquiry Form",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "url",
      "id": "return_url",
      "label": "t:sections.all.form.return_url.label",
      "info": "t:sections.all.form.return_url.info"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "default": false,
      "label": "t:sections.all.show_divider.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.heading.label"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Start the Conversation",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "default": "<p>We believe the best partnerships begin with a conversation. Whether you're placing your first order or simply curious about what we're building, we'd love to hear from you.</p>",
      "label": "Description Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Request Wholesale Catalogue",
      "label": "Button Label",
      "info": "Modify your primary call-to-action message here."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h3", "label": "Small" },
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h2",
      "label": "Heading Size"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "div", "label": "div" }
      ],
      "default": "h2",
      "label": "Heading Tag"
    },
    {
      "type": "header",
      "content": "Horizontal Form Alignment Layout"
    },
    {
      "type": "range",
      "id": "padding_horizontal_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop Form Left-Side Offset",
      "info": "On ultra-wide monitors, this slider acts as the absolute left gap to push the form out from the left edge.",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Mobile Form Left/Right Padding",
      "info": "Keeps form balanced and centered on phones.",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "contact",
      "name": "Side Contact Info",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Wholesale Operations",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "text",
          "default": "b2b@yourstore.com",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "media",
      "name": "Social Links",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Follow our B2B channel",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "custom_field",
      "name": "Additional Custom Field",
      "settings": [
        {
          "type": "select",
          "id": "type",
          "options": [
            { "value": "text", "label": "Text" },
            { "value": "textarea", "label": "Textarea" },
            { "value": "checkbox", "label": "Checkbox" },
            { "value": "radio", "label": "Radio" },
            { "value": "select", "label": "Select" }
          ],
          "default": "text",
          "label": "Type"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Your Custom Field"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required",
          "default": false
        },
        {
          "type": "header",
          "content": "Checkbox Options"
        },
        {
          "type": "text",
          "id": "checked_value",
          "label": "Checked Value",
          "default": "Yes"
        },
        {
          "type": "text",
          "id": "unchecked_value",
          "label": "Unchecked Value",
          "default": "No"
        },
        {
          "type": "header",
          "content": "Radio Options (Comma separated)"
        },
        {
          "type": "text",
          "id": "radio_options",
          "label": "Options"
        },
        {
          "type": "header",
          "content": "Dropdown Options (Comma separated)"
        },
        {
          "type": "text",
          "id": "select_options",
          "label": "Options"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wholesale Inquiry Form",
      "blocks": [
        { "type": "contact" }
      ]
    }
  ]
}
{% endschema %}