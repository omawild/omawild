{%- comment -%}
  oma-dispatch-feed — Dispatch's filterable story feed: featured-latest card
  + responsive grid + "load more". Filter pills are merchant-defined blocks
  (tag + display label) rather than hardcoded categories, so which
  categories exist and what they're called lives entirely in the theme
  editor. "All" is automatic and always first. Reflows to a single column on
  narrow screens via CSS grid rather than a separate list-mode markup.

  All matching articles (up to the "Articles to load" cap) are rendered into
  the DOM up front with their tags as data attributes; assets/oma-dispatch-
  feed.js does the filtering/paginating by toggling `hidden`, so switching
  filters never re-fetches the page.
{%- endcomment -%}
{% assign owid = section.id | replace: '-', '' | replace: '_', '' %}
{% style %}
.oma-dispatch-feed-{{ owid }} {
  box-sizing: border-box;
  background: {{ section.settings.background_color }};
  padding: {{ section.settings.padding_top }}px clamp(20px, 4vw, 48px) {{ section.settings.padding_bottom }}px;
  font-family: var(--font-body-family);
  }
.oma-dispatch-feed-{{ owid }} *, .oma-dispatch-feed-{{ owid }} *::before, .oma-dispatch-feed-{{ owid }} *::after {
  box-sizing: border-box;
  }
.oma-dispatch-feed-{{ owid }} .inner {
  max-width: 1280px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 28px;
  }
.oma-dispatch-feed-{{ owid }} .filters {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  scrollbar-width: none;
  }
.oma-dispatch-feed-{{ owid }} .filters::-webkit-scrollbar {
  display: none;
  }
.oma-dispatch-feed-{{ owid }} .filter-pill {
  flex: none;
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 44px;
  cursor: pointer;
  border: 1.5px solid {{ section.settings.accent_color }};
  background: #ffffff;
  color: {{ section.settings.accent_color }};
  padding: 0 18px;
  border-radius: 999px;
  font: 800 12px/1 var(--font-heading-family);
  }
.oma-dispatch-feed-{{ owid }} .filter-pill[aria-selected="true"] {
  background: {{ section.settings.accent_color }};
  color: #ffffff;
  }
.oma-dispatch-feed-{{ owid }} .filter-pill .count {
  font: 700 11px/1 var(--font-body-family);
  opacity: .8;
  }
.oma-dispatch-feed-{{ owid }} .featured {
  display: grid;
  grid-template-columns: 1fr;
  border: 1.5px solid {{ section.settings.accent_color }};
  background: #ffffff;
  text-decoration: none;
  color: {{ section.settings.text_color }};
  transition: background .15s ease;
  }
.oma-dispatch-feed-{{ owid }} .featured:hover {
  background: {{ section.settings.hover_background }};
  }
@media (min-width: 900px) {
  .oma-dispatch-feed-{{ owid }} .featured {
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
  }
}
.oma-dispatch-feed-{{ owid }} .featured-media {
  position: relative;
  min-width: 0;
  overflow: hidden;
  aspect-ratio: 3 / 2;
  background: {{ section.settings.hover_background }};
  border-bottom: 1.5px solid {{ section.settings.accent_color }};
  box-sizing: border-box;
  }
@media (min-width: 900px) {
  .oma-dispatch-feed-{{ owid }} .featured-media {
    aspect-ratio: auto;
    border-bottom: none;
    border-right: 1.5px solid {{ section.settings.accent_color }};
  }
}
.oma-dispatch-feed-{{ owid }} .featured-media img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  }
.oma-dispatch-feed-{{ owid }} .featured-body {
  min-width: 0;
  padding: clamp(22px, 3vw, 44px);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  }
.oma-dispatch-feed-{{ owid }} .featured-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px 12px;
  }
.oma-dispatch-feed-{{ owid }} .badge {
  border: 1.5px solid {{ section.settings.accent_color }};
  color: {{ section.settings.accent_color }};
  padding: 5px 8px;
  border-radius: 4px;
  font: 800 10px/1 var(--font-heading-family);
  letter-spacing: .1em;
  }
.oma-dispatch-feed-{{ owid }} .kicker {
  font: 800 10.5px/1.3 var(--font-heading-family);
  letter-spacing: .12em;
  color: {{ section.settings.accent_color }};
  }
.oma-dispatch-feed-{{ owid }} .featured-title {
  margin: 18px 0 0;
  font-family: var(--font-heading-family);
  font-weight: 900;
  font-size: clamp(34px, 4.6vw, 68px);
  line-height: .94;
  letter-spacing: -.045em;
  color: {{ section.settings.accent_color }};
  text-wrap: balance;
  }
.oma-dispatch-feed-{{ owid }} .featured-excerpt {
  margin: 20px 0 0;
  max-width: 46ch;
  font-size: 16.5px;
  line-height: 1.6;
  color: {{ section.settings.text_color }};
  text-wrap: pretty;
  }
.oma-dispatch-feed-{{ owid }} .featured-foot {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-top: auto;
  padding-top: 28px;
  }
.oma-dispatch-feed-{{ owid }} .read-time {
  font: 700 12.5px/1.55 var(--font-body-family);
  color: {{ section.settings.text_color }};
  }
.oma-dispatch-feed-{{ owid }} .read-cta {
  background: {{ section.settings.accent_color }};
  color: #ffffff;
  padding: 14px 22px;
  border-radius: 999px;
  font: 800 12px/1 var(--font-heading-family);
  }
.oma-dispatch-feed-{{ owid }} .grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  gap: 24px;
  }
.oma-dispatch-feed-{{ owid }} .story-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  border: 1.5px solid {{ section.settings.accent_color }};
  background: #ffffff;
  text-decoration: none;
  color: {{ section.settings.text_color }};
  transition: background .15s ease;
  }
.oma-dispatch-feed-{{ owid }} .story-card:hover {
  background: {{ section.settings.hover_background }};
  }
.oma-dispatch-feed-{{ owid }} .story-media {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  background: {{ section.settings.hover_background }};
  border-bottom: 1.5px solid {{ section.settings.accent_color }};
  }
.oma-dispatch-feed-{{ owid }} .story-media img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  }
.oma-dispatch-feed-{{ owid }} .story-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 20px 20px 22px;
  }
.oma-dispatch-feed-{{ owid }} .story-title {
  margin: 12px 0 0;
  font-family: var(--font-heading-family);
  font-weight: 900;
  font-size: 24px;
  line-height: 1.05;
  letter-spacing: -.03em;
  color: {{ section.settings.accent_color }};
  text-wrap: balance;
  }
.oma-dispatch-feed-{{ owid }} .story-excerpt {
  margin: 12px 0 0;
  font-size: 14.5px;
  line-height: 1.6;
  color: {{ section.settings.text_color }};
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  }
.oma-dispatch-feed-{{ owid }} .story-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-top: auto;
  padding-top: 18px;
  }
.oma-dispatch-feed-{{ owid }} .story-read {
  font: 800 14.5px/1 var(--font-heading-family);
  color: {{ section.settings.accent_color }};
  }
.oma-dispatch-feed-{{ owid }} .story-date {
  font: 700 12.5px/1 var(--font-body-family);
  color: {{ section.settings.text_color }};
  }
.oma-dispatch-feed-{{ owid }} .more-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  padding-top: 16px;
  }
.oma-dispatch-feed-{{ owid }} .shown-count {
  font: 700 12.5px/1.55 var(--font-body-family);
  color: {{ section.settings.text_color }};
  }
.oma-dispatch-feed-{{ owid }} .progress-track {
  width: min(240px, 60%);
  height: 4px;
  background: {{ section.settings.hover_background }};
  border-radius: 4px;
  overflow: hidden;
  }
.oma-dispatch-feed-{{ owid }} .progress-fill {
  height: 100%;
  width: 0%;
  background: {{ section.settings.accent_color }};
  }
.oma-dispatch-feed-{{ owid }} .load-more {
  min-height: 48px;
  cursor: pointer;
  border: 1.5px solid {{ section.settings.accent_color }};
  background: transparent;
  color: {{ section.settings.accent_color }};
  padding: 0 26px;
  border-radius: 999px;
  font: 800 12px/1 var(--font-heading-family);
  }
.oma-dispatch-feed-{{ owid }} .load-more:hover {
  background: {{ section.settings.accent_color }};
  color: #ffffff;
  }
.oma-dispatch-feed-{{ owid }} .empty-message {
  margin: 0;
  padding: 40px 0;
  border-top: 1.5px solid {{ section.settings.accent_color }};
  font-size: 16.5px;
  line-height: 1.6;
  color: {{ section.settings.text_color }};
  }
{% endstyle %}
{%- liquid
  assign filter_blocks = section.blocks | where: 'type', 'filter'
  assign all_articles = section.settings.blog.articles | slice: 0, section.settings.post_limit
  assign total_count = all_articles.size
  assign has_featured = false
  if section.settings.show_featured and total_count > 0
    assign has_featured = true
  endif
-%}
<div class="oma-dispatch-feed-{{ owid }}" data-oma-dispatch-feed data-section-id="{{ section.id }}" data-page-size="{{ section.settings.page_size }}" data-has-featured="{{ has_featured }}">
  <div class="inner">
    {%- if section.settings.blog == blank -%}
      {%- if request.design_mode -%}
        <p>Select a blog above to show its stories here.</p>
      {%- endif -%}
    {%- else -%}
      <div class="filters" role="tablist" aria-label="Filter stories" data-filter-row>
        <button type="button" class="filter-pill" role="tab" aria-selected="true" data-filter-tag="">
          <span>{{ section.settings.all_label | escape }}</span>
          <span class="count">{{ total_count }}</span>
        </button>
        {%- for block in filter_blocks -%}
          {%- if block.settings.tag != blank -%}
            {%- assign needle = '|' | append: block.settings.tag | downcase | append: '|' -%}
            {%- assign tag_count = 0 -%}
            {%- for article in all_articles -%}
              {%- assign haystack = '|' -%}
              {%- for t in article.tags -%}{%- assign haystack = haystack | append: t | downcase | append: '|' -%}{%- endfor -%}
              {%- if haystack contains needle -%}{%- assign tag_count = tag_count | plus: 1 -%}{%- endif -%}
            {%- endfor -%}
            <button type="button" class="filter-pill" role="tab" aria-selected="false" data-filter-tag="{{ block.settings.tag | escape }}" {{ block.shopify_attributes }}>
              <span>{{ block.settings.label | default: block.settings.tag | escape }}</span>
              <span class="count">{{ tag_count }}</span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if has_featured -%}
        {%- assign featured = all_articles.first -%}
        {%- assign featured_words = featured.content | strip_html | split: ' ' | size -%}
        {%- assign featured_read = featured_words | divided_by: 225 | at_least: 1 -%}
        <a href="{{ featured.url }}" class="featured" data-featured-card data-tags="{{ featured.tags | join: '|' | escape }}">
          <div class="featured-media">
            {%- if featured.image != blank -%}
              {{ featured.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '480, 800, 1200, 1600', alt: featured.title }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="featured-body">
            <div class="featured-meta">
              <span class="badge">{{ section.settings.featured_badge_label | escape }}</span>
              {%- if featured.tags.size > 0 -%}<span class="kicker">{{ featured.tags | join: ' · ' | upcase }}</span>{%- endif -%}
            </div>
            <h2 class="featured-title">{{ featured.title }}</h2>
            {%- if featured.excerpt != blank -%}
              <p class="featured-excerpt">{{ featured.excerpt | strip_html }}</p>
            {%- else -%}
              <p class="featured-excerpt">{{ featured.content | strip_html | truncatewords: 40 }}</p>
            {%- endif -%}
            <div class="featured-foot">
              <span class="read-time">{{ featured.published_at | time_tag: format: 'month_day_year' }} · {{ featured_read }} {{ section.settings.read_time_label | escape }}</span>
              <span class="read-cta">{{ section.settings.read_label | escape }} →</span>
            </div>
          </div>
        </a>
      {%- endif -%}

      <div class="grid" data-feed-grid>
        {%- for article in all_articles -%}
          {%- if has_featured and forloop.first -%}{%- continue -%}{%- endif -%}
          <a href="{{ article.url }}" class="story-card" data-story-card data-tags="{{ article.tags | join: '|' | escape }}" {% if forloop.index0 >= section.settings.page_size %}hidden{% endif %}>
            <div class="story-media">
              {%- if article.image != blank -%}
                {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 600, 900', alt: article.title }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div class="story-body">
              {%- if article.tags.size > 0 -%}<div class="kicker">{{ article.tags | join: ' · ' | upcase }}</div>{%- endif -%}
              <h3 class="story-title">{{ article.title }}</h3>
              {%- if article.excerpt != blank -%}
                <p class="story-excerpt">{{ article.excerpt | strip_html }}</p>
              {%- else -%}
                <p class="story-excerpt">{{ article.content | strip_html | truncatewords: 30 }}</p>
              {%- endif -%}
              <div class="story-foot">
                <span class="story-read">{{ section.settings.read_label | escape }} →</span>
                <span class="story-date">{{ article.published_at | time_tag: format: 'month_day_year' }}</span>
              </div>
            </div>
          </a>
        {%- endfor -%}
      </div>

      <div class="more-row" data-more-row hidden>
        <div class="shown-count" data-shown-count></div>
        <div class="progress-track" aria-hidden="true"><div class="progress-fill" data-progress-fill></div></div>
        <button type="button" class="load-more" data-load-more>{{ section.settings.load_more_label | escape }}</button>
      </div>

      <p class="empty-message" data-empty-message hidden>{{ section.settings.empty_message | escape }}</p>
    {%- endif -%}
  </div>
</div>
<script>
  window.omaDispatchFeedI18n = window.omaDispatchFeedI18n || {};
  window.omaDispatchFeedI18n["{{ section.id }}"] = {
    shownOfTotal: {{ section.settings.shown_of_total_label | json }},
    loadMore: {{ section.settings.load_more_label | json }}
  };
</script>
<script src="{{ 'oma-dispatch-feed.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "OMA Dispatch Feed",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "post_limit", "label": "Articles to load", "min": 12, "max": 96, "step": 12, "default": 60, "info": "Every matching article up to this cap is rendered for client-side filtering; raise it once the blog outgrows it." },
    { "type": "range", "id": "page_size", "label": "Stories shown per \"Load more\" click", "min": 4, "max": 24, "step": 4, "default": 12 },
    { "type": "checkbox", "id": "show_featured", "label": "Feature the latest story", "default": true },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "all_label", "label": "\"All\" pill label", "default": "All" },
    { "type": "text", "id": "featured_badge_label", "label": "Featured badge", "default": "LATEST" },
    { "type": "text", "id": "read_label", "label": "\"Read\" link text", "default": "Read the story" },
    { "type": "text", "id": "read_time_label", "label": "Read-time unit", "default": "min read" },
    { "type": "text", "id": "shown_of_total_label", "label": "\"Shown of total\" text", "default": "Showing {shown} of {total} stories", "info": "Use {shown} and {total} as placeholders." },
    { "type": "text", "id": "load_more_label", "label": "\"Load more\" button text", "default": "Load {count} more", "info": "Use {count} as a placeholder for how many stories the click will reveal." },
    { "type": "text", "id": "empty_message", "label": "Empty-filter message", "default": "More stories from this series are on their way." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#F7F5F1" },
    { "type": "color", "id": "accent_color", "label": "Accent (borders, titles, pills)", "default": "#FF3F00" },
    { "type": "color", "id": "text_color", "label": "Body text color", "default": "#00180C" },
    { "type": "color", "id": "hover_background", "label": "Hover / image placeholder background", "default": "#FFE4E7" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 60, "step": 4, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Filter pill",
      "settings": [
        { "type": "text", "id": "tag", "label": "Article tag to match", "info": "Must match an Article's tag exactly (case-insensitive)." },
        { "type": "text", "id": "label", "label": "Display label", "info": "Blank uses the tag as typed above." }
      ]
    }
  ],
  "presets": [
    {
      "name": "OMA Dispatch Feed",
      "blocks": [
        { "type": "filter", "settings": { "tag": "reflections", "label": "Reflections" } },
        { "type": "filter", "settings": { "tag": "expedition", "label": "Expeditions" } }
      ]
    }
  ]
}
{% endschema %}
