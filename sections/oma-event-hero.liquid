{%- comment -%}
  oma-event-hero — opener for event landing pages (first used on Meet
  Taipei 2026): breadcrumb, a tilted sticker pill, display title, lead,
  one or two pill buttons and a large illustration. Matches "Hero (split)"
  and "Hero (centered)" in the Meet Taipei Page of the Omawild Web Redesign
  handoff -- the layout setting switches between the two.

  Kept separate from oma-page-header.liquid (shared by five pages, no
  illustration or buttons) and oma-hero.liquid (the homepage's planet
  hero) for the same reason as oma-page-header-origin.liquid: the needs
  don't fit either one's settings.
{%- endcomment -%}
{% assign owid = section.id | replace: '-', '' | replace: '_', '' %}
{%- assign centered = false -%}
{%- if section.settings.layout == 'centered' -%}{%- assign centered = true -%}{%- endif -%}
{% style %}
.oma-event-hero-{{ owid }} {
  box-sizing: border-box;
  background: {{ section.settings.background_color }};
  color: {{ section.settings.text_color }};
  overflow: hidden;
  font-family: var(--font-body-family);
  }
.oma-event-hero-{{ owid }} *, .oma-event-hero-{{ owid }} *::before, .oma-event-hero-{{ owid }} *::after {
  box-sizing: border-box;
  }
.oma-event-hero-{{ owid }} .inner {
  max-width: 1440px;
  margin: 0 auto;
  padding: {{ section.settings.padding_top }}px clamp(20px, 4vw, 48px) {% if centered %}0{% else %}clamp(40px, 5vw, 64px){% endif %};
  }
.oma-event-hero-{{ owid }} .crumbs {
  display: flex;
  gap: 6px;
  font: 700 11px/1.4 var(--font-heading-family);
  letter-spacing: .06em;
  color: {{ section.settings.crumb_color }};
  }
.oma-event-hero-{{ owid }} .crumbs a {
  color: inherit;
  text-decoration: none;
  }
.oma-event-hero-{{ owid }} .crumbs a:hover {
  text-decoration: underline;
  }
.oma-event-hero-{{ owid }} .row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: clamp(24px, 4vw, 56px);
  margin-top: clamp(20px, 3vw, 36px);
  }
.oma-event-hero-{{ owid }} .copy {
  flex: 1 1 440px;
  min-width: 0;
  }
.oma-event-hero-{{ owid }} .art {
  flex: 1.3 1 520px;
  min-width: 0;
  margin-right: clamp(-48px, -2vw, 0px);
  }
.oma-event-hero-{{ owid }}.is-centered .row {
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 0;
  margin-top: clamp(24px, 3vw, 40px);
  }
.oma-event-hero-{{ owid }}.is-centered .copy {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  }
.oma-event-hero-{{ owid }}.is-centered .art {
  flex: none;
  width: min(100%, 980px);
  margin: clamp(24px, 3vw, 40px) 0 0;
  }
.oma-event-hero-{{ owid }} .sticker {
  display: inline-block;
  background: {{ section.settings.sticker_background }};
  color: {{ section.settings.sticker_text_color }};
  padding: 8px 14px;
  border-radius: 100px;
  font: 900 10.5px/1 var(--font-heading-family);
  letter-spacing: .12em;
  transform: rotate(-2deg);
  }
.oma-event-hero-{{ owid }} h1 {
  margin: 24px 0 0;
  font: 900 clamp(52px, 7.4vw, 112px)/.9 var(--font-heading-family);
  letter-spacing: -.05em;
  color: inherit;
  text-wrap: balance;
  }
.oma-event-hero-{{ owid }}.is-centered h1 {
  max-width: 10ch;
  font-size: clamp(56px, 8.4vw, 128px);
  line-height: .88;
  }
.oma-event-hero-{{ owid }} .lead {
  margin: 22px 0 0;
  max-width: 40ch;
  font: 400 16.5px/1.6 var(--font-body-family);
  }
.oma-event-hero-{{ owid }}.is-centered .lead {
  max-width: 52ch;
  }
.oma-event-hero-{{ owid }} .buttons {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
  margin-top: 30px;
  }
.oma-event-hero-{{ owid }}.is-centered .buttons {
  justify-content: center;
  margin-top: 28px;
  }
.oma-event-hero-{{ owid }} .btn {
  display: inline-block;
  text-decoration: none;
  padding: 15.5px 28px;
  border: 1.5px solid {{ section.settings.text_color }};
  border-radius: 100px;
  font: 900 13px/1 var(--font-heading-family);
  transition: background .15s ease, color .15s ease, border-color .15s ease;
  }
.oma-event-hero-{{ owid }} .btn-primary {
  background: {{ section.settings.text_color }};
  color: {{ section.settings.background_color }};
  }
.oma-event-hero-{{ owid }} .btn-primary:hover {
  background: {{ section.settings.sticker_background }};
  border-color: {{ section.settings.sticker_background }};
  }
.oma-event-hero-{{ owid }} .btn-secondary {
  color: {{ section.settings.text_color }};
  }
.oma-event-hero-{{ owid }} .btn-secondary:hover {
  background: {{ section.settings.text_color }};
  color: {{ section.settings.background_color }};
  }
.oma-event-hero-{{ owid }} .art img,
.oma-event-hero-{{ owid }} .art svg {
  display: block;
  width: 100%;
  height: auto;
  }
{%- if section.settings.hide_image_mobile %}
@media (max-width: 749px) {
  .oma-event-hero-{{ owid }} .art {
    display: none;
  }
  .oma-event-hero-{{ owid }}.is-centered .inner {
    padding-bottom: clamp(40px, 5vw, 64px);
  }
}
{%- endif %}
{% endstyle %}
<header class="oma-event-hero-{{ owid }}{% if centered %} is-centered{% endif %}" id="{{ section.settings.anchor_id | default: 'top' | handleize }}">
  <div class="inner">
    {%- if section.settings.show_breadcrumb -%}
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t | default: 'Home' }}</a>
        <span aria-hidden="true">/</span>
        <span>{{ section.settings.breadcrumb_label | default: page.title | escape }}</span>
      </nav>
    {%- endif -%}
    <div class="row">
      <div class="copy">
        {%- if section.settings.sticker != blank -%}<span class="sticker">{{ section.settings.sticker | escape }}</span>{%- endif -%}
        <h1>{{ section.settings.heading }}</h1>
        {%- if section.settings.lead != blank -%}<p class="lead">{{ section.settings.lead }}</p>{%- endif -%}
        {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
          <div class="buttons">
            {%- if section.settings.primary_label != blank -%}
              <a class="btn btn-primary" href="{{ section.settings.primary_link | default: '#' }}">{{ section.settings.primary_label | escape }}</a>
            {%- endif -%}
            {%- if section.settings.secondary_label != blank and centered == false -%}
              <a class="btn btn-secondary" href="{{ section.settings.secondary_link | default: '#' }}">{{ section.settings.secondary_label | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
      <div class="art">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1600, 2000', sizes: '(min-width: 1024px) 60vw, 100vw' }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
    </div>
  </div>
</header>
{% schema %}
{
  "name": "OMA Event Hero",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "split", "label": "Split (text left, illustration right)" },
        { "value": "centered", "label": "Centered (illustration below)" }
      ],
      "default": "split",
      "info": "Centered shows the primary button only."
    },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "text", "id": "breadcrumb_label", "label": "Breadcrumb label", "info": "Defaults to the page title." },
    { "type": "text", "id": "sticker", "label": "Sticker", "default": "BACK BY POPULAR DEMAND · NOV 19–21" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Exhibitor Coffee Pass" },
    { "type": "inline_richtext", "id": "lead", "label": "Lead", "default": "Cold brew at Booth [__], every day of Meet Taipei." },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Choose your pass ↓" },
    { "type": "url", "id": "primary_link", "label": "Primary button link", "info": "e.g. #passes to jump to the pass cards." },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "What's in the cup" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link", "info": "e.g. #reserve" },
    { "type": "header", "content": "Illustration" },
    { "type": "image_picker", "id": "image", "label": "Illustration", "info": "Set its alt text in Files." },
    { "type": "checkbox", "id": "hide_image_mobile", "label": "Hide illustration on mobile", "info": "Below 750px wide, so the buttons sit higher on the screen.", "default": false },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FF3F00" },
    { "type": "color", "id": "text_color", "label": "Heading, text and buttons", "default": "#FFFFFF" },
    { "type": "color", "id": "crumb_color", "label": "Breadcrumb", "default": "#FCD0FD" },
    { "type": "color", "id": "sticker_background", "label": "Sticker and button hover", "default": "#FCD0FD" },
    { "type": "color", "id": "sticker_text_color", "label": "Sticker text", "default": "#FF3F00" },
    { "type": "header", "content": "Layout" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "top" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 }
  ],
  "presets": [
    { "name": "OMA Event Hero" }
  ]
}
{% endschema %}
