{%- comment -%}
  Products Band — Standalone section file
  Layout lives in assets/ow-landing.css and behavior in assets/ow-landing.js.
{%- endcomment -%}

<section class="products-band" id="products-band">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="products-band__header">
        <h2 class="products-band__title h2">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="products-band__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'product_card' -%}
            <div class="products-band__item" {{ block.shopify_attributes }}>
              {%- assign product = block.settings.product -%}
              {%- if product != blank -%}
                <div class="product-card">
                  <a href="{{ product.url }}" class="product-card__link">
                    <div class="product-card__media">
                      {%- if product.featured_media -%}
                        {{ product.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', class: 'product-card__image' }}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      {%- endif -%}
                    </div>
                    <div class="product-card__info">
                      <h3 class="product-card__title">{{ product.title }}</h3>
                      <div class="product-card__price">{{ product.price | money }}</div>
                    </div>
                  </a>
                </div>
              {%- else -%}
                <div class="product-card product-card--placeholder">
                  <p>Select a product in block settings</p>
                </div>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="products-band__item">
            <div class="product-card product-card--placeholder">
              {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
              <p>Product Title</p>
              <p>{{ 1999 | money }}</p>
            </div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "OW Products Band",
  "tag": "section",
  "class": "section-products-band",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "OW Products Band",
      "blocks": [
        {
          "type": "product_card"
        },
        {
          "type": "product_card"
        },
        {
          "type": "product_card"
        }
      ]
    }
  ]
}
{% endschema %}