{%- comment -%}
  owv2-product-origin — the red origin band under the buy panel (canvas 4a / 5b).

  The Story body used to default via the schema's own "default" (a Liquid
  string referencing product.metafields.custom.about_origin), same as
  name/place do. Confirmed via a freshly-added section instance's actual
  stored settings in templates/product.product-coffee.json that this does
  NOT work: kicker/name/place/cta_label (all "text" settings) correctly
  materialized their schema defaults, but body (a "richtext" setting) came
  out as "" regardless of what its schema default said. Shopify's preset
  materialization appears to just not honor richtext defaults. The fallback
  is computed here in Liquid instead, at render time, which works no matter
  how the instance was created and doesn't depend on that schema mechanism
  at all.

  about_origin is itself a Rich Text metafield (Shopify's rich_text_field
  type). Its .value is the editor's internal AST as a Ruby-hash-style string
  (literally {"type"=>"root","children"=>...), not HTML -- rendering .value
  directly, even escaped, just prints that raw structure. metafield_tag
  applied to the metafield itself (not .value) is what actually converts a
  rich_text_field's AST into real HTML.
{%- endcomment -%}

{{ 'owv2-product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign body = section.settings.body
  if body == blank
    assign about_origin = product.metafields.custom.about_origin
    if about_origin != blank
      assign body = about_origin | metafield_tag
    endif
  endif
-%}

<div class="od-pdp">
  <section class="odp-origin" data-odp-origin aria-labelledby="odp-origin-{{ section.id }}">
    <div class="odp-origin__inner">
      <div class="odp-origin__head">
        <p class="odp-label">{{ section.settings.kicker }}</p>
        <h2 class="odp-origin__name" id="odp-origin-{{ section.id }}">{{ section.settings.name }}</h2>
        {%- if section.settings.place != blank -%}
          <p class="odp-origin__place">{{ section.settings.place }}</p>
        {%- endif -%}
      </div>
      <div class="odp-origin__story">
        <div class="odp-origin__body">{{ body }}</div>
        {%- if section.settings.cta_label != blank -%}
          <a class="odp-origin__cta" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <dl class="odp-origin__facts">
          {%- for block in section.blocks -%}
            <div class="odp-fact" {{ block.shopify_attributes }}>
              <dt>{{ block.settings.key }}</dt>
              <dd>{{ block.settings.value }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "OWV2 Product — origin",
  "tag": "section",
  "class": "owv2-section owv2-product-origin",
  "enabled_on": { "templates": ["product"] },
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The origin" },
    { "type": "text", "id": "name", "label": "Origin", "default": "{{ product.metafields.custom[\"origin-of-country\"].value }}", "info": "Defaults to the Origin metafield." },
    { "type": "text", "id": "place", "label": "Place", "default": "{{ product.metafields.custom.region.value }}", "info": "Defaults to the Region metafield." },
    { "type": "richtext", "id": "body", "label": "Story", "info": "Defaults to the about_origin metafield -- see the Liquid at the top of this file, not this schema default (Shopify doesn't materialize richtext schema defaults on new instances, and this would be the wrong syntax for a Rich Text metafield anyway)." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Read the full origin story →" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        { "type": "text", "id": "key", "label": "Label", "default": "Producer" },
        { "type": "text", "id": "value", "label": "Value", "default": "{{ product.metafields.custom.farm_producer.value }}" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OWV2 Product — origin",
      "blocks": [
        { "type": "fact", "settings": { "key": "Producer", "value": "{{ product.metafields.custom.farm_producer.value }}" } },
        { "type": "fact", "settings": { "key": "Elevation", "value": "{{ product.metafields.custom.elevation_masl.value }} MASL" } },
        { "type": "fact", "settings": { "key": "Region", "value": "{{ product.metafields.custom.region.value }}" } },
        { "type": "fact", "settings": { "key": "Crop year", "value": "{{ product.metafields.custom.crop_year.value }}" } },
        { "type": "fact", "settings": { "key": "Varietal", "value": "{{ product.metafields.custom.varietal_all_listed.value }}" } }
      ]
    }
  ]
}
{% endschema %}
