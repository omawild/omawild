{%- comment -%}
  owv2-product-origin — the red origin band under the buy panel (canvas 4a / 5b).
  Name/place/facts default to the same product.metafields.custom.* fields the
  vendor "Behind the Bean" blocks already use on this template (origin-of-country,
  region, elevation_masl, crop_year, farmer_producer, varietal_all_listed), so a
  coffee with those metafields set needs no further editing. The story field has
  no equivalent metafield yet, so it defaults blank rather than inventing one.

  The Farm Story button link defaults to product.metafields.custom.about_origin
  when the merchant hasn't set an explicit Button link. That metafield's Type
  determines how to read a URL out of it, so this branches on .type rather than
  assuming one shape -- same reasoning as the taste_notes handling one section
  over in owv2-product-main.liquid. url and single_line_text_field cover a
  plain link typed straight into the metafield; page/product/collection/
  metaobject_reference cover linking it to an actual resource instead (a
  metaobject only resolves a URL if its definition has "Add a storefront
  page" turned on). Anything else -- or no about_origin value at all -- falls
  back to the manual Button link setting, and the button just doesn't render
  if that's blank too.
{%- endcomment -%}

{{ 'owv2-product.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  No per-section color settings here on purpose, same reasoning as
  owv2-product-main.liquid: Omawild has one brand palette, and a merchant-
  editable color picker per PDP section would let it drift product by
  product. This section just uses .od-pdp's own defaults in
  assets/owv2-product.css.
{%- endcomment -%}

<div class="od-pdp">
  <section class="odp-origin" data-odp-origin aria-labelledby="odp-origin-{{ section.id }}">
    <div class="odp-origin__inner">
      <div class="odp-origin__head">
        <p class="odp-label">{{ section.settings.kicker }}</p>
        <h2 class="odp-origin__name" id="odp-origin-{{ section.id }}">{{ section.settings.name }}</h2>
        {%- if section.settings.place != blank -%}
          <p class="odp-origin__place">{{ section.settings.place }}</p>
        {%- endif -%}
      </div>
      <div class="odp-origin__story">
        <div class="odp-origin__body">{{ section.settings.body }}</div>
        {%- liquid
          assign cta_url = section.settings.cta_url
          if cta_url == blank
            assign about_origin = product.metafields.custom.about_origin
            case about_origin.type
              when 'url'
                assign cta_url = about_origin.value
              when 'single_line_text_field'
                assign cta_url = about_origin.value
              when 'page_reference', 'product_reference', 'collection_reference', 'metaobject_reference'
                assign cta_url = about_origin.value.url
            endcase
          endif
        -%}
        {%- if section.settings.cta_label != blank and cta_url != blank -%}
          <a class="odp-origin__cta" href="{{ cta_url }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <dl class="odp-origin__facts">
          {%- for block in section.blocks -%}
            <div class="odp-fact" {{ block.shopify_attributes }}>
              <dt>{{ block.settings.key }}</dt>
              <dd>{{ block.settings.value }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "OWV2 Product — origin",
  "tag": "section",
  "class": "owv2-section owv2-product-origin",
  "enabled_on": { "templates": ["product"] },
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The origin" },
    { "type": "text", "id": "name", "label": "Origin", "default": "{{ product.metafields.custom[\"origin-of-country\"].value }}", "info": "Defaults to the origin-of-country metafield." },
    { "type": "text", "id": "place", "label": "Place", "default": "{{ product.metafields.custom.region.value }}", "info": "Defaults to the region metafield." },
    { "type": "richtext", "id": "body", "label": "Story", "info": "No metafield for a farm story yet — write this per coffee, or connect one via the dynamic source icon." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Read the full origin story →" },
    { "type": "url", "id": "cta_url", "label": "Button link", "info": "Defaults to the about_origin metafield when left blank." }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        { "type": "text", "id": "key", "label": "Label", "default": "Producer" },
        { "type": "text", "id": "value", "label": "Value", "default": "{{ product.metafields.custom.farmer_producer.value }}" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OWV2 Product — origin",
      "blocks": [
        { "type": "fact", "settings": { "key": "Producer", "value": "{{ product.metafields.custom.farmer_producer.value }}" } },
        { "type": "fact", "settings": { "key": "Elevation", "value": "{{ product.metafields.custom.elevation_masl.value }} MASL" } },
        { "type": "fact", "settings": { "key": "Region", "value": "{{ product.metafields.custom.region.value }}" } },
        { "type": "fact", "settings": { "key": "Crop year", "value": "{{ product.metafields.custom.crop_year.value }}" } },
        { "type": "fact", "settings": { "key": "Varietal", "value": "{{ product.metafields.custom.varietal_all_listed.value }}" } }
      ]
    }
  ]
}
{% endschema %}
