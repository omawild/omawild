{%- comment -%}
  ow-footer — Omawild site footer, replacing the RoarTheme footer site-wide via
  sections/footer-group.json.

  The email signup is a real Shopify customer form (tags it as accepts_marketing)
  rather than the design's inert <form id="footerEmailForm">. ow-chrome.js still
  shows the success toast; on a real submit Shopify round-trips the page and the
  form.posted_successfully? branch below re-opens the toast on return.

  Nav columns are blocks (nav_column), one per column, however many the
  merchant adds/removes/reorders -- not a fixed set of slots. Each points at
  a Shopify Navigation link list, so the links themselves stay editable in
  the admin; leave a column's menu unset to drop it.

  Layout: .footer-grid puts the brand block (logo/copyright/1% badge) and
  the nav columns in one CSS grid row on tablet+ (assets/ow-chrome.css),
  ordered via `order`, not DOM position, so mobile can stack them in the
  opposite order (nav accordion, then brand) without duplicating markup.
  Social icons and payment icons are each a single instance now too,
  repositioned per breakpoint by CSS rather than rendered into two slots.
{%- endcomment -%}

{{ 'ow-chrome.css' | asset_url | stylesheet_tag }}

<footer class="footer">
  <div class="footer-top">
    <div class="footer-newsletter">
      <img class="footer-head" src="{{ 'ow-nature-head.svg' | asset_url }}" alt="" width="284" height="74">
      <p class="footer-tagline">{{ section.settings.tagline }}</p>

      {%- form 'customer', id: 'footerEmailForm', class: 'footer-email' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="hidden" name="contact[accepts_marketing]" value="true">
        <input type="email"
               name="contact[email]"
               placeholder="{{ section.settings.email_placeholder | escape }}"
               aria-label="{{ section.settings.email_placeholder | escape }}"
               autocomplete="email"
               required>
        <button type="submit">{{ section.settings.submit_label | escape }}</button>
        {%- comment -%}
          The `form` object only exists inside this {% form %} block, so the success
          state has to be captured here — the toast below cannot read it directly.
          Liquid assigns outlive the block, which is what makes this work.
        {%- endcomment -%}
        {%- if form.posted_successfully? -%}
          {%- assign newsletter_posted = true -%}
        {%- endif -%}
      {%- endform -%}

      <div class="email-toast-backdrop" id="emailToastBackdrop"></div>
      <div class="email-toast{% if newsletter_posted %} show{% endif %}" id="emailToast" role="status" aria-live="polite">
        <span class="email-toast-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M20 6L9 17l-5-5" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="email-toast-text">{{ section.settings.toast_text }}</span>
      </div>
    </div>

    {%- if section.settings.linkedin != blank or section.settings.instagram != blank -%}
      <div class="footer-social">
        {%- if section.settings.linkedin != blank -%}
          <a href="{{ section.settings.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn">
            <img src="{{ 'ow-icon-linkedin.svg' | asset_url }}" alt="" width="20" height="20">
          </a>
        {%- endif -%}
        {%- if section.settings.instagram != blank -%}
          <a href="{{ section.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
            <img src="{{ 'ow-icon-instagram.svg' | asset_url }}" alt="" width="20" height="20">
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%}
    One block per column, however many the merchant adds/removes/reorders --
    replaces the old fixed menu_1..menu_4 settings, which always reserved
    four slots whether or not all four were configured. --nav-count drives
    the desktop grid's column count in assets/ow-chrome.css.
  {%- endcomment -%}
  {%- liquid
    assign nav_columns = section.blocks | where: 'type', 'nav_column'
    assign visible_nav_count = 0
    for block in nav_columns
      if block.settings.menu != blank and block.settings.menu.links.size > 0
        assign visible_nav_count = visible_nav_count | plus: 1
      endif
    endfor
  -%}
  {%- comment -%}
    Grid on desktop: the brand block sits in its own column beside the nav
    columns (order:-1 in CSS puts it first regardless of DOM position).
    .footer-nav becomes display:contents there, so each .footer-nav-section
    is a direct grid item instead of a nested flex child -- see
    assets/ow-chrome.css. Mobile ignores the grid entirely and just stacks
    nav (accordion) then brand, in DOM order.
  {%- endcomment -%}
  <div class="footer-grid">
    <nav class="footer-nav" style="--nav-count: {{ visible_nav_count }};">
      {%- for block in nav_columns -%}
        {%- assign menu = block.settings.menu -%}
        {%- if menu != blank and menu.links.size > 0 -%}
          <div class="footer-nav-section" {{ block.shopify_attributes }}>
            {%- comment -%}
              A real <button>, not a div: it has to be reachable by keyboard and
              announce its own state. type="button" keeps it from submitting the
              newsletter form it shares a page with. aria-expanded is seeded
              false and then corrected by ow-chrome.js, which owns the truth of
              whether the links are actually visible at the current width.
            {%- endcomment -%}
            <button type="button"
                    class="footer-nav-section-head"
                    aria-expanded="false"
                    onclick="toggleFooterNav(this)">
              {{ block.settings.title | default: menu.title }}
              <img src="{{ 'ow-bullet.svg' | asset_url }}" alt="" width="16" height="16">
            </button>
            <div class="footer-nav-links">
              {%- for link in menu.links -%}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="footer-brand">
      <a class="footer-logo" href="{{ routes.root_url }}">
        <img src="{{ 'ow-logo-menu.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="320" height="53">
      </a>
      <p class="footer-copy">{{ section.settings.copyright }}</p>
      <a class="footer-1ftp-link" href="https://www.onepercentfortheplanet.org" aria-label="Member of 1% for the Planet">
        <img class="footer-1ftp" src="{{ 'ow-badge-1ftp.png' | asset_url }}" alt="1% for the Planet" width="376" height="160">
      </a>
    </div>
  </div>

  {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
    <div class="footer-payments-row">
      <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
      <ul class="footer-payments-list" role="list">
        {%- for type in shop.enabled_payment_types -%}
          <li class="footer-payments-item">
            {{ type | payment_type_svg_tag: class: 'footer-payment-icon' }}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</footer>

{% schema %}
{
  "name": "OW Footer",
  "settings": [
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Coffee is just the beginning. Join us for the adventure, a little chaos, and a whole lot of love (because life is better together). 🫶" },
    { "type": "header", "content": "Email signup" },
    { "type": "text", "id": "email_placeholder", "label": "Input placeholder", "default": "your@email.com" },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Subscribe" },
    { "type": "text", "id": "toast_text", "label": "Success message", "default": "Welcome to Omawild" },
    { "type": "header", "content": "Social" },
    { "type": "paragraph", "content": "Shopify's url setting cannot carry a default, so these are seeded from sections/footer-group.json instead. Clearing one hides that icon." },
    { "type": "url", "id": "linkedin", "label": "LinkedIn URL" },
    { "type": "url", "id": "instagram", "label": "Instagram URL" },
    { "type": "header", "content": "Payment icons" },
    { "type": "paragraph", "content": "Icons are pulled from your store's enabled payment methods (Settings → Payments). Toggle off to hide the row." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "header", "content": "Bottom" },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "© Wilde Planet Limited 2026" }
  ],
  "blocks": [
    {
      "type": "nav_column",
      "name": "Nav column",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "info": "Blank uses the menu's own title." },
        { "type": "link_list", "id": "menu", "label": "Menu", "info": "Leave unset to hide this column." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "OW Footer",
      "blocks": [
        { "type": "nav_column", "settings": { "title": "Foundation" } },
        { "type": "nav_column", "settings": { "title": "Shop" } },
        { "type": "nav_column", "settings": { "title": "Support" } }
      ]
    }
  ]
}
{% endschema %}
