<div class="movie-theater-container" data-movie-container>
  {% if section.blocks.size == 0 %}
    <div class="movie-theater-empty">
      <p>Add chapters in the sidebar to start creating your movie.</p>
    </div>
  {% endif %}

  {% for block in section.blocks %}
    <div class="movie-theater-slide-wrapper" data-narrative-chapter-slide style="width: 100%; height: 100%; flex-shrink: 0;">
      {% case block.type %}
        {% when 'chapter_open' %}
          {% render 'chapter-open', block: block %}
        {% when 'chapter_pledge' %}
          {% render 'chapter-pledge', block: block %}
        {% when 'chapter_map' %}
          {% render 'chapter-map', block: block %}
        {% when 'chapter_offerings' %}
          {% render 'chapter-offerings', block: block %}
        {% when 'chapter_info' %}
          {% render 'chapter-info', block: block %}
      {% endcase %}
    </div>
  {% endfor %}
</div>

{% style %}
  .movie-theater-container {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow-y: scroll;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
    background-color: {{ section.settings.theater_bg_color }};
  }
  .movie-theater-slide-wrapper {
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .movie-theater-container::-webkit-scrollbar {
    display: none;
  }
  .movie-theater-container {
    -ms-overflow-style: none;  
    scrollbar-width: none;  
  }
  .movie-theater-empty {
    width: 100vw;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #888888;
    font-family: sans-serif;
    text-align: center;
    padding: 20px;
    box-sizing: border-box;
  }
{% endstyle %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.querySelector('[data-movie-container]');
    if (!container) return;

    const getChapters = () => Array.from(container.querySelectorAll('[data-narrative-chapter-slide]'));

    // Global background tap click action handler logic
    container.addEventListener('click', (e) => {
      const currentSlide = e.target.closest('[data-narrative-chapter-slide]');
      if (!currentSlide) return;

      const chapters = getChapters();
      const currentSlideIndex = chapters.indexOf(currentSlide);

      if (currentSlideIndex !== -1 && currentSlideIndex < chapters.length - 1) {
        container.scrollTo({ 
          top: (currentSlideIndex + 1) * container.clientHeight, 
          behavior: 'smooth' 
        });
      }
    });

    // Arrow Key listener metrics control logic mapping matrix
    window.addEventListener('keydown', (e) => {
      const currentIndex = Math.round(container.scrollTop / container.clientHeight);
      const chaptersCount = getChapters().length;
      
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        if (currentIndex < chaptersCount - 1) {
          container.scrollTo({ top: (currentIndex + 1) * container.clientHeight, behavior: 'smooth' });
        }
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (currentIndex > 0) {
          container.scrollTo({ top: (currentIndex - 1) * container.clientHeight, behavior: 'smooth' });
        }
      }
    });
  });
</script>

