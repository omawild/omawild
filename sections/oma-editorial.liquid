{%- comment -%}
  oma-editorial — full-bleed "essay" layout: a sticky background photo behind
  a bordered, drop-shadowed text card. Body content is block-driven —
  "lines" (a short stacked opening statement), "paragraph" (rich text), and
  "source" (numbered footnote, label + URL) — rather than a blog article's
  content field, since this renders on a Shopify Page, not an article
  template. Source numbering follows block order, independent of any links
  inside paragraph blocks.

  Max card width defaults to 800px, same as OD Notice Board's own "Max Card
  Width" setting, so the card reads as the same visual system (narrower
  card = more of the background photo visible at the sides) rather than an
  arbitrary different width.

  heading_color, series_color and accent_color are deliberately separate
  settings, each independently repaintable: the card's border and
  box-shadow always match each other (both read accent_color, on purpose
  -- a mismatched border/shadow would look like a bug), defaulting to
  --sunbrella; the heading defaults to --midnight; the series/eyebrow
  label defaults to --electric. See assets/ow-base.css for those brand
  tokens -- this section doesn't read the CSS vars directly (every other
  oma-*/owv2-* color is a plain settings-driven hex, not a var()
  reference), it just starts from the same hex values.

  Links (in paragraph text and the sources list) are shown by font color,
  not an underline -- link_color, its own setting, defaults to --electric
  too but is independent so it doesn't drag the border/shadow or heading
  color along if repainted.
{%- endcomment -%}
{% assign owid = section.id | replace: '-', '' | replace: '_', '' %}
{% style %}
.oma-editorial-{{ owid }} {
  position: relative;
  box-sizing: border-box;
  background: {{ section.settings.background_color }};
  font-family: var(--font-body-family);
  }
.oma-editorial-{{ owid }} *, .oma-editorial-{{ owid }} *::before, .oma-editorial-{{ owid }} *::after {
  box-sizing: border-box;
  }
.oma-editorial-{{ owid }} .bg-wrap {
  position: absolute;
  inset: 0;
  overflow: clip;
  }
.oma-editorial-{{ owid }} .bg-sticky {
  position: sticky;
  top: 0;
  height: 100vh;
  background: {{ section.settings.background_color }};
  }
.oma-editorial-{{ owid }} .bg-sticky img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  }
.oma-editorial-{{ owid }} .content-wrap {
  position: relative;
  max-width: {{ section.settings.max_width | default: 800 }}px;
  margin: 0 auto;
  padding: {{ section.settings.padding_top }}px clamp(16px, 4vw, 48px) {{ section.settings.padding_bottom }}px;
  }
.oma-editorial-{{ owid }} .card {
  background: {{ section.settings.card_background }};
  border: 1.5px solid {{ section.settings.accent_color }};
  box-shadow: 8px 8px 0 {{ section.settings.accent_color }};
  padding: clamp(28px, 5vw, 64px) clamp(20px, 5vw, 64px);
  display: flex;
  flex-direction: column;
  }
.oma-editorial-{{ owid }} .head {
  width: 100%;
  max-width: 720px;
  margin: 0 auto;
  }
.oma-editorial-{{ owid }} .series {
  font: 900 11px/1.3 var(--font-heading-family);
  letter-spacing: .14em;
  text-transform: uppercase;
  color: {{ section.settings.series_color }};
  }
.oma-editorial-{{ owid }} .heading {
  margin: 16px 0 0;
  font: 900 clamp(40px, 5.2vw, 64px)/.95 var(--font-heading-family);
  letter-spacing: -.045em;
  color: {{ section.settings.heading_color }};
  text-wrap: balance;
  }
.oma-editorial-{{ owid }} .blocks {
  display: flex;
  flex-direction: column;
  gap: 22px;
  margin-top: 8px;
  }
.oma-editorial-{{ owid }} .lines-block {
  width: 100%;
  max-width: 720px;
  margin: 0 auto;
  font: 600 15px/1.35 var(--font-body-family);
  color: {{ section.settings.text_color }};
  }
.oma-editorial-{{ owid }} .lines-block span {
  display: block;
  }
.oma-editorial-{{ owid }} .p-block {
  width: 100%;
  max-width: 720px;
  margin: 0 auto;
  font: 400 15px/1.5 var(--font-body-family);
  color: {{ section.settings.text_color }};
  text-wrap: pretty;
  }
.oma-editorial-{{ owid }} .p-block p {
  margin: 0 0 1em;
  }
.oma-editorial-{{ owid }} .p-block p:last-child {
  margin-bottom: 0;
  }
{%- comment -%}
  Headings an editor adds inside the rich text (e.g. formatting a line
  as Heading 1) otherwise fall back to the browser's own UA margin,
  which reads as "barely any spacing" before whatever follows (a list's
  own margin-top is zeroed above, so margins don't collapse into
  anything bigger). Explicit, generous margin on both sides, zeroed on
  whichever heading opens the block so it doesn't float down from the
  card's own top edge.
{%- endcomment -%}
.oma-editorial-{{ owid }} .p-block h1,
.oma-editorial-{{ owid }} .p-block h2,
.oma-editorial-{{ owid }} .p-block h3,
.oma-editorial-{{ owid }} .p-block h4,
.oma-editorial-{{ owid }} .p-block h5,
.oma-editorial-{{ owid }} .p-block h6 {
  margin: .6em 0 .45em;
  }
.oma-editorial-{{ owid }} .p-block h1:first-child,
.oma-editorial-{{ owid }} .p-block h2:first-child,
.oma-editorial-{{ owid }} .p-block h3:first-child,
.oma-editorial-{{ owid }} .p-block h4:first-child,
.oma-editorial-{{ owid }} .p-block h5:first-child,
.oma-editorial-{{ owid }} .p-block h6:first-child {
  margin-top: 0;
  }
{%- comment -%}
  Explicit list indentation rather than relying on the browser/theme
  default: with list-style-position's default of "outside" and no
  padding reserved for the marker, a <ul>/<ol> from rich text renders
  its bullets/numbers outside its own box -- to the left of the rest of
  the paragraph text, past the card's padding. This keeps the marker
  inside the block, aligned with it, regardless of what any other
  stylesheet does to ul/ol elsewhere on the page.
{%- endcomment -%}
.oma-editorial-{{ owid }} .p-block ul,
.oma-editorial-{{ owid }} .p-block ol {
  margin: 0 0 1em;
  padding-left: 1.25em;
  }
.oma-editorial-{{ owid }} .p-block ul:last-child,
.oma-editorial-{{ owid }} .p-block ol:last-child {
  margin-bottom: 0;
  }
.oma-editorial-{{ owid }} .p-block li {
  margin-bottom: .4em;
  }
.oma-editorial-{{ owid }} .p-block li:last-child {
  margin-bottom: 0;
  }
.oma-editorial-{{ owid }} .p-block a {
  color: {{ section.settings.link_color }};
  text-decoration: none;
  }
.oma-editorial-{{ owid }} .p-block a:hover {
  opacity: .8;
  }
.oma-editorial-{{ owid }} .sources {
  width: 100%;
  max-width: 720px;
  margin: 48px auto 0;
  padding-top: 20px;
  border-top: 1.5px solid {{ section.settings.accent_color }};
  }
.oma-editorial-{{ owid }} .sources-label {
  font: 900 11px/1.3 var(--font-heading-family);
  letter-spacing: .14em;
  text-transform: uppercase;
  color: {{ section.settings.accent_color }};
  }
.oma-editorial-{{ owid }} .sources-list {
  margin: 14px 0 0;
  padding: 0;
  list-style: none;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  gap: 8px 32px;
  }
.oma-editorial-{{ owid }} .sources-list li {
  display: grid;
  grid-template-columns: 18px minmax(0, 1fr);
  gap: 8px;
  font: 400 12.5px/1.55 var(--font-body-family);
  color: {{ section.settings.text_color }};
  }
.oma-editorial-{{ owid }} .sources-list .num {
  font: 900 12px/1.55 var(--font-heading-family);
  color: {{ section.settings.accent_color }};
  }
.oma-editorial-{{ owid }} .sources-list a {
  color: {{ section.settings.link_color }};
  text-decoration: none;
  }
.oma-editorial-{{ owid }} .sources-list a:hover {
  opacity: .8;
  }
{% endstyle %}
{%- liquid
  assign source_blocks = section.blocks | where: 'type', 'source'
  assign show_sources = false
  if section.settings.show_sources and source_blocks.size > 0
    assign show_sources = true
  endif
-%}
<div class="oma-editorial-{{ owid }}">
  <div class="bg-wrap" aria-hidden="true">
    <div class="bg-sticky">
      {%- if section.settings.background_image != blank -%}
        {{ section.settings.background_image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '600, 900, 1200, 1800, 2400', sizes: '100vw', alt: '' }}
      {%- endif -%}
    </div>
  </div>
  <div class="content-wrap">
    <div class="card">
      <header class="head">
        {%- if section.settings.series != blank -%}
          <div class="series">{{ section.settings.series | escape }}</div>
        {%- endif -%}
        <h1 class="heading">{{ section.settings.heading }}</h1>
      </header>
      <div class="blocks">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'lines' -%}
              <p class="lines-block" {{ block.shopify_attributes }}>
                {%- assign lines = block.settings.lines | newline_to_br | split: '<br />' -%}
                {%- for line in lines -%}
                  {%- assign line = line | strip -%}
                  {%- if line != blank -%}<span>{{ line }}</span>{%- endif -%}
                {%- endfor -%}
              </p>
            {%- when 'paragraph' -%}
              <div class="p-block" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
      {%- if show_sources -%}
        <aside class="sources" aria-label="Sources">
          <div class="sources-label">{{ section.settings.sources_label | escape }}</div>
          <ol class="sources-list">
            {%- for block in source_blocks -%}
              <li {{ block.shopify_attributes }}>
                <span class="num">{{ forloop.index }}</span>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}">{{ block.settings.label | escape }}</a>
                {%- else -%}
                  <span>{{ block.settings.label | escape }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ol>
        </aside>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "OMA Editorial",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Background photo" },
    { "type": "text", "id": "series", "label": "Series / eyebrow label", "default": "Common Ground" },
    { "type": "text", "id": "heading", "label": "Title", "default": "Down to Earth" },
    { "type": "checkbox", "id": "show_sources", "label": "Show sources list", "default": true, "info": "Only shows if at least one \"Source\" block is added below." },
    { "type": "text", "id": "sources_label", "label": "Sources label", "default": "Sources" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background (behind photo / fallback)", "default": "#FFE4E7" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#00180C" },
    { "type": "color", "id": "series_color", "label": "Series / eyebrow color", "default": "#FF3F00" },
    { "type": "color", "id": "accent_color", "label": "Accent (card border & shadow, source numbers)", "info": "Border and shadow always match each other — this one color drives both, independent of the heading and series colors.", "default": "#FBB925" },
    { "type": "color", "id": "text_color", "label": "Body text color", "default": "#00180C" },
    { "type": "color", "id": "link_color", "label": "Link color", "info": "Links are shown by color, not an underline.", "default": "#FF3F00" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Max card width", "min": 300, "max": 1600, "step": 20, "unit": "px", "default": 800, "info": "Narrower shows more of the background photo at the sides — matches OD Notice Board's \"Max Card Width\" setting (also 800px by default) so the two read as one visual system." },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "lines",
      "name": "Opening statement",
      "settings": [
        { "type": "textarea", "id": "lines", "label": "Lines", "info": "One line per row — each becomes its own stacked line.", "default": "We breathe the same air.\nDrink the same water.\nEat from the same soil." }
      ]
    },
    {
      "type": "paragraph",
      "name": "Paragraph",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "source",
      "name": "Source",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "link", "label": "URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OMA Editorial",
      "blocks": [
        { "type": "lines" },
        { "type": "paragraph" }
      ]
    }
  ]
}
{% endschema %}
