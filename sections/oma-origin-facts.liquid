{%- comment -%}
  oma-origin-facts — "ABOUT THIS FARM" facts band for the Origin Intro page:
  Producer/Elevation/Process (derived from the linked products, via
  origin-facts.liquid) plus Certifications/Harvest period (straight off the
  origin metaobject), and an optional jump link down to the coffees list.

  Each fact is its own block (type "fact", picking which of the five known
  facts it is via fact_type) rather than five fixed show/hide settings. The
  five ship by default via this section's preset, in the usual order, so a
  merchant adding this section gets everything -- but a specific origin
  missing one fact for good (not "coming soon", just doesn't apply to that
  farm) can delete that one block instead of having coming_soon_label sit
  there implying data that's never coming. The VALUE behind each fact is
  still always derived centrally in origin-facts.liquid -- blocks only
  control which facts this instance shows and their label text, never the
  values themselves, so "one place to edit each fact" still holds.

  Display order is fixed (Producer, Elevation, Process, Certifications,
  Harvest), independent of block order -- only which blocks exist matters,
  not the order they're arranged in the editor's block list. Reordering
  support would mean restructuring origin-facts.liquid's snippet around a
  merchant-ordered list instead of a fixed sequence; nobody's asked for that
  yet, so it's not built.

  Responsive, not sticky. An earlier version tried to float this band
  beside the story column (position: fixed, stopping just above Coffees,
  with oma-image-text reserving matching gutter space) -- in practice that
  left a long dead gap between the band and the story on the way down the
  page, because the two live in independent sections with nothing actually
  tying their vertical rhythm together. Dropped in favor of this: a plain
  3-per-row grid on desktop, and on mobile -- where there's no second
  column for it to float beside in the first place -- a <details> accordion
  instead of a wall of facts up front, same pattern as
  oma-regen-practices.liquid's practice cards. The facts markup itself is
  rendered once and reused in both the desktop grid and the mobile
  accordion's answer, not duplicated by hand.
{%- endcomment -%}
{% assign owid = section.id | replace: '-', '' | replace: '_', '' %}
{%- liquid
  assign origin = section.settings.origin_reference
  assign stop_anchor = section.settings.jump_anchor | default: 'coffees'

  assign show_producer = false
  assign show_elevation = false
  assign show_process = false
  assign show_certifications = false
  assign show_harvest = false
  assign producer_label = ''
  assign elevation_label = ''
  assign process_label = ''
  assign certifications_label = ''
  assign harvest_label = ''

  for block in section.blocks
    case block.settings.fact_type
      when 'producer'
        assign show_producer = true
        assign producer_label = block.settings.label
      when 'elevation'
        assign show_elevation = true
        assign elevation_label = block.settings.label
      when 'process'
        assign show_process = true
        assign process_label = block.settings.label
      when 'certifications'
        assign show_certifications = true
        assign certifications_label = block.settings.label
      when 'harvest'
        assign show_harvest = true
        assign harvest_label = block.settings.label
    endcase
  endfor
-%}
{% style %}
.oma-origin-facts-{{ owid }} {
  box-sizing: border-box;
  background: {{ section.settings.background_color }};
  padding: {{ section.settings.padding_top }}px clamp(20px, 4vw, 48px) {{ section.settings.padding_bottom }}px;
  font-family: var(--font-body-family);
  }
.oma-origin-facts-{{ owid }} *, .oma-origin-facts-{{ owid }} *::before, .oma-origin-facts-{{ owid }} *::after {
  box-sizing: border-box;
  }
.oma-origin-facts-{{ owid }} .inner {
  max-width: 1440px;
  margin: 0 auto;
  }
.oma-origin-facts-{{ owid }} .eyebrow {
  font: 800 10.5px/1 var(--font-heading-family);
  letter-spacing: .14em;
  color: {{ section.settings.accent_color }};
  }
.oma-origin-facts-{{ owid }} .subtitle {
  {%- comment -%} oma-page-header-origin.liquid's kicker already shows this. {%- endcomment -%}
  display: none;
  }
.oma-origin-facts-{{ owid }} .facts {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 0;
  margin-top: 14px;
  }
.oma-origin-facts-{{ owid }} .fact {
  padding: 12px 0;
  border-top: 1.5px solid {{ section.settings.accent_color }};
  }
.oma-origin-facts-{{ owid }} .fact-label {
  font: 700 10px/1.3 var(--font-heading-family);
  letter-spacing: .1em;
  color: {{ section.settings.accent_color }};
  }
.oma-origin-facts-{{ owid }} .fact-value {
  margin-top: 6px;
  font: 400 15px/1.35 var(--font-heading-family);
  color: {{ section.settings.text_color }};
  }
.oma-origin-facts-{{ owid }} .fact-value.is-pending {
  font-weight: 500;
  font-style: italic;
  color: color-mix(in srgb, {{ section.settings.text_color }} 60%, transparent);
  }
.oma-origin-facts-{{ owid }} .jump {
  display: inline-block;
  margin-top: 18px;
  text-decoration: none;
  font: 800 13px/1 var(--font-heading-family);
  color: {{ section.settings.accent_color }};
  }
.oma-origin-facts-{{ owid }} .jump:hover {
  opacity: .75;
  }
.oma-origin-facts-{{ owid }} .missing-origin {
  margin: 0;
  font: 700 15px/1.5 var(--font-body-family);
  color: {{ section.settings.text_color }};
  }

{%- comment -%} Mobile: collapsible, same <details>/<summary> pattern as oma-regen-practices.liquid {%- endcomment -%}
.oma-origin-facts-{{ owid }} .mobile-accordion {
  border-top: 1.5px solid {{ section.settings.accent_color }};
  }
.oma-origin-facts-{{ owid }} .mobile-accordion summary {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 24px;
  gap: 16px;
  align-items: center;
  padding: 16px 0;
  cursor: pointer;
  list-style: none;
  }
.oma-origin-facts-{{ owid }} .mobile-accordion summary::-webkit-details-marker {
  display: none;
  }
.oma-origin-facts-{{ owid }} .mobile-accordion summary .eyebrow {
  margin: 0;
  }
.oma-origin-facts-{{ owid }} .mobile-accordion summary .sign {
  justify-self: end;
  font: 800 20px/1 var(--font-heading-family);
  color: {{ section.settings.accent_color }};
  }
.oma-origin-facts-{{ owid }} .mobile-accordion summary .sign::after {
  content: '+';
  }
.oma-origin-facts-{{ owid }} .mobile-accordion[open] summary .sign::after {
  content: '\2212';
  }
.oma-origin-facts-{{ owid }} .mobile-accordion .accordion-body {
  padding-bottom: 8px;
  }
.oma-origin-facts-{{ owid }} .mobile-accordion .facts {
  margin-top: 0;
  }
.oma-origin-facts-{{ owid }} .mobile-accordion .fact:first-child {
  border-top: none;
  padding-top: 0;
  }

{%- comment -%} Desktop: static 3-per-row grid, always expanded, no accordion chrome {%- endcomment -%}
.oma-origin-facts-{{ owid }} .desktop-band {
  display: none;
  }
@media (min-width: 750px) {
  .oma-origin-facts-{{ owid }} .mobile-accordion {
    display: none;
  }
  .oma-origin-facts-{{ owid }} .desktop-band {
    display: block;
  }
  .oma-origin-facts-{{ owid }} .desktop-band .facts {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px 32px;
  }
}
{% endstyle %}
<div class="oma-origin-facts-{{ owid }}">
  <div class="inner">
    {%- if origin == blank -%}
      {%- if request.design_mode -%}
        <p class="missing-origin">Select an origin to fill in this facts band.</p>
      {%- endif -%}
    {%- else -%}
      {%- capture facts_markup -%}
        {%- render 'origin-facts',
          origin: origin,
          show_producer: show_producer,
          producer_label: producer_label,
          show_elevation: show_elevation,
          elevation_label: elevation_label,
          show_process: show_process,
          process_label: process_label,
          coming_soon_label: section.settings.coming_soon_label,
          show_certifications: show_certifications,
          certifications_label: certifications_label,
          show_harvest: show_harvest,
          harvest_label: harvest_label
        -%}
      {%- endcapture -%}
      {%- capture jump_markup -%}
        {%- if section.settings.jump_label != blank -%}
          <a class="jump" href="#{{ stop_anchor }}">{{ section.settings.jump_label | escape }} ↓</a>
        {%- endif -%}
      {%- endcapture -%}

      <details class="mobile-accordion">
        <summary>
          <div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>
          <span class="sign" aria-hidden="true"></span>
        </summary>
        <div class="accordion-body">
          {{ facts_markup }}
          {{ jump_markup }}
        </div>
      </details>

      <div class="desktop-band">
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
        {{ facts_markup }}
        {{ jump_markup }}
      </div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "OMA Origin Facts",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "metaobject", "id": "origin_reference", "metaobject_type": "origin", "label": "Origin" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow / mobile accordion label", "default": "ABOUT THIS FARM" },
    { "type": "header", "content": "Facts" },
    { "type": "paragraph", "content": "All five facts (Producer, Elevation, Process, Certifications, Harvest period) are added as blocks below by default. If one genuinely doesn't apply to this origin, delete its block rather than leaving it to show the \"Coming soon\" placeholder forever." },
    { "type": "text", "id": "coming_soon_label", "label": "Placeholder for a shown fact with no linked product data yet", "info": "Only shown for a fact block that's present but whose value isn't filled in yet. An origin missing a fact for good -- not \"coming soon\", just doesn't apply -- should have that fact's block removed below instead.", "default": "Coming soon" },
    { "type": "header", "content": "Jump link" },
    { "type": "text", "id": "jump_label", "label": "Jump link label", "default": "The coffee from this farm" },
    { "type": "text", "id": "jump_anchor", "label": "Jump link target anchor ID", "info": "Must match the Anchor ID setting on the OMA Origin Coffees section further down the page.", "default": "coffees" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F7F5F1" },
    { "type": "color", "id": "accent_color", "label": "Accent (eyebrow, labels, borders)", "default": "#FF3F00" },
    { "type": "color", "id": "text_color", "label": "Fact value color", "default": "#00180C" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        {
          "type": "select",
          "id": "fact_type",
          "label": "Fact",
          "options": [
            { "value": "producer", "label": "Producer" },
            { "value": "elevation", "label": "Elevation" },
            { "value": "process", "label": "Process" },
            { "value": "certifications", "label": "Certifications" },
            { "value": "harvest", "label": "Harvest period" }
          ],
          "default": "producer",
          "info": "Producer/Elevation/Process come from the linked products' own metafields; Certifications/Harvest period come from this origin entry directly. Either way, the value isn't set here -- only whether this fact shows at all, and its label."
        },
        { "type": "text", "id": "label", "label": "Label", "default": "PRODUCER" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OMA Origin Facts",
      "blocks": [
        { "type": "fact", "settings": { "fact_type": "producer", "label": "PRODUCER" } },
        { "type": "fact", "settings": { "fact_type": "elevation", "label": "ELEVATION" } },
        { "type": "fact", "settings": { "fact_type": "process", "label": "PROCESS" } },
        { "type": "fact", "settings": { "fact_type": "certifications", "label": "CERTIFICATIONS" } },
        { "type": "fact", "settings": { "fact_type": "harvest", "label": "HARVEST" } }
      ]
    }
  ]
}
{% endschema %}
