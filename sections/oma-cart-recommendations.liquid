{%- comment -%}
  oma-cart-recommendations — "You may also like", shown under the cart.
  Pulls from one merchant-picked collection and skips anything already in the
  cart, rather than Shopify's ML product-recommendations endpoint — matches
  the design file's COMPONENT - Featured Products (fixed collection + limit +
  exclude), not the vendor's cart-recommendations.liquid (which uses
  routes.product_recommendations_url).

  Add to cart reuses the same <product-form> custom element (assets/product-form.js)
  and {% form 'product' %} pattern already established in
  sections/od-collection-showcase.liquid — real AJAX add, real cart bubble update.
{%- endcomment -%}

{%- liquid
  assign coll = section.settings.collection
  assign limit = section.settings.limit
  assign cart_handles = cart.items | map: 'product' | map: 'handle'
  assign shown = 0
-%}

{%- if coll != blank and cart != empty -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      width: 100vw;
      margin-left: calc(50% - 50vw);
    }

    .ocr-{{ section.id }} {
      background: {{ section.settings.background_color }};
      border-bottom: 1.5px solid #FF3F00;
    }
    .ocr-inner-{{ section.id }} {
      max-width: 1280px;
      margin: 0 auto;
      padding: 56px clamp(20px, 4vw, 48px) 64px;
      box-sizing: border-box;
    }
    .ocr-head-{{ section.id }} {
      max-width: 680px;
      text-align: left;
    }
    .ocr-title-{{ section.id }} {
      margin: 0;
      font: 800 clamp(30px, 3.4vw, 44px)/1.05 var(--font-heading-family);
      letter-spacing: -0.025em;
      color: #FF3F00;
    }
    .ocr-grid-{{ section.id }} {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
      margin-top: 36px;
    }
    @media screen and (min-width: 750px) {
      .ocr-grid-{{ section.id }} { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
    }

    .ocr-card-{{ section.id }} {
      height: 100%;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      border: 1.5px solid #FF3F00;
      border-radius: 10px;
      overflow: hidden;
      background: #FBB925;
    }
    .ocr-card__media-{{ section.id }} {
      position: relative;
      display: block;
      aspect-ratio: 1 / 1;
      text-decoration: none;
    }
    .ocr-card__media-{{ section.id }} img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .ocr-card__tag-{{ section.id }} {
      position: absolute;
      top: 12px;
      left: 12px;
      background: #fff;
      border: 1.5px solid #FF3F00;
      color: #FF3F00;
      padding: 5px 10px;
      border-radius: 4px;
      font: 800 9.5px/1 var(--font-heading-family);
      letter-spacing: 0.1em;
    }
    .ocr-card__body-{{ section.id }} {
      display: flex;
      flex-direction: column;
      flex: 1;
      padding: 22px;
      background: #fff;
      border-top: 1.5px solid #FF3F00;
    }
    .ocr-card__note-{{ section.id }} {
      display: inline-block;
      align-self: flex-start;
      white-space: nowrap;
      background: #FF3F00;
      color: #fff;
      padding: 6px 10px;
      border-radius: 4px;
      font: 800 9.5px/1 var(--font-heading-family);
      letter-spacing: 0.1em;
    }
    .ocr-card__name-{{ section.id }} { text-decoration: none; }
    .ocr-card__name-{{ section.id }} h3 {
      margin: 16px 0 0;
      font: 800 23px/1.05 var(--font-heading-family);
      letter-spacing: -0.02em;
      color: #FF3F00;
    }
    .ocr-card__blurb-{{ section.id }} {
      margin: 10px 0 22px;
      font: 500 14.5px/1.6 var(--font-body-family);
      color: #00180C;
    }
    .ocr-card__price-row-{{ section.id }} {
      margin-top: auto;
      margin-bottom: 14px;
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 9px;
    }
    .ocr-card__price-{{ section.id }} { white-space: nowrap; font: 800 17px/1 var(--font-heading-family); color: #FF3F00; }

    .ocr-select-wrap-{{ section.id }} { position: relative; margin: 0 0 8px; }
    .ocr-select-{{ section.id }} {
      width: 100%;
      appearance: none;
      -webkit-appearance: none;
      cursor: pointer;
      border: 1.5px solid #FF3F00;
      border-radius: 100px;
      background: #fff;
      color: #FF3F00;
      padding: 12px 38px 12px 15px;
      font: 700 12px/1 var(--font-heading-family);
    }
    .ocr-select-chevron-{{ section.id }} {
      position: absolute;
      right: 16px;
      top: 50%;
      width: 11px;
      height: 8px;
      margin-top: -4px;
      pointer-events: none;
    }
    .ocr-cta-{{ section.id }} {
      border: 1.5px solid #FF3F00;
      background: #FF3F00;
      color: #fff;
      cursor: pointer;
      padding: 13px 0;
      border-radius: 100px;
      font: 800 12px/1 var(--font-heading-family);
      width: 100%;
    }
    .ocr-cta-{{ section.id }}:hover { background: #D63200; border-color: #D63200; }
    .ocr-cta-{{ section.id }}:disabled { opacity: 0.5; cursor: not-allowed; }
  {%- endstyle -%}

  <section class="ocr-{{ section.id }}">
    <div class="ocr-inner-{{ section.id }}">
      <div class="ocr-head-{{ section.id }}">
        <h2 class="ocr-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      <div class="ocr-grid-{{ section.id }}">
        {%- for product in coll.products -%}
          {%- if shown >= limit -%}
            {%- break -%}
          {%- endif -%}
          {%- if cart_handles contains product.handle -%}
            {%- continue -%}
          {%- endif -%}
          {%- assign shown = shown | plus: 1 -%}

          <div class="ocr-card-{{ section.id }}">
            <a href="{{ product.url }}" class="ocr-card__media-{{ section.id }}">
              {%- if product.featured_image != blank -%}
                <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" loading="lazy" width="800" height="{{ 800 | divided_by: product.featured_image.aspect_ratio | round }}">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
              {%- if product.type != blank -%}<span class="ocr-card__tag-{{ section.id }}">{{ product.type | upcase }}</span>{%- endif -%}
            </a>
            <div class="ocr-card__body-{{ section.id }}">
              {%- if product.tags.first != blank -%}<span class="ocr-card__note-{{ section.id }}">{{ product.tags.first | upcase }}</span>{%- endif -%}
              <a href="{{ product.url }}" class="ocr-card__name-{{ section.id }}"><h3>{{ product.title }}</h3></a>
              <p class="ocr-card__blurb-{{ section.id }}">{{ product.description | strip_html | truncatewords: 18 }}</p>
              <div class="ocr-card__price-row-{{ section.id }}">
                {%- if product.price_varies -%}
                  <span class="ocr-card__price-{{ section.id }}">From {{ product.price_min | money }}</span>
                {%- else -%}
                  <span class="ocr-card__price-{{ section.id }}">{{ product.price | money }}</span>
                {%- endif -%}
              </div>

              {%- if product.available -%}
                {%- assign form_id = 'ocr-form-' | append: section.id | append: '-' | append: product.id -%}
                <product-form data-section="{{ section.id }}">
                  {%- form 'product', product, id: form_id, data-type: 'add-to-cart-form' -%}
                    <div class="product-form__error-message-wrapper" role="alert" hidden><span class="product-form__error-message"></span></div>
                    {%- if product.has_only_default_variant -%}
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    {%- else -%}
                      <div class="ocr-select-wrap-{{ section.id }}">
                        <select class="ocr-select-{{ section.id }}" name="id" aria-label="{{ product.title | escape }} options">
                          {%- for variant in product.variants -%}
                            <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }}{% unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}</option>
                          {%- endfor -%}
                        </select>
                        <svg class="ocr-select-chevron-{{ section.id }}" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1l5 5 5-5" fill="none" stroke="#FF3F00" stroke-width="2" stroke-linecap="round"/></svg>
                      </div>
                    {%- endif -%}
                    <button type="submit" name="add" class="product-form__submit ocr-cta-{{ section.id }}"><span>{{ 'products.product.add_to_cart' | t | default: 'Add to Cart' }}</span></button>
                  {%- endform -%}
                </product-form>
              {%- else -%}
                <button class="ocr-cta-{{ section.id }}" disabled>{{ 'products.product.sold_out' | t }}</button>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "OMA Cart Recommendations",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Max products", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFE4E7" }
  ],
  "presets": [{ "name": "OMA Cart Recommendations" }]
}
{% endschema %}
