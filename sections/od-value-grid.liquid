{%- style -%}
.section-{{ section.id }} 
{
  background-color: {{ section.settings.background_color }};
  padding-top: {{ section.settings.section_padding_top }}px;
  padding-bottom: {{ section.settings.section_padding_bottom }}px;
}

.container-{{ section.id }} 
{
  {%- if section.settings.full_width -%}
    max-width: 100%;
  {%- else -%}
    max-width: {{ section.settings.max_width }}px;
  {%- endif -%}
  margin: 0 auto;
  padding-left: {{ section.settings.mobile_padding_horizontal }}px;
  padding-right: {{ section.settings.mobile_padding_horizontal }}px;
}

.header-{{ section.id }} 
{
  margin-bottom: 50px;
  text-align: {{ section.settings.header_alignment }};
}

.title-{{ section.id }} 
{
  margin: 0;
  color: {{ section.settings.heading_color }};
  font-size: 32px;
  font-weight: 700;
}

/* --- The USP Grid --- */
.usp-grid-{{ section.id }}
{
  display: grid;
  grid-template-columns: 1fr;
  gap: 40px 20px;
}

.usp-item-{{ section.id }}
{
  display: flex;
  flex-direction: column;
  /* Mobile Default */
  align-items: center;
  text-align: center;
  font-family: var(--font-heading-family);
  font-style: var(--font-heading-style);
}

/* --- Bordered card style (card_style: "bordered") --- */
.usp-item-{{ section.id }}.style-bordered
{
  align-items: flex-start;
  text-align: left;
  background: {{ section.settings.card_background }};
  border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
  border-radius: {{ section.settings.card_radius }}px;
  {% if section.settings.card_shadow_offset > 0 -%}
  box-shadow: {{ section.settings.card_shadow_offset }}px {{ section.settings.card_shadow_offset }}px 0 {{ section.settings.card_border_color }};
  {%- endif %}
  padding: {{ section.settings.card_padding }}px;
  box-sizing: border-box;
}

.usp-item-{{ section.id }}.style-bordered .usp-icon-wrap-{{ section.id }}
{
  justify-content: flex-start;
  margin-bottom: 14px;
}

.usp-item-{{ section.id }}.style-bordered .usp-title-{{ section.id }}
{
  text-align: left;
  width: auto;
}

.usp-number-{{ section.id }}
{
  display: block;
  font-family: var(--font-heading-family);
  font-weight: 900;
  font-size: 34px;
  line-height: .9;
  letter-spacing: -.04em;
  color: {{ section.settings.card_border_color }};
  opacity: .3;
  margin-bottom: 14px;
}

.usp-tag-{{ section.id }}
{
  display: inline-flex;
  align-self: flex-start;
  font-family: var(--font-heading-family);
  font-weight: 800;
  font-size: 9.5px;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: #ffffff;
  background: {{ section.settings.card_border_color }};
  padding: 6px 11px;
  border-radius: 100px;
  margin-bottom: 11px;
}

.usp-body-{{ section.id }}
{
  margin: 10px 0 0;
  width: 100%;
  font-family: var(--font-body-family);
  font-size: 14.5px;
  line-height: 1.5;
  color: {{ section.settings.text_color }};
  text-align: left;
}

.usp-icon-wrap-{{ section.id }} 
{
  margin-bottom: 20px;
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: center;
}

.usp-icon-wrap-{{ section.id }} img 
{
  height: auto;
  width: auto;
  max-width: {{ section.settings.global_icon_width }}px;
  object-fit: contain;
}

.usp-title-{{ section.id }} 
{
  all: unset;
  display: block;
  width: 100%; /* The Fix: Ensures the title spans the full column width */
  margin-top: 0;
  margin-bottom: 10px;
  color: {{ section.settings.text_color }};
  line-height: 1.1;
  font-weight: 700;
  font-size: {{ section.settings.global_title_size }}px;
  font-size: {{ section.settings.mobile_title_size }}px; /* Mobile first */
  box-sizing: border-box;
}

.usp-link-wrap-{{ section.id }} 
{
  width: 100%;
  display: flex;
  justify-content: center;
}

.usp-link-{{ section.id }} 
{
  font-family: var(--font-body-family) !important;
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  text-decoration: underline;
  text-underline-offset: 5px;
  color: {{ section.settings.text_color }};
  transition: opacity 0.2s ease;
}

/* --- Desktop Logic (900px+) --- */
@media screen and (min-width: 900px) 
{
  .container-{{ section.id }} 
  {
    padding-left: {{ section.settings.desktop_padding_horizontal }}px;
    padding-right: {{ section.settings.desktop_padding_horizontal }}px;
  }

  .usp-title-{{ section.id }} {
    font-size: {{ section.settings.global_title_size }}px;
  }

  .usp-grid-{{ section.id }}
  {
    grid-template-columns: repeat(auto-fit, minmax({{ section.settings.card_min_width }}px, 1fr));
    gap: 0 30px;
  }

  .usp-grid-{{ section.id }}.style-bordered
  {
    gap: 16px;
  }

  .usp-item-{{ section.id }} 
  {
    /* Change flex alignment based on setting */
    align-items: {{ section.settings.content_alignment }};
    text-align: {{ section.settings.content_alignment | replace: 'flex-start', 'left' }};
  }

  .usp-icon-wrap-{{ section.id }} 
  {
    justify-content: {{ section.settings.content_alignment }};
  }

  .usp-link-wrap-{{ section.id }} 
  {
    justify-content: {{ section.settings.content_alignment }};
  }
}


/* Tablet intermediary (3 across) */
@media screen and (max-width: 899px) and (min-width: 750px) {
  .usp-grid-{{ section.id }} 
  {
    grid-template-columns: repeat(3, 1fr);
  }

  .usp-title-{{ section.id }} {
    font-size: 18px !important; 
  }
}

@media screen and (max-width: 750px) {
 .usp-item-{{ section.id }} {
    margin-left: 40px;
    margin-right: 40px;
  }
}
  
{%- endstyle -%}

<div class="section-{{ section.id }}">
  <div class="container-{{ section.id }}">
    
    {% if section.settings.heading != blank %}
      <div class="header-{{ section.id }}">
        <h2 class="title-{{ section.id }}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {% endif %}

    <div class="usp-grid-{{ section.id }}{% if section.settings.card_style == 'bordered' %} style-bordered{% endif %}">
      {%- for block in section.blocks -%}
        <div
          class="usp-item-{{ section.id }}{% if section.settings.card_style == 'bordered' %} style-bordered{% endif %}"
          {{ block.shopify_attributes }}
        >

          {% if section.settings.card_style == 'bordered' and section.settings.show_numbers %}
            <span class="usp-number-{{ section.id }}">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          {% elsif section.settings.card_style == 'bordered' and block.settings.tag != blank %}
            <span class="usp-tag-{{ section.id }}">{{ block.settings.tag | escape }}</span>
          {% elsif block.settings.icon != blank %}
            <div class="usp-icon-wrap-{{ section.id }}">
              <img
                src="{{ block.settings.icon | image_url: width: 400 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="{{ block.settings.icon.width }}"
                height="{{ block.settings.icon.height }}"
              >
            </div>
          {% endif %}

          <h4 class="usp-title-{{ section.id }}">
            {{ block.settings.title }}
          </h4>

          {% if section.settings.card_style == 'bordered' and block.settings.body != blank %}
            <div class="usp-body-{{ section.id }}">{{ block.settings.body }}</div>
          {% endif %}

          {% if block.settings.link_label != blank %}
            <div class="usp-link-wrap-{{ section.id }}">
              <a 
                href="{{ block.settings.link_url | default: '#' }}" 
                class="usp-link-{{ section.id }}"
              >
                {{ block.settings.link_label }}
              </a>
            </div>
          {% endif %}

        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "OD Value Grid",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Section Heading"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Desktop Content Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "flex-start"
    },
    {
      "type": "header",
      "content": "Global USP Sizing"
    },
    {
      "type": "range",
      "id": "global_icon_width",
      "label": "Icon Max Width",
      "min": 30,
      "max": 150,
      "step": 2,
      "default": 50
    },
    {
      "type": "range",
      "id": "global_title_size",
      "label": "Title Font Size (Desktop)",
      "min": 16,
      "max": 80,
      "step": 1,
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_title_size",
      "label": "Title Font Size (Mobile)",
      "min": 12,
      "max": 40,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "card_min_width",
      "label": "Card minimum width (desktop)",
      "min": 120,
      "max": 340,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "Layout Spacing"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": false
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max Width",
      "info": "Applies only when full width is disabled",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "default": 1400
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_padding_horizontal",
      "label": "Desktop Side Padding",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_horizontal",
      "label": "Mobile Side Padding",
      "min": 10,
      "max": 50,
      "default": 20
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        { "value": "plain", "label": "Plain (icon + title + link)" },
        { "value": "bordered", "label": "Bordered card (title + body)" }
      ],
      "default": "plain"
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Show numbered index instead of icon/tag",
      "default": false,
      "info": "Only applies in Bordered card style."
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border, number & tag color",
      "default": "#1a1b18"
    },
    {
      "type": "range",
      "id": "card_border_width",
      "label": "Card border width",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "default": 1.5
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_shadow_offset",
      "label": "Card shadow offset",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 0,
      "info": "0 disables the shadow."
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text/Link Color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "Value Proposition",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Our Value"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon/Image"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link Label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        },
        {
          "type": "header",
          "content": "Bordered card style only"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag / badge",
          "info": "Small pill shown above the title. Blank hides it. Ignored when the section's \"Show numbered index\" is on."
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "OD Value Grid",
      "blocks": [
        { "type": "usp" },
        { "type": "usp" },
        { "type": "usp" },
        { "type": "usp" },
        { "type": "usp" },
        { "type": "usp" }
      ]
    }
  ]
}
{% endschema %}