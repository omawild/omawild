{% assign banner_id = section.id | replace: '_', '' | downcase %}

{%- style -%}
  /* Section-isolated wrapper - Now strictly handles structural layout flow */
  .custom-banner-wrapper-{{ banner_id }} {
    display: block;
    width: 100%;
    box-sizing: border-box;
  }

  /* Core Banner Framework */
  .custom-banner-{{ banner_id }} {
    display: flex;
    flex-direction: column;
    position: relative;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;

    /* Smart Height Conditions */
    {% if section.settings.fit_to_content %}
      min-height: max-content;
      height: auto;
    {% else %}
      min-height: {{ section.settings.banner_height }}px;
      height: {{ section.settings.banner_height }}px;
    {% endif %}

    /* ORIGINAL BUTTON & FOREGROUND COLOR VARIABLES */
    --color-foreground: {{ section.settings.colors_text.red }}, {{ section.settings.colors_text.green }}, {{ section.settings.colors_text.blue }};
    --color-link: var(--color-foreground);
    --color-heading: var(--color-foreground);
    --color-button-text: {{ section.settings.colors_button_label.red }}, {{ section.settings.colors_button_label.green }}, {{ section.settings.colors_button_label.blue }};
    --color-button-background: {{ section.settings.colors_button_background.red }}, {{ section.settings.colors_button_background.green }}, {{ section.settings.colors_button_background.blue }};
    --color-button-border: var(--color-button-background);
  }

  /* Stretches the image container to match whatever height the content demands */
  .custom-banner-media-{{ banner_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .custom-banner-media-{{ banner_id }} img,
  .custom-banner-media-{{ banner_id }} .media-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Overlay injection layer */
  .custom-banner-media-{{ banner_id }}::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgb({{ section.settings.colors_overlay.red }}, {{ section.settings.colors_overlay.green }}, {{ section.settings.colors_overlay.blue }});
    opacity: {{ section.settings.colors_overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
    pointer-events: none;
  }

  /* Content Overlay Layer */
  .custom-banner-content-{{ banner_id }} {
    position: relative;
    z-index: 3;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-grow: 1;
    align-self: stretch;
    min-height: inherit;
    
    /* FIX: Top and Bottom padding now applied INSIDE the container framework */
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.desktop_gutter }}px;
    padding-right: {{ section.settings.desktop_gutter }}px;
    
    /* Alignment conditions */
    {%- if section.settings.vertical_content_alignment == 'top' -%} align-items: flex-start;
    {%- elsif section.settings.vertical_content_alignment == 'middle' -%} align-items: center;
    {%- else -%} align-items: flex-end; {%- endif -%}

    {%- if section.settings.horizontal_content_alignment == 'left' -%} justify-content: flex-start;
    {%- elsif section.settings.horizontal_content_alignment == 'center' -%} justify-content: center;
    {%- else -%} justify-content: flex-end; {%- endif -%}
  }

  /* Internal Text Container Block */
  .custom-banner-box-{{ banner_id }} {
    max-width: {{ section.settings.content_max_width }}px;
    width: 100%;
    color: rgb(var(--color-foreground));
    
    {%- if section.settings.horizontal_content_alignment == 'left' -%} margin-left: 0; margin-right: auto;
    {%- elsif section.settings.horizontal_content_alignment == 'center' -%} margin-left: auto; margin-right: auto;
    {%- else -%} margin-left: auto; margin-right: 0; {%- endif -%}
  }

  /* Typography block settings */
  .custom-banner-box-{{ banner_id }} h2 {
    margin: 0 0 10px 0;
    color: rgb(var(--color-foreground));
  }

  .custom-banner-text-{{ banner_id }}, 
  .custom-banner-text-{{ banner_id }} p {
    color: rgb(var(--color-foreground));
    font-size: 15px;
    line-height: 1.4;
    margin: 0 0 15px 0;
  }

  /* Mobile Overrides */
  @media screen and (max-width: 749px) {
    .custom-banner-box-{{ banner_id }} { max-width: 100%; }
    
    .custom-banner-content-{{ banner_id }} {
      padding-left: {{ section.settings.mobile_gutter }}px;
      padding-right: {{ section.settings.mobile_gutter }}px;
      /* Scales down internal padding nicely for mobile screens */
      padding-top: max(2rem, calc({{ section.settings.padding_top }}px * 0.7));
      padding-bottom: max(2rem, calc({{ section.settings.padding_bottom }}px * 0.7));
    }
    
    {% unless section.settings.fit_to_content %}
      .custom-banner-{{ banner_id }} {
        min-height: calc({{ section.settings.banner_height }}px * 0.9);
        height: calc({{ section.settings.banner_height }}px * 0.9);
      }
    {% endunless %}
  }
{%- endstyle -%}

{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

<div class="custom-banner-wrapper-{{ banner_id }}">
  <div id="Banner-{{ section.id }}" class="custom-banner-{{ banner_id }}">
    
    {%- comment -%} Background Media Container {%- endcomment -%}
    {%- if section.settings.image != blank -%}
      <div class="custom-banner-media-{{ banner_id }}">
        {{ section.settings.image | image_url: width: 3840 | image_tag: loading: 'lazy' }}
      </div>
    {%- else -%}
      <div class="custom-banner-media-{{ banner_id }}">
        <div class="media-placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} Interactive Foreground Text Container {%- endcomment -%}
    <div class="custom-banner-content-{{ banner_id }}">
      <div class="custom-banner-box-{{ banner_id }} {{ section.settings.text_alignment }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <h2 class="banner__heading {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                {{ block.settings.heading }}
              </h2>
            {%- when 'text' -%}
              <div class="custom-banner-text-{{ banner_id }} rte" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
            {%- when 'button' -%}
              <div class="banner__buttons" {{ block.shopify_attributes }}>
                {%- if block.settings.button_label != blank -%}
                  <a href="{{ block.settings.button_link }}" class="button button--{{ block.settings.button_size }}{% if block.settings.button_style_secondary %} button--secondary{% endif %}">
                    {{ block.settings.button_label | escape }}
                  </a>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Image Banner",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "color", "id": "colors_overlay", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "colors_overlay_opacity", "label": "Overlay opacity", "default": 0, "min": 0, "max": 100, "step": 4, "unit": "%" },
    
    { "type": "header", "content": "Sizing & Heights" },
    { "type": "checkbox", "id": "fit_to_content", "label": "Fit to text content (Auto-grow)", "default": false, "info": "Overrides the fixed slider height below so your copy never overflows or crops." },
    { "type": "range", "id": "banner_height", "min": 100, "max": 800, "step": 10, "unit": "px", "label": "Fixed Banner Height", "default": 200 },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "content_max_width", "min": 400, "max": 1200, "step": 50, "unit": "px", "label": "Content max-width", "default": 800 },
    { "type": "select", "id": "vertical_content_alignment", "options": [{ "value": "top", "label": "Top" }, { "value": "middle", "label": "Middle" }, { "value": "bottom", "label": "Bottom" }], "default": "middle", "label": "Vertical position" },
    { "type": "select", "id": "horizontal_content_alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center", "label": "Horizontal position" },
    { "type": "select", "id": "text_alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center", "label": "Text alignment" },
    
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "colors_text", "label": "Text color", "default": "#ffffff" },

    { "type": "header", "content": "Buttons" },
    { "type": "color", "id": "colors_button_label", "label": "Text Colour", "default": "#000000" },
    { "type": "color", "id": "colors_button_background", "label": "Button Background", "default": "#ffffff" },
    
    { "type": "header", "content": "Section Padding & Gutter Settings" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Internal Top Padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Internal Bottom Padding", "default": 40 },
    { "type": "range", "id": "desktop_gutter", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Desktop Side Gutter", "default": 40 },
    { "type": "range", "id": "mobile_gutter", "min": 0, "max": 50, "step": 2, "unit": "px", "label": "Mobile Side Gutter", "default": 20 }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
        "settings": [
          { 
            "type": "inline_richtext", 
            "id": "heading", "default": 
            "Image banner", 
            "label": "Heading" 
          },
          { 
            "type": "select", "id": "heading_size", "options": [{ "value": "h2", "label": "Small" }, { "value": "h1", "label": "Medium" }], "default": "h1", "label": "Size" }
        ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "default": "<p>Description</p>", "label": "Text" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "button_label", "default": "Shop Now", "label": "Label" },
        { "type": "url", "id": "button_link", "label": "Link" },
        { "type": "select", "id": "button_size", "options": [{ "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }], "default": "medium", "label": "Size" },
        { "type": "checkbox", "id": "button_style_secondary", "default": false, "label": "Secondary style" }
      ]
    }
  ],
  "presets": [{ "name": "Image Banner" }]
}
{% endschema %}