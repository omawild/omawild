{%- comment -%}
  OMA Page Header — Office. This is the "sentence builder" hero from Workplace
  Coffee Page (new): breadcrumb + badge, an eyebrow, a live sentence-built
  calculator (team size / cups per day / office days a week / taste), a
  stats-and-email-capture panel, and a footnote link. Kept as its own file
  rather than an edit to oma-page-header.liquid, which is shared by Shop/
  Subscriptions/About/Origins/Dispatch and has none of this interactivity.

  The calculator's math and copy structure are ported as-is from the design
  file: cups/month = team * cups-per-day * days-per-week * 4.33 (weeks/month),
  kg/month = cups/month * grams-per-cup / 1000. Team size, cups and days
  pluralize their unit word client-side; assets/oma-page-header-office.js
  owns that plus the stepper math and the taste toggle.

  The email capture reuses the theme's native `customer` form action (see
  oma-sampler-form.liquid) rather than a third-party ESP. The customer form
  has no fields for team size/cups/days/taste, so those are folded into
  `contact[tags]` client-side, same trick as oma-sampler-form.js. If JS never
  runs, the hidden tag input still carries the schema defaults baked in at
  render time, so the email is never lost — it just isn't tagged with
  whatever the visitor actually chose.
{%- endcomment -%}
{% assign owid = section.id | replace: '-', '' | replace: '_', '' %}
{%- liquid
  assign taste_blocks = section.blocks | where: 'type', 'taste'
  assign first_taste = taste_blocks.first.settings.label | default: 'chocolatey'
  assign first_taste_slug = first_taste | handleize
  assign cups_per_month_default = section.settings.team_default | times: section.settings.cups_default | times: section.settings.days_default | times: 4.33
  assign kg_default = cups_per_month_default | times: section.settings.grams_per_cup | divided_by: 1000.0

  assign team_word = section.settings.team_unit
  if section.settings.team_default != 1
    assign team_word = section.settings.team_unit | append: 's'
  endif
  assign cups_word = section.settings.cups_unit
  if section.settings.cups_default != 1
    assign cups_word = section.settings.cups_unit | append: 's'
  endif
  assign days_word = section.settings.days_unit
  if section.settings.days_default != 1
    assign days_word = section.settings.days_unit | append: 's'
  endif
-%}
{% style %}
.oma-page-header-office-{{ owid }} {
  box-sizing: border-box;
  background: {{ section.settings.background_color }};
  border-bottom: 1.5px solid {{ section.settings.border_color }};
  font-family: var(--font-body-family);
}
.oma-page-header-office-{{ owid }} *, .oma-page-header-office-{{ owid }} *::before, .oma-page-header-office-{{ owid }} *::after {
  box-sizing: border-box;
}
.oma-page-header-office-{{ owid }} .inner {
  max-width: 1440px;
  margin: 0 auto;
  padding: 36px clamp(20px, 4vw, 48px) clamp(48px, 6vw, 80px);
}
.oma-page-header-office-{{ owid }} .top-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 14px 24px;
}
.oma-page-header-office-{{ owid }} .crumbs {
  flex: none;
  display: flex;
  gap: 6px;
  margin: 0;
  padding: 0;
  list-style: none;
  white-space: nowrap;
  font: 700 11px/1.4 var(--font-heading-family);
  letter-spacing: .06em;
  text-transform: uppercase;
  color: {{ section.settings.breadcrumb_color }};
}
.oma-page-header-office-{{ owid }} .crumbs a { color: inherit; text-decoration: none; }
.oma-page-header-office-{{ owid }} .crumbs a:hover { opacity: .75; }
.oma-page-header-office-{{ owid }} .badge {
  flex: none;
  display: inline-block;
  white-space: nowrap;
  background: {{ section.settings.badge_background }};
  color: {{ section.settings.accent_color }};
  padding: 8px 14px;
  border-radius: 999px;
  font: 900 10.5px/1 var(--font-heading-family);
  letter-spacing: .12em;
  text-transform: uppercase;
  transform: rotate(-2deg);
}
.oma-page-header-office-{{ owid }} .eyebrow {
  margin: clamp(28px, 4vw, 48px) 0 0;
  font: 900 clamp(18px, 1.6vw, 22px)/1.2 var(--font-heading-family);
  letter-spacing: -.01em;
  color: {{ section.settings.eyebrow_color }};
}
.oma-page-header-office-{{ owid }} .sentence {
  margin: 14px 0 0;
  max-width: 1100px;
  font-family: var(--font-heading-family);
  font-weight: 900;
  font-size: clamp(30px, 4.4vw, 64px);
  line-height: 1.32;
  letter-spacing: -.035em;
  color: {{ section.settings.sentence_color }};
  text-wrap: pretty;
}
.oma-page-header-office-{{ owid }} .unit {
  font-family: var(--font-heading-family);
}
.oma-page-header-office-{{ owid }} .stepper {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  vertical-align: .08em;
  background: #ffffff;
  border-radius: 999px;
  padding: 4px;
  line-height: 1;
}
.oma-page-header-office-{{ owid }} .stepper button {
  width: 1.05em;
  height: 1.05em;
  border: none;
  border-radius: 999px;
  background: {{ section.settings.form_panel_background }};
  color: {{ section.settings.accent_color }};
  cursor: pointer;
  font: 900 .5em/1 var(--font-heading-family);
  display: flex;
  align-items: center;
  justify-content: center;
}
.oma-page-header-office-{{ owid }} .stepper button:hover { background: {{ section.settings.badge_background }}; }
.oma-page-header-office-{{ owid }} .stepper input {
  box-sizing: content-box;
  width: 2ch;
  padding: 0 .12em;
  border: none;
  outline: none;
  background: transparent;
  text-align: center;
  color: {{ section.settings.accent_color }};
  font: inherit;
  letter-spacing: inherit;
}
.oma-page-header-office-{{ owid }} .stepper input:focus { background: {{ section.settings.form_panel_background }}; border-radius: 8px; }
.oma-page-header-office-{{ owid }} .taste-toggle {
  display: inline-flex;
  align-items: center;
  gap: .25em;
  vertical-align: .08em;
  border: none;
  cursor: pointer;
  background: {{ section.settings.badge_background }};
  color: {{ section.settings.accent_color }};
  border-radius: 999px;
  padding: .08em .4em .12em;
  font: inherit;
  letter-spacing: inherit;
  line-height: 1.15;
}
.oma-page-header-office-{{ owid }} .taste-toggle:hover { background: #ffffff; }
.oma-page-header-office-{{ owid }} .taste-toggle .icon { font-size: .45em; }
.oma-page-header-office-{{ owid }} .panel {
  margin-top: clamp(36px, 4vw, 56px);
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
  background: #ffffff;
  border: 2px solid {{ section.settings.card_border_color }};
  border-radius: 14px;
  box-shadow: 8px 8px 0 {{ section.settings.card_border_color }};
  overflow: hidden;
}
.oma-page-header-office-{{ owid }} .stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 200px));
  align-content: center;
  align-items: center;
  gap: 20px 40px;
  padding: clamp(22px, 3vw, 32px);
}
.oma-page-header-office-{{ owid }} .stat { display: flex; flex-direction: column; gap: 8px; }
.oma-page-header-office-{{ owid }} .stat-label {
  font: 900 10px/1 var(--font-heading-family);
  letter-spacing: .14em;
  text-transform: uppercase;
  color: {{ section.settings.accent_color }};
}
.oma-page-header-office-{{ owid }} .stat-value {
  margin: 6px 0;
  font-family: var(--font-heading-family);
  font-weight: 900;
  font-size: clamp(36px, 3.6vw, 48px);
  line-height: 1;
  letter-spacing: -.04em;
  color: {{ section.settings.accent_color }};
}
.oma-page-header-office-{{ owid }} .stat-unit {
  font-size: 12.5px;
  line-height: 1.55;
  color: {{ section.settings.text_color }};
}
.oma-page-header-office-{{ owid }} .form-panel {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12px;
  padding: clamp(22px, 3vw, 32px);
  background: {{ section.settings.form_panel_background }};
  border-left: 1.5px solid {{ section.settings.accent_color }};
}
@media (max-width: 749px) {
  .oma-page-header-office-{{ owid }} .form-panel { border-left: none; border-top: 1.5px solid {{ section.settings.accent_color }}; }
}
.oma-page-header-office-{{ owid }} .form-label {
  font: 900 10px/1 var(--font-heading-family);
  letter-spacing: .14em;
  text-transform: uppercase;
  color: {{ section.settings.accent_color }};
}
.oma-page-header-office-{{ owid }} .capture-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.oma-page-header-office-{{ owid }} .capture-row input[type="email"] {
  flex: 1 1 200px;
  min-width: 0;
  box-sizing: border-box;
  border: 1.5px solid {{ section.settings.accent_color }};
  border-radius: 999px;
  padding: 15px 18px;
  outline: none;
  background: #ffffff;
  font: 400 14px var(--font-body-family);
  color: {{ section.settings.accent_color }};
}
.oma-page-header-office-{{ owid }} .capture-row button {
  flex: none;
  border: none;
  cursor: pointer;
  background: {{ section.settings.accent_color }};
  color: #ffffff;
  padding: 16px 26px;
  border-radius: 999px;
  font: 900 13px/1 var(--font-heading-family);
  transition: filter .2s ease;
}
.oma-page-header-office-{{ owid }} .capture-row button:hover { filter: brightness(.85); }
.oma-page-header-office-{{ owid }} .fine-print {
  font-size: 12.5px;
  line-height: 1.55;
  color: {{ section.settings.text_color }};
}
.oma-page-header-office-{{ owid }} .field--with-error input { border-color: #d72c0d; }
.oma-page-header-office-{{ owid }} .field-error { margin-top: 2px; font-size: 12px; color: #d72c0d; }
.oma-page-header-office-{{ owid }} .success { font: 400 14.5px/1.6 var(--font-body-family); color: {{ section.settings.accent_color }}; }
.oma-page-header-office-{{ owid }} .footnote {
  margin: 18px 0 0;
  font: 400 14.5px/1.6 var(--font-body-family);
  color: {{ section.settings.footnote_color }};
}
.oma-page-header-office-{{ owid }} .footnote a {
  color: {{ section.settings.footnote_color }};
  font-weight: 700;
}
{% endstyle %}
<div
  class="oma-page-header-office-{{ owid }}"
  id="top"
  data-oma-page-header-office
  data-team-default="{{ section.settings.team_default }}"
  data-cups-default="{{ section.settings.cups_default }}"
  data-days-default="{{ section.settings.days_default }}"
  data-grams-per-cup="{{ section.settings.grams_per_cup }}"
  data-team-unit-singular="{{ section.settings.team_unit | escape }}"
  data-cups-unit-singular="{{ section.settings.cups_unit | escape }}"
  data-days-unit-singular="{{ section.settings.days_unit | escape }}"
  data-base-tag="{{ section.settings.tag | escape }}"
>
  <div class="inner">
    <div class="top-row">
      {%- if section.settings.show_breadcrumb -%}
        <ul class="crumbs">
          <li><a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t | default: 'Home' }}</a></li>
          <li aria-hidden="true">/</li>
          <li>{{ section.settings.breadcrumb_label | default: 'Workplace Coffee' }}</li>
        </ul>
      {%- endif -%}
      {%- if section.settings.badge_text != blank -%}
        <span class="badge">{{ section.settings.badge_text }}</span>
      {%- endif -%}
    </div>

    {%- if section.settings.eyebrow_text != blank -%}
      <h1 class="eyebrow">{{ section.settings.eyebrow_text }}</h1>
    {%- endif -%}

    <p class="sentence">
      {{ section.settings.text_lead }}
      <span class="stepper" data-stepper="team">
        <button type="button" data-step="down" aria-label="Fewer people">&minus;</button>
        <input type="text" inputmode="numeric" value="{{ section.settings.team_default }}" data-input aria-label="Number of people on the team">
        <button type="button" data-step="up" aria-label="More people">+</button>
      </span>
      <span class="unit" data-unit="team">{{ team_word }}</span>,
      {{ section.settings.text_after_team }}
      <span class="stepper" data-stepper="cups">
        <button type="button" data-step="down" aria-label="Fewer cups">&minus;</button>
        <input type="text" inputmode="decimal" value="{{ section.settings.cups_default }}" data-input aria-label="Cups per person per day">
        <button type="button" data-step="up" aria-label="More cups">+</button>
      </span>
      <span class="unit" data-unit="cups">{{ cups_word }}</span>
      {{ section.settings.text_after_cups }}
      <span class="stepper" data-stepper="days">
        <button type="button" data-step="down" aria-label="Fewer days">&minus;</button>
        <input type="text" inputmode="numeric" value="{{ section.settings.days_default }}" data-input aria-label="Days in the office per week">
        <button type="button" data-step="up" aria-label="More days">+</button>
      </span>
      <span class="unit" data-unit="days">{{ days_word }}</span>
      {{ section.settings.text_after_days }}
      <button type="button" class="taste-toggle" data-taste-toggle aria-label="Change taste preference">
        <span data-taste-label>{{ first_taste }}</span><span class="icon" aria-hidden="true">&#8635;</span>
      </button>.
    </p>
    <ul hidden data-taste-options>
      {%- for block in taste_blocks -%}
        <li {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</li>
      {%- endfor -%}
    </ul>

    <div class="panel">
      <div class="stats">
        <div class="stat">
          <span class="stat-label">{{ section.settings.stats_label_1 | escape }}</span>
          <span class="stat-value">&asymp; <span data-stat="kg">{{ kg_default | round: 1 }}</span></span>
          <span class="stat-unit">{{ section.settings.stats_unit_1 | escape }}</span>
        </div>
        <div class="stat">
          <span class="stat-label">{{ section.settings.stats_label_2 | escape }}</span>
          <span class="stat-value">&asymp; <span data-stat="cups">{{ cups_per_month_default | round }}</span></span>
          <span class="stat-unit">{{ section.settings.stats_unit_2 | escape }}</span>
        </div>
      </div>
      <div class="form-panel">
        {% form 'customer', class: 'oma-page-header-office-form', data-oma-page-header-office-form: '' %}
          {%- if form.posted_successfully? -%}
            <p class="success" role="status" tabindex="-1" autofocus>{{ section.settings.success_message | escape }}</p>
          {%- else -%}
            <span class="form-label">{{ section.settings.form_eyebrow | escape }}</span>
            <input
              type="hidden"
              name="contact[tags]"
              value="{{ section.settings.tag | escape }}, team-{{ section.settings.team_default }}, cups-{{ section.settings.cups_default }}, days-{{ section.settings.days_default }}, taste-{{ first_taste_slug }}"
              data-tags-input
            >
            <div class="capture-row {% if form.errors contains 'email' %}field--with-error{% endif %}">
              <label class="visually-hidden" for="OfficeSamplerEmail-{{ section.id }}">{{ 'templates.contact.form.email' | t }}</label>
              <input
                id="OfficeSamplerEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
                aria-required="true"
                value="{{ form.email }}"
                placeholder="{{ section.settings.email_placeholder | escape }}"
              >
              <button type="submit">{{ section.settings.submit_label | escape }}</button>
            </div>
            {%- if form.errors contains 'email' -%}
              <div class="field-error">{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</div>
            {%- endif -%}
            <div class="fine-print">{{ section.settings.fine_print }}</div>
          {%- endif -%}
        {% endform %}
      </div>
    </div>

    <p class="footnote">
      {{ section.settings.footnote_prefix | replace: '{grams}', section.settings.grams_per_cup }}
      {%- if section.settings.footnote_link_label != blank -%}
        &nbsp;<a href="{{ section.settings.footnote_link_href | default: '#range' }}">{{ section.settings.footnote_link_label }}</a>
      {%- endif -%}
    </p>
  </div>
</div>
<script src="{{ 'oma-page-header-office.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "OMA Page Header — Office",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "header", "content": "Top row" },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "text", "id": "breadcrumb_label", "label": "Breadcrumb label", "default": "Workplace Coffee" },
    { "type": "text", "id": "badge_text", "label": "Badge text", "info": "Leave blank to hide.", "default": "FREE SAMPLER · YOU COVER SHIPPING" },
    { "type": "header", "content": "Eyebrow" },
    { "type": "text", "id": "eyebrow_text", "label": "Eyebrow", "default": "Coffee for the Workplace" },
    { "type": "header", "content": "Sentence builder" },
    { "type": "text", "id": "text_lead", "label": "Opening words", "default": "We're a team of" },
    { "type": "text", "id": "team_unit", "label": "Team unit (singular)", "default": "human" },
    { "type": "text", "id": "text_after_team", "label": "Words after team count", "default": "drinking" },
    { "type": "text", "id": "cups_unit", "label": "Cups unit (singular)", "default": "cup" },
    { "type": "text", "id": "text_after_cups", "label": "Words after cup count", "default": "each, in the office" },
    { "type": "text", "id": "days_unit", "label": "Days unit (singular)", "default": "day" },
    { "type": "text", "id": "text_after_days", "label": "Words after day count", "default": "a week, and we prefer our coffee" },
    { "type": "range", "id": "team_default", "label": "Default team size", "min": 1, "max": 200, "step": 1, "default": 10 },
    { "type": "range", "id": "cups_default", "label": "Default cups per person per day", "min": 0.5, "max": 10, "step": 0.5, "default": 1 },
    { "type": "range", "id": "days_default", "label": "Default office days per week", "min": 1, "max": 7, "step": 1, "default": 5 },
    { "type": "range", "id": "grams_per_cup", "label": "Grams of coffee per cup", "min": 5, "max": 30, "step": 1, "unit": "g", "default": 15, "info": "Drives both the calculator and the footnote copy." },
    { "type": "header", "content": "Stats" },
    { "type": "text", "id": "stats_label_1", "label": "Stat 1 label", "default": "TOTAL COFFEE VOLUME" },
    { "type": "text", "id": "stats_unit_1", "label": "Stat 1 unit", "default": "kg per month" },
    { "type": "text", "id": "stats_label_2", "label": "Stat 2 label", "default": "TOTAL CUPS" },
    { "type": "text", "id": "stats_unit_2", "label": "Stat 2 unit", "default": "cups per month" },
    { "type": "header", "content": "Email capture" },
    { "type": "text", "id": "form_eyebrow", "label": "Form label", "default": "GET A FREE SAMPLER" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "you@company.com" },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Send my sampler" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "On its way — check your inbox." },
    { "type": "richtext", "id": "fine_print", "label": "Fine print", "default": "<p>You just cover shipping. No card, no contract. Your answers above come with the request.</p>" },
    { "type": "text", "id": "tag", "label": "Customer tag applied on submit", "default": "workplace-sampler-request", "info": "Team size, cups, days and taste are appended automatically as separate tags." },
    { "type": "header", "content": "Footnote" },
    { "type": "text", "id": "footnote_prefix", "label": "Footnote text", "default": "Estimate assumes {grams} g per cup.", "info": "Use {grams} as a placeholder for the setting above." },
    { "type": "text", "id": "footnote_link_label", "label": "Footnote link label", "default": "See the full product range ↓" },
    { "type": "url", "id": "footnote_link_href", "label": "Footnote link destination" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FF3F00" },
    { "type": "color", "id": "border_color", "label": "Border color", "default": "#FF3F00" },
    { "type": "color", "id": "breadcrumb_color", "label": "Breadcrumb color", "default": "#FCD0FD" },
    { "type": "color", "id": "badge_background", "label": "Badge background", "default": "#FCD0FD" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#FBB925" },
    { "type": "color", "id": "sentence_color", "label": "Sentence color", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent (steppers, taste pill, badge text, stat & form labels)", "default": "#FF3F00" },
    { "type": "color", "id": "card_border_color", "label": "Panel border & shadow", "default": "#FBB925" },
    { "type": "color", "id": "form_panel_background", "label": "Form panel & stepper-button background", "default": "#FFE4E7" },
    { "type": "color", "id": "text_color", "label": "Body/fine-print text (on white panel)", "default": "#00180C" },
    { "type": "color", "id": "footnote_color", "label": "Footnote text (on header background)", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "taste",
      "name": "Taste option",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "info": "e.g. \"chocolatey\", \"bright and fruity\"", "default": "chocolatey" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OMA Page Header — Office",
      "blocks": [
        { "type": "taste", "settings": { "label": "chocolatey" } },
        { "type": "taste", "settings": { "label": "bright and fruity" } },
        { "type": "taste", "settings": { "label": "a bit of both" } }
      ]
    }
  ]
}
{% endschema %}
