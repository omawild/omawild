{%- assign omawild_id = section.id | replace: '_', '' | replace: '-', '' | downcase -%}
{%- assign label_tag = section.settings.label_tag | default: 'h3' -%}

{% style %}
/* --- 1. Foundation --- */
 .section-{{ omawild_id }} {
   width: 100%;
   background-color: {{ section.settings.background_color }};
   padding-top: {{ section.settings.section_padding_top }}px;
   padding-bottom: {{ section.settings.section_padding_bottom }}px;
   display: flex;
   flex-direction: column;
 }

 .container-{{ omawild_id }} {
   margin: 0 auto;
   box-sizing: border-box;
   align-items: {{ section.settings.content_alignment }};
   text-align: {{ section.settings.content_alignment }};
   padding: 0 {{ section.settings.mobile_side_padding }}px;
   /* Fixed the missing max-width mapping from your original schema */
   {% if section.settings.full_width %}
     width: 100%;
     max-width: 100%;
   {% else %}
     width: 100%;
     max-width: {{ section.settings.max_width }}px;
   {% endif %}
 }

/* --- 2. Top Content (Label, Heading, Body) --- */
 .label-{{ omawild_id }} {
   display: block !important;
   font-family: var(--font-body-family) !important; 
   font-size: 12px !important;
   letter-spacing: 0.15em !important;
   font-weight: 400 !important; 
   color: {{ section.settings.label_color }} !important;
   text-transform: uppercase !important;
   margin: 0 0 20px 0 !important;
   line-height: 1.2 !important;
 }

 .main-heading-{{ omawild_id }} :is(h1, h2, h3, h4, h5, h6) {
   font-size: clamp({{ section.settings.heading_size | times: 0.6 }}px, 5vw + 10px, {{ section.settings.heading_size }}px) !important;
   line-height: 1 !important; 
   letter-spacing: -0.02em !important;
   color: {{ section.settings.heading_color }} !important;
   font-weight: 700;
   display: block;
   margin-top: 0 !important;
   margin-bottom: 22px !important;
 }

 .body-text-{{ omawild_id }} p {
   font-size: clamp({{ section.settings.text_size | times: 0.8 }}px, 2vw + 12px, {{ section.settings.text_size }}px) !important;
   line-height: {{ section.settings.body_line_height }} !important;
   color: {{ section.settings.text_color }} !important;
   margin: 0 0 10px 0 !important;
 }

 .text-{{ omawild_id }} {
   width: 100%;
   margin-bottom: 30px;
 }

 .text-{{ omawild_id }} strong {
   color: {{ section.settings.emphasis_color }} !important;
 }

/* --- 3. The Grid & Cards --- */
 .stats-{{ omawild_id }} {
   display: flex;
   flex-wrap: wrap;
   gap: {{ section.settings.stat_gap }}px;
   width: 100%;
   justify-content: {% if section.settings.content_alignment == 'center' %}center{% elsif section.settings.content_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
   margin-top: -20px;
 }

 .stat-card-{{ omawild_id }} {
   background-color: {{ section.settings.card_background }} !important;
   border: 1px solid {{ section.settings.card_border_color }} !important;
   padding: {{ section.settings.card_padding }}px !important;
   flex: 1 1 100%; 
   box-sizing: border-box;
   display: flex;
   flex-direction: column;
   justify-content: flex-start;
   text-align: {{ section.settings.content_alignment }};
 }

 .stat-label-{{ omawild_id }} {
    font-family: var(--font-heading-family) !important; 
    font-weight: 600 !important;
    font-size: clamp({{ section.settings.stat_label_size | times: 0.7 }}px, 4vw, {{ section.settings.stat_label_size }}px) !important;
    color: {{ section.settings.stat_label_color }} !important;
    letter-spacing: -0.02em !important;
    line-height: {{ section.settings.stat_label_height }} !important;
    margin-bottom: {{ section.settings.stat_label_margin_bottom }}px !important;
    display: block !important;
  }

 .stat-body-{{ omawild_id }} {
    font-family: var(--font-body-family) !important;
    font-size: {{ section.settings.stat_body_size }}px !important;
    line-height: 1.3 !important;
    color: {{ section.settings.stat_body_color }} !important;
    display: block !important;
 }

/* --- 4. Responsive --- */
 @media screen and (min-width: 750px) {
   .container-{{ omawild_id }} {
     padding-left: {{ section.settings.desktop_side_padding }}px;
     padding-right: {{ section.settings.desktop_side_padding }}px;
   }
   
   .text-{{ omawild_id }} {
     margin-bottom: 40px;
     
     /* Adaptive Width Logic */
     {% if section.settings.match_container_width %}
       max-width: 100%;
     {% else %}
       max-width: {{ section.settings.text_max_width }}px;
     {% endif %}

     {% if section.settings.content_alignment == 'center' %}
       margin-left: auto;
       margin-right: auto;
     {% elsif section.settings.content_alignment == 'right' %}
       margin-left: auto;
       margin-right: 0;
     {% endif %}
   }
   
   .stat-card-{{ omawild_id }} {
     flex: 0 1 calc(33.333% - {{ section.settings.stat_gap }}px);
     min-height: {{ section.settings.card_min_height }}px;
   }
 }
{% endstyle %}

<div class="section-{{ omawild_id }}" {{ section.shopify_attributes }}>

 <div class="container-{{ omawild_id }}">
   {% if section.settings.section_label != blank %}
     <{{ label_tag }} class="label-{{ omawild_id }}">
       {{ section.settings.section_label }}
     </{{ label_tag }}>
   {% endif %}

    <div class="text-{{ omawild_id }}">
      {% if section.settings.heading != blank %}
        <div class="main-heading-{{ omawild_id }}">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.content != blank %}
        <div class="body-text-{{ omawild_id }}">
          {{ section.settings.content }}
        </div>
      {% endif %}
    </div>

    <div class="stats-stats-{{ omawild_id }}">
      <div class="stats-{{ omawild_id }}">
        {%- for block in section.blocks -%}
          <div class="stat-card-{{ omawild_id }}" {{ block.shopify_attributes }}>
            {% if block.settings.stat_label != blank %}
              <div class="stat-label-{{ omawild_id }}">
                {{ block.settings.stat_label }}
              </div>
            {% endif %}
            {% if block.settings.stat_body != blank %}
              <div class="stat-body-{{ omawild_id }}">
                {{ block.settings.stat_body }}
              </div>
            {% endif %}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
 "name": "OD Stack Cards",
 "settings": [
   { "type": "header", "content": "Layout" },
   { "type": "select", "id": "content_alignment", "label": "Content Alignment", "options": [
       { "value": "left", "label": "Left" },
       { "value": "center", "label": "Center" },
       { "value": "right", "label": "Right" }
     ], "default": "left" 
   },
   { "type": "checkbox", "id": "full_width", "label": "Make section full width (Infinite)", "default": false },
   { "type": "range", "id": "max_width", "label": "Max width", "info": "Ignored if Full Width is checked", "min": 600, "max": 1600, "step": 50, "unit": "px", "default": 1000 },
   { "type": "range", "id": "section_padding_top", "label": "Top padding", "min": 0, "max": 150, "step": 10, "unit": "px", "default": 40 },
   { "type": "range", "id": "section_padding_bottom", "label": "Bottom padding", "min": 0, "max": 150, "step": 10, "unit": "px", "default": 40 },
   { "type": "range", "id": "desktop_side_padding", "label": "Desktop Side Padding", "min": 0, "max": 150, "step": 5, "unit": "px", "default": 40 },
   { "type": "range", "id": "mobile_side_padding", "label": "Mobile Side Padding", "min": 0, "max": 50, "step": 5, "unit": "px", "default": 20 },
   { "type": "color", "id": "background_color", "label": "Section Background", "default": "#ffffff" },

   { "type": "header", "content": "Header Text Width Control" },
   { "type": "checkbox", "id": "match_container_width", "label": "Match card container width", "info": "Forces header text to flush left and right with the card grid edges.", "default": true },
   { "type": "range", "id": "text_max_width", "label": "Custom Text Max Width", "info": "Ignored if 'Match card container width' is checked.", "min": 400, "max": 1200, "step": 50, "unit": "px", "default": 850 },

   { "type": "header", "content": "Card Styles" },
   { "type": "color", "id": "card_background", "label": "Card Background", "default": "#ffffff" },
   { "type": "color", "id": "card_border_color", "label": "Card Border", "default": "#e5e5e5" },
   { "type": "range", "id": "card_padding", "label": "Card Padding", "min": 10, "max": 60, "default": 20 },
   { "type": "range", "id": "card_min_height", "label": "Card Min Height", "min": 50, "max": 500, "step": 10, "unit": "px", "default": 150 },
   { "type": "range", "id": "stat_gap", "label": "Gap between cards", "min": 0, "max": 60, "step": 5, "unit": "px", "default": 15 },

   { "type": "header", "content": "Colors" },  
   { "type": "color", "id": "label_color", "label": "Section Label Color", "default": "#666666" },
   { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#1A1B18" },
   { "type": "color", "id": "emphasis_color", "label": "Emphasis color", "default": "#B231C6" },
   { "type": "color", "id": "text_color", "label": "Body Text Color", "default": "#1B1B1B" },
   { "type": "color", "id": "stat_label_color", "label": "Stat Label Color", "default": "#1A1B18" },
   { "type": "color", "id": "stat_body_color", "label": "Stat Body Color", "default": "#1B1B1B" },

   { "type": "header", "content": "Type Size" },
   { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 40 },
   { "type": "range", "id": "text_size", "label": "Body Text Size", "min": 12, "max": 30, "default": 16 },
   { "type": "range", "id": "stat_label_size", "label": "Stat Label Size", "min": 18, "max": 50, "default": 48 },
   { "type": "range", "id": "stat_body_size", "label": "Stat Body Size", "min": 10, "max": 30, "default": 15 },

   { "type": "header", "content": "Line Height & Margin" },
   { "type": "range", "id": "body_line_height", "label": "Body Line Height", "min": 1.0, "max": 2.4, "step": 0.1, "default": 1.4 },
   { "type": "range", "id": "stat_label_height", "label": "Stat Label Line Height", "min": 1.0, "max": 2.4, "step": 0.1, "default": 1 },
   { "type": "range", "id": "stat_label_margin_bottom", "label": "Stat Label Margin Bottom", "min": -10, "max": 20, "step": 2, "unit": "px", "default": 14 },

   { "type": "header", "content": "Section Content" },
   { "type": "select", "id": "label_tag", "label": "Label SEO Tag", "options": [{"value":"h1","label":"H1"},{"value":"h2","label":"H2"},{"value":"h3","label":"H3"},{"value":"p","label":"p"}], "default": "h3" },
   { "type": "inline_richtext", "id": "section_label", "label": "Section Label Text", "default": "Label" },
   { "type": "richtext", "id": "heading", "label": "Heading", "default": "<h2>Heading</h2>" },
   { "type": "richtext", "id": "content", "label": "Body text", "default": "<p>Lorem ipsum dolor sit amet.</p>" }
 ],
 "blocks": [
   {
     "type": "stat_card",
     "name": "Stat Card",
     "settings": [
       { "type": "inline_richtext", "id": "stat_label", "label": "Stat Label", "default": "0" },
       { "type": "inline_richtext", "id": "stat_body", "label": "Stat Body Text", "default": "Stat body text here." },
      ]
   }
 ],
 "presets": [
   { "name": "OD Stack Cards", "blocks": [{ "type": "stat_card" },{ "type": "stat_card" },{ "type": "stat_card" }] }
 ]
}
{% endschema %}