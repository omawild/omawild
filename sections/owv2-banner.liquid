{% assign owid = section.id | replace: '-', '' | replace: '_', '' %}
{% style %}
.owv2-banner-{{ owid }} {
  box-sizing: border-box;
  --bg: {{ section.settings.background_color }};
  --ink: {{ section.settings.text_color }};
  --surface: {{ section.settings.card_background }};
  background: var(--bg);
  color: var(--ink);
  padding: {{ section.settings.padding_top }}px max(20px, 5vw) {{ section.settings.padding_bottom }}px;
  font-family: var(--font-body-family);
  font-size: 16px;
  line-height: 1.5;
  }
.owv2-banner-{{ owid }} *, .owv2-banner-{{ owid }} *::before, .owv2-banner-{{ owid }} *::after {
  box-sizing: border-box;
  }
.owv2-banner-{{ owid }} h1, .owv2-banner-{{ owid }} h2, .owv2-banner-{{ owid }} h3 {
  font-family: var(--font-heading-family);
  color: inherit;
  font-weight: 900;
  letter-spacing: -.035em;
  line-height: 1.05;
  text-transform: none;
  margin: 0;
  overflow-wrap: anywhere;
  }
.owv2-banner-{{ owid }} h2 {
  font-size: clamp(30px, 4vw, 58px);
  }
.owv2-banner-{{ owid }} h3 {
  font-size: 26px;
  }
.owv2-banner-{{ owid }} p {
  margin: 0 0 16px;
  }
.owv2-banner-{{ owid }} p:last-child {
  margin-bottom: 0;
  }
.owv2-banner-{{ owid }} a {
  color: inherit;
  }
.owv2-banner-{{ owid }} img, .owv2-banner-{{ owid }} svg {
  display: block;
  max-width: 100%;
  height: auto;
  }
.owv2-banner-{{ owid }} .inner {
  max-width: 1320px;
  margin-inline: auto;
  min-width: 0;
  }
.owv2-banner-{{ owid }} .intro {
  max-width: 760px;
  margin-bottom: 32px;
  }
.owv2-banner-{{ owid }} .intro > * + * {
  margin-top: 20px;
  }
.owv2-banner-{{ owid }} .eyebrow {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  }
.owv2-banner-{{ owid }} .owv2-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 12px 24px;
  border: 1px solid var(--ink);
  border-radius: 999px;
  background: var(--ink);
  color: var(--bg);
  font: 700 16px var(--font-body-family);
  text-decoration: none;
  text-align: center;
  cursor: pointer;
  }
.owv2-banner-{{ owid }} :focus-visible {
  outline: 3px solid currentColor;
  outline-offset: 4px;
  }
.owv2-banner-{{ owid }} .owv2-placeholder {
  width: 100%;
  height: 100%;
  min-height: 200px;
  background: var(--surface);
  fill: var(--ink);
  }
@media (prefers-reduced-motion: reduce) {
  .owv2-banner-{{ owid }} * {
  scroll-behavior: auto !important;
  scroll-snap-type: none !important;
  }
}
.owv2-banner-{{ owid }} {
  position:relative;
  display:grid;
  place-items:center;
  min-height:{{ section.settings.min_height }}px;
  text-align:center;
  }
.owv2-banner-{{ owid }} .background, .owv2-banner-{{ owid }} .shade {
  position:absolute;
  inset:0;
  }
.owv2-banner-{{ owid }} .background img, .owv2-banner-{{ owid }} .background svg {
  width:100%;
  height:100%;
  object-fit:cover;
  }
.owv2-banner-{{ owid }} .shade {
  display:block;
  background:{{ section.settings.overlay_color }};
  opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
.owv2-banner-{{ owid }} h2 {
  position:relative;
  max-width:1100px;
  }
.owv2-banner-{{ owid }} h2 a {
  text-decoration:none;
  }
@media(max-width:749px) {
  .owv2-banner-{{ owid }} {
  min-height:{{ section.settings.min_height_mobile }}px;
  }
}
{% endstyle %}
<div class="owv2-banner-{{ owid }}">
<div class="background">
{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '390, 750, 1100, 1500, 1800', sizes: '(min-width: 990px) 50vw, 100vw' }}{% else %}{{ 'lifestyle-1' | placeholder_svg_tag: 'owv2-placeholder' }}{% endif %}
</div>
<div class="shade ignore-empty">
</div>
<h2>
{% if section.settings.link != blank %}
<a href="{{ section.settings.link }}">
{% endif %}{{ section.settings.heading }}{% if section.settings.link != blank %}
</a>
{% endif %}
</h2>
</div>
{% schema %}
{
  "name": "OWV2 Photo banner",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Edit alternative text in the image picker for accessibility."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Drink like you give a damn"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Min height",
      "min": 200,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Min height mobile",
      "min": 160,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 240
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F1ECE2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "OWV2 Photo banner",
      "blocks": []
    }
  ]
}
{% endschema %}
