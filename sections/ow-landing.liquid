{%- comment -%}
  ow-landing — the Omawild landing page, imported 1-to-1 from
  omawild-landing(1).html.

  Each band of the page is a theme block in blocks/ow-*.liquid; this section is
  only the shell that loads the page's CSS and JS and renders whatever blocks
  the merchant has arranged. The old `case block.type` dispatch is gone.

  The move to theme blocks was made so the products band could own its cards as
  real children rather than scanning for siblings: ow-product-card is offered
  only inside ow-products, so cards cannot drift elsewhere in the section. A
  section may not mix theme blocks with locally defined ones, which is why every
  band moved at once.

  Behaviour lives in assets/ow-landing.js and expects these ids, so do not
  rename them: #regenTrack #regenPrev #regenNext #regenDesktop
  #productsTrack #productsTrackWrap #aboutCardsWrap

  Site chrome (announcement bars, navbar, footer, menu modal) is NOT here —
  it is in ow-announcement-bar / ow-header / ow-footer, rendered site-wide via
  the header and footer section groups.
{%- endcomment -%}

{{ 'ow-landing.css' | asset_url | stylesheet_tag }}

{% content_for 'blocks' %}

<script src="{{ 'ow-landing.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "OW Landing",
  "tag": "div",
  "class": "ow-landing",
  "settings": [],
  "blocks": [
    { "type": "ow-hero" },
    { "type": "ow-regen" },
    { "type": "ow-prop-scroller" },
    { "type": "ow-products" },
    { "type": "ow-partner" },
    { "type": "ow-about" },
    { "type": "ow-tagline" },
    { "type": "ow-why" }
  ],
  "presets": [
    {
      "name": "OW Landing",
      "blocks": [
        { "type": "ow-hero" },
        { "type": "ow-regen" },
        { "type": "ow-prop-scroller" },
        {
          "type": "ow-products",
          "blocks": [
            { "type": "ow-product-card" },
            { "type": "ow-product-card" },
            { "type": "ow-product-card" }
          ]
        },
        { "type": "ow-partner" },
        {
          "type": "ow-about",
          "blocks": [
            {
              "type": "ow-about-card",
              "settings": {
                "alt": "Bali expedition",
                "caption": "It started in 2023 with a one-way ticket to Bali. Forget \"Eat, Pray, Love\" — more Dig, Sweat, Build."
              }
            },
            {
              "type": "ow-about-card",
              "settings": {
                "alt": "Conservation work",
                "caption": "Into forests, reefs, and degraded land being brought back to life. One cup at a time."
              }
            },
            {
              "type": "ow-about-card",
              "settings": {
                "alt": "West Java farm",
                "caption": "Found a farm in West Java that grows the best coffee I've ever tasted — and runs on regenerative principles."
              }
            },
            {
              "type": "ow-about-card",
              "settings": {
                "alt": "Omawild launch",
                "caption": "Omawild is the business model conservation never had."
              }
            }
          ]
        },
        { "type": "ow-tagline" },
        { "type": "ow-why" }
      ]
    }
  ]
}
{% endschema %}
