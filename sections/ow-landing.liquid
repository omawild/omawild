{%- comment -%}
  ow-landing — the Omawild landing page, imported 1-to-1 from
  omawild-landing(1).html.

  One block per band. Layout, decorative SVG and carousel scaffolding stay in
  the markup; headlines, body copy, images and links are settings. Phase 2
  splits these blocks into finer components — the markup here is deliberately
  kept in the same shape as the source HTML so that diff stays readable.

  Behaviour lives in assets/ow-landing.js and expects these ids, so do not
  rename them: #regenTrack #regenPrev #regenNext #regenDesktop
  #productsTrack #productsTrackWrap #aboutCardsWrap

  Site chrome (announcement bars, navbar, footer, menu modal) is NOT here —
  it is in ow-announcement-bar / ow-header / ow-footer, rendered site-wide via
  the header and footer section groups.
{%- endcomment -%}

{{ 'ow-landing.css' | asset_url | stylesheet_tag }}

{%- for block in section.blocks -%}
  {%- case block.type -%}

  {%- when 'hero' -%}
    <section class="hero" id="hero" {{ block.shopify_attributes }}>
      <div class="hero-left">
        <div class="hero-logo">
          <img src="{{ 'ow-hero-logo.svg' | asset_url }}" alt="{{ block.settings.logo_alt | escape }}" width="480" height="80">
        </div>
        <div class="hero-headline-wrap">
          <img class="hero-headline-svg" src="{{ 'ow-hero-headline.svg' | asset_url }}" alt="{{ block.settings.headline_alt | escape }}" width="461" height="162">
        </div>
        <div class="hero-submark">
          <img src="{{ 'ow-hero-submark.svg' | asset_url }}" alt="{{ block.settings.submark_alt | escape }}" width="41" height="41">
        </div>
        <p class="hero-tagline">{{ block.settings.tagline }}</p>
      </div>
      <div class="hero-right">
        {%- if block.settings.image -%}
          {{ block.settings.image | image_url: width: 1200 | image_tag: alt: block.settings.image_alt }}
        {%- else -%}
          <img src="{{ 'ow-product-card-placeholder.jpg' | asset_url }}" alt="{{ block.settings.image_alt | escape }}" width="464" height="650">
        {%- endif -%}
      </div>
    </section>

  {%- when 'regen' -%}
    {%- comment -%}
      The six annotation texts drive BOTH the mobile swipe cards and the desktop
      gutter annotations — same copy, different presentation per breakpoint.
      Desktop splits them 1,2,3 left and 4,5,6 right. The data-delay values are
      the staggered reveal timings from the design and are intentionally fixed.
    {%- endcomment -%}
    <section class="regen" id="regenSection" {{ block.shopify_attributes }}>
      <div class="regen-inner">
        <h2 class="regen-headline fade-up h2">{{ block.settings.headline }}</h2>
        <div class="regen-ctas fade-up">
          <a href="{{ block.settings.cta_link | default: '#' }}" class="btn-primary">{{ block.settings.cta_text }}</a>
          <button class="text-link">{{ block.settings.link_text }}</button>
        </div>
      </div>

      <!-- Mobile: swipeable annotation cards -->
      <div class="regen-cards-mobile">
        <div class="regen-cards-track" id="regenTrack">
          {%- for i in (1..6) -%}
            {%- assign key = 'ann_' | append: i -%}
            <div class="regen-card">
              <div class="regen-card-num">0{{ i }}</div>
              <div class="regen-card-text">{{ block.settings[key] }}</div>
            </div>
          {%- endfor -%}
        </div>
      </div>
      <div class="regen-nav">
        <button id="regenPrev" aria-label="Previous"><img src="{{ 'ow-arrow-left.svg' | asset_url }}" alt="←" width="24" height="24"></button>
        <button id="regenNext" aria-label="Next"><img src="{{ 'ow-arrow-right.svg' | asset_url }}" alt="→" width="24" height="24"></button>
      </div>

      <!-- Mobile illustration with numbered dots -->
      <div class="regen-illustration">
        {%- if block.settings.illustration -%}
          {{ block.settings.illustration | image_url: width: 1200 | image_tag: class: 'illus', alt: block.settings.illustration_alt }}
        {%- endif -%}
        <div class="regen-dot" style="left:13%;top:28%">1</div>
        <div class="regen-dot" style="left:10%;top:62%">2</div>
        <div class="regen-dot" style="left:29%;top:48%">3</div>
        <div class="regen-dot" style="left:62%;top:40%">4</div>
        <div class="regen-dot" style="left:72%;top:60%">5</div>
        <div class="regen-dot" style="left:90%;top:50%">6</div>
      </div>

      <!-- Desktop: gutter annotations flanking illustration -->
      <div class="regen-desktop" id="regenDesktop">
        <div class="regen-ann-col regen-ann-col--left">
          {%- assign left_delays = '0,160,320' | split: ',' -%}
          {%- for i in (1..3) -%}
            {%- assign key = 'ann_' | append: i -%}
            {%- assign d = forloop.index0 -%}
            <div class="regen-ann" data-delay="{{ left_delays[d] }}">
              <div class="regen-ann-text">{{ block.settings[key] }}</div>
              <div class="regen-ann-tick"></div>
            </div>
          {%- endfor -%}
        </div>
        <div class="regen-desktop-illus">
          {%- if block.settings.illustration -%}
            {{ block.settings.illustration | image_url: width: 1600 | image_tag: alt: block.settings.illustration_alt }}
          {%- endif -%}
        </div>
        <div class="regen-ann-col regen-ann-col--right">
          {%- assign right_delays = '80,240,400' | split: ',' -%}
          {%- for i in (4..6) -%}
            {%- assign key = 'ann_' | append: i -%}
            {%- assign d = forloop.index0 -%}
            <div class="regen-ann" data-delay="{{ right_delays[d] }}">
              <div class="regen-ann-text">{{ block.settings[key] }}</div>
              <div class="regen-ann-tick"></div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>

  {%- when 'prop_scroller' -%}
    {%- comment -%}
      Items are duplicated inline so the CSS marquee loops seamlessly — the
      keyframe translates -50%, which only lines up if the track holds exactly
      two copies of the list.
    {%- endcomment -%}
    {%- assign props = block.settings.items | split: ',' -%}
    <div class="prop-scroller" aria-hidden="true" {{ block.shopify_attributes }}>
      <div class="prop-scroller-inner">
        {%- for pass in (1..2) -%}
          {%- for p in props -%}
            <span>{{ p | strip }}</span><span>✷</span>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>

  {%- when 'products' -%}
    <section class="products" {{ block.shopify_attributes }}>
      <h2 class="fade-up h2">{{ block.settings.heading }}</h2>
      <p class="products-subhead paragraph fade-up">{{ block.settings.subhead }}</p>

      <div class="products-carousel">
      <div class="products-track-wrap" id="productsTrackWrap" tabindex="0" role="region" aria-label="Product carousel — swipe or use arrow keys to browse">
        <div class="products-track" id="productsTrack">
          {%- for i in (1..3) -%}
            {%- assign name_key  = 'p' | append: i | append: '_name' -%}
            {%- assign tag_key   = 'p' | append: i | append: '_tag' -%}
            {%- assign desc_key  = 'p' | append: i | append: '_desc' -%}
            {%- assign price_key = 'p' | append: i | append: '_price' -%}
            {%- assign grade_key = 'p' | append: i | append: '_grade' -%}
            {%- assign opts_key  = 'p' | append: i | append: '_options' -%}
            {%- assign img_key   = 'p' | append: i | append: '_image' -%}
            {%- assign prod_key  = 'p' | append: i | append: '_product' -%}
            {%- assign prod = block.settings[prod_key] -%}
            {%- comment -%}
              A card is either backed by a real Shopify product or by static copy.

              When a product is linked, the product record is authoritative and
              nothing needs retyping — title, price, description, image and
              variants all come from it. The text settings are only consulted as
              a fallback for cards with no product, which is what keeps the
              original static design renderable.

              `default:` cannot express this. The settings ship with the design's
              copy pre-filled, so they are never blank and would always win.
              Precedence has to be stated explicitly, product first.

              Two fields have no native product equivalent, so they fall back to
              settings even when a product is linked:
                - flavour tag  -> product type, else the first product tag
                - grade tag    -> a product tag beginning "GRADE", else setting
            {%- endcomment -%}
            {%- if prod != blank -%}
              {%- assign p_name = prod.title -%}
              {%- comment -%}
                Product descriptions are rich text and unbounded, while the card
                has no line clamp (.product-desc is flex:1) — a long one simply
                makes that card taller than the two beside it and breaks the row.
                The design's copy runs ~28 words, so 45 is generous headroom
                while still keeping the row even.
              {%- endcomment -%}
              {%- assign p_desc = prod.description | strip_html | strip | truncatewords: 45 -%}
              {%- if p_desc == blank -%}
                {%- assign p_desc = block.settings[desc_key] -%}
              {%- endif -%}

              {%- assign p_tag = prod.type -%}
              {%- if p_tag == blank -%}
                {%- comment -%}
                  Skip GRADE tags here — they are claimed by the grade badge
                  below, and taking tags.first blindly would print the same
                  string in both places.
                {%- endcomment -%}
                {%- for t in prod.tags -%}
                  {%- assign t_up = t | upcase -%}
                  {%- unless t_up contains 'GRADE' -%}
                    {%- assign p_tag = t -%}
                    {%- break -%}
                  {%- endunless -%}
                {%- endfor -%}
              {%- endif -%}
              {%- if p_tag == blank -%}
                {%- assign p_tag = block.settings[tag_key] -%}
              {%- endif -%}

              {%- assign p_grade = '' -%}
              {%- for t in prod.tags -%}
                {%- assign t_up = t | upcase -%}
                {%- if t_up contains 'GRADE' -%}
                  {%- assign p_grade = t -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if p_grade == blank -%}
                {%- assign p_grade = block.settings[grade_key] -%}
              {%- endif -%}
            {%- else -%}
              {%- assign p_name  = block.settings[name_key] -%}
              {%- assign p_desc  = block.settings[desc_key] -%}
              {%- assign p_tag   = block.settings[tag_key] -%}
              {%- assign p_grade = block.settings[grade_key] -%}
            {%- endif -%}
            {%- if p_name != blank -%}
              <div class="product-card">
                <div class="product-card-img-wrap" style="position:relative">
                  <div class="grade-tag">{{ p_grade }}</div>
                  <div class="product-card-img">
                    {%- if block.settings[img_key] -%}
                      {{ block.settings[img_key] | image_url: width: 600 | image_tag: alt: p_name }}
                    {%- elsif prod != blank and prod.featured_image -%}
                      {{ prod.featured_image | image_url: width: 600 | image_tag: alt: p_name }}
                    {%- else -%}
                      <img src="{{ 'ow-product-card-placeholder.jpg' | asset_url }}" alt="{{ p_name | escape }}" width="464" height="650">
                    {%- endif -%}
                  </div>
                </div>
                <div class="product-card-body">
                  <span class="product-tag">{{ p_tag }}</span>
                  <div class="product-name">{{ p_name }}</div>
                  <p class="product-desc paragraph">{{ p_desc }}</p>
                  {%- if prod != blank -%}
                    {%- comment -%}
                      prod.price is the lowest variant price. On a product whose
                      variants differ in price that reads as a flat price, so
                      say "From" instead of quietly understating it.
                    {%- endcomment -%}
                    {%- comment -%}
                      Format the money value first. `t: price: prod.price | money`
                      would apply money to the translated string rather than to
                      the price — the same argument-parsing trap as the form tag
                      above.
                    {%- endcomment -%}
                    {%- assign price_str = prod.price | money -%}
                    <p class="product-price">
                      {%- if prod.price_varies -%}
                        {{ 'products.product.price.from_price_html' | t: price: price_str }}
                      {%- else -%}
                        {{ price_str }}
                      {%- endif -%}
                    </p>
                    {%- comment -%}
                      A plain {% form 'product' %} posts to /cart/add and lands
                      on the cart page. Be Yours' <product-form> custom element
                      is deliberately not used here: it drives the cart drawer,
                      which lives in the vendor header we replaced. The native
                      post is the same fallback product-form.js itself uses when
                      no drawer is present.
                    {%- endcomment -%}
                    {%- comment -%}
                      Build the id first — a filter inside the tag's argument
                      list is not scoped to that argument, and Liquid ends up
                      reading the filtered value as a positional argument.
                    {%- endcomment -%}
                    {%- assign product_form_id = 'ow-product-form-' | append: i -%}
                    {%- form 'product', prod, id: product_form_id, class: 'product-card-form' -%}
                      {%- comment -%}
                        A single-variant product has one variant literally titled
                        "Default Title". Rendering the dropdown regardless would
                        show that string as if it were a size option, so the
                        selector is only drawn when there is a real choice to
                        make; otherwise the variant id goes in a hidden input so
                        the form still posts.
                      {%- endcomment -%}
                      {%- if prod.has_only_default_variant -%}
                        <input type="hidden" name="id" value="{{ prod.selected_or_first_available_variant.id }}">
                      {%- else -%}
                        <select class="product-dropdown" name="id" aria-label="{{ p_name | escape }} options">
                          {%- for variant in prod.variants -%}
                            <option value="{{ variant.id }}"
                                    {% if variant == prod.selected_or_first_available_variant %}selected{% endif %}
                                    {% unless variant.available %}disabled{% endunless %}>
                              {{ variant.title }}
                            </option>
                          {%- endfor -%}
                        </select>
                      {%- endif -%}
                      <button class="product-atc" type="submit" {% unless prod.available %}disabled{% endunless %}>
                        {%- if prod.available -%}{{ block.settings.atc_label }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                      </button>
                    {%- endform -%}
                  {%- else -%}
                    <p class="product-price">{{ block.settings[price_key] }}</p>
                    {%- comment -%}
                      No product linked, so this card is static copy and the
                      button has nothing to add. Link a product in the theme
                      editor to make it live.
                    {%- endcomment -%}
                    <select class="product-dropdown" aria-label="{{ p_name | escape }} options">
                      {%- assign opts = block.settings[opts_key] | split: ',' -%}
                      {%- for o in opts -%}
                        <option>{{ o | strip }}</option>
                      {%- endfor -%}
                    </select>
                    <button class="product-atc" type="button" disabled aria-disabled="true">{{ block.settings.atc_label }}</button>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      <div class="scroll-fade scroll-fade-left hide" aria-hidden="true"></div>
      <div class="scroll-fade scroll-fade-right" aria-hidden="true"></div>
      </div>
    </section>

  {%- when 'partner' -%}
    <section class="partner" {{ block.shopify_attributes }}>
      <div class="partner-inner fade-up">
        <h3 class="h3">{{ block.settings.heading }}</h3>
        <a href="{{ block.settings.cta_link | default: '#' }}" class="btn-outline">{{ block.settings.cta_text }}</a>
      </div>
    </section>

  {%- when 'about' -%}
    <section class="about" {{ block.shopify_attributes }}>
      <div class="about-story">
        <h3 class="fade-up h3">{{ block.settings.heading }}</h3>
        <p class="fade-up paragraph">{{ block.settings.body }}</p>
        <a href="{{ block.settings.cta_link | default: '#' }}" class="btn-outline fade-up">{{ block.settings.cta_text }}</a>
      </div>
      <div class="about-cards-carousel">
      <div class="about-cards-wrap" id="aboutCardsWrap" tabindex="0" role="region" aria-label="About carousel — swipe or use arrow keys to browse">
        <div class="about-cards-track">
          {%- for i in (1..4) -%}
            {%- assign cap_key = 'c' | append: i | append: '_caption' -%}
            {%- assign alt_key = 'c' | append: i | append: '_alt' -%}
            {%- assign img_key = 'c' | append: i | append: '_image' -%}
            {%- assign caption = block.settings[cap_key] -%}
            {%- if caption != blank -%}
              <div class="about-card">
                <div class="about-card-img">
                  {%- if block.settings[img_key] -%}
                    {{ block.settings[img_key] | image_url: width: 800 | image_tag: alt: block.settings[alt_key] }}
                  {%- else -%}
                    <img src="{{ 'ow-about-card-placeholder.jpg' | asset_url }}" alt="{{ block.settings[alt_key] | escape }}" width="1024" height="768">
                  {%- endif -%}
                </div>
                <div class="about-card-caption">{{ caption }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      <div class="scroll-fade scroll-fade-left hide" aria-hidden="true"></div>
      <div class="scroll-fade scroll-fade-right" aria-hidden="true"></div>
      </div>
    </section>

  {%- when 'tagline' -%}
    <section class="tagline" {{ block.shopify_attributes }}>
      {%- if block.settings.image -%}
        {{ block.settings.image | image_url: width: 1600 | image_tag: class: 'tagline-img', alt: '' }}
      {%- else -%}
        <img class="tagline-img" src="{{ 'ow-tagline.jpg' | asset_url }}" alt="" width="1600" height="670">
      {%- endif -%}
      <div class="tagline-overlay">
        <h2>{{ block.settings.heading }}</h2>
      </div>
    </section>

  {%- when 'why' -%}
    <section class="why" {{ block.shopify_attributes }}>
      <div class="why-inner fade-up">
        {%- comment -%}
          The line break carries class="br-desktop" — it only applies above the
          desktop breakpoint, so the heading is two settings rather than one.
        {%- endcomment -%}
        <h3 class="h3">{{ block.settings.heading_line1 }}<br class="br-desktop"> {{ block.settings.heading_line2 }}</h3>
        <p class="why-intro paragraph">{{ block.settings.intro }}</p>
        <div class="why-cols">
          <div class="why-col">
            <div class="why-col-icon" role="img" aria-label="{{ block.settings.col1_title | escape }}">
              <img src="{{ 'ow-why-icon-regen.svg' | asset_url }}" alt="" width="60" height="60">
            </div>
            <h3 class="why-col-title">{{ block.settings.col1_title }}</h3>
            <p>{{ block.settings.col1_body }}</p>
          </div>
          <div class="why-col">
            <div class="why-col-icon">
              <img src="{{ 'ow-badge-1ftp.png' | asset_url }}" alt="{{ block.settings.col2_title | escape }}" width="376" height="160" style="height:52px;width:auto;">
            </div>
            <h3 class="why-col-title">{{ block.settings.col2_title }}</h3>
            <p>{{ block.settings.col2_body }}</p>
          </div>
          <div class="why-col">
            <div class="why-col-icon">
              <img src="{{ 'ow-badge-recyclable.png' | asset_url }}" alt="{{ block.settings.col3_title | escape }}" width="160" height="160" style="height:48px;width:auto;">
            </div>
            <h3 class="why-col-title">{{ block.settings.col3_title }}</h3>
            <p>{{ block.settings.col3_body }}</p>
          </div>
        </div>
      </div>
    </section>

  {%- endcase -%}
{%- endfor -%}

<script src="{{ 'ow-landing.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "OW Landing",
  "tag": "div",
  "class": "ow-landing",
  "settings": [],
  "blocks": [
    {
      "type": "hero",
      "name": "Hero",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "The logo, headline and submark are fixed SVG artwork from the design. Only their alt text is editable here." },
        { "type": "text", "id": "logo_alt", "label": "Logo alt text", "default": "Omawild" },
        { "type": "text", "id": "headline_alt", "label": "Headline alt text", "default": "Welcome to the Expedition" },
        { "type": "text", "id": "submark_alt", "label": "Submark alt text", "default": "Drink for Planet Earth" },
        { "type": "text", "id": "tagline", "label": "Tagline", "default": "Coffee's just the bait to reel you in" },
        { "type": "image_picker", "id": "image", "label": "Hero image" },
        { "type": "text", "id": "image_alt", "label": "Hero image alt text", "default": "Omawild product" }
      ]
    },
    {
      "type": "regen",
      "name": "Regenerative",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "headline", "label": "Headline", "default": "The most powerful climate solution is in what you eat and drink" },
        { "type": "text", "id": "cta_text", "label": "Button text", "default": "Drink for Planet Earth" },
        { "type": "url", "id": "cta_link", "label": "Button link" },
        { "type": "text", "id": "link_text", "label": "Secondary link text", "default": "Or learn about regen" },
        { "type": "image_picker", "id": "illustration", "label": "Farm illustration" },
        { "type": "text", "id": "illustration_alt", "label": "Illustration alt text", "default": "Regenerative farm ecosystem — Garut, West Java" },
        { "type": "header", "content": "Annotations" },
        { "type": "paragraph", "content": "These six texts appear as swipeable cards on mobile and as gutter annotations on desktop (1–3 left, 4–6 right)." },
        { "type": "text", "id": "ann_1", "label": "Annotation 1", "default": "Tree canopies cool soil temperature by up to 10°C and create vital wildlife habitats" },
        { "type": "text", "id": "ann_2", "label": "Annotation 2", "default": "Deep roots act like underground anchors, preventing landslides and soil erosion" },
        { "type": "text", "id": "ann_3", "label": "Annotation 3", "default": "Crop diversification increases soil microbial activity and nutrient availability" },
        { "type": "text", "id": "ann_4", "label": "Annotation 4", "default": "Healthy soil sequesters 3x more carbon than the atmosphere" },
        { "type": "text", "id": "ann_5", "label": "Annotation 5", "default": "One hectare of living soil holds up to 50,000 litres of water" },
        { "type": "text", "id": "ann_6", "label": "Annotation 6", "default": "Roots, rocks, and rivers: the oldest water filtration technology" }
      ]
    },
    {
      "type": "prop_scroller",
      "name": "Proposition scroller",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "items", "label": "Items (comma separated)", "default": "REGENERATIVE INGREDIENTS, 1% FOR THE PLANET, 100% RECYCLABLE PACKAGING, DIRECT FARM RELATIONSHIPS" }
      ]
    },
    {
      "type": "products",
      "name": "Products",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Drink for Planet Earth" },
        { "type": "textarea", "id": "subhead", "label": "Subheading", "default": "Clean caffeine without the damn jitters so you can feel great while doing the work of protecting the places that inspire your next adventure." },
        { "type": "text", "id": "atc_label", "label": "Button label", "default": "Add to Cart" },
        { "type": "paragraph", "content": "Link a product and the card fills itself in — title, description, price, image, variants and a working Add to Cart all come from Shopify, nothing to retype. The text fields below are only used for cards with no linked product. Flavour tag falls back to product type or first tag; grade tag to a product tag containing GRADE." },
        { "type": "header", "content": "Card 1" },
        { "type": "text", "id": "p1_name", "label": "Name (no-product fallback)", "default": "Wild Bloom" },
        { "type": "text", "id": "p1_grade", "label": "Grade tag (no-product fallback)", "default": "GRADE 1" },
        { "type": "text", "id": "p1_tag", "label": "Flavour tag (no-product fallback)", "default": "FRUITY & FLORAL" },
