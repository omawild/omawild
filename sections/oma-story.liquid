{% assign owid = section.id | replace: '-', '' | replace: '_', '' %}
{% style %}
.oma-story-{{ owid }} {
  box-sizing: border-box;
  --bg: {{ section.settings.background_color }};
  --ink: {{ section.settings.text_color }};
  --surface: {{ section.settings.card_background }};
  --card-border: {{ section.settings.card_border_color }};
  background: var(--bg);
  color: var(--ink);
  padding: {{ section.settings.padding_top }}px clamp(20px, 4vw, 48px) {{ section.settings.padding_bottom }}px;
  font-family: var(--font-body-family);
  font-size: 16px;
  line-height: 1.5;
  }
.oma-story-{{ owid }} *, .oma-story-{{ owid }} *::before, .oma-story-{{ owid }} *::after {
  box-sizing: border-box;
  }
.oma-story-{{ owid }} h1, .oma-story-{{ owid }} h2, .oma-story-{{ owid }} h3 {
  font-family: var(--font-heading-family);
  color: inherit;
  font-weight: 900;
  letter-spacing: -.035em;
  line-height: 1.05;
  text-transform: none;
  margin: 0;
  overflow-wrap: anywhere;
  }
.oma-story-{{ owid }} h2 {
  font-size: clamp(30px, 4vw, 58px);
  }
.oma-story-{{ owid }} h3 {
  font-size: 26px;
  }
.oma-story-{{ owid }} p {
  margin: 0 0 16px;
  }
.oma-story-{{ owid }} p:last-child {
  margin-bottom: 0;
  }
.oma-story-{{ owid }} a {
  color: inherit;
  }
.oma-story-{{ owid }} img, .oma-story-{{ owid }} svg {
  display: block;
  max-width: 100%;
  height: auto;
  }
.oma-story-{{ owid }} .inner {
  max-width: 1344px;
  margin-inline: auto;
  min-width: 0;
  }
.oma-story-{{ owid }} .story-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 20px;
  }
.oma-story-{{ owid }} .intro {
  max-width: 760px;
  margin-bottom: 0;
  }
.oma-story-{{ owid }} .intro .eyebrow {
  margin: 0;
  }
.oma-story-{{ owid }} .intro h2 {
  margin-top: 14px;
  }
.oma-story-{{ owid }} .intro > div {
  margin-top: 10px;
  }
{%- comment -%}
  Eyebrow/subcopy are each optional now — when the eyebrow is hidden, the
  heading becomes .intro's first child and its margin-top (meant to clear
  the eyebrow above it) needs to be 0, at both breakpoints, or it just reads
  as stray top padding on the section.
{%- endcomment -%}
.oma-story-{{ owid }} .intro.no-eyebrow h2 {
  margin-top: 0;
  }
@media (min-width:750px) {
  .oma-story-{{ owid }} .story-head {
  margin-bottom: 26px;
  }
  .oma-story-{{ owid }} .intro h2 {
  margin-top: 16px;
  }
  .oma-story-{{ owid }} .intro > div {
  margin-top: 12px;
  }
}
.oma-story-{{ owid }} .eyebrow {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  }
{%- comment -%}
  Prev/next buttons: merchant-toggled (default off, matching the Home page
  instance's existing look) for pages like About where the row's own edge
  fade isn't a strong enough hint that it scrolls. Disabled state (dimmed,
  native :disabled — see oma-story.js) is what actually communicates "no
  more that way", same information the scroll-fade already gives, just
  legible without a hover/drag gesture first.
{%- endcomment -%}
.oma-story-{{ owid }} .story-nav {
  display: flex;
  gap: 12px;
  flex-shrink: 0;
  padding-top: 4px;
  }
.oma-story-{{ owid }} .story-nav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  padding: 0;
  border-radius: 999px;
  border: 1.5px solid var(--ink);
  background: transparent;
  color: var(--ink);
  cursor: pointer;
  transition: background-color .2s ease, color .2s ease, opacity .2s ease;
  }
.oma-story-{{ owid }} .story-nav-btn svg {
  width: 16px;
  height: 16px;
  }
@media (hover:hover) {
  .oma-story-{{ owid }} .story-nav-btn:hover:not(:disabled) {
  background: var(--ink);
  color: var(--bg);
  }
}
.oma-story-{{ owid }} .story-nav-btn:disabled {
  opacity: .35;
  cursor: default;
  }
.oma-story-{{ owid }} .oma-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 10px 20px;
  border: 1px solid var(--ink);
  border-radius: 999px;
  background: var(--ink);
  color: var(--bg);
  font: 700 15px var(--font-body-family);
  text-decoration: none;
  text-align: center;
  cursor: pointer;
  }
.oma-story-{{ owid }} :focus-visible {
  outline: 3px solid currentColor;
  outline-offset: 4px;
  }
.oma-story-{{ owid }} .oma-placeholder {
  width: 100%;
  height: 100%;
  min-height: 200px;
  background: var(--surface);
  fill: var(--ink);
  }
@media (prefers-reduced-motion: reduce) {
  .oma-story-{{ owid }} * {
  scroll-behavior: auto !important;
  scroll-snap-type: none !important;
  }
}
.oma-story-{{ owid }} .gallery-wrap {
  position:relative;
  }
/* Always one row, always potentially scrollable: card width is fixed per
   breakpoint below (2-up mobile, 3-up tablet, 4-up desktop), and the row
   only actually scrolls when there are more cards than fit -- a merchant
   adding extra photos stays reachable by swipe/drag instead of being
   dropped, rather than wrapping to a second row. */
.oma-story-{{ owid }} .gallery {
  display:flex;
  flex-wrap:nowrap;
  gap:14px;
  padding:6px 0 16px;
  margin:0;
  overflow-x:auto;
  overflow-y:hidden;
  scroll-snap-type:x mandatory;
  -webkit-overflow-scrolling:touch;
  scrollbar-width:none;
  cursor:grab;
  }
.oma-story-{{ owid }} .gallery::-webkit-scrollbar {
  display:none;
  }
.oma-story-{{ owid }} .gallery.dragging {
  cursor:grabbing;
  user-select:none;
  }
.oma-story-{{ owid }} .gallery::after {
  content:"";
  flex:0 0 6px;
  }
@media (min-width:750px) {
  .oma-story-{{ owid }} .gallery {
  gap:24px;
  }
}
.oma-story-{{ owid }} figure, .oma-story-{{ owid }} .teaser {
  {%- comment -%}
    Flat percentages that don't divide the row evenly -- same trick as
    od-featured-products' card sizing -- so the last visible card is always
    partly cut off by the container edge. That partial card is what actually
    tells a viewer the row scrolls; a row that lands on an exact card count
    looks like the whole gallery, edge fade or not.
  {%- endcomment -%}
  flex:0 0 44%;
  min-width:0;
  margin:0;
  padding:9px 9px 12px;
  background:var(--surface);
  border:2px solid var(--card-border);
  box-shadow:4px 4px 0 var(--card-border);
  scroll-snap-align:start;
  display:flex;
  flex-direction:column;
  text-decoration:none;
  color:inherit;
  }
@media (min-width:750px) {
  .oma-story-{{ owid }} figure, .oma-story-{{ owid }} .teaser {
  /* tablet: ~3 cards in view, a peek of the next one */
  flex-basis:30%;
  padding:12px 12px 16px;
  box-shadow:5px 5px 0 var(--card-border);
  }
}
@media (min-width:990px) {
  .oma-story-{{ owid }} figure, .oma-story-{{ owid }} .teaser {
  /* desktop: ~4 cards in view, a peek of the next one */
  flex-basis:22%;
  }
}
/* Keep the image from claiming the figure's full height (the placeholder rule
   sets height:100%, which pushes the caption outside the card); let it size
   from its aspect ratio so the caption sits inside the card. 1:1, per the
   design file -- not a taller portrait crop, which read as too long/narrow. */
.oma-story-{{ owid }} figure img, .oma-story-{{ owid }} figure svg, .oma-story-{{ owid }} figure .oma-placeholder,
.oma-story-{{ owid }} .teaser-media img {
  width:100%;
  aspect-ratio:1/1;
  object-fit:cover;
  height:auto;
  min-height:0;
  }
/* Body copy is always Midnight, never the section's accent --ink (which
   defaults to Electric red, meant for headings/eyebrow) -- and a tighter
   1.32 line-height than the section's base 1.5, without going so tight it
   crowds a two-line caption. Matches the design file at both breakpoints. */
.oma-story-{{ owid }} figcaption, .oma-story-{{ owid }} .teaser figcaption {
  margin-top:10px;
  padding:0 4px 2px;
  text-align:center;
  font-size:11px;
  line-height:1.32;
  color:#00180C;
  }
@media (min-width:750px) {
  .oma-story-{{ owid }} figcaption, .oma-story-{{ owid }} .teaser figcaption {
  margin-top:13px;
  font-size:12.5px;
  }
}
/* Teaser card: a real photo (dimmed), with its own heading + button
   permanently overlaid -- not a hover reveal, matching the design file,
   which shows this treatment at rest with no separate interaction state. */
.oma-story-{{ owid }} .teaser-media {
  position:relative;
  }
.oma-story-{{ owid }} .teaser-media img, .oma-story-{{ owid }} .teaser-media .oma-placeholder {
  opacity:.15;
  }
.oma-story-{{ owid }} .teaser-overlay {
  position:absolute;
  inset:0;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:12px;
  text-align:center;
  padding:12px;
  }
.oma-story-{{ owid }} .teaser-heading {
  font-family:var(--font-heading-family);
  font-weight:800;
  font-size:15px;
  line-height:1.2;
  letter-spacing:-.02em;
  color:var(--ink);
  max-width:14ch;
  }
.oma-story-{{ owid }} .teaser-button {
  display:inline-flex;
  align-items:center;
  justify-content:center;
  background:var(--ink);
  color:var(--bg);
  padding:10px 13px;
  border-radius:999px;
  font-weight:800;
  font-size:10px;
  white-space:nowrap;
  }
@media (min-width:750px) {
  .oma-story-{{ owid }} .teaser-overlay {
  gap:18px;
  padding:20px;
  }
  .oma-story-{{ owid }} .teaser-heading {
  font-size:19px;
  }
  .oma-story-{{ owid }} .teaser-button {
  padding:11px 16px;
  font-size:11px;
  }
}
.oma-story-{{ owid }} .scroll-fade {
  position:absolute;
  top:0;
  bottom:16px;
  width:56px;
  pointer-events:none;
  transition:opacity .2s ease;
  }
.oma-story-{{ owid }} .scroll-fade-left {
  left:0;
  background:linear-gradient(to right, var(--bg), rgba(0,0,0,0));
  }
.oma-story-{{ owid }} .scroll-fade-right {
  right:0;
  background:linear-gradient(to left, var(--bg), rgba(0,0,0,0));
  }
.oma-story-{{ owid }} .scroll-fade.hide {
  opacity:0;
  }
{% endstyle %}
<div class="oma-story-{{ owid }} oma-story">
<div class="inner">
<div class="story-head">
<div class="intro{% unless section.settings.show_eyebrow %} no-eyebrow{% endunless %}">
{%- if section.settings.show_eyebrow -%}
<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
{%- endif -%}
<h2>{{ section.settings.heading }}</h2>
{%- if section.settings.show_subcopy -%}
<div>{{ section.settings.subcopy }}</div>
{%- endif -%}
</div>
{%- if section.settings.show_nav_buttons -%}
<div class="story-nav" role="group" aria-label="Scroll {{ section.settings.heading | strip_html | escape }} gallery">
<button type="button" class="story-nav-btn story-nav-prev" aria-label="Previous photos">
<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5 8 12l7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button>
<button type="button" class="story-nav-btn story-nav-next" aria-label="Next photos">
<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button>
</div>
{%- endif -%}
</div>
<div class="gallery-wrap is-scroll">
<div class="gallery">
{% for block in section.blocks %}
<figure {{ block.shopify_attributes }}>
{% if block.settings.link != blank %}
<a href="{{ block.settings.link }}">
{% endif %}
{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '390, 750, 1100, 1500, 1800', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw' }}{% else %}{{ 'lifestyle-1' | placeholder_svg_tag: 'oma-placeholder' }}{% endif %}
<figcaption>{{ block.settings.caption | escape }}</figcaption>
{% if block.settings.link != blank %}
</a>
{% endif %}
</figure>
{% endfor %}
{% if section.settings.show_teaser_card and section.settings.teaser_text != blank %}
{%- comment -%}
  The always-last card: a real, deliberately dimmed photo with its heading
  and button overlaid at rest -- see the CSS comment above teaser-media.
  Falls back to a plain div when no link is set, same tag-switch pattern
  used for the photo blocks above, so an empty href never renders.
{%- endcomment -%}
{% assign teaser_tag = 'div' %}
{% if section.settings.teaser_link != blank %}{% assign teaser_tag = 'a' %}{% endif %}
<{{ teaser_tag }} class="teaser" {% if teaser_tag == 'a' %}href="{{ section.settings.teaser_link }}"{% endif %}>
<div class="teaser-media">
{% if section.settings.teaser_image != blank %}{{ section.settings.teaser_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '390, 750, 1100, 1500, 1800', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw', alt: '' }}{% else %}{{ 'lifestyle-1' | placeholder_svg_tag: 'oma-placeholder' }}{% endif %}
<div class="teaser-overlay">
<div class="teaser-heading">{{ section.settings.teaser_text | escape }}</div>
{% if section.settings.teaser_button_label != blank %}<span class="teaser-button">{{ section.settings.teaser_button_label | escape }}</span>{% endif %}
</div>
</div>
{% if section.settings.teaser_caption != blank %}<figcaption>{{ section.settings.teaser_caption | escape }}</figcaption>{% endif %}
</{{ teaser_tag }}>
{% endif %}
</div>
<div class="scroll-fade scroll-fade-left hide" aria-hidden="true"></div>
<div class="scroll-fade scroll-fade-right hide" aria-hidden="true"></div>
</div>
</div>
</div>
<script src="{{ 'oma-story.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "OMA Story",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "label": "Show eyebrow",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "HOW WE GOT HERE"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "We plunged our entire life savings into conservation work, until then went broke"
    },
    {
      "type": "checkbox",
      "id": "show_subcopy",
      "label": "Show subcopy",
      "default": true
    },
    {
      "type": "richtext",
      "id": "subcopy",
      "label": "Subcopy",
      "default": "<p>Which is how we learned nature needed a better business model.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_nav_buttons",
      "label": "Show prev/next buttons",
      "default": false,
      "info": "Circular arrow buttons next to the heading, for pages where it isn't obvious the row scrolls -- e.g. the About page. Off by default to match this section's existing look on the Home page."
    },
    {
      "type": "header",
      "content": "Teaser card",
      "info": "The always-last card in the row, on every breakpoint. Blank teaser text, or the toggle below, hides it entirely."
    },
    {
      "type": "checkbox",
      "id": "show_teaser_card",
      "label": "Show teaser card",
      "default": true,
      "info": "Turn off for a page that already tells the full story -- e.g. the About page, where a \"read more\" card doesn't make sense."
    },
    {
      "type": "image_picker",
      "id": "teaser_image",
      "label": "Image",
      "info": "Shown dimmed behind the heading and button, same treatment as the other cards' photos."
    },
    {
      "type": "text",
      "id": "teaser_text",
      "label": "Heading",
      "default": "Follow us down our rabbit hole"
    },
    {
      "type": "text",
      "id": "teaser_button_label",
      "label": "Button label",
      "default": "Read the rest \u2192"
    },
    {
      "type": "text",
      "id": "teaser_caption",
      "label": "Caption",
      "info": "A short one-liner, not a description of the image -- replace the # with the actual count.",
      "default": "# more photographs."
    },
    {
      "type": "url",
      "id": "teaser_link",
      "label": "Link",
      "info": "Wherever the rest of the story lives -- an About page, an Origins page, or leave blank for a non-clickable card."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FBDCDC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F5450D"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border & shadow color",
      "default": "#F5450D",
      "info": "Independent of Text color above, which only affects headings and the eyebrow."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "OMA Story",
      "blocks": [
        {
          "type": "photo",
          "settings": {
            "caption": "It started with a one-way ticket to Bali, in search of answers we could no longer find in the rush of everyday life."
          }
        },
        {
          "type": "photo",
          "settings": {
            "caption": "That summer, we traded the comforts of the city to live and learn alongside those who grew more than just our food."
          }
        },
        {
          "type": "photo",
          "settings": {
            "caption": "We cleaned up beaches and rivers chocked with plastic."
          }
        }
      ]
    },
    {
      "name": "Field notes",
      "settings": {
        "show_eyebrow": false,
        "show_subcopy": false,
        "heading": "From the field",
        "show_nav_buttons": true,
        "show_teaser_card": false,
        "teaser_text": "",
        "background_color": "#F7F5F1",
        "text_color": "#FF3F00",
        "card_border_color": "#FF3F00"
      },
      "blocks": [
        { "type": "photo", "settings": { "caption": "Construction of THKB Permaculture Center in 2023" } },
        { "type": "photo", "settings": { "caption": "Overbooked production on the impacts of mass tourism on our planet" } },
        { "type": "photo", "settings": { "caption": "Overbooked Interview with Balinese rice farmer in 2023" } },
        { "type": "photo", "settings": { "caption": "Permaculture project: regenerating degraded corn fields" } },
        { "type": "photo", "settings": { "caption": "Restoration of degraded reefs in Tulamben of summer 2025" } },
        { "type": "photo", "settings": { "caption": "Site survey around Tianyar artificial reef in 2025" } },
        { "type": "photo", "settings": { "caption": "River clean up with Sungai Watch and local middle school kids" } },
        { "type": "photo", "settings": { "caption": "Sorting through plastic trash with Sungai Watch" } },
        { "type": "photo", "settings": { "caption": "Permaculture workshop with engineering graduates from Malaysia" } },
        { "type": "photo", "settings": { "caption": "Origin visit to Garut, West Java, 2025" } },
        { "type": "photo", "settings": { "caption": "Permaculture workshop to train local farmers in Bali" } },
        { "type": "photo", "settings": { "caption": "Farmers learning workshop to train local farmers in Bali" } },
        { "type": "photo", "settings": { "caption": "Our conservation work continues with your support :)" } }
      ]
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Edit alternative text in the image picker for accessibility."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 16
}
{% endschema %}
