{%- assign omawild_id = section.id | replace: '_', '' | replace: '-', '' | downcase -%}
{%- assign label_tag = section.settings.label_tag | default: 'h3' -%}

{% style %}
/* --- 1. Foundation --- */
  .section-{{ omawild_id }} {
    width: 100%;
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
    display: block;
    --gap: {{ section.settings.stat_gap }}px;
  }

  .container-{{ omawild_id }} {
    max-width: {{ section.settings.max_width }}px;
    margin-left: auto;
    margin-right: auto;
    padding-left: {{ section.settings.mobile_padding_horizontal }}px;
    padding-right: {{ section.settings.mobile_padding_horizontal }}px;
    width: 100%;
  }

  .grid-{{ omawild_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
    margin-bottom: {{ section.settings.grid_bottom_margin }}px;
    align-items: start; 
  }

  .image-wrapper-{{ omawild_id }} {
    width: 100%;
    position: relative;
    overflow: hidden;
    aspect-ratio: {{ section.settings.image_ratio }};
  }

  .image-wrapper-{{ omawild_id }} img, 
  .image-wrapper-{{ omawild_id }} svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

/* --- 2. Typography Styles --- */
  {%- assign h_tag = section.settings.label_tag | default: 'h2' -%}
  {%- assign desktop_size = section.settings.heading_size -%}

  {%- case h_tag -%}
    {%- when 'h1' -%}{%- assign floor_ratio = 1 -%}{%- assign hard_min = 30 -%}
    {%- when 'h2' -%}{%- assign floor_ratio = 0.2 -%}{%- assign hard_min = 20 -%}
    {%- when 'h3' -%}{%- assign floor_ratio = 0.4 -%}{%- assign hard_min = 18 -%}
    {%- when 'h4' -%}{%- assign floor_ratio = 0.2 -%}{%- assign hard_min = 16 -%}
  {%- endcase -%}

  {%- assign calculated_floor = desktop_size | times: floor_ratio | round -%}
  {%- if calculated_floor < hard_min -%}{%- assign final_floor = hard_min -%}{%- else -%}{%- assign final_floor = calculated_floor -%}{%- endif -%}

  .label-{{ omawild_id }} {
    display: block !important;
    font-family: var(--font-body-family) !important;
    font-size: 12px !important;
    letter-spacing: 0.15em !important;
    font-weight: 400 !important;
    color: {{ section.settings.label_color }} !important;
    text-transform: uppercase !important;
    margin: 0 0 20px 0 !important;
    line-height: 1.2 !important;
  }

  .main-heading-{{ omawild_id }} :is(h1, h2, h3, h4, h5, h6) {
    font-size: clamp({{ final_floor }}px, 5vw + 20px, {{ desktop_size }}px) !important;
    line-height: 1 !important;
    letter-spacing: -0.02em !important;
    color: {{ section.settings.heading_color }} !important;
    font-weight: 700;
    display: block;
    margin: 0 0 22px 0 !important; 
  }

  .text-{{ omawild_id }} strong {
    color: {{ section.settings.emphasis_color }} !important;
  }

  .text-{{ omawild_id }} a,
  .stat-body-{{ omawild_id }} a {
    color: {{ section.settings.link_color }} !important;
    transition: opacity 0.2s ease;
  }

  .text-{{ omawild_id }} a:hover,
  .stat-body-{{ omawild_id }} a:hover {
    opacity: 0.7;
  }

  .text-{{ omawild_id }} p {
    font-size: clamp({{ section.settings.text_size | times: 0.85 }}px, 1vw + 10px, {{ section.settings.text_size }}px) !important;
    line-height: {{ section.settings.body_line_height }} !important;
    color: {{ section.settings.text_color }} !important;
    margin: 0 0 20px 0 !important;
  }

/* --- 3. Cards --- */
  .stats-{{ omawild_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap);
    width: 100%;
  }

  .stat-card-{{ omawild_id }} {
    background-color: {{ section.settings.card_background }};
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: 1px;
    padding: {{ section.settings.card_padding }}px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    flex: 1 1 100%;
  }

  .stat-label-{{ omawild_id }} {
    font-family: var(--font-heading-family) !important; 
    font-weight: 600 !important;
    font-size: clamp({{ section.settings.stat_label_size | times: 0.7 }}px, 4vw, {{ section.settings.stat_label_size }}px) !important;
    color: {{ section.settings.stat_label_color }} !important;
    letter-spacing: -0.02em !important;
    line-height: {{ section.settings.stat_label_height }} !important;
    margin-bottom: {{ section.settings.stat_label_margin_bottom }}px !important;
    display: block !important;
  }

  .stat-body-{{ omawild_id }} {
    font-family: var(--font-body-family) !important;
    font-size: {{ section.settings.stat_body_size }}px !important;
    line-height: {{ section.settings.stat_body_height }} !important;
    color: {{ section.settings.stat_body_color }} !important;
    display: block !important;
  }

  .stat-body-{{ omawild_id }} p { margin: 0 0 10px 0 !important; }
  .stat-body-{{ omawild_id }} p:last-child { margin-bottom: 0 !important; }

/* --- 4. Responsive --- */
  @media screen and (min-width: 750px) {
    .grid-{{ omawild_id }} {
      grid-template-columns: 1fr 1fr;
      gap: {{ section.settings.grid_gap }}px;
    }

    {%- assign cards_desktop = section.settings.cards_per_row -%}
    {%- assign gap_factor = cards_desktop | minus: 1 | append: '.0' | divided_by: cards_desktop -%}
    
    .stat-card-{{ omawild_id }} {
      flex: 0 0 calc({{ 100.0 | divided_by: cards_desktop }}% - (var(--gap) * {{ gap_factor }}));
    }
  }
{% endstyle %}

<div class="section-{{ omawild_id }}" {{ section.shopify_attributes }}>
  <div class="container-{{ omawild_id }}">
    {% if section.settings.section_label != blank %}
      <{{ label_tag }} class="label-{{ omawild_id }}">
        {{ section.settings.section_label }}
      </{{ label_tag }}>
    {% endif %}

    <div class="grid-{{ omawild_id }}">
      <div class="text-{{ omawild_id }}">
        {% if section.settings.heading != blank %}
          <div class="main-heading-{{ omawild_id }}">
            {{ section.settings.heading }}
          </div>
        {% endif %}
        {% if section.settings.content != blank %}
          {{ section.settings.content }}
        {% endif %}
      </div>

      <div class="image-wrapper-{{ omawild_id }}">
        {% if section.settings.side_image != blank %}
          {{ section.settings.side_image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
    </div>

    <div class="stats-{{ omawild_id }}">
      {% for block in section.blocks %}
        {% if block.type == 'stat_card' %}
          <div class="stat-card-{{ omawild_id }}" {{ block.shopify_attributes }}>
            {% if block.settings.stat_label != blank %}
              <div class="stat-label-{{ omawild_id }}">{{ block.settings.stat_label }}</div>
            {% endif %}
            {% if block.settings.stat_body != blank %}
              <div class="stat-body-{{ omawild_id }}">{{ block.settings.stat_body }}</div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
"name": "OD Split Feature Grid",
"settings": [
  { "type": "header", "content": "Layout" },
  { "type": "range", "id": "max_width", "label": "Max width", "min": 600, "max": 1600, "step": 50, "unit": "px", "default": 1000 },
  { "type": "range", "id": "section_padding_top", "label": "Top padding", "min": 0, "max": 150, "step": 10, "unit": "px", "default": 40 },
  { "type": "range", "id": "section_padding_bottom", "label": "Bottom padding", "min": 0, "max": 150, "step": 10, "unit": "px", "default": 40 },
  { "type": "range", "id": "grid_gap", "label": "Column Gap", "min": 20, "max": 120, "step": 5, "unit": "px", "default": 60 },
  { "type": "range", "id": "grid_bottom_margin", "label": "Spacing Below Image", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 40 },
  { "type": "range", "id": "mobile_padding_horizontal", "label": "Side Padding (Mobile)", "min": 10, "max": 50, "step": 5, "unit": "px", "default": 20 },
  { "type": "color", "id": "background_color", "label": "Background Colour", "default": "#ffffff" },

  { "type": "header", "content": "Image Settings" },
  { "type": "image_picker", "id": "side_image", "label": "Side Image" },
  { "type": "select", "id": "image_ratio", "label": "Image Aspect Ratio", "options": [
      { "value": "1 / 1", "label": "Square (1:1)" },
      { "value": "4 / 3", "label": "Landscape (4:3)" },
      { "value": "16 / 9", "label": "Wide (16:9)" },
      { "value": "3 / 4", "label": "Portrait (3:4)" },
      { "value": "2 / 3", "label": "Tall (2:3)" }
    ], "default": "4 / 3" },

  { "type": "header", "content": "Card Design" },
  { "type": "range", "id": "cards_per_row", "label": "Cards Per Row (Desktop)", "min": 1, "max": 6, "step": 1, "default": 3 },
  { "type": "color", "id": "card_background", "label": "Card Background", "default": "#ffffff" },
  { "type": "color", "id": "card_border_color", "label": "Card Border", "default": "#e5e5e5" },
  { "type": "range", "id": "card_padding", "label": "Card Padding", "min": 10, "max": 60, "default": 20 },
  { "type": "range", "id": "stat_gap", "label": "Gap between cards", "min": 10, "max": 60, "step": 5, "unit": "px", "default": 15 },

  { "type": "header", "content": "Type Size" },
  { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 40 },
  { "type": "range", "id": "text_size", "label": "Body Size", "min": 12, "max": 30, "step": 1, "unit": "px", "default": 16 },
  { "type": "range", "id": "stat_label_size", "label": "Stat Label Size", "min": 20, "max": 120, "default": 48 },
  { "type": "range", "id": "stat_body_size", "label": "Stat Body Size", "min": 10, "max": 30, "default": 15 },

  { "type": "header", "content": "Line Height & Margin" },
  { "type": "range", "id": "body_line_height", "label": "Body Line Height", "min": 1.0, "max": 2.4, "step": 0.1, "default": 1.4 },
  { "type": "range", "id": "stat_label_height", "label": "Stat Label Line Height", "min": 1.0, "max": 2.4, "step": 0.1, "default": 1 },
  { "type": "range", "id": "stat_body_height", "label": "Stat Body Line Height", "min": 1.0, "max": 2.4, "step": 0.1, "default": 1.3 },
  { "type": "range", "id": "stat_label_margin_bottom", "label": "Stat Label Margin Bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 16},

  { "type": "header", "content": "Colors" },
  { "type": "color", "id": "label_color", "label": "Label Color", "default": "#666666" },
  { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#1A1B18" },
  { "type": "color", "id": "emphasis_color", "label": "Emphasis color (Bold)", "default": "#B231C6" },
  { "type": "color", "id": "link_color", "label": "Link color", "default": "#B231C6" },
  { "type": "color", "id": "text_color", "label": "Text Color", "default": "#1B1B1B" },
  { "type": "color", "id": "stat_label_color", "label": "Stat Label Color", "default": "#1A1B18" },
  { "type": "color", "id": "stat_body_color", "label": "Stat Body Color", "default": "#1B1B1B" },

  { "type": "header", "content": "Section Content" },
  { "type": "select", "id": "label_tag", "label": "Label SEO Tag", "options": [{"value":"h1","label":"H1"},{"value":"h2","label":"H2"},{"value":"h3","label":"H3"},{"value":"p","label":"p"}], "default": "h3" },
  { "type": "inline_richtext", "id": "section_label", "label": "Label Text", "default": "Label" },
  { "type": "richtext", "id": "heading", "label": "Heading", "default": "<h2>Heading</h2>" },
  { "type": "richtext", "id": "content", "label": "Body text", "default": "<p>Lorem ipsum dolor sit amet.</p>" }

],
"blocks": [
  {
    "type": "stat_card",
    "name": "Stat Card",
    "settings": [
      { "type": "inline_richtext", "id": "stat_label", "label": "Stat Label", "default": "100%" },
      { "type": "richtext", "id": "stat_body", "label": "Stat Body", "default": "<p>Stat Description</p>" }
    ]
  }
],
"presets": [
  {
    "name": "OD Split Feature Grid",
    "blocks": [
      { "type": "stat_card" },
      { "type": "stat_card" },
      { "type": "stat_card" }
    ]
  }
]
}
{% endschema %}