{% assign omawild_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .horizontal-gallery-{{ omawild_id }} {
    display: block;
    width: 100%;
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px;
    background-color: transparent;
  }

  .horizontal-gallery-header-{{ omawild_id }} {
    margin-bottom: 0px !important;
    padding-left: {{ section.settings.gallery_padding_left }}px;
    padding-right: 0px;
    text-align: {{ section.settings.text_alignment }};
  }

 h2.horizontal-gallery-title-{{ omawild_id }} {
    margin: 0;
    padding: 0;
    color: {{ section.settings.header_color }};
   
    font-size: clamp(
      {{ section.settings.header_size | times: 0.6 }}px, 
      5vw, 
      {{ section.settings.header_size }}px
    );
    line-height: 1.2;
    text-transform: none;
  }

  .horizontal-gallery-body-{{ omawild_id }} {
    margin: {{ section.settings.body_spacing }}px 0 0;
    color: {{ section.settings.body_color }};
    font-size: {{ section.settings.body_size }}px;
    line-height: 1.4;
  }

  .horizontal-gallery-scroll-container-{{ omawild_id }} {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: {{ section.settings.scrollbar_color }} transparent;
    padding-left: {{ section.settings.gallery_padding_left }}px;
    margin-top: 10px; /* Gap between header and cards */
  }

  .horizontal-gallery-scroll-container-{{ omawild_id }}::-webkit-scrollbar {
    height: 8px;
  }

  .horizontal-gallery-scroll-container-{{ omawild_id }}::-webkit-scrollbar-thumb {
    background-color: {{ section.settings.scrollbar_color }};
    border-radius: 4px;
  }

  .horizontal-gallery-cards-{{ omawild_id }} {
    display: flex;
    flex-wrap: nowrap;
    gap: {{ section.settings.card_gap }}px;
    padding: 10px 0 20px 0; /* Extra bottom padding for scrollbar clearance */
    width: max-content;
  }

  /* CARD LOCK: Prevents vertical stretching */
  .horizontal-gallery-card-{{ omawild_id }} {
    flex: 0 0 {{ section.settings.card_width }}px;
    width: {{ section.settings.card_width }}px;
    min-width: {{ section.settings.card_width }}px;
    max-width: {{ section.settings.card_width }}px;
    position: relative;
    border-radius: {{ section.settings.card_border_radius }}px;
    overflow: hidden;
    isolation: isolate;
    display: block;
  }

  .horizontal-gallery-card-image-wrapper-{{ omawild_id }} {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: {{ section.settings.aspect_ratio }}%;
    overflow: hidden;
    display: block;
  }

  .horizontal-gallery-card-image-{{ omawild_id }},
  .horizontal-gallery-card-image-placeholder-{{ omawild_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .horizontal-gallery-card-overlay-{{ omawild_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
    pointer-events: none;
    display: block !important;
  }

  .horizontal-gallery-card-content-{{ omawild_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ section.settings.card_padding }}px;
    z-index: 3;
  }

  .horizontal-gallery-card-title-{{ omawild_id }} {
    margin: 0;
    color: {{ section.settings.card_title_color }};
    font-size: {{ section.settings.card_title_size }}px;
    font-weight: 600;
    line-height: 1.3;
  }

  .horizontal-gallery-card-body-{{ omawild_id }} {
    margin: 4px 0 0;
    color: {{ section.settings.card_body_color }};
    font-size: {{ section.settings.card_body_size }}px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .horizontal-gallery-{{ omawild_id }} {
      padding: {{ section.settings.gallery_padding_top_mobile }}px 0 {{ section.settings.gallery_padding_bottom_mobile }}px;
    }
    .horizontal-gallery-header-{{ omawild_id }},
    .horizontal-gallery-scroll-container-{{ omawild_id }} {
      padding-left: {{ section.settings.gallery_padding_left_mobile }}px;
    }
    .horizontal-gallery-card-{{ omawild_id }} {
      flex: 0 0 {{ section.settings.card_width_mobile }}px;
      width: {{ section.settings.card_width_mobile }}px;
      min-width: {{ section.settings.card_width_mobile }}px;
      max-width: {{ section.settings.card_width_mobile }}px;
    }
  }
{% endstyle %}

<horizontal-gallery-{{ omawild_id }} class="horizontal-gallery-{{ omawild_id }}" {{ section.shopify_attributes }}>
  {% if section.settings.header_text != blank or section.settings.body_text != blank %}
    <div class="horizontal-gallery-header-{{ omawild_id }}">
      {% if section.settings.header_text != blank %}
        <h2 class="horizontal-gallery-title-{{ omawild_id }}">
          {{ section.settings.header_text | escape }}
        </h2>
      {% endif %}
      {% if section.settings.body_text != blank %}
        <div class="horizontal-gallery-body-{{ omawild_id }}">
          {{ section.settings.body_text }}
        </div>
      {% endif %}
    </div>
  {% endif %}

  <div class="horizontal-gallery-scroll-container-{{ omawild_id }}">
    <div class="horizontal-gallery-cards-{{ omawild_id }}">
      {% for block in section.blocks %}
        <div class="horizontal-gallery-card-{{ omawild_id }}" {{ block.shopify_attributes }}>
          <div class="horizontal-gallery-card-image-wrapper-{{ omawild_id }}">
            {% if block.settings.image %}
             <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                class="horizontal-gallery-card-image-{{ omawild_id }}"
              >
            {% else %}
              <div class="horizontal-gallery-card-image-placeholder-{{ omawild_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
            
            <div class="horizontal-gallery-card-overlay-{{ omawild_id }}"></div>
            
            <div class="horizontal-gallery-card-content-{{ omawild_id }}">
              {% if block.settings.title != blank %}
                <h3 class="horizontal-gallery-card-title-{{ omawild_id }}">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.body != blank %}
                <div class="horizontal-gallery-card-body-{{ omawild_id }}">{{ block.settings.body }}</div>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</horizontal-gallery-{{ omawild_id }}>

<script>
  (function() {
    if (!customElements.get('horizontal-gallery-{{ omawild_id }}')) {
      customElements.define('horizontal-gallery-{{ omawild_id }}', class extends HTMLElement {
        connectedCallback() {
          this.scrollContainer = this.querySelector('.horizontal-gallery-scroll-container-{{ omawild_id }}');
          this.setupSmoothScroll();
        }
        setupSmoothScroll() {
          if (!this.scrollContainer) return;
          let isDown = false, startX, scrollLeft;
          this.scrollContainer.addEventListener('mousedown', (e) => {
            isDown = true;
            this.scrollContainer.style.cursor = 'grabbing';
            startX = e.pageX - this.scrollContainer.offsetLeft;
            scrollLeft = this.scrollContainer.scrollLeft;
          });
          this.scrollContainer.addEventListener('mouseleave', () => { isDown = false; this.scrollContainer.style.cursor = 'grab'; });
          this.scrollContainer.addEventListener('mouseup', () => { isDown = false; this.scrollContainer.style.cursor = 'grab'; });
          this.scrollContainer.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            const walk = (e.pageX - this.scrollContainer.offsetLeft - startX) * 2;
            this.scrollContainer.scrollLeft = scrollLeft - walk;
          });
          this.scrollContainer.style.cursor = 'grab';
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "OD Cards Gallery (Hrz)",
  "settings": [
    { "type": "header", "content": "Section Padding (Desktop)" },
    { "type": "range", "id": "section_padding_top", "label": "Top (desktop)", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 40 },
    { "type": "range", "id": "section_padding_bottom", "label": "Bottom (desktop)", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 40 },
    { "type": "range", "id": "gallery_padding_left", "label": "Left (desktop)", "min": 0, "max": 200, "step": 10, "unit": "px", "default": 40 },
    
    { "type": "header", "content": "Section Padding (Mobile)" },
    { "type": "range", "id": "gallery_padding_top_mobile", "label": "Top (mobile)", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 30 },
    { "type": "range", "id": "gallery_padding_bottom_mobile", "label": "Bottom (mobile)", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 30 },
    { "type": "range", "id": "gallery_padding_left_mobile", "label": "Left (mobile)", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 20 },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ], "default": "left" 
    },

    { "type": "header", "content": "Card Overlay" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 30 },

   
    { "type": "header", "content": "Card Size" },
    { "type": "range", "id": "card_width", "label": "Card Width (Desktop)", "min": 200, "max": 500, "step": 20, "unit": "px", "default": 320 },
    { "type": "range", "id": "card_width_mobile", "label": "Card Width (mobile)", "min": 200, "max": 400, "step": 20, "unit": "px", "default": 280 },
    { "type": "range", "id": "card_gap", "label": "Gap (Between Cards)", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 14 },
    { "type": "select", "id": "aspect_ratio", "label": "Card aspect ratio", "options": [
        { "value": "56.25", "label": "Landscape (16:9)" },
        { "value": "75", "label": "Landscape (4:3)" },
        { "value": "100", "label": "Square (1:1)" },
        { "value": "133", "label": "Portrait (3:4)" },
        { "value": "177", "label": "Portrait (9:16)" }
      ], "default": "133" 
    },

    { "type": "header", "content": "Card Styling" },
    { "type": "range", "id": "card_border_radius", "label": "Border radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "card_padding", "label": "Content padding", "min": 0, "max": 40, "step": 5, "unit": "px", "default": 20 },
    { "type": "color", "id": "scrollbar_color", "label": "Scrollbar color", "default": "#d2d5d9" },
        
    { "type": "header", "content": "Card Text Styling" },
    { "type": "range", "id": "card_title_size", "label": "Title size", "min": 12, "max": 32, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "card_body_size", "label": "Body size", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "color", "id": "card_title_color", "label": "Title color", "default": "#ffffff" },
    { "type": "color", "id": "card_body_color", "label": "Body color", "default": "#ffffff" },

    { "type": "header", "content": "Heading Content" },
    { "type": "text", "id": "header_text", "label": "Header text (SEO H2)", "default": "Gallery" },
    { "type": "richtext", "id": "body_text", "label": "Body text" },
    { "type": "range", "id": "body_spacing", "label": "Margin btw Heading & Body Text", "min": 0, "max": 50, "step": 5, "unit": "px", "default": 10 },
    { "type": "range", "id": "header_size", "label": "Header size", "min": 16, "max": 60, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "body_size", "label": "Body size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "color", "id": "header_color", "label": "Header color", "default": "#1a1b18" },
    { "type": "color", "id": "body_color", "label": "Body color", "default": "#212326" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Card Title" },
        { "type": "textarea", "id": "body", "label": "Body text" }
      ]
    }
  ],
  "presets": [
    { "name": "OD Cards Gallery (Hrz)", "blocks": [ { "type": "card" }, { "type": "card" }, { "type": "card" } ] }
  ]
}
{% endschema %}