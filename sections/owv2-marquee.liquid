{% assign owid = section.id | replace: '-', '' | replace: '_', '' %}
{% style %}
.owv2-marquee-{{ owid }} {
  box-sizing: border-box;
  --bg: {{ section.settings.background_color }};
  --ink: {{ section.settings.text_color }};
  --surface: {{ section.settings.card_background }};
  background: var(--bg);
  color: var(--ink);
  padding: {{ section.settings.padding_top }}px max(20px, 5vw) {{ section.settings.padding_bottom }}px;
  font-family: var(--font-body-family);
  font-size: 16px;
  line-height: 1.5;
  }
.owv2-marquee-{{ owid }} *, .owv2-marquee-{{ owid }} *::before, .owv2-marquee-{{ owid }} *::after {
  box-sizing: border-box;
  }
.owv2-marquee-{{ owid }} h1, .owv2-marquee-{{ owid }} h2, .owv2-marquee-{{ owid }} h3 {
  font-family: var(--font-heading-family);
  color: inherit;
  font-weight: 900;
  letter-spacing: -.035em;
  line-height: 1.05;
  text-transform: none;
  margin: 0;
  overflow-wrap: anywhere;
  }
.owv2-marquee-{{ owid }} h2 {
  font-size: clamp(30px, 4vw, 58px);
  }
.owv2-marquee-{{ owid }} h3 {
  font-size: 26px;
  }
.owv2-marquee-{{ owid }} p {
  margin: 0 0 16px;
  }
.owv2-marquee-{{ owid }} p:last-child {
  margin-bottom: 0;
  }
.owv2-marquee-{{ owid }} a {
  color: inherit;
  }
.owv2-marquee-{{ owid }} img, .owv2-marquee-{{ owid }} svg {
  display: block;
  max-width: 100%;
  height: auto;
  }
.owv2-marquee-{{ owid }} .inner {
  max-width: 1320px;
  margin-inline: auto;
  min-width: 0;
  }
.owv2-marquee-{{ owid }} .intro {
  max-width: 760px;
  margin-bottom: 32px;
  }
.owv2-marquee-{{ owid }} .intro > * + * {
  margin-top: 20px;
  }
.owv2-marquee-{{ owid }} .eyebrow {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  }
.owv2-marquee-{{ owid }} .owv2-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 12px 24px;
  border: 1px solid var(--ink);
  border-radius: 999px;
  background: var(--ink);
  color: var(--bg);
  font: 700 16px var(--font-body-family);
  text-decoration: none;
  text-align: center;
  cursor: pointer;
  }
.owv2-marquee-{{ owid }} :focus-visible {
  outline: 3px solid currentColor;
  outline-offset: 4px;
  }
.owv2-marquee-{{ owid }} .owv2-placeholder {
  width: 100%;
  height: 100%;
  min-height: 200px;
  background: var(--surface);
  fill: var(--ink);
  }
@media (prefers-reduced-motion: reduce) {
  .owv2-marquee-{{ owid }} * {
  scroll-behavior: auto !important;
  scroll-snap-type: none !important;
  }
}
.owv2-marquee-{{ owid }} {
  overflow:hidden;
  padding-inline:0;
  }
.owv2-marquee-{{ owid }} .track {
  display:flex;
  width:max-content;
  animation:owv2-marquee-{{ owid }} {{ section.settings.speed }}s linear infinite;
  {% if section.settings.direction == 'right' %}animation-direction:reverse;{% endif %} }
.owv2-marquee-{{ owid }} ul {
  display:flex;
  list-style:none;
  min-width:100vw;
  justify-content:space-around;
  padding:0;
  margin:0;
  flex-shrink:0;
  }
.owv2-marquee-{{ owid }} li {
  padding-inline:20px;
  font-size:12px;
  font-weight:700;
  letter-spacing:.09em;
  white-space:nowrap;
  }
.owv2-marquee-{{ owid }} li span {
  margin-left:32px;
  }
.owv2-marquee-{{ owid }} :hover .track {
  animation-play-state:paused;
  }
@keyframes owv2-marquee-{{ owid }} {
  to {
  transform:translateX(-50%);
  }
} @media(prefers-reduced-motion:reduce) {
  .owv2-marquee-{{ owid }} .track {
  animation:none;
  width:auto;
  }
.owv2-marquee-{{ owid }} ul {
  flex-wrap:wrap;
  justify-content:center;
  gap:12px;
  }
.owv2-marquee-{{ owid }} li {
  white-space:normal;
  }
.owv2-marquee-{{ owid }} ul[aria-hidden] {
  display:none;
  }
}
{% endstyle %}
<div class="owv2-marquee-{{ owid }}">
<div class="track">
{% for repetition in (1..2) %}
<ul {% if repetition == 2 %}aria-hidden="true"{% endif %}>
{% for block in section.blocks %}
<li {% if repetition == 1 %}{{ block.shopify_attributes }}{% endif %}>{{ block.settings.text | escape }} <span aria-hidden="true">{{ section.settings.separator | escape }}</span>
</li>
{% endfor %}
</ul>
{% endfor %}
</div>
</div>
{% schema %}
{
  "name": "OWV2 Trust marquee",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "Speed",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "s",
      "default": 30
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator",
      "default": "\u2737"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F5450D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "OWV2 Trust marquee",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "100% RECYCLABLE PACKAGING"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "DIRECT FARM RELATIONSHIPS"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "REGENERATIVE INGREDIENTS"
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 16
}
{% endschema %}
