{% assign owid = section.id | replace: '-', '' | replace: '_', '' %}
{% style %}
.owv2-values-{{ owid }} {
  box-sizing: border-box;
  --bg: {{ section.settings.background_color }};
  --ink: {{ section.settings.text_color }};
  --surface: {{ section.settings.card_background }};
  background: var(--bg);
  color: var(--ink);
  padding: {{ section.settings.padding_top }}px max(20px, 5vw) {{ section.settings.padding_bottom }}px;
  font-family: var(--font-body-family);
  font-size: 16px;
  line-height: 1.5;
  }
.owv2-values-{{ owid }} *, .owv2-values-{{ owid }} *::before, .owv2-values-{{ owid }} *::after {
  box-sizing: border-box;
  }
.owv2-values-{{ owid }} h1, .owv2-values-{{ owid }} h2, .owv2-values-{{ owid }} h3 {
  font-family: var(--font-heading-family);
  color: inherit;
  font-weight: 900;
  letter-spacing: -.035em;
  line-height: 1.05;
  text-transform: none;
  margin: 0;
  overflow-wrap: anywhere;
  }
.owv2-values-{{ owid }} h2 {
  font-size: clamp(30px, 4vw, 58px);
  }
.owv2-values-{{ owid }} h3 {
  font-size: 26px;
  }
.owv2-values-{{ owid }} p {
  margin: 0 0 16px;
  }
.owv2-values-{{ owid }} p:last-child {
  margin-bottom: 0;
  }
.owv2-values-{{ owid }} a {
  color: inherit;
  }
.owv2-values-{{ owid }} img, .owv2-values-{{ owid }} svg {
  display: block;
  max-width: 100%;
  height: auto;
  }
.owv2-values-{{ owid }} .inner {
  max-width: 1320px;
  margin-inline: auto;
  min-width: 0;
  }
.owv2-values-{{ owid }} .intro {
  max-width: 760px;
  margin-bottom: 32px;
  }
.owv2-values-{{ owid }} .intro > * + * {
  margin-top: 20px;
  }
.owv2-values-{{ owid }} .eyebrow {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  }
.owv2-values-{{ owid }} .owv2-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 10px 20px;
  border: 1px solid var(--ink);
  border-radius: 999px;
  background: var(--ink);
  color: var(--bg);
  font: 700 15px var(--font-body-family);
  text-decoration: none;
  text-align: center;
  cursor: pointer;
  }
.owv2-values-{{ owid }} :focus-visible {
  outline: 3px solid currentColor;
  outline-offset: 4px;
  }
.owv2-values-{{ owid }} .owv2-placeholder {
  width: 100%;
  height: 100%;
  min-height: 200px;
  background: var(--surface);
  fill: var(--ink);
  }
@media (prefers-reduced-motion: reduce) {
  .owv2-values-{{ owid }} * {
  scroll-behavior: auto !important;
  scroll-snap-type: none !important;
  }
}
.owv2-values-{{ owid }} .intro {
  text-align:center;
  margin-inline:auto;
  max-width:720px;
  margin-bottom:34px;
  }
.owv2-values-{{ owid }} .intro h2 {
  font-size:23px;
  font-weight:800;
  letter-spacing:-.02em;
  line-height:1.2;
  }
.owv2-values-{{ owid }} .intro div {
  font-size:13.5px;
  line-height:1.65;
  font-weight:500;
  /* Body copy is muted warm-gray in the design, distinct from the
     section's --ink accent (which stays reserved for headings). */
  color:#5A5550;
  }
.owv2-values-{{ owid }} .cards {
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:22px;
  }
.owv2-values-{{ owid }} article {
  display:flex;
  flex-direction:column;
  padding:24px;
  background:var(--surface);
  border:1.5px solid var(--ink);
  border-radius:10px;
  }
.owv2-values-{{ owid }} article > * + * {
  margin-top:16px;
  }
.owv2-values-{{ owid }} .icon {
  width:42px;
  height:42px;
  object-fit:contain;
  }
.owv2-values-{{ owid }} article h3 {
  font-size:15px;
  font-weight:800;
  letter-spacing:normal;
  line-height:1.2;
  }
.owv2-values-{{ owid }} article > div {
  font-size:12.5px;
  line-height:1.6;
  font-weight:500;
  color:#5A5550;
  }
.owv2-values-{{ owid }} article a {
  align-self:flex-start;
  margin-top:auto;
  display:inline-flex;
  text-decoration:none;
  border:1.5px solid var(--ink);
  color:var(--ink);
  padding:11px 18px;
  border-radius:999px;
  font-size:11.5px;
  font-weight:800;
  transition:background .2s ease, color .2s ease;
  }
.owv2-values-{{ owid }} article a:hover {
  background:var(--ink);
  /* Hardcoded white, not var(--bg): the design's hover state is a solid
     accent pill with white text regardless of the section's own
     background color setting. */
  color:#FFFFFF;
  }
@media(max-width:749px) {
  .owv2-values-{{ owid }} .cards {
  grid-template-columns:1fr;
  }
}
{% endstyle %}
<div class="owv2-values-{{ owid }}">
<div class="inner">
<div class="intro">
<h2>{{ section.settings.heading }}</h2>
<div>{{ section.settings.intro }}</div>
</div>
<div class="cards">
{% for block in section.blocks %}
<article {{ block.shopify_attributes }}>
{% if block.settings.icon != blank %}
{{ block.settings.icon | image_url: width: 160 | image_tag: loading: 'lazy', class: 'icon' }}
{% else %}
{% comment %}
  Design's three fixed pillar badges, by position, until a merchant
  picks their own icon in the block's Icon setting (image_picker can't
  carry a default or preset image reference).
{% endcomment %}
{% case forloop.index %}
{% when 1 %}<img src="{{ 'ow-why-icon-regen.svg' | asset_url }}" alt="" class="icon" width="60" height="60" loading="lazy">
{% when 2 %}<img src="{{ 'ow-badge-1ftp.png' | asset_url }}" alt="" class="icon" width="376" height="160" loading="lazy">
{% when 3 %}<img src="{{ 'ow-badge-recyclable.png' | asset_url }}" alt="" class="icon" width="160" height="160" loading="lazy">
{% endcase %}
{% endif %}
<h3>{{ block.settings.heading | escape }}</h3>
<div>{{ block.settings.body }}</div>
{% if block.settings.cta_link != blank and block.settings.cta_label != blank %}
<a href="{{ block.settings.cta_link }}">{{ block.settings.cta_label | escape }}</a>
{% endif %}
</article>
{% endfor %}
</div>
</div>
</div>
{% schema %}
{
  "name": "OWV2 Values",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "There are many reasons to give a damn. And we don't need the same reasons."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Maybe you're here for the vibes and adventure. Or for a damn good cup of coffee. You don't have to care about the climate for any of that, but there's one thing none of us can opt out of: everything that sustains a well-lived life runs on healthy ecosystems.</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F6F3EC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FF3F00"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "OWV2 Values",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "heading": "Regenerative Farming",
            "body": "<p>Soil health is nurtured by the farmers we grow alongside, season after season, through regenerative agriculture: our direct mechanism for better food and climate resilience.</p>",
            "cta_label": "How regen works",
            "cta_link": "/pages/regenerative-farming"
          }
        },
        {
          "type": "value",
          "settings": {
            "heading": "1% for the Planet",
            "body": "<p>Regenerative farming is just one part of caring for our planet. As members of 1% for the Planet, we give at minimum one percent of annual sales to environmental organisations working hard beyond our own supply chains.</p>",
            "cta_label": "Where the 1% goes",
            "cta_link": "/pages/1-percent-for-the-planet"
          }
        },
        {
          "type": "value",
          "settings": {
            "heading": "Fully Recyclable",
            "body": "<p>Pretty \"paper\" bags that can't be recycled. BS \"compostable\" claims that don't actually degrade. None of that is eco-friendly. It's plain greenwashing. Ours is fully recyclable: one PE material from start to finish.</p>"
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Edit alternative text in the image picker for accessibility."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>Every cup is a chance to do something good.</p>"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Cta label"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Cta link"
        }
      ]
    }
  ],
  "max_blocks": 16
}
{% endschema %}
