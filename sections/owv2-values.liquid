{% assign owid = section.id | replace: '-', '' | replace: '_', '' %}
{% style %}
.owv2-values-{{ owid }} {
  box-sizing: border-box;
  --bg: {{ section.settings.background_color }};
  --ink: {{ section.settings.text_color }};
  --surface: {{ section.settings.card_background }};
  background: var(--bg);
  color: var(--ink);
  padding: {{ section.settings.padding_top }}px max(20px, 5vw) {{ section.settings.padding_bottom }}px;
  font-family: var(--font-body-family);
  font-size: 16px;
  line-height: 1.5;
  }
.owv2-values-{{ owid }} *, .owv2-values-{{ owid }} *::before, .owv2-values-{{ owid }} *::after {
  box-sizing: border-box;
  }
.owv2-values-{{ owid }} h1, .owv2-values-{{ owid }} h2, .owv2-values-{{ owid }} h3 {
  font-family: var(--font-heading-family);
  color: inherit;
  font-weight: 900;
  letter-spacing: -.035em;
  line-height: 1.05;
  text-transform: none;
  margin: 0;
  overflow-wrap: anywhere;
  }
.owv2-values-{{ owid }} h2 {
  font-size: clamp(30px, 4vw, 58px);
  }
.owv2-values-{{ owid }} h3 {
  font-size: 26px;
  }
.owv2-values-{{ owid }} p {
  margin: 0 0 16px;
  }
.owv2-values-{{ owid }} p:last-child {
  margin-bottom: 0;
  }
.owv2-values-{{ owid }} a {
  color: inherit;
  }
.owv2-values-{{ owid }} img, .owv2-values-{{ owid }} svg {
  display: block;
  max-width: 100%;
  height: auto;
  }
.owv2-values-{{ owid }} .inner {
  max-width: 1320px;
  margin-inline: auto;
  min-width: 0;
  }
.owv2-values-{{ owid }} .intro {
  max-width: 760px;
  margin-bottom: 32px;
  }
.owv2-values-{{ owid }} .intro > * + * {
  margin-top: 20px;
  }
.owv2-values-{{ owid }} .eyebrow {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  }
.owv2-values-{{ owid }} .owv2-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 12px 24px;
  border: 1px solid var(--ink);
  border-radius: 999px;
  background: var(--ink);
  color: var(--bg);
  font: 700 16px var(--font-body-family);
  text-decoration: none;
  text-align: center;
  cursor: pointer;
  }
.owv2-values-{{ owid }} :focus-visible {
  outline: 3px solid currentColor;
  outline-offset: 4px;
  }
.owv2-values-{{ owid }} .owv2-placeholder {
  width: 100%;
  height: 100%;
  min-height: 200px;
  background: var(--surface);
  fill: var(--ink);
  }
@media (prefers-reduced-motion: reduce) {
  .owv2-values-{{ owid }} * {
  scroll-behavior: auto !important;
  scroll-snap-type: none !important;
  }
}
.owv2-values-{{ owid }} .intro {
  text-align:center;
  margin-inline:auto;
  }
.owv2-values-{{ owid }} .cards {
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:24px;
  }
.owv2-values-{{ owid }} article {
  padding:32px;
  background:var(--surface);
  border:1px solid var(--ink);
  border-radius:12px;
  }
.owv2-values-{{ owid }} article > * + * {
  margin-top:20px;
  }
.owv2-values-{{ owid }} .icon {
  width:64px;
  height:64px;
  object-fit:contain;
  }
@media(max-width:749px) {
  .owv2-values-{{ owid }} .cards {
  grid-template-columns:1fr;
  }
}
{% endstyle %}
<div class="owv2-values-{{ owid }}">
<div class="inner">
<div class="intro">
<h2>{{ section.settings.heading }}</h2>
<div>{{ section.settings.intro }}</div>
</div>
<div class="cards">
{% for block in section.blocks %}
<article {{ block.shopify_attributes }}>
{% if block.settings.icon != blank %}{{ block.settings.icon | image_url: width: 160 | image_tag: loading: 'lazy', class: 'icon' }}{% endif %}
<h3>{{ block.settings.heading | escape }}</h3>
<div>{{ block.settings.body }}</div>
{% if block.settings.cta_link != blank and block.settings.cta_label != blank %}
<a href="{{ block.settings.cta_link }}">{{ block.settings.cta_label | escape }}</a>
{% endif %}
</article>
{% endfor %}
</div>
</div>
</div>
{% schema %}
{
  "name": "OWV2 Values",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "There are many reasons to give a damn\u2026"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>A better daily ritual, with nature at its heart.</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F1ECE2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F5450D"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "OWV2 Values",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "heading": "Good coffee"
          }
        },
        {
          "type": "value",
          "settings": {
            "heading": "Living landscapes"
          }
        },
        {
          "type": "value",
          "settings": {
            "heading": "A shared future"
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Edit alternative text in the image picker for accessibility."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>Every cup is a chance to do something good.</p>"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Cta label"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Cta link"
        }
      ]
    }
  ],
  "max_blocks": 16
}
{% endschema %}
