{%- comment -%}
  oma-related-stories — standalone "Keep reading" strip: a heading + "All
  stories" link, then a static grid of story cards pulled from a blog. No
  filtering/pagination (that's oma-dispatch-feed's job) — this is the
  lightweight end-of-page teaser. Reuses oma-dispatch-feed's story-card
  visual language so a page that shows both reads as one system.

  When placed on an article page, "Exclude current article" (on by
  default) skips the article being viewed by comparing against the
  global `article` object.
{%- endcomment -%}
{% assign owid = section.id | replace: '-', '' | replace: '_', '' %}
{% style %}
.oma-related-stories-{{ owid }} {
  box-sizing: border-box;
  background: {{ section.settings.background_color }};
  border-top: 1.5px solid {{ section.settings.accent_color }};
  padding: {{ section.settings.padding_top }}px clamp(20px, 4vw, 48px) {{ section.settings.padding_bottom }}px;
  font-family: var(--font-body-family);
  }
.oma-related-stories-{{ owid }} *, .oma-related-stories-{{ owid }} *::before, .oma-related-stories-{{ owid }} *::after {
  box-sizing: border-box;
  }
.oma-related-stories-{{ owid }} .inner {
  max-width: 1440px;
  margin: 0 auto;
  }
.oma-related-stories-{{ owid }} .head-row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px 40px;
  }
.oma-related-stories-{{ owid }} .heading {
  margin: 0;
  font-family: var(--font-heading-family);
  font-weight: 900;
  font-size: clamp(34px, 4.4vw, 56px);
  line-height: .95;
  letter-spacing: -.04em;
  color: {{ section.settings.accent_color }};
  }
.oma-related-stories-{{ owid }} .cta {
  flex: none;
  text-decoration: none;
  border: 1.5px solid {{ section.settings.accent_color }};
  color: {{ section.settings.accent_color }};
  padding: 15px 20px;
  border-radius: 100px;
  font: 900 12px/1 var(--font-heading-family);
  white-space: nowrap;
  transition: background-color .15s ease, color .15s ease;
  }
.oma-related-stories-{{ owid }} .cta:hover {
  background: {{ section.settings.accent_color }};
  color: #ffffff;
  }
.oma-related-stories-{{ owid }} .grid {
  margin-top: 36px;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
  gap: 24px;
  }
.oma-related-stories-{{ owid }} .story-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  border: 1.5px solid {{ section.settings.accent_color }};
  background: #ffffff;
  text-decoration: none;
  color: {{ section.settings.text_color }};
  transition: background-color .15s ease;
  }
.oma-related-stories-{{ owid }} .story-card:hover {
  background: {{ section.settings.hover_background }};
  }
.oma-related-stories-{{ owid }} .story-media {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  background: {{ section.settings.hover_background }};
  border-bottom: 1.5px solid {{ section.settings.accent_color }};
  }
.oma-related-stories-{{ owid }} .story-media img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  }
.oma-related-stories-{{ owid }} .story-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 20px 20px 22px;
  }
.oma-related-stories-{{ owid }} .kicker {
  font: 900 10.5px/1.3 var(--font-heading-family);
  letter-spacing: .12em;
  color: {{ section.settings.accent_color }};
  }
.oma-related-stories-{{ owid }} .story-title {
  margin: 12px 0 0;
  font-family: var(--font-heading-family);
  font-weight: 900;
  font-size: 24px;
  line-height: 1.05;
  letter-spacing: -.03em;
  color: {{ section.settings.accent_color }};
  text-wrap: balance;
  }
.oma-related-stories-{{ owid }} .story-excerpt {
  margin: 12px 0 0;
  font-size: 14.5px;
  line-height: 1.6;
  color: {{ section.settings.text_color }};
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  }
.oma-related-stories-{{ owid }} .story-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-top: auto;
  padding-top: 18px;
  }
.oma-related-stories-{{ owid }} .story-read {
  font: 900 14.5px/1 var(--font-heading-family);
  color: {{ section.settings.accent_color }};
  }
.oma-related-stories-{{ owid }} .story-date {
  font: 700 12.5px/1 var(--font-body-family);
  color: {{ section.settings.text_color }};
  }
{% endstyle %}
{%- liquid
  assign feed_blog = section.settings.blog | default: blog
-%}
<div class="oma-related-stories-{{ owid }}">
  <div class="inner">
    {%- if feed_blog == blank -%}
      {%- if request.design_mode -%}
        <p>Select a blog above to show its stories here.</p>
      {%- endif -%}
    {%- else -%}
      <div class="head-row">
        <h2 class="heading">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link | default: feed_blog.url }}" class="cta">{{ section.settings.cta_label | escape }}</a>
        {%- endif -%}
      </div>
      <div class="grid">
        {%- assign shown = 0 -%}
        {%- for related_article in feed_blog.articles -%}
          {%- if shown >= section.settings.count -%}{%- break -%}{%- endif -%}
          {%- if section.settings.exclude_current and article != blank and related_article.id == article.id -%}{%- continue -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          <a href="{{ related_article.url }}" class="story-card">
            <div class="story-media">
              {%- if related_article.image != blank -%}
                {{ related_article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 600, 900', alt: related_article.title }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div class="story-body">
              {%- if related_article.tags.size > 0 -%}<div class="kicker">{{ related_article.tags | join: ' · ' | upcase }}</div>{%- endif -%}
              <h3 class="story-title">{{ related_article.title }}</h3>
              {%- if related_article.excerpt != blank -%}
                <p class="story-excerpt">{{ related_article.excerpt | strip_html }}</p>
              {%- else -%}
                <p class="story-excerpt">{{ related_article.content | strip_html | truncatewords: 30 }}</p>
              {%- endif -%}
              <div class="story-foot">
                <span class="story-read">{{ section.settings.read_label | escape }} →</span>
                <span class="story-date">{{ related_article.published_at | time_tag: format: 'month_day_year' }}</span>
              </div>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "OMA Related Stories",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog", "info": "Leave blank on a Blog page template, or an article page, to use whichever blog is being viewed." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Keep reading" },
    { "type": "text", "id": "cta_label", "label": "\"All stories\" link text", "default": "All stories →" },
    { "type": "url", "id": "cta_link", "label": "\"All stories\" link", "info": "Leave blank to link to the blog above." },
    { "type": "range", "id": "count", "label": "Stories to show", "min": 1, "max": 6, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "exclude_current", "label": "Exclude the article being viewed", "default": true, "info": "Only applies on an article page." },
    { "type": "text", "id": "read_label", "label": "\"Read\" link text", "default": "Read the story" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#F7F5F1" },
    { "type": "color", "id": "accent_color", "label": "Accent (borders, titles)", "default": "#FF3F00" },
    { "type": "color", "id": "text_color", "label": "Body text color", "default": "#00180C" },
    { "type": "color", "id": "hover_background", "label": "Hover / image placeholder background", "default": "#FFE4E7" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [
    { "name": "OMA Related Stories" }
  ]
}
{% endschema %}
