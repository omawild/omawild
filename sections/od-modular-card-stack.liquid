   { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#1A1B18" },
   { "type": "color", "id": "emphasis_color", "label": "Emphasis color", "default": "#B231C6" },
      { "type": "color", "id": "link_color", "label": "Link color", "default": "#B231C6" },
   { "type": "color", "id": "text_color", "label": "Body Text Color", "default": "#1B1B1B" },
