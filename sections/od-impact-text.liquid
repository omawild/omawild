{%- style -%}
/* --- Section & Core Colors --- */
.section-{{ section.id }} {
  background-color: {{ section.settings.background_color }};
  padding-top: {{ section.settings.section_padding_top }}px;
  padding-bottom: {{ section.settings.section_padding_bottom }}px;
  overflow: hidden;
  position: relative;
}

.container-{{ section.id }} {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  padding-left: {{ section.settings.mobile_padding_horizontal }}px;
  padding-right: {{ section.settings.mobile_padding_horizontal }}px;
  box-sizing: border-box;
}

.impact-content__inner-{{ section.id }} {
  width: {{ section.settings.desktop_width_percent }}%;
  max-width: 100%;
  margin: 0 auto;
}

/* --- Block Styling & Spacing --- */
.impact-block-{{ section.id }} {
  box-sizing: border-box;
  width: 100%;
}

.impact-content__section-heading-{{ section.id }} {
  font-size: {{ section.settings.section_heading_size }}px;
  color: {{ section.settings.heading_color }};
  margin: 0 0 {{ section.settings.content_spacing }}px 0;
  font-weight: 600;
  letter-spacing: 0.5px;
  line-height: 1.2;
}

.impact-content__subsection-heading-{{ section.id }} {
  font-size: {{ section.settings.subsection_heading_size }}px;
  color: {{ section.settings.heading_color }};
  margin: 0 0 {{ section.settings.content_spacing }}px 0;
  font-weight: 600;
  line-height: 1.3;
}

.impact-content__body-{{ section.id }} {
  font-size: {{ section.settings.body_size }}px;
  color: {{ section.settings.text_color }};
  line-height: 1.5;
  margin-bottom: {{ section.settings.paragraph_spacing }}px;
}

.impact-content__body-{{ section.id }} p {
  margin: 0 0 {{ section.settings.paragraph_spacing }}px 0;
}

.impact-content__body-{{ section.id }} p:last-child {
  margin-bottom: 0;
}

.impact-content__image-wrapper-{{ section.id }} {
  margin-top: 0px;
  margin-bottom: {{ section.settings.image_bottom_spacing }}px;
  width: 100%;
  overflow: hidden;
}

.impact-content__image-{{ section.id }} {
  width: 100%;
  height: auto;
  display: block;
  border-radius: {{ section.settings.image_border_radius }}px;
}

/* --- Responsive Typography Scale --- */
@media screen and (max-width: 749px) {
  .impact-content__section-heading-{{ section.id }} {
    font-size: calc({{ section.settings.section_heading_size }}px * 0.85);
  }
  .impact-content__subsection-heading-{{ section.id }} {
    font-size: calc({{ section.settings.subsection_heading_size }}px * 0.9);
  }
  .impact-content__body-{{ section.id }} {
    font-size: calc({{ section.settings.body_size }}px * 0.95);
  }
}
{%- endstyle -%}

<div class="section-{{ section.id }}">
  <div class="container-{{ section.id }}">
    <div class="impact-content__inner-{{ section.id }}">
      
      {%- for block in section.blocks -%}
        <div class="impact-block-{{ section.id }}" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            
            {%- when 'od_header' -%}
              {%- if block.settings.section_heading != blank -%}
                {%- assign heading_tag = block.settings.heading_tag -%}
                <div class="impact-content__section-{{ section.id }}">
                  <{{ heading_tag }} class="impact-content__section-heading-{{ section.id }}">
                    {{ block.settings.section_heading }}
                  </{{ heading_tag }}>
                </div>
              {%- endif -%}
              
              {%- if block.settings.subsection_heading != blank -%}
                {%- assign subheading_tag = block.settings.subheading_tag -%}
                <{{ subheading_tag }} class="impact-content__subsection-heading-{{ section.id }}">
                  {{ block.settings.subsection_heading }}
                </{{ subheading_tag }}>
              {%- endif -%}

            {%- when 'od_text' -%}
              {%- if block.settings.body_content != blank -%}
                <div class="impact-content__body-{{ section.id }}">
                  {{ block.settings.body_content }}
                </div>
              {%- endif -%}

            {%- when 'od_image' -%}
              <div class="impact-content__image-wrapper-{{ section.id }}">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 1600 }}"
                    alt="{{ block.settings.image.alt | escape }}"
                    loading="lazy"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    class="impact-content__image-{{ section.id }}"
                    style="aspect-ratio: {{ block.settings.image_aspect_ratio }}; object-fit: cover;"
                  >
                {%- else -%}
                  <div style="aspect-ratio: {{ block.settings.image_aspect_ratio }}; background-color: #f3f3f3; display: flex; align-items: center; justify-content: center; border-radius: {{ section.settings.image_border_radius }}px;">
                    {{ 'image' | placeholder_svg_tag: 'impact-content__image-placeholder' }}
                  </div>
                {%- endif -%}
              </div>

          {%- endcase -%}
        </div>
      {%- endfor -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "OD Impact Content",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Layout Layout & Framing" },
    { "type": "range", "id": "max_width", "label": "Max Container Width", "min": 800, "max": 1600, "step": 50, "unit": "px", "default": 1200 },
    { "type": "range", "id": "desktop_width_percent", "label": "Inner Content Width (Desktop)", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "section_padding_top", "label": "Top Padding", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 40 },
    { "type": "range", "id": "section_padding_bottom", "label": "Bottom Padding", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 40 },
    { "type": "range", "id": "mobile_padding_horizontal", "label": "Mobile Safety Gutter", "min": 10, "max": 50, "step": 5, "unit": "px", "default": 20 },
    { "type": "header", "content": "Global Formatting Spacing" },
    { "type": "range", "id": "content_spacing", "label": "Spacing Under Headings", "min": 10, "max": 50, "step": 5, "unit": "px", "default": 20 },
    { "type": "range", "id": "paragraph_spacing", "label": "Paragraph Bottom Margin", "min": 10, "max": 40, "step": 5, "unit": "px", "default": 20 },
    { "type": "range", "id": "image_bottom_spacing", "label": "Image Bottom Spacing", "min": 0, "max": 60, "step": 5, "unit": "px", "default": 20 },
    { "type": "header", "content": "Typography Scales" },
    { "type": "range", "id": "section_heading_size", "label": "Main Heading Size", "min": 14, "max": 50, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "subsection_heading_size", "label": "Sub-Heading Size", "min": 14, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "body_size", "label": "Body Font Size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading Color", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Body Text Color", "default": "#212326" },
    { "type": "header", "content": "Image style" },
    { "type": "range", "id": "image_border_radius", "label": "Image Border Radius", "min": 0, "max": 20, "step": 2, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "od_header",
      "name": "Header Block",
      "settings": [
        {
          "type": "select",
          "id": "heading_tag",
          "label": "Heading SEO Tag",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" }
          ],
          "default": "h2"
        },
        { "type": "inline_richtext", "id": "section_heading", "label": "Main Heading", "default": "Trailblazing Tech" },
        {
          "type": "select",
          "id": "subheading_tag",
          "label": "Sub-Heading SEO Tag",
          "options": [
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" }
          ],
          "default": "h4"
        },
        { "type": "inline_richtext", "id": "subsection_heading", "label": "Sub-Heading", "default": "Trailblazing tech that rethinks how we recycle" }
      ]
    },
    {
      "type": "od_text",
      "name": "Rich Text Block",
      "settings": [
        { "type": "richtext", "id": "body_content", "label": "Body Content", "default": "<p>Imagine a future where the gear we love is made purely from preexisting materials.</p>" }
      ]
    },
    {
      "type": "od_image",
      "name": "Image Block",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Pick Block Image" },
        {
          "type": "select",
          "id": "image_aspect_ratio",
          "label": "Image Aspect Ratio (Cropping / Height)",
          "options": [
            { "value": "auto", "label": "Original (No Crop)" },
            { "value": "1/1", "label": "Square (1:1)" },
            { "value": "16/9", "label": "Landscape Wide (16:9)" },
            { "value": "4/3", "label": "Standard Landscape (4:3)" },
            { "value": "3/4", "label": "Portrait (3:4)" },
            { "value": "2/1", "label": "Cinematic Banner (2:1)" }
          ],
          "default": "auto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "OD Impact Content",
      "blocks": [
        { "type": "od_header" },
        { "type": "od_text" }
      ]
    }
  ]
}
{% endschema %}