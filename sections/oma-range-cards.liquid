{%- comment -%}
  oma-range-cards — "The Range" grid on the Workplace Coffee page. Every card
  is plain merchant-entered content (tag, image, title, blurb, size chips) --
  deliberately NOT tied to a real Product. These aren't purchasable SKUs on
  the storefront: corporate clients place their order separately, off-
  platform, so there's no Add to Cart or product link here, only the
  section's own CTA button (see cta_link, typically an in-page anchor like
  #build pointing at oma-programme-form.liquid's lead form).
{%- endcomment -%}
{% assign owid = section.id | replace: '-', '' | replace: '_', '' %}
{% style %}
.oma-range-cards-{{ owid }} {
  box-sizing: border-box;
  background: {{ section.settings.background_color }};
  padding: {{ section.settings.padding_top }}px clamp(20px, 4vw, 48px) {{ section.settings.padding_bottom }}px;
  font-family: var(--font-body-family);
  }
.oma-range-cards-{{ owid }} *, .oma-range-cards-{{ owid }} *::before, .oma-range-cards-{{ owid }} *::after {
  box-sizing: border-box;
  }
.oma-range-cards-{{ owid }} .inner {
  max-width: 1344px;
  margin: 0 auto;
  }
.oma-range-cards-{{ owid }} .head-row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px 40px;
  }
.oma-range-cards-{{ owid }} .eyebrow {
  font: 900 10.5px/1 var(--font-heading-family);
  letter-spacing: .18em;
  color: {{ section.settings.accent_color }};
  }
.oma-range-cards-{{ owid }} .heading {
  margin: 16px 0 0;
  font-family: var(--font-heading-family);
  font-weight: 900;
  font-size: clamp(28px, 3.4vw, 46px);
  line-height: 1.02;
  letter-spacing: -.03em;
  color: {{ section.settings.accent_color }};
  }
.oma-range-cards-{{ owid }} .cta {
  flex: none;
  text-decoration: none;
  border: 1.5px solid {{ section.settings.accent_color }};
  color: {{ section.settings.accent_color }};
  padding: 15px 26px;
  border-radius: 999px;
  font: 900 13px/1 var(--font-heading-family);
  white-space: nowrap;
  transition: background .15s ease, color .15s ease;
  }
.oma-range-cards-{{ owid }} .cta:hover {
  background: {{ section.settings.accent_color }};
  color: #ffffff;
  }
.oma-range-cards-{{ owid }} .grid {
  margin-top: 30px;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
  gap: 18px;
  }
.oma-range-cards-{{ owid }} .card {
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border: 2px solid {{ section.settings.accent_color }};
  border-radius: 12px;
  box-shadow: 6px 6px 0 {{ section.settings.accent_color }};
  overflow: hidden;
  }
.oma-range-cards-{{ owid }} .shot {
  position: relative;
  background: {{ section.settings.image_placeholder_background }};
  border-bottom: 1.5px solid {{ section.settings.accent_color }};
  aspect-ratio: 1 / 1;
  }
.oma-range-cards-{{ owid }} .shot img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  }
.oma-range-cards-{{ owid }} .shot-placeholder-text {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: flex-end;
  padding: 16px;
  background: repeating-linear-gradient(135deg, {{ section.settings.image_placeholder_background }} 0 9px, {{ section.settings.image_placeholder_stripe }} 9px 18px);
  }
.oma-range-cards-{{ owid }} .shot-placeholder-text span {
  font: 500 10.5px/1.35 ui-monospace, SFMono-Regular, Menlo, monospace;
  color: {{ section.settings.accent_color }};
  background: rgba(255, 255, 255, .9);
  padding: 6px 9px;
  border-radius: 4px;
  }
.oma-range-cards-{{ owid }} .tag {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 2;
  background: #ffffff;
  border: 1.5px solid {{ section.settings.accent_color }};
  color: {{ section.settings.accent_color }};
  padding: 7px 11px;
  border-radius: 999px;
  font: 900 9.5px/1 var(--font-heading-family);
  letter-spacing: .1em;
  text-transform: uppercase;
  }
.oma-range-cards-{{ owid }} .coming-soon {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 2;
  background: {{ section.settings.coming_soon_bg }};
  color: {{ section.settings.coming_soon_text }};
  padding: 7px 11px;
  border-radius: 999px;
  font: 900 9.5px/1 var(--font-heading-family);
  letter-spacing: .1em;
  text-transform: uppercase;
  }
.oma-range-cards-{{ owid }} .body {
  padding: 20px 20px 22px;
  display: flex;
  flex-direction: column;
  gap: 9px;
  flex: 1;
  }
.oma-range-cards-{{ owid }} .title {
  margin: 0;
  font-family: var(--font-heading-family);
  font-weight: 900;
  font-size: 20px;
  line-height: 1.08;
  letter-spacing: -.025em;
  color: {{ section.settings.accent_color }};
  }
.oma-range-cards-{{ owid }} .blurb {
  margin: 0;
  flex: 1;
  font-size: 14.5px;
  line-height: 1.5;
  color: {{ section.settings.text_color }};
  }
.oma-range-cards-{{ owid }} .chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 4px;
  }
.oma-range-cards-{{ owid }} .chip {
  font: 700 11px/1 var(--font-heading-family);
  padding: 8px 11px;
  border-radius: 999px;
  border: 1.5px solid color-mix(in srgb, {{ section.settings.accent_color }} 45%, transparent);
  color: {{ section.settings.accent_color }};
  }
{% endstyle %}
{%- liquid
  assign card_blocks = section.blocks | where: 'type', 'card'
-%}
<div class="oma-range-cards-{{ owid }}">
  <div class="inner">
    <div class="head-row">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
        <h2 class="heading">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.show_cta and section.settings.cta_label != blank -%}
        <a class="cta" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}
    </div>

    {%- if card_blocks.size > 0 -%}
      <div class="grid">
        {%- for block in card_blocks -%}
          <div class="card" {{ block.shopify_attributes }}>
            {%- comment -%}
              Not named .media: base.css's global `.media > *` rule stretches
              every direct child of a `.media` element to 100% width/height,
              which turned these pill badges into full circles.
            {%- endcomment -%}
            <div class="shot">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {%- else -%}
                <div class="shot-placeholder-text"><span>{{ section.settings.placeholder_label | escape }} — {{ block.settings.title | escape }}</span></div>
              {%- endif -%}
              {%- if block.settings.tag != blank -%}<span class="tag">{{ block.settings.tag | escape }}</span>{%- endif -%}
              {%- if block.settings.coming_soon -%}<span class="coming-soon">{{ section.settings.coming_soon_label | escape }}</span>{%- endif -%}
            </div>
            <div class="body">
              <h3 class="title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.blurb != blank -%}<p class="blurb">{{ block.settings.blurb }}</p>{%- endif -%}
              {%- if block.settings.size_chips != blank -%}
                <div class="chips">
                  {%- assign chip_list = block.settings.size_chips | split: ',' -%}
                  {%- for chip in chip_list -%}
                    <span class="chip">{{ chip | strip | escape }}</span>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "OMA Range Cards",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE RANGE" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Four coffees, one programme" },
    { "type": "header", "content": "Button" },
    { "type": "checkbox", "id": "show_cta", "label": "Show button", "default": true },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "See full range & pricing" },
    { "type": "text", "id": "cta_link", "label": "Button link", "info": "An in-page anchor (e.g. #build to point at the Build Your Programme form) or any URL.", "default": "#build" },
    { "type": "header", "content": "Card copy" },
    { "type": "text", "id": "coming_soon_label", "label": "\"Coming soon\" badge label", "default": "COMING SOON" },
    { "type": "text", "id": "placeholder_label", "label": "Image placeholder label", "default": "product shot" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#F7F5F1" },
    { "type": "color", "id": "accent_color", "label": "Accent (borders, titles, tags)", "default": "#FF3F00" },
    { "type": "color", "id": "text_color", "label": "Blurb text color", "default": "#00180C" },
    { "type": "color", "id": "coming_soon_bg", "label": "\"Coming soon\" badge background", "default": "#FBB925" },
    { "type": "color", "id": "coming_soon_text", "label": "\"Coming soon\" badge text", "default": "#00180C" },
    { "type": "color", "id": "image_placeholder_background", "label": "Image placeholder background", "default": "#FFE4E7" },
    { "type": "color", "id": "image_placeholder_stripe", "label": "Image placeholder stripe", "default": "#FFD2D7" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Coffee card",
      "settings": [
        { "type": "text", "id": "tag", "label": "Tag", "default": "HOUSE BLEND" },
        { "type": "checkbox", "id": "coming_soon", "label": "Mark as \"Coming soon\"", "default": false },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Coffee name" },
        { "type": "textarea", "id": "blurb", "label": "Blurb" },
        { "type": "text", "id": "size_chips", "label": "Size chips", "info": "Comma-separated, e.g. \"500g, 1kg\".", "default": "500g, 1kg" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OMA Range Cards",
      "blocks": [
        { "type": "card", "settings": { "tag": "HOUSE BLEND", "coming_soon": true, "title": "Rimba Jawa", "blurb": "Our high-volume workplace blend for busy offices and coworking spaces.", "size_chips": "500g, 1kg" } },
        { "type": "card", "settings": { "tag": "EVERYDAY CHOICE", "title": "Forest Trail", "blurb": "Chocolate and toasty nuts. Forgiving to brew, reliable through a busy morning.", "size_chips": "500g, 1kg" } },
        { "type": "card", "settings": { "tag": "FRUITY & FLORAL", "title": "Wild Bloom", "blurb": "Bright, floral, a little unhinged.", "size_chips": "500g, 1kg" } },
        { "type": "card", "settings": { "tag": "RARE MICRO-LOT", "title": "Limited Reserve", "blurb": "For gifting and occasions worth celebrating.", "size_chips": "100g" } }
      ]
    }
  ]
}
{% endschema %}
