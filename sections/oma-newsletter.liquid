{%- comment -%}
  oma-newsletter — rebuilt to match the redesign's "Dispatch newsletter"
  banner: a wide accent-colored band, eyebrow + heading + body on the
  left, a pill-shaped email capsule on the right, stacking on mobile.
  Not placed on any page yet (checked before rebuilding) — safe to
  replace the previous centered/stacked layout outright rather than add
  it as a variant.
{%- endcomment -%}
{% assign owid = section.id | replace: '-', '' | replace: '_', '' %}
{% style %}
.oma-newsletter-{{ owid }} {
  box-sizing: border-box;
  background: {{ section.settings.background_color }};
  padding: {{ section.settings.padding_top }}px clamp(20px, 4vw, 48px) {{ section.settings.padding_bottom }}px;
  font-family: var(--font-body-family);
  }
.oma-newsletter-{{ owid }} *, .oma-newsletter-{{ owid }} *::before, .oma-newsletter-{{ owid }} *::after {
  box-sizing: border-box;
  }
.oma-newsletter-{{ owid }} .inner {
  max-width: 1440px;
  margin: 0 auto;
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: 28px 48px;
  }
.oma-newsletter-{{ owid }} .copy {
  flex: 1 1 420px;
  min-width: 0;
  max-width: 620px;
  }
.oma-newsletter-{{ owid }} .eyebrow {
  font: 900 12px/1.3 var(--font-heading-family);
  letter-spacing: .14em;
  text-transform: uppercase;
  color: {{ section.settings.eyebrow_color }};
  }
.oma-newsletter-{{ owid }} .heading {
  margin: 14px 0 0;
  font-family: var(--font-heading-family);
  font-weight: 900;
  font-size: clamp(34px, 4.4vw, 56px);
  line-height: .95;
  letter-spacing: -.04em;
  color: {{ section.settings.heading_color }};
  text-wrap: balance;
  }
.oma-newsletter-{{ owid }} .body {
  margin: 18px 0 0;
  font-size: 16.5px;
  line-height: 1.6;
  color: {{ section.settings.body_color }};
  text-wrap: pretty;
  }
.oma-newsletter-{{ owid }} .body p {
  margin: 0;
  }
.oma-newsletter-{{ owid }} form {
  flex: 1 1 420px;
  max-width: 560px;
  }
.oma-newsletter-{{ owid }} .visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  }
.oma-newsletter-{{ owid }} .capsule {
  display: flex;
  gap: 8px;
  padding: 6px;
  background: {{ section.settings.capsule_background }};
  border-radius: 100px;
  }
.oma-newsletter-{{ owid }} .capsule input[type="email"] {
  flex: 1;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  padding: 0 18px;
  font: 400 14.5px/1 var(--font-body-family);
  color: {{ section.settings.input_text_color }};
  }
.oma-newsletter-{{ owid }} .submit {
  flex: none;
  min-height: 48px;
  cursor: pointer;
  border: 0;
  background: {{ section.settings.button_background }};
  color: {{ section.settings.button_text_color }};
  padding: 0 24px;
  border-radius: 100px;
  font: 900 12px/1 var(--font-heading-family);
  transition: background-color .15s ease;
  }
.oma-newsletter-{{ owid }} .submit:hover {
  background: {{ section.settings.button_hover_background }};
  }
.oma-newsletter-{{ owid }} .errors {
  margin-top: 10px;
  font: 700 13px/1.4 var(--font-body-family);
  color: {{ section.settings.heading_color }};
  }
.oma-newsletter-{{ owid }} .success {
  flex: 1 1 420px;
  max-width: 560px;
  margin: 0;
  font-family: var(--font-heading-family);
  font-weight: 900;
  font-size: 19px;
  line-height: 1.3;
  color: {{ section.settings.heading_color }};
  }
@media (prefers-reduced-motion: reduce) {
  .oma-newsletter-{{ owid }} * {
  transition: none !important;
  }
}
{% endstyle %}
{% assign form_id = 'oma-newsletter-' | append: section.id %}
<div class="oma-newsletter-{{ owid }}">
  <div class="inner">
    <div class="copy">
      {%- if section.settings.eyebrow_text != blank -%}
        <div class="eyebrow">{{ section.settings.eyebrow_text | escape }}</div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="body">{{ section.settings.body }}</div>
      {%- endif -%}
    </div>
    {% form 'customer', id: form_id %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p role="status" class="success">{{ section.settings.success_message | escape }}</p>
      {%- else -%}
        <label class="visually-hidden" for="{{ form_id }}-email">{{ section.settings.email_label | escape }}</label>
        <div class="capsule">
          <input id="{{ form_id }}-email" type="email" name="contact[email]" value="{{ form.email | escape }}" placeholder="{{ section.settings.placeholder | escape }}" autocomplete="email" autocapitalize="off" required {% if form.errors %}aria-invalid="true" aria-describedby="{{ form_id }}-errors"{% endif %}>
          <button class="submit" type="submit">{{ section.settings.button_label | escape }}</button>
        </div>
        {%- if form.errors -%}
          <div id="{{ form_id }}-errors" class="errors" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
      {%- endif -%}
    {% endform %}
  </div>
</div>
{% schema %}
{
  "name": "OMA Newsletter",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "default": "The Dispatch, by email"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Get the next story first"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>New expeditions and reflections, sent to your inbox when they're published.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "You’re on the list. The next story will land in your inbox."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FF3F00"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#FCD0FD"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "capsule_background",
      "label": "Email field background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "Email field text color",
      "default": "#00180C"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#FF3F00"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button hover background",
      "default": "#D63200"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "OMA Newsletter",
      "blocks": []
    }
  ]
}
{% endschema %}
