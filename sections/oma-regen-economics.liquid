{%- comment -%}
  oma-regen-economics — Regenerative Agriculture page, chapter 04 ("The
  economics of regenerative farming") plus the page's closing full-bleed
  statement band. Combined into one section the way oma-impact-callout.liquid
  pairs its reason cards with a closing banner card -- same precedent, two
  tones in one file rather than a second section just for the band.
{%- endcomment -%}
{% assign owid = section.id | replace: '-', '' | replace: '_', '' %}
{% style %}
.oma-regen-economics-{{ owid }} {
  box-sizing: border-box;
  font-family: var(--font-body-family);
  }
.oma-regen-economics-{{ owid }} *, .oma-regen-economics-{{ owid }} *::before, .oma-regen-economics-{{ owid }} *::after {
  box-sizing: border-box;
  }
.oma-regen-economics-{{ owid }} .chapter {
  background: {{ section.settings.background_color }};
  border-top: 1.5px solid {{ section.settings.accent_color }};
  padding: clamp(48px, 6vw, 80px) clamp(20px, 4vw, 48px);
  scroll-margin-top: 112px;
  }
.oma-regen-economics-{{ owid }} .inner {
  max-width: 1440px;
  margin: 0 auto;
  }
.oma-regen-economics-{{ owid }} .head {
  max-width: 900px;
  }
.oma-regen-economics-{{ owid }} .eyebrow {
  font: 800 12px/1.3 var(--font-heading-family);
  letter-spacing: .14em;
  color: {{ section.settings.accent_color }};
  }
.oma-regen-economics-{{ owid }} h2 {
  margin: 16px 0 0;
  font-family: var(--font-heading-family);
  font-weight: 800;
  font-size: clamp(34px, 4.4vw, 60px);
  line-height: .98;
  letter-spacing: -.04em;
  color: {{ section.settings.accent_color }};
  text-wrap: balance;
  }
.oma-regen-economics-{{ owid }} .statement-line {
  margin: 16px 0 0;
  font-family: var(--font-heading-family);
  font-weight: 800;
  font-size: clamp(18px, 1.6vw, 22px);
  line-height: 1.3;
  letter-spacing: -.015em;
  color: {{ section.settings.text_color }};
  }
.oma-regen-economics-{{ owid }} .loops {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  margin-top: 32px;
  }
.oma-regen-economics-{{ owid }} .loop {
  border: 2px solid {{ section.settings.accent_color }};
  border-radius: 10px;
  padding: clamp(22px, 3vw, 32px);
  min-width: 0;
  }
.oma-regen-economics-{{ owid }} .loop.is-light {
  background: #ffffff;
  }
.oma-regen-economics-{{ owid }} .loop.is-accent {
  background: {{ section.settings.accent_color }};
  }
.oma-regen-economics-{{ owid }} .loop-label {
  font: 800 11px/1.3 var(--font-heading-family);
  letter-spacing: .12em;
  color: {{ section.settings.accent_color }};
  }
.oma-regen-economics-{{ owid }} .loop.is-accent .loop-label {
  color: #ffffff;
  }
.oma-regen-economics-{{ owid }} .loop-steps {
  list-style: none;
  margin: 16px 0 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  }
.oma-regen-economics-{{ owid }} .loop-step {
  display: grid;
  grid-template-columns: 28px minmax(0, 1fr);
  gap: 12px;
  align-items: baseline;
  padding: 10px 0;
  border-top: 1.5px solid {{ section.settings.loop_rule_color }};
  }
.oma-regen-economics-{{ owid }} .loop.is-accent .loop-step {
  border-top-color: rgba(255, 255, 255, .45);
  }
.oma-regen-economics-{{ owid }} .loop-step .arrow {
  font: 800 16px/1 var(--font-heading-family);
  color: {{ section.settings.accent_color }};
  }
.oma-regen-economics-{{ owid }} .loop.is-accent .loop-step .arrow {
  color: #ffffff;
  }
.oma-regen-economics-{{ owid }} .loop-step .t {
  font: 800 17px/1.3 var(--font-heading-family);
  letter-spacing: -.01em;
  color: {{ section.settings.accent_color }};
  }
.oma-regen-economics-{{ owid }} .loop.is-accent .loop-step .t {
  color: #ffffff;
  }
.oma-regen-economics-{{ owid }} .columns {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px 48px;
  margin-top: 32px;
  }
.oma-regen-economics-{{ owid }} .columns > div > * {
  margin: 0 0 14px;
  font-size: 14.5px;
  line-height: 1.6;
  font-weight: 500;
  color: {{ section.settings.text_color }};
  text-wrap: pretty;
  }
.oma-regen-economics-{{ owid }} .columns > div > *:last-child {
  margin-bottom: 0;
  }
.oma-regen-economics-{{ owid }} .statement {
  background: {{ section.settings.statement_background }};
  padding: clamp(48px, 6vw, 80px) clamp(20px, 4vw, 48px);
  }
.oma-regen-economics-{{ owid }} .statement .inner > p {
  margin: 0;
  max-width: 1040px;
  font-family: var(--font-heading-family);
  font-weight: 800;
  font-size: clamp(34px, 4.6vw, 64px);
  line-height: 1;
  letter-spacing: -.04em;
  color: {{ section.settings.statement_text_color }};
  text-wrap: balance;
  }
.oma-regen-economics-{{ owid }} .statement-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 20px 48px;
  margin-top: 32px;
  padding-top: 24px;
  border-top: 1.5px solid {{ section.settings.statement_text_color }};
  }
.oma-regen-economics-{{ owid }} .statement-support {
  flex: 1 1 420px;
  margin: 0;
  max-width: 560px;
  font-size: 14.5px;
  line-height: 1.6;
  font-weight: 500;
  color: {{ section.settings.statement_text_color }};
  text-wrap: pretty;
  }
.oma-regen-economics-{{ owid }} .statement-ctas {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  }
.oma-regen-economics-{{ owid }} .cta-filled {
  text-decoration: none;
  background: {{ section.settings.statement_text_color }};
  color: {{ section.settings.statement_background }};
  padding: 15px 24px;
  border-radius: 100px;
  font: 800 12.5px/1 var(--font-heading-family);
  transition: opacity .15s ease;
  }
.oma-regen-economics-{{ owid }} .cta-filled:hover {
  opacity: .85;
  }
.oma-regen-economics-{{ owid }} .cta-outline {
  text-decoration: none;
  border: 1.5px solid {{ section.settings.statement_text_color }};
  color: {{ section.settings.statement_text_color }};
  padding: 13.5px 22px;
  border-radius: 100px;
  font: 800 12.5px/1 var(--font-heading-family);
  transition: background .15s ease, color .15s ease;
  }
.oma-regen-economics-{{ owid }} .cta-outline:hover {
  background: {{ section.settings.statement_text_color }};
  color: {{ section.settings.statement_background }};
  }
@media (max-width: 749px) {
  .oma-regen-economics-{{ owid }} .loops,
  .oma-regen-economics-{{ owid }} .columns {
    grid-template-columns: 1fr;
  }
}
{% endstyle %}
<div class="oma-regen-economics-{{ owid }}">
  <div id="regen-economics" class="chapter">
    <div class="inner">
      <div class="head">
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.statement_line != blank -%}<p class="statement-line">{{ section.settings.statement_line | escape }}</p>{%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <div class="loops">
          {%- for block in section.blocks -%}
            {%- liquid
              assign steps = block.settings.steps | newline_to_br | split: '<br />'
            -%}
            <div class="loop {% if block.settings.tone == 'accent' %}is-accent{% else %}is-light{% endif %}" {{ block.shopify_attributes }}>
              <div class="loop-label">{{ block.settings.label | escape }}</div>
              <ol class="loop-steps">
                {%- for step in steps -%}
                  {%- assign step = step | strip -%}
                  {%- if step != blank -%}
                    <li class="loop-step">
                      <span class="arrow">{% if forloop.first %}{{ block.settings.first_arrow | default: '↻' }}{% else %}{{ block.settings.repeat_arrow | default: '↓' }}{% endif %}</span>
                      <span class="t">{{ step }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ol>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="columns">
        <div>{{ section.settings.body_left }}</div>
        <div>{{ section.settings.body_right }}</div>
      </div>
    </div>
  </div>
  <div class="statement">
    <div class="inner">
      <p>{{ section.settings.statement_heading }}</p>
      <div class="statement-row">
        {%- if section.settings.statement_support != blank -%}
          <p class="statement-support">{{ section.settings.statement_support | escape }}</p>
        {%- endif -%}
        <div class="statement-ctas">
          {%- if section.settings.cta_1_label != blank and section.settings.cta_1_link != blank -%}
            <a class="cta-filled" href="{{ section.settings.cta_1_link }}">{{ section.settings.cta_1_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.cta_2_label != blank and section.settings.cta_2_link != blank -%}
            <a class="cta-outline" href="{{ section.settings.cta_2_link }}">{{ section.settings.cta_2_label | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "OMA Regen Economics",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "04 · THE ECONOMICS" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "The economics of regenerative farming" },
    { "type": "text", "id": "statement_line", "label": "Bold statement line", "default": "Conventional farming has a debt problem that is far worse than financial debt." },
    { "type": "richtext", "id": "body_left", "label": "Body (left column)", "default": "<p>Degraded soil needs more external inputs to stay productive. More inputs cost more money. Higher costs squeeze farmers' margins. Farmers push the land harder to recover lost margins. Intensive farming further degrades the soil. It's a spiral that deepens every season.</p><p>The assumption that regenerative farming is a financial sacrifice misses the longer arc entirely. Healthy soil needs fewer inputs. Fewer inputs mean lower costs. Lower costs improve margins, even before crop yields increase. The economics of regenerative farming compound.</p>" },
    { "type": "richtext", "id": "body_right", "label": "Body (right column)", "default": "<p>Even the choice of what gets planted reflects this logic. Take cover crops as an example: oats and barley rebuild soil fertility while generating income at the same time. In a well-designed regenerative system, the line between cover crop and cash crop begins to blur.</p><p>While this doesn't happen overnight, farms committed to regenerative agriculture consistently outperform their conventional neighbours in resilience, soil health, and long-term productivity. The transition takes years, sometimes decades — but it ends the financial and ecological debt spiral for good.</p>" },
    { "type": "header", "content": "Colors — economics chapter" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFE4E7" },
    { "type": "color", "id": "accent_color", "label": "Accent (eyebrow, heading, loop cards)", "default": "#FF3F00" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#00180C" },
    { "type": "color", "id": "loop_rule_color", "label": "Loop card step divider (light card)", "default": "#FFE4E7" },
    { "type": "header", "content": "Closing statement band" },
    { "type": "richtext", "id": "statement_heading", "label": "Statement heading", "default": "<p>The regenerative investment compounds for generations.</p>" },
    { "type": "text", "id": "statement_support", "label": "Supporting line", "default": "Our coffee is grown using regenerative practices inside agroforestry systems, so each harvest improves soil health while our forest stays standing." },
    { "type": "text", "id": "cta_1_label", "label": "Primary button label", "default": "Shop the coffee →" },
    { "type": "url", "id": "cta_1_link", "label": "Primary button link" },
    { "type": "text", "id": "cta_2_label", "label": "Secondary button label", "default": "Meet our origins" },
    { "type": "url", "id": "cta_2_link", "label": "Secondary button link" },
    { "type": "color", "id": "statement_background", "label": "Statement background", "default": "#FF3F00" },
    { "type": "color", "id": "statement_text_color", "label": "Statement text", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "loop_card",
      "name": "Loop card",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "info": "e.g. \"CONVENTIONAL · THE DEBT SPIRAL\"" },
        { "type": "textarea", "id": "steps", "label": "Steps", "info": "One per line." },
        { "type": "text", "id": "first_arrow", "label": "First step's arrow", "default": "↻" },
        { "type": "text", "id": "repeat_arrow", "label": "Other steps' arrow", "default": "↓" },
        {
          "type": "select",
          "id": "tone",
          "label": "Tone",
          "options": [
            { "value": "light", "label": "Light" },
            { "value": "accent", "label": "Accent" }
          ],
          "default": "light"
        }
      ],
      "limit": 4
    }
  ],
  "presets": [
    {
      "name": "OMA Regen Economics",
      "blocks": [
        {
          "type": "loop_card",
          "settings": {
            "label": "CONVENTIONAL · THE DEBT SPIRAL",
            "steps": "Degraded soil needs more external inputs\nMore inputs cost more money\nHigher costs squeeze farmers' margins\nFarmers push the land harder\nIntensive farming further degrades the soil",
            "first_arrow": "↻",
            "repeat_arrow": "↓",
            "tone": "light"
          }
        },
        {
          "type": "loop_card",
          "settings": {
            "label": "REGENERATIVE · THE COMPOUNDING LOOP",
            "steps": "Soil health rises\nSavings on inputs grow\nFarmers' margins improve\nResilience builds season after season\nThe economics compound",
            "first_arrow": "↑",
            "repeat_arrow": "↑",
            "tone": "accent"
          }
        }
      ]
    }
  ]
}
{% endschema %}
