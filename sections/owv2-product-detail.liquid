{%- comment -%}
  owv2-product-detail — "About this bag" spec table beside the brew guide
  (canvas 4a / 6a / 6b / 5b). An assortment swaps the brew guide for
  "What's inside": add Inside blocks and the brew cards are not shown.

  Three brew cards share the column; four or more become a snap swipe with a
  224px floor. On phones the same 224px floor means even two cards already
  overflow, so the row is swipeable there too, showing the full card (not a
  collapsed summary row) -- see the mobile brew rules in owv2-product.css.

  Spec rows are fixed section settings, not blocks: the same five rows
  (Elevation, Crop year, Varietal, Roast date, Peak freshness) apply to every
  coffee, so there's nothing for a per-instance block list to vary -- only
  the VALUES differ per product, and those already come from
  product.metafields.custom.* the same way name/place do elsewhere on this
  template. A row hides itself when its value is blank, so a coffee missing
  one of these metafields just shows fewer rows instead of an empty one.
  Brew methods genuinely do vary per coffee (a product might have two brew
  methods, another five), so those stay as blocks.
{%- endcomment -%}

{{ 'owv2-product.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} .od-pdp {
    --odp-red: {{ section.settings.color_red }};
    --odp-pink: {{ section.settings.color_pink }};
    --odp-yellow: {{ section.settings.color_yellow }};
    --odp-ink: {{ section.settings.color_ink }};
    --odp-page: {{ section.settings.color_page }};
  }
</style>

{%- liquid
  assign brews = section.blocks | where: 'type', 'brew'
  assign inside = section.blocks | where: 'type', 'inside'

  assign has_specs = false
  if section.settings.spec_elevation_value != blank or section.settings.spec_crop_year_value != blank or section.settings.spec_varietal_value != blank or section.settings.spec_roast_date_value != blank or section.settings.spec_peak_value != blank
    assign has_specs = true
  endif
-%}

<div class="od-pdp">
  <div class="odp-detail">
    <div class="odp-specs">
      <h2 class="odp-label">{{ section.settings.specs_title }}</h2>
      {%- if has_specs -%}
        <dl class="odp-specs__list">
          {%- if section.settings.spec_elevation_value != blank -%}
            <dt>{{ section.settings.spec_elevation_label }}</dt>
            <dd>{{ section.settings.spec_elevation_value }}</dd>
          {%- endif -%}
          {%- if section.settings.spec_crop_year_value != blank -%}
            <dt>{{ section.settings.spec_crop_year_label }}</dt>
            <dd>{{ section.settings.spec_crop_year_value }}</dd>
          {%- endif -%}
          {%- if section.settings.spec_varietal_value != blank -%}
            <dt>{{ section.settings.spec_varietal_label }}</dt>
            <dd>{{ section.settings.spec_varietal_value }}</dd>
          {%- endif -%}
          {%- if section.settings.spec_roast_date_value != blank -%}
            <dt>{{ section.settings.spec_roast_date_label }}</dt>
            <dd>{{ section.settings.spec_roast_date_value }}</dd>
          {%- endif -%}
          {%- if section.settings.spec_peak_value != blank -%}
            <dt>{{ section.settings.spec_peak_label }}</dt>
            <dd>{{ section.settings.spec_peak_value }}</dd>
          {%- endif -%}
        </dl>
      {%- endif -%}
    </div>

    <div class="odp-side">
      {%- if inside.size > 0 -%}
        <div class="odp-side__head">
          <h2 class="odp-label">{{ section.settings.inside_title }}</h2>
        </div>
        <div class="odp-inside">
          {%- for block in inside -%}
            {%- assign p = block.settings.product -%}
            {%- if p != blank -%}
              <a class="odp-inside__item" href="{{ p.url }}" {{ block.shopify_attributes }}>
                {%- if p.featured_media -%}
                  {{ p.featured_media.preview_image | image_url: width: 120 | image_tag: class: 'odp-inside__img', loading: 'lazy', alt: '' }}
                {%- endif -%}
                <span>
                  <span class="odp-inside__name" style="display:block">{{ p.title }}</span>
                  {%- if block.settings.note != blank -%}
                    <span class="odp-inside__note" style="display:block">{{ block.settings.note }}</span>
                  {%- endif -%}
                </span>
                <span class="odp-inside__size">{{ block.settings.size }}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.inside_foot != blank -%}
          <p class="odp-inside__foot">{{ section.settings.inside_foot }}</p>
        {%- endif -%}
      {%- elsif brews.size > 0 -%}
        <div class="odp-side__head">
          <h2 class="odp-label">{{ section.settings.brew_title }}</h2>
          {%- if section.settings.brew_note != blank -%}
            <span class="odp-side__note">{{ section.settings.brew_note }}</span>
          {%- endif -%}
        </div>
        <div class="odp-brew odp-scroll">
          {%- for block in brews -%}
            {%- liquid
              assign b = block.settings
              assign tag = 'div'
              if b.url != blank
                assign tag = 'a'
              endif
            -%}
            <{{ tag }} class="odp-brew__card" {% if tag == 'a' %}href="{{ b.url }}"{% endif %} {{ block.shopify_attributes }}>
              <div class="odp-brew__top">
                <span class="odp-brew__name">{{ b.title }}</span>
                {%- if b.summary != blank -%}<span class="odp-brew__summary">{{ b.summary }}</span>{%- endif -%}
                {%- if b.preferred -%}
                  <span class="odp-tag">{{ section.settings.preferred_label }}</span>
                {%- elsif section.settings.plain_label != blank -%}
                  <span class="odp-tag odp-tag--plain">{{ section.settings.plain_label }}</span>
                {%- endif -%}
              </div>
              <dl class="odp-brew__lines">
                {%- if b.grind != blank -%}<div class="odp-brew__line"><dt>{{ section.settings.k_grind }}</dt><dd>{{ b.grind }}</dd></div>{%- endif -%}
                {%- if b.coffee != blank -%}<div class="odp-brew__line"><dt>{{ section.settings.k_coffee }}</dt><dd>{{ b.coffee }}</dd></div>{%- endif -%}
                {%- if b.water != blank -%}<div class="odp-brew__line"><dt>{{ section.settings.k_water }}</dt><dd>{{ b.water }}</dd></div>{%- endif -%}
                {%- if b.temp != blank -%}<div class="odp-brew__line"><dt>{{ section.settings.k_temp }}</dt><dd>{{ b.temp }}</dd></div>{%- endif -%}
                {%- if b.time != blank -%}<div class="odp-brew__line"><dt>{{ section.settings.k_time }}</dt><dd>{{ b.time }}</dd></div>{%- endif -%}
              </dl>
              {%- if b.preferred -%}
                <span class="odp-tag odp-brew__badge">{{ section.settings.preferred_label }}</span>
              {%- endif -%}
              {%- if tag == 'a' -%}
                {%- if section.settings.guide_label != blank -%}<span class="odp-brew__go">{{ section.settings.guide_label }}</span>{%- endif -%}
                <span class="odp-brew__arrow" aria-hidden="true">→</span>
              {%- endif -%}
            </{{ tag }}>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "OWV2 Specs & brew",
  "tag": "section",
  "class": "owv2-section owv2-product-detail",
  "enabled_on": { "templates": ["product"] },
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "specs_title", "label": "Specs heading", "default": "About this bag" },
    { "type": "text", "id": "spec_elevation_label", "label": "Row label — elevation", "default": "Elevation" },
    { "type": "text", "id": "spec_elevation_value", "label": "Row value — elevation", "default": "{{ product.metafields.custom.elevation_masl.value }} MASL", "info": "Defaults to the elevation_masl metafield. Blank hides the row." },
    { "type": "text", "id": "spec_crop_year_label", "label": "Row label — crop year", "default": "Crop year" },
    { "type": "text", "id": "spec_crop_year_value", "label": "Row value — crop year", "default": "{{ product.metafields.custom.crop_year.value }}", "info": "Defaults to the crop_year metafield. Blank hides the row." },
    { "type": "text", "id": "spec_varietal_label", "label": "Row label — varietal", "default": "Varietal" },
    { "type": "text", "id": "spec_varietal_value", "label": "Row value — varietal", "default": "{{ product.metafields.custom.varietal_all_listed.value }}", "info": "Defaults to the varietal_all_listed metafield. Blank hides the row." },
    { "type": "text", "id": "spec_roast_date_label", "label": "Row label — roast date", "default": "Roast date" },
    { "type": "text", "id": "spec_roast_date_value", "label": "Row value — roast date", "default": "Printed on every bag", "info": "No metafield for this yet — same text for every coffee. Blank hides the row." },
    { "type": "text", "id": "spec_peak_label", "label": "Row label — peak freshness", "default": "Peak freshness" },
    { "type": "text", "id": "spec_peak_value", "label": "Row value — peak freshness", "default": "Day 7 to month 3 after roast", "info": "No metafield for this yet — same text for every coffee. Blank hides the row." },
    { "type": "header", "content": "Brew guide" },
    { "type": "text", "id": "brew_title", "label": "Heading", "default": "How to brew it" },
    { "type": "text", "id": "brew_note", "label": "Note", "default": "The same beans taste different, depending on how it's brewed." },
    { "type": "text", "id": "preferred_label", "label": "Preferred tag", "default": "HOW WE PREFER IT" },
    { "type": "text", "id": "plain_label", "label": "Other methods tag", "default": "ALSO WORTH IT", "info": "Blank hides it." },
    { "type": "text", "id": "guide_label", "label": "Link label", "default": "Guide →", "info": "Shown on methods that have a link." },
    { "type": "text", "id": "k_grind", "label": "Row label — grind", "default": "GRIND" },
    { "type": "text", "id": "k_coffee", "label": "Row label — coffee", "default": "COFFEE" },
    { "type": "text", "id": "k_water", "label": "Row label — water", "default": "WATER" },
    { "type": "text", "id": "k_temp", "label": "Row label — temperature", "default": "TEMP" },
    { "type": "text", "id": "k_time", "label": "Row label — time", "default": "TIME" },
    { "type": "header", "content": "What's inside", "info": "Used instead of the brew guide when the section has Inside blocks." },
    { "type": "text", "id": "inside_title", "label": "Heading", "default": "What's inside" },
    { "type": "text", "id": "inside_foot", "label": "Footnote", "default": "Each coffee brews a little differently — the guide travels in the box, and every bag links to its own method." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_red", "label": "Brand red", "default": "#FF3F00" },
    { "type": "color", "id": "color_pink", "label": "Salmon (card hover)", "default": "#FFE4E7" },
    { "type": "color", "id": "color_yellow", "label": "Sunbrella", "default": "#FBB925" },
    { "type": "color", "id": "color_ink", "label": "Text", "default": "#00180C" },
    { "type": "color", "id": "color_page", "label": "Background", "default": "#F7F5F1", "info": "Sand #F7F5F1 or white #FFFFFF." }
  ],
  "blocks": [
    {
      "type": "brew",
      "name": "Brew method",
      "settings": [
        { "type": "text", "id": "title", "label": "Method", "default": "Pour-over" },
        { "type": "text", "id": "summary", "label": "Summary", "default": "1:16 · one mug", "info": "Shown on phones instead of the table." },
        { "type": "checkbox", "id": "preferred", "label": "How we prefer it", "default": false },
        { "type": "url", "id": "url", "label": "Guide link" },
        { "type": "text", "id": "grind", "label": "Grind", "default": "Medium" },
        { "type": "text", "id": "coffee", "label": "Coffee", "default": "22 g" },
        { "type": "text", "id": "water", "label": "Water", "default": "350 g" },
        { "type": "text", "id": "temp", "label": "Temperature", "default": "94°C" },
        { "type": "text", "id": "time", "label": "Time", "default": "3:00" }
      ]
    },
    {
      "type": "inside",
      "name": "Inside (assortment)",
      "settings": [
        { "type": "product", "id": "product", "label": "Coffee" },
        { "type": "text", "id": "note", "label": "Note" },
        { "type": "text", "id": "size", "label": "Size", "default": "100 g" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OWV2 Specs & brew",
      "blocks": [
        { "type": "brew", "settings": { "title": "Pour-over", "summary": "1:16 · one mug", "preferred": true, "grind": "Medium", "coffee": "22 g", "water": "350 g", "temp": "94°C", "time": "3:00" } },
        { "type": "brew", "settings": { "title": "Cold brew", "summary": "1:12 · one jug", "preferred": true, "grind": "Coarse", "coffee": "80 g", "water": "1 L", "temp": "Cold", "time": "16 hrs" } },
        { "type": "brew", "settings": { "title": "Nitro", "summary": "1:8 concentrate · charged", "preferred": false, "grind": "Coarse", "coffee": "125 g", "water": "1 L", "temp": "Cold", "time": "18 hrs" } }
      ]
    }
  ]
}
{% endschema %}
