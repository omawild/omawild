  "presets": [
    {
      "name": "OMA Vision",
      "blocks": [
        { "type": "story_note", "settings": { "caption": "It started with a one-way ticket to Bali, in search of answers we could no longer find in the rush of everyday life.", "placeholder": "Drop photo: arriving in Bali" } },
        { "type": "story_note", "settings": { "caption": "That summer, we traded the comforts of the city to live and learn alongside those who grew more than just our food.", "placeholder": "Drop photo: living with farmers" } },
        { "type": "story_note", "settings": { "caption": "We got our hands dirty restoring degraded land while harnessing the river to power a local village.", "placeholder": "Drop photo: land restoration / river power" } },
        { "type": "story_note", "settings": { "caption": "We even built a permaculture school, with our bare hands (and a lot of sweat).", "placeholder": "Drop photo: THKB Permaculture Center build" } },
        { "type": "story_note", "settings": { "caption": "An interview with a rice farmer changed the way we saw our future.", "placeholder": "Drop photo: rice farmer interview" } },
        { "type": "story_note", "settings": { "caption": "We began to understand something we had forgotten: everything we need depends on nature.", "placeholder": "Drop field photo 06" } },
        { "type": "story_note", "settings": { "caption": "What started as volunteering in 2023 became something we couldn't walk away from. We kept returning.", "placeholder": "Drop field photo 07" } },
        { "type": "ors_card", "settings": { "number": "01", "title": "Grown under trees.", "body": "Coffee grown in agroforestry: planted among shade and fruit trees to support local biodiversity and nourish soil health." } },
        { "type": "ors_card", "settings": { "number": "02", "title": "Zero synthetic inputs.", "body": "No synthetic fertilisers, pesticides or herbicides. Natural inputs made on the farm, like compost or neem sprays, are welcome." } },
        { "type": "ors_card", "settings": { "number": "03", "title": "Three crops or more.", "body": "Crop intercropped with at least three species, not varieties. For example: coffee, banana and cacao on the same land." } },
        { "type": "ors_card", "settings": { "number": "04", "title": "Verified on the ground.", "body": "Every farm is visited by us or a trusted partner and checked against the same criteria." } },
        { "type": "chapter", "settings": { "chapter": "CHAPTER 01", "status": "ON SHELVES", "title": "Specialty roast coffee", "body": "Regeneratively sourced coffee for the morning ritual, sold by subscription, in offices and at events.", "bg": "#FFE4E7", "pill_bg": "#FF3F00", "pill_ink": "#FFFFFF", "placeholder": "Drop photo: Forest Trail, Wild Bloom, Limited Reserve bags" } },
        { "type": "chapter", "settings": { "chapter": "CHAPTER 02", "status": "IN DEVELOPMENT", "title": "Cold brew & nitro", "body": "The same forest-grown coffee in a can that can be easily taken on-the-go. Found at retail shops, cafes, and convenient stores.", "bg": "#FBB925", "pill_bg": "#FFFFFF", "pill_ink": "#FF3F00", "placeholder": "Drop render: Omawild cold brew can" } },
        { "type": "chapter", "settings": { "chapter": "CHAPTER 03", "status": "ON THE MAP", "title": "The outdoor pantry", "body": "Snacks and trail food sourced either regeneratively or from organic producers willing to transition.", "bg": "#FCD0FD", "pill_bg": "#FFFFFF", "pill_ink": "#FF3F00", "placeholder": "Drop moodboard: trail snacks, camp food" } },
        { "type": "milestone", "settings": { "number": "01", "when": "JUN 2026 – AUG 2026", "title": "Imported our first lot.", "details": "First lot imported from Indonesia to Taiwan, as our own importer and customs broker.\nThree coffee processes from one origin." } },
        { "type": "milestone", "settings": { "number": "02", "when": "AUG 2026", "title": "Debuted Omawild.", "details": "First public launch at Meet Greater South, a tech startup expo, 28 to 29 August.\nChosen on purpose to trial expo setup, meet potential clients, and pitch on stage.\nIntroduced Omawild as the climate tech, not just coffee.\nNT$11,750 in first sales." } },
        { "type": "milestone", "settings": { "number": "03", "when": "OCT 2026 – JAN 2027", "title": "Secure three corporate partners.", "details": "Three corporate partners between 5 to 20 kg of coffee a month.\nConvert one into an annual contract." } },
        { "type": "help_option", "settings": { "title": "Distribution", "body": "Shelves, coolers and business accounts for coffee now and cold brew next." } },
        { "type": "help_option", "settings": { "title": "OEM introductions", "body": "Cold brew and nitro canning partners who can run our first batches." } },
        { "type": "help_option", "settings": { "title": "Funding", "body": "Capital for the first cold brew run, inventory and the team to sell it." } },
        { "type": "help_option", "settings": { "title": "Partnerships", "body": "Co-branded programmes, workplace coffee and long-term supply." } },
        { "type": "help_option", "settings": { "title": "PR & stages", "body": "Press, panels and rooms full of people who should hear this." } },
        { "type": "model_step", "settings": { "number": "01", "title": "Farmed with the forest", "body": "Our coffee comes from producers in Garut, West Java, who grow it under timber, fruit and shade trees." } },
        { "type": "model_step", "settings": { "number": "02", "title": "Good enough to come back for", "body": "Grade 1 specialty, roasted in Taipei with the roast date on every bag. Taste is what keeps the loop turning." } },
        { "type": "model_step", "settings": { "number": "03", "title": "Money back to the land", "body": "Part of every sale funds organisations restoring ecosystems, starting with fighting forest fires in Indonesia." } },
        { "type": "model_step", "settings": { "number": "04", "title": "More reasons to go outside", "body": "Healthier places draw more people outdoors, and the more we love a place, the more we protect it. Then it starts again." } },
        { "type": "road", "settings": { "number": "01", "verdict": "WENT BROKE", "title": "Conservation on its own", "why": "Expeditions, reef restoration, permaculture builds and film across Indonesia, paid for with our life savings.", "rule": "Nature needs a business model that pays for itself." } },
        { "type": "road", "settings": { "number": "02", "verdict": "DROPPED", "title": "Reef-safe skincare", "why": "The easy option, since we knew the industry. Then we learned mineral sunscreen can still harm reefs.", "rule": "If it still harms what we protect, it's out." } },
        { "type": "road", "settings": { "number": "03", "verdict": "DROPPED", "title": "Electrolytes", "why": "No regenerative farming in it, a format and marketing play, and built for competitive athletes.", "rule": "Real food, grown on land it restores, for awe over podiums." } },
        { "type": "road", "settings": { "number": "04", "verdict": "YES", "title": "Coffee", "why": "Grown in agroforests, drunk every day, real food close to its source, and fuel for going outside.", "rule": "Where it was always going to start." } },
        { "type": "filter_item", "settings": { "number": "01", "title": "Is it real food, close to source?", "body": "No engineered formats. Real food with transparent ingredients." } },
        { "type": "filter_item", "settings": { "number": "02", "title": "Is it grown in a way that restores land?", "body": "Does this heal or destroy the land and the life that these ecosystems support?" } },
        { "type": "filter_item", "settings": { "number": "03", "title": "Does it fuel exploration?", "body": "For people who love being outside: diving, trekking, climbing." } },
        { "type": "filter_item", "settings": { "number": "04", "title": "Will people buy it again?", "body": "It has to make money, or none of the above lasts." } },
