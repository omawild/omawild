{%- comment -%}
  oma-vision — gated expedition Vision page (boarding → vision → Base Camp).
  Spec: docs/superpowers/specs/2026-11-02-vision-page-design.md
{%- endcomment -%}
{{ 'oma-vision.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign boarded_attr = 'false'
  assign inner_attr = 'false'
  if request.design_mode
    assign boarded_attr = 'true'
    assign inner_attr = 'true'
  endif
-%}

<div
  class="oma-vision"
  data-oma-vision
  data-boarded="{{ boarded_attr }}"
  data-inner="{{ inner_attr }}"
  data-chrome="{{ section.settings.chrome }}"
  data-help-to="{{ section.settings.help_mailto | escape }}"
>
  <div class="oma-vision__sticky-logo">
    <a href="{{ routes.root_url }}" aria-label="Omawild">
      <img src="{{ 'ow-logo.svg' | asset_url }}" alt="{{ shop.name | escape }}" height="26" width="120">
    </a>
  </div>

  <div id="oma-vision-boarding" class="oma-vision__boarding">
    <img
      class="oma-vision__badge"
      src="{{ 'oma-vision-badge.svg' | asset_url }}"
      alt="{{ section.settings.boarding_badge_alt | escape }}"
      width="180"
      height="180"
    >
    <h1 class="oma-vision__boarding-title">{{ section.settings.boarding_heading | escape | newline_to_br }}</h1>
    <form class="oma-vision__pass" data-vision-board novalidate>
      <div class="oma-vision__pass-head">
        <div>
          <div class="oma-vision__pass-label">{{ section.settings.boarding_dest_label | escape }}</div>
          <div class="oma-vision__pass-dest">{{ section.settings.boarding_dest | escape }}</div>
        </div>
      </div>
      <div class="oma-vision__pass-body">
        <div class="oma-vision__field" data-vision-name-field>
          <label for="oma-vision-name-{{ section.id }}">{{ section.settings.boarding_name_label | escape }}</label>
          <input
            id="oma-vision-name-{{ section.id }}"
            name="passenger"
            autocomplete="name"
            placeholder="{{ section.settings.boarding_name_placeholder | escape }}"
            data-vision-name
          >
        </div>
        <button type="submit" class="oma-vision__btn">{{ section.settings.boarding_cta | escape }}</button>
      </div>
      <div class="oma-vision__msg" data-vision-board-msg hidden></div>
    </form>
    {%- if section.settings.boarding_home_label != blank -%}
      <a class="oma-vision__boarding-home" href="{{ routes.root_url }}">{{ section.settings.boarding_home_label | escape }}</a>
    {%- endif -%}
  </div>

  <div id="oma-vision-main">
    {%- comment -%} 01 Hero {%- endcomment -%}
    <section class="oma-vision__band oma-vision__hero">
      <div class="oma-vision__inner oma-vision__hero-grid">
        <div>
          <div class="oma-vision__pill">
            {{ section.settings.hero_eyebrow | escape }}
            <span data-guest-pill hidden> FOR <span data-guest-name></span></span>
          </div>
          <h2 class="oma-vision__title oma-vision__title--hero">{{ section.settings.hero_heading | escape }}</h2>
          <p class="oma-vision__lead">{{ section.settings.hero_body | escape }}</p>
        </div>
        <div class="oma-vision__media">
          <div class="oma-vision__media-frame oma-vision__media-frame--hero">
            {%- if section.settings.hero_image != blank -%}
              {%- assign hero_alt = section.settings.hero_image.alt | default: section.settings.hero_heading -%}
              {{ section.settings.hero_image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 1024px) 40vw, 100vw', widths: '400, 800, 1200', alt: hero_alt }}
            {%- else -%}
              <div class="oma-vision__ph oma-vision__ph--fill" role="img" aria-label="{{ section.settings.hero_image_ph | escape }}"></div>
            {%- endif -%}
          </div>
          {%- if section.settings.hero_sticker != blank -%}
            <div class="oma-vision__sticker">{{ section.settings.hero_sticker | escape | newline_to_br }}</div>
          {%- endif -%}
        </div>
      </div>
    </section>

    {%- comment -%} 02 How we started {%- endcomment -%}
    <section class="oma-vision__band oma-vision__band--pad">
      <div class="oma-vision__inner">
        <div class="oma-vision__eyebrow">{{ section.settings.story_eyebrow | escape }}</div>
        <h2 class="oma-vision__title">{{ section.settings.story_heading | escape }}</h2>
        <div class="oma-vision__story-head">
          <p class="oma-vision__lead" style="margin:0;">{{ section.settings.story_body | escape }}</p>
          <div class="oma-vision__story-nav">
            <button type="button" class="oma-vision__icon-btn" data-vision-notes-prev aria-label="Previous photos">←</button>
            <button type="button" class="oma-vision__icon-btn" data-vision-notes-next aria-label="Next photos">→</button>
          </div>
        </div>
        <div class="oma-vision__notes" data-vision-notes>
          {%- for block in section.blocks -%}
            {%- if block.type == 'story_note' -%}
              <figure class="oma-vision__note" {{ block.shopify_attributes }}>
                <div class="oma-vision__note-img">
                  {%- if block.settings.image != blank -%}
                    {%- assign note_alt = block.settings.image.alt | default: block.settings.caption -%}
                    {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 800', alt: note_alt }}
                  {%- else -%}
                    <div class="oma-vision__ph oma-vision__ph--fill" role="img" aria-label="{{ block.settings.placeholder | escape }}"></div>
                  {%- endif -%}
                </div>
                <figcaption>{{ block.settings.caption | escape }}</figcaption>
              </figure>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>

    {%- comment -%} 03 Mission {%- endcomment -%}
    <section class="oma-vision__band oma-vision__band--pad oma-vision__band--salmon">
      <div class="oma-vision__inner oma-vision__two">
        <div>
          <div class="oma-vision__eyebrow">{{ section.settings.mission_eyebrow | escape }}</div>
          <h2 class="oma-vision__title">{{ section.settings.mission_heading | escape }}</h2>
        </div>
        <div class="oma-vision__stack">
          <p class="oma-vision__pull">{{ section.settings.mission_pull | escape }}</p>
          <p>{{ section.settings.mission_body | escape }}</p>
        </div>
      </div>
    </section>

    {%- comment -%} 04 ORS {%- endcomment -%}
    <section class="oma-vision__band oma-vision__band--pad">
      <div class="oma-vision__inner">
        <div class="oma-vision__eyebrow">{{ section.settings.ors_eyebrow | escape }}</div>
        <h2 class="oma-vision__title">{{ section.settings.ors_heading | escape }}</h2>
        <p class="oma-vision__lead">{{ section.settings.ors_body | escape }}</p>
        <div class="oma-vision__grid-4">
          {%- for block in section.blocks -%}
            {%- if block.type == 'ors_card' -%}
              <article class="oma-vision__card" {{ block.shopify_attributes }}>
                <div class="oma-vision__card-n">{{ block.settings.number | escape }}</div>
                <h3 class="oma-vision__card-title">{{ block.settings.title | escape }}</h3>
                <p>{{ block.settings.body | escape }}</p>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="oma-vision__scale">
          <div class="oma-vision__eyebrow">{{ section.settings.scale_eyebrow | escape }}</div>
          <p class="oma-vision__lead">{{ section.settings.scale_body | escape }}</p>
          <div class="oma-vision__legend">
            <div class="oma-vision__legend-row"><span class="oma-vision__tag oma-vision__tag--fill">{{ section.settings.legend_1_label | escape }}</span><p>{{ section.settings.legend_1_body | escape }}</p></div>
            <div class="oma-vision__legend-row"><span class="oma-vision__tag oma-vision__tag--salmon">{{ section.settings.legend_2_label | escape }}</span><p>{{ section.settings.legend_2_body | escape }}</p></div>
            <div class="oma-vision__legend-row"><span class="oma-vision__tag">{{ section.settings.legend_3_label | escape }}</span><p>{{ section.settings.legend_3_body | escape }}</p></div>
          </div>
        </div>
      </div>
    </section>

    {%- comment -%} 05 Pantry {%- endcomment -%}
    <section class="oma-vision__band oma-vision__band--pad" id="pantry">
      <div class="oma-vision__inner">
        <div class="oma-vision__eyebrow">{{ section.settings.pantry_eyebrow | escape }}</div>
        <h2 class="oma-vision__title">{{ section.settings.pantry_heading | escape }}</h2>
        <p class="oma-vision__lead">{{ section.settings.pantry_body | escape }}</p>
        <div class="oma-vision__grid-3">
          {%- for block in section.blocks -%}
            {%- if block.type == 'chapter' -%}
              <article class="oma-vision__chapter" {{ block.shopify_attributes }}>
                <div class="oma-vision__chapter-media" style="background:{{ block.settings.bg }};">
                  {%- if block.settings.image != blank -%}
                    {%- assign ch_alt = block.settings.image.alt | default: block.settings.title -%}
                    {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 900', alt: ch_alt }}
                  {%- else -%}
                    <div class="oma-vision__ph oma-vision__ph--fill" role="img" aria-label="{{ block.settings.placeholder | escape }}"></div>
                  {%- endif -%}
                  <span class="oma-vision__status" style="background:{{ block.settings.pill_bg }};color:{{ block.settings.pill_ink }};">{{ block.settings.status | escape }}</span>
                </div>
                <div class="oma-vision__chapter-body">
                  <div class="oma-vision__eyebrow">{{ block.settings.chapter | escape }}</div>
                  <h3 class="oma-vision__card-title">{{ block.settings.title | escape }}</h3>
                  <p>{{ block.settings.body | escape }}</p>
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>

    {%- comment -%} 06 Goals {%- endcomment -%}
    <section class="oma-vision__band oma-vision__band--pad oma-vision__band--wonderland">
      <div class="oma-vision__inner">
        <div class="oma-vision__eyebrow">{{ section.settings.goals_eyebrow | escape }}</div>
        <h2 class="oma-vision__title">{{ section.settings.goals_heading | escape }}</h2>
        <p class="oma-vision__lead">{{ section.settings.goals_body | escape }}</p>
        <div class="oma-vision__milestones">
          {%- for block in section.blocks -%}
            {%- if block.type == 'milestone' -%}
              <div class="oma-vision__milestone" {{ block.shopify_attributes }}>
                <div class="oma-vision__milestone-meta">
                  <div class="oma-vision__milestone-n">{{ block.settings.number | escape }}</div>
                  <div class="oma-vision__milestone-when">{{ block.settings.when | escape }}</div>
                </div>
                <div>
                  <div class="oma-vision__milestone-title">{{ block.settings.title | escape }}</div>
                  {%- if section.settings.show_goal_details and block.settings.details != blank -%}
                    <ul class="oma-vision__bullets">
                      {%- assign lines = block.settings.details | newline_to_br | split: '<br />' -%}
                      {%- for line in lines -%}
                        {%- assign t = line | strip -%}
                        {%- if t != blank -%}<li>{{ t | escape }}</li>{%- endif -%}
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>

    {%- comment -%} 07 Help {%- endcomment -%}
    <section class="oma-vision__band oma-vision__band--pad oma-vision__band--salmon" id="partner">
      <div class="oma-vision__inner">
        <div class="oma-vision__eyebrow" data-ask-eyebrow>{{ section.settings.help_eyebrow | escape }}</div>
        <h2 class="oma-vision__title">{{ section.settings.help_heading | escape }}</h2>
        <p class="oma-vision__lead">{{ section.settings.help_lead | escape }}</p>
        <form class="oma-vision__help" data-vision-ask novalidate>
          <div class="oma-vision__help-head">
            <div class="oma-vision__pass-label">{{ section.settings.help_form_label | escape }}</div>
            <div class="oma-vision__help-hint">{{ section.settings.help_form_hint | escape }}</div>
          </div>
          {%- for block in section.blocks -%}
            {%- if block.type == 'help_option' -%}
              <button
                type="button"
                class="oma-vision__help-row"
                data-help-toggle
                data-help-key="{{ block.id }}"
                data-help-label="{{ block.settings.title | escape }}"
                aria-pressed="false"
                {{ block.shopify_attributes }}
              >
                <span class="oma-vision__help-box" aria-hidden="true"></span>
                <span class="oma-vision__help-title">{{ block.settings.title | escape }}</span>
                <span class="oma-vision__help-desc">{{ block.settings.body | escape }}</span>
              </button>
            {%- endif -%}
          {%- endfor -%}
          <div class="oma-vision__help-foot">
            <div class="oma-vision__field">
              <label for="oma-vision-note-{{ section.id }}">{{ section.settings.help_note_label | escape }}</label>
              <textarea id="oma-vision-note-{{ section.id }}" rows="4" data-vision-ask-note placeholder="{{ section.settings.help_note_placeholder | escape }}"></textarea>
            </div>
            <div class="oma-vision__help-submit">
              <div class="oma-vision__field">
                <label for="oma-vision-email-{{ section.id }}">{{ section.settings.help_email_label | escape }}</label>
                <input id="oma-vision-email-{{ section.id }}" type="email" autocomplete="email" data-vision-ask-email placeholder="{{ section.settings.help_email_placeholder | escape }}">
              </div>
              <button type="submit" class="oma-vision__btn">{{ section.settings.help_cta | escape }}</button>
            </div>
            <div class="oma-vision__msg" data-vision-ask-msg hidden></div>
          </div>
        </form>
        <div class="oma-vision__card oma-vision__ask-done" data-vision-ask-done hidden>
          <div class="oma-vision__title" style="font-size:clamp(28px,3vw,44px);">{{ section.settings.help_success_heading | escape }}</div>
          <p class="oma-vision__lead">{{ section.settings.help_success_body | escape }}</p>
        </div>
      </div>
    </section>

    {%- comment -%} Nature fund model {%- endcomment -%}
    <section class="oma-vision__band oma-vision__band--pad oma-vision__band--electric">
      <div class="oma-vision__inner">
        <div class="oma-vision__eyebrow oma-vision__eyebrow--light">{{ section.settings.model_eyebrow | escape }}</div>
        <h2 class="oma-vision__title oma-vision__title--light">{{ section.settings.model_heading | escape }}</h2>
        <p class="oma-vision__lead oma-vision__lead--light">{{ section.settings.model_body | escape }}</p>
        <div class="oma-vision__grid-4">
          {%- for block in section.blocks -%}
            {%- if block.type == 'model_step' -%}
              <div class="oma-vision__model-card" {{ block.shopify_attributes }}>
                <div class="oma-vision__card-n">{{ block.settings.number | escape }}</div>
                <div class="oma-vision__card-title">{{ block.settings.title | escape }}</div>
                <p>{{ block.settings.body | escape }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>

    {%- comment -%} Base Camp lock {%- endcomment -%}
    <section id="oma-vision-basecamp" class="oma-vision__band oma-vision__band--pad oma-vision__band--wonderland oma-vision__basecamp">
      <div class="oma-vision__inner oma-vision__basecamp-inner">
        <div class="oma-vision__eyebrow">{{ section.settings.basecamp_eyebrow | escape }}</div>
        <h2 class="oma-vision__title" style="max-width:900px;">{{ section.settings.basecamp_heading | escape }}</h2>
        <div class="oma-vision__lead" style="max-width:640px;margin-inline:auto;">{{ section.settings.basecamp_body }}</div>
        <form class="oma-vision__pass oma-vision__pass--narrow" data-vision-inner novalidate>
          <div class="oma-vision__pass-body" style="padding-top:22px;">
            <div class="oma-vision__field" data-vision-code-field>
              <label for="oma-vision-code-{{ section.id }}">{{ section.settings.basecamp_code_label | escape }}</label>
              <input
                id="oma-vision-code-{{ section.id }}"
                name="basecamp"
                autocomplete="off"
                spellcheck="false"
                placeholder="{{ section.settings.basecamp_code_placeholder | escape }}"
                data-vision-code
                style="text-transform:uppercase;"
              >
            </div>
            <button type="submit" class="oma-vision__btn">{{ section.settings.basecamp_cta | escape }}</button>
          </div>
          <div class="oma-vision__msg" data-vision-inner-msg hidden></div>
        </form>
      </div>
    </section>

    <div id="oma-vision-investor">
      {%- comment -%} Roads {%- endcomment -%}
      <section class="oma-vision__band oma-vision__band--pad">
        <div class="oma-vision__inner">
          <div class="oma-vision__eyebrow">{{ section.settings.roads_eyebrow | escape }}</div>
          <h2 class="oma-vision__title">{{ section.settings.roads_heading | escape }}</h2>
          <p class="oma-vision__lead">{{ section.settings.roads_body | escape }}</p>
          <div class="oma-vision__grid-4">
            {%- for block in section.blocks -%}
              {%- if block.type == 'road' -%}
                <div class="oma-vision__road{% if block.settings.verdict == 'YES' %} oma-vision__road--yes{% endif %}" {{ block.shopify_attributes }}>
                  <div class="oma-vision__road-top">
                    <span>{{ block.settings.number | escape }}</span>
                    <span class="oma-vision__tag">{{ block.settings.verdict | escape }}</span>
                  </div>
                  <h3 class="oma-vision__card-title">{{ block.settings.title | escape }}</h3>
                  <p>{{ block.settings.why | escape }}</p>
                  <div class="oma-vision__road-rule">THE RULE</div>
                  <p class="oma-vision__road-rule-body">{{ block.settings.rule | escape }}</p>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </section>

      {%- comment -%} Filter {%- endcomment -%}
      <section class="oma-vision__band oma-vision__band--pad oma-vision__band--salmon">
        <div class="oma-vision__inner">
          <div class="oma-vision__eyebrow">{{ section.settings.filter_eyebrow | escape }}</div>
          <h2 class="oma-vision__title">{{ section.settings.filter_heading | escape }}</h2>
          <div class="oma-vision__filter">
            {%- for block in section.blocks -%}
              {%- if block.type == 'filter_item' -%}
                <div class="oma-vision__filter-row" {{ block.shopify_attributes }}>
                  <div class="oma-vision__filter-n">{{ block.settings.number | escape }}</div>
                  <div>
                    <div class="oma-vision__filter-title">{{ block.settings.title | escape }}</div>
                    <p>{{ block.settings.body | escape }}</p>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </section>

      {%- comment -%} Numbers {%- endcomment -%}
      <section class="oma-vision__band oma-vision__band--pad oma-vision__band--midnight">
        <div class="oma-vision__inner">
          <div class="oma-vision__eyebrow oma-vision__eyebrow--wonder">{{ section.settings.numbers_eyebrow | escape }}</div>
          <h2 class="oma-vision__title oma-vision__title--sand">{{ section.settings.numbers_heading | escape }}</h2>
          <div class="oma-vision__numbers">
            <div>
              <div class="oma-vision__eyebrow">{{ section.settings.numbers_done_label | escape }}</div>
              {%- for block in section.blocks -%}
                {%- if block.type == 'number_row' and block.settings.column == 'done' -%}
                  <div class="oma-vision__number-row" {{ block.shopify_attributes }}>
                    <span>{{ block.settings.label | escape }}</span>
                    <span>{{ block.settings.value | escape }}</span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <div>
              <div class="oma-vision__eyebrow">{{ section.settings.numbers_need_label | escape }}</div>
              {%- for block in section.blocks -%}
                {%- if block.type == 'number_row' and block.settings.column == 'need' -%}
                  <div class="oma-vision__number-row" {{ block.shopify_attributes }}>
                    <span>{{ block.settings.label | escape }}</span>
                    <span>{{ block.settings.value | escape }}</span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      </section>
    </div>

    {%- comment -%} Founder {%- endcomment -%}
    <section class="oma-vision__band oma-vision__band--pad oma-vision__band--wonderland">
      <div class="oma-vision__inner">
        <div class="oma-vision__eyebrow">{{ section.settings.founder_eyebrow | escape }}</div>
        <p class="oma-vision__founder-lead">{{ section.settings.founder_lead | escape }}</p>
        <div class="oma-vision__stack oma-vision__founder-copy">
          <p>{{ section.settings.founder_body_1 | escape }}</p>
          <p>{{ section.settings.founder_body_2 | escape }}</p>
          <div class="oma-vision__links">
            {%- if section.settings.founder_link_1_url != blank -%}
              <a href="{{ section.settings.founder_link_1_url }}" target="_blank" rel="noopener">{{ section.settings.founder_link_1_label | escape }}</a>
            {%- endif -%}
            {%- if section.settings.founder_link_2_url != blank -%}
              <a href="{{ section.settings.founder_link_2_url }}" target="_blank" rel="noopener">{{ section.settings.founder_link_2_label | escape }}</a>
            {%- endif -%}
          </div>
        </div>
        <div class="oma-vision__media-frame oma-vision__media-frame--founder">
          {%- if section.settings.founder_image != blank -%}
            {%- assign founder_alt = section.settings.founder_image.alt | default: section.settings.founder_eyebrow -%}
            {{ section.settings.founder_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '800, 1200, 1600', alt: founder_alt }}
          {%- else -%}
            <div class="oma-vision__ph oma-vision__ph--fill" role="img" aria-label="{{ section.settings.founder_image_ph | escape }}"></div>
          {%- endif -%}
        </div>
      </div>
    </section>

    {%- comment -%} Close {%- endcomment -%}
    <section class="oma-vision__band oma-vision__band--pad oma-vision__band--electric oma-vision__close">
      <div class="oma-vision__inner">
        <h2 class="oma-vision__title oma-vision__title--light oma-vision__title--close">{{ section.settings.close_heading | escape }}</h2>
        <p class="oma-vision__lead oma-vision__lead--light">{{ section.settings.close_body | escape }}</p>
        {%- if section.settings.close_cta_label != blank -%}
          {%- assign close_href = section.settings.close_cta_link | default: '/pages/contact' -%}
          <a class="oma-vision__btn oma-vision__btn--light" href="{{ close_href }}">{{ section.settings.close_cta_label | escape }}</a>
        {%- endif -%}
      </div>
    </section>
  </div>
</div>

<script src="{{ 'oma-vision.js' | asset_url }}" type="module" defer></script>

{%- comment -%}
  theme-check: ExcessiveSettingsCount — this is one interactive long-form page
  (boarding + vision + Base Camp). Splitting into multiple sections would break
  the shared sessionStorage gate controller. Headers already group the settings.
{%- endcomment -%}
{% # theme-check-disable ExcessiveSettingsCount %}
{% schema %}
{
  "name": "OMA Vision",
  "tag": "section",
  "class": "oma-vision-section",
  "settings": [
    { "type": "select", "id": "chrome", "label": "Chrome", "options": [ { "value": "store", "label": "Store header & footer" }, { "value": "minimal", "label": "Minimal (sticky logo)" } ], "default": "store" },
    { "type": "header", "content": "Boarding" },
    { "type": "text", "id": "boarding_badge_alt", "label": "Badge alt", "default": "Welcome to the Expedition" },
    { "type": "textarea", "id": "boarding_heading", "label": "Boarding heading", "default": "Pack your bags.\nWe're going on a mission." },
    { "type": "text", "id": "boarding_dest_label", "label": "Destination label", "default": "DESTINATION" },
    { "type": "text", "id": "boarding_dest", "label": "Destination", "default": "Back to Nature" },
