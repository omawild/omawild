{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign featured_image = current_variant.featured_image | default: product.featured_media -%}

<div class="pdp container">
  {% comment %} ── LEFT PANE: MEDIA ── {% endcomment %}
  <div class="pdp-media">
    {% if featured_image %}
      <img 
        id="PDP-FeaturedImage" 
        src="{{ featured_image | image_url: width: 1000 }}" 
        alt="{{ featured_image.alt | escape }}" 
        loading="eager"
        width="{{ featured_image.width }}"
        height="{{ featured_image.height }}"
      >
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
  </div>

  {% comment %} ── RIGHT PANE: DETAILS & FORM ── {% endcomment %}
  <div class="pdp-details">
    
    {% comment %} Breadcrumbs {% endcomment %}
    <nav class="pdp-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="sep">/</span>
      {% if collection %}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
        <span class="sep">/</span>
      {% else %}
        <a href="{{ routes.all_products_collection_url }}">Shop</a>
        <span class="sep">/</span>
      {% endif %}
      <span>{{ product.title }}</span>
    </nav>

    {% comment %} Tag / Eyebrow {% endcomment %}
    {% if product.metafields.custom.eyebrow != blank %}
      <span class="pdp-eyebrow">{{ product.metafields.custom.eyebrow }}</span>
    {% elsif product.tags.size > 0 %}
      <span class="pdp-eyebrow">{{ product.tags.first }}</span>
    {% endif %}

    {% comment %} Title & Subtitle {% endcomment %}
    <h1 class="pdp-title">{{ product.title }}</h1>
    {% if product.metafields.custom.subtitle != blank %}
      <p class="pdp-subtitle paragraph">{{ product.metafields.custom.subtitle }}</p>
    {% endif %}

    {% comment %} Price Display {% endcomment %}
    <div class="pdp-price-row" id="PDP-Price-{{ section.id }}">
      <span class="pdp-price">{{ current_variant.price | money }}</span>
      {% if current_variant.compare_at_price > current_variant.price %}
        <div class="pdp-price-stack">
          <span class="pdp-price-compare">{{ current_variant.compare_at_price | money }}</span>
        </div>
      {% endif %}
    </div>

    {% comment %} Product Form {% endcomment %}
    {% form 'product', product, id: 'AddToCartForm', class: 'pdp-form' %}
      <input type="hidden" name="id" value="{{ current_variant.id }}">

      {% comment %} Variant Selectors {% endcomment %}
      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          <div class="pdp-variant-group">
            <label class="pdp-variant-label">{{ option.name }}</label>
            <div class="pdp-variant-options">
              {% for value in option.values %}
                <button 
                  type="button" 
                  class="pdp-variant-btn {% if option.selected_value == value %}active{% endif %}"
                  data-option-index="{{ forloop.parentloop.index0 }}"
                  data-value="{{ value | escape }}"
                >
                  {{ value }}
                </button>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      {% endunless %}

      {% comment %} Quantity + Add to Cart {% endcomment %}
      <div class="pdp-cart-row">
        <div class="pdp-qty">
          <button type="button" data-qty-change="-1" aria-label="Decrease quantity">-</button>
          <input type="number" id="Quantity" name="quantity" value="1" min="1" class="pdp-qty-input" aria-label="Quantity">
          <button type="button" data-qty-change="1" aria-label="Increase quantity">+</button>
        </div>

        <button 
          type="submit" 
          name="add" 
          class="pdp-add"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          {% if current_variant.available %}
            Add to Cart
          {% else %}
            Sold Out
          {% endif %}
        </button>
      </div>
    {% endform %}

    {% comment %} Dynamic Metafield Specs {% endcomment %}
    <div class="pdp-specs">
      {% if product.metafields.custom.origin != blank %}
        <div class="pdp-spec-row">
          <span class="pdp-spec-label">Origin</span>
          <span class="pdp-spec-value">{{ product.metafields.custom.origin }}</span>
        </div>
      {% endif %}

      {% if product.metafields.custom.process != blank %}
        <div class="pdp-spec-row">
          <span class="pdp-spec-label">Process</span>
          <span class="pdp-spec-value">{{ product.metafields.custom.process }}</span>
        </div>
      {% endif %}

      {% if product.metafields.custom.elevation != blank %}
        <div class="pdp-spec-row">
          <span class="pdp-spec-label">Elevation</span>
          <span class="pdp-spec-value">{{ product.metafields.custom.elevation }}</span>
        </div>
      {% endif %}

      {% comment %} Tasting Notes Pills (List-type Metafield) {% endcomment %}
      {% if product.metafields.custom.tasting_notes.value != blank %}
        <div class="pdp-spec-row">
          <span class="pdp-spec-label">Tasting Notes</span>
          <div class="pdp-spec-notes">
            {% for note in product.metafields.custom.tasting_notes.value %}
              <span class="pdp-note-pill">{{ note }}</span>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Quantity Stepper Logic
    const qtyInput = document.getElementById('Quantity');
    document.querySelectorAll('[data-qty-change]').forEach(btn => {
      btn.addEventListener('click', () => {
        const step = parseInt(btn.dataset.qtyChange);
        const current = parseInt(qtyInput.value) || 1;
        if (current + step >= 1) qtyInput.value = current + step;
      });
    });
  });
</script>

{% schema %}
{
  "name": "Product Main (Omawild)",
  "tag": "section",
  "class": "section-pdp-main",
  "settings": []
}
{% endschema %}