{%- comment -%}
  oma-origin-cards — "Field Guide" preview grid, reading from the `origin`
  metaobject (Settings > Metaobjects). Region, country, elevation, producers,
  process and varieties are deliberately NOT fields on the metaobject itself
  -- they're derived here from the linked products' existing metafields
  (custom.region, custom.origin-of-country, custom.elevation_masl,
  custom.farm_producer, custom.process, custom.varietal-coffee) so there is
  exactly one place to edit each of those facts. An origin with no product
  linked yet renders "Coming soon" for whatever it can't derive, rather than
  hiding the row or showing a blank dash.
{%- endcomment -%}
{% assign owid = section.id | replace: '-', '' | replace: '_', '' %}
{% style %}
.oma-origin-cards-{{ owid }} {
  box-sizing: border-box;
  background: {{ section.settings.background_color }};
  padding: {{ section.settings.padding_top }}px clamp(20px, 4vw, 48px) {{ section.settings.padding_bottom }}px;
  font-family: var(--font-body-family);
  }
.oma-origin-cards-{{ owid }} *, .oma-origin-cards-{{ owid }} *::before, .oma-origin-cards-{{ owid }} *::after {
  box-sizing: border-box;
  }
.oma-origin-cards-{{ owid }} .inner {
  max-width: 1344px;
  margin: 0 auto;
  }
.oma-origin-cards-{{ owid }} .head-row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px 40px;
  }
.oma-origin-cards-{{ owid }} .eyebrow {
  font: 900 10.5px/1 var(--font-heading-family);
  letter-spacing: .18em;
  color: {{ section.settings.accent_color }};
  }
.oma-origin-cards-{{ owid }} .heading {
  margin: 14px 0 0;
  font-family: var(--font-heading-family);
  font-weight: 900;
  font-size: clamp(34px, 4.4vw, 60px);
  line-height: .95;
  letter-spacing: -.04em;
  color: {{ section.settings.accent_color }};
  }
.oma-origin-cards-{{ owid }} .intro {
  flex: 1 1 480px;
  min-width: 0;
  max-width: 780px;
  }
.oma-origin-cards-{{ owid }} .body {
  margin: 18px 0 0;
  font-size: 16.5px;
  /* The sitewide "Lead paragraph" token is 16.5px/1.6 (CLAUDE.md), tuned
     for a longer passage. At this short 1-2 line length that leading reads
     as oversized, so it's tightened locally here rather than in the token
     itself -- flag it if other lead paragraphs should follow suit. */
  line-height: 1.4;
  color: {{ section.settings.text_color }};
  }
.oma-origin-cards-{{ owid }} .body a {
  color: {{ section.settings.link_color }};
  text-decoration: underline;
  }
.oma-origin-cards-{{ owid }} .cta {
  flex: none;
  text-decoration: none;
  border: 1.5px solid {{ section.settings.accent_color }};
  color: {{ section.settings.accent_color }};
  padding: 15px 20px;
  border-radius: 999px;
  font: 900 12px/1 var(--font-heading-family);
  white-space: nowrap;
  transition: background .15s ease, color .15s ease;
  }
.oma-origin-cards-{{ owid }} .cta:hover {
  background: {{ section.settings.accent_color }};
  color: #ffffff;
  }
.oma-origin-cards-{{ owid }} .cards {
  margin-top: 28px;
  }
.oma-origin-cards-{{ owid }} .card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  border: 1.5px solid {{ section.settings.accent_color }};
  background: #ffffff;
  text-decoration: none;
  color: {{ section.settings.text_color }};
  transition: background .15s ease;
  }
.oma-origin-cards-{{ owid }} a.card:hover {
  background: {{ section.settings.hover_background }};
  }
.oma-origin-cards-{{ owid }} .cover {
  position: relative;
  width: 100%;
  background: {{ section.settings.hover_background }};
  overflow: hidden;
  }
.oma-origin-cards-{{ owid }} .cover img,
.oma-origin-cards-{{ owid }} .cover svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  }
.oma-origin-cards-{{ owid }} .card-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  }
.oma-origin-cards-{{ owid }} .num-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 24px;
  }
.oma-origin-cards-{{ owid }} .num {
  font: 900 14px/1 var(--font-heading-family);
  color: {{ section.settings.accent_color }};
  }
.oma-origin-cards-{{ owid }} .place {
  margin: 12px 0 0;
  font-family: var(--font-heading-family);
  font-weight: 900;
  color: {{ section.settings.accent_color }};
  letter-spacing: -.045em;
  }
.oma-origin-cards-{{ owid }} .subtitle {
  margin-top: 10px;
  font-weight: 600;
  font-size: 14.5px;
  line-height: 1.5;
  color: {{ section.settings.text_color }};
  }
.oma-origin-cards-{{ owid }} .facts {
  margin-top: auto;
  }
.oma-origin-cards-{{ owid }} .fact {
  padding-top: 8px;
  border-top: 1.5px solid {{ section.settings.accent_color }};
  }
.oma-origin-cards-{{ owid }} .fact-label {
  font: 400 10.5px/1.4 var(--font-heading-family);
  letter-spacing: .12em;
  color: {{ section.settings.accent_color }};
  }
.oma-origin-cards-{{ owid }} .fact-value {
  font: 700 14.5px/1.35 var(--font-heading-family);
  color: {{ section.settings.text_color }};
  }
.oma-origin-cards-{{ owid }} .fact-value.is-pending {
  font-weight: 500;
  font-style: italic;
  color: color-mix(in srgb, {{ section.settings.text_color }} 60%, transparent);
  }
.oma-origin-cards-{{ owid }} .visit {
  align-self: flex-start;
  background: {{ section.settings.accent_color }};
  color: #ffffff;
  padding: 14px 22px;
  border-radius: 999px;
  font: 900 12px/1 var(--font-heading-family);
  }

/* Single origin: wide feature card */
.oma-origin-cards-{{ owid }} .cards.is-single .card {
  flex-direction: row;
  flex-wrap: wrap;
  }
.oma-origin-cards-{{ owid }} .cards.is-single .cover {
  flex: 1.3 1 420px;
  min-height: 320px;
  aspect-ratio: 4 / 3;
  border-right: 1.5px solid {{ section.settings.accent_color }};
  }
.oma-origin-cards-{{ owid }} .cards.is-single .card-body {
  flex: 1 1 360px;
  min-width: 0;
  padding: clamp(24px, 3vw, 44px);
  gap: 20px;
  }
.oma-origin-cards-{{ owid }} .cards.is-single .place {
  font-size: clamp(56px, 7vw, 112px);
  line-height: .86;
  }
.oma-origin-cards-{{ owid }} .cards.is-single .lead {
  margin: 28px 0 0;
  max-width: 30ch;
  font-family: var(--font-heading-family);
  font-weight: 900;
  font-size: clamp(22px, 2vw, 28px);
  line-height: 1.2;
  letter-spacing: -.02em;
  color: {{ section.settings.accent_color }};
  text-wrap: pretty;
  }
.oma-origin-cards-{{ owid }} .cards.is-single .facts {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  /* Row-gap was 0 -- fine when every value fits one line, but a wrapped
     2-line value (e.g. two producer names) then sat flush against the
     border-top of the next row with no breathing room at all. The base
     .facts also carries margin-top:auto (for pinning facts to the bottom
     of a uniform grid card) and the parent .card-body now supplies its own
     gap -- neither applies to this wide feature-card layout, so both are
     zeroed here rather than stacking on top of each other. */
  gap: 24px;
  margin-top: 0;
  padding-top: 0;
  }
.oma-origin-cards-{{ owid }} .cards.is-single .fact-label {
  margin-bottom: 8px;
  }
.oma-origin-cards-{{ owid }} .cards.is-single .visit {
  margin-top: 28px;
  }
@media (max-width: 781px) {
  .oma-origin-cards-{{ owid }} .cards.is-single .cover {
    flex-basis: 100%;
    border-right: none;
    border-bottom: 1.5px solid {{ section.settings.accent_color }};
  }
}

/* Multiple origins: grid */
.oma-origin-cards-{{ owid }} .cards.is-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
  gap: 24px;
  }
.oma-origin-cards-{{ owid }} .cards.is-grid .cover {
  aspect-ratio: 4 / 3;
  border-bottom: 1.5px solid {{ section.settings.accent_color }};
  }
.oma-origin-cards-{{ owid }} .cards.is-grid .card-body {
  padding: 22px 22px 24px;
  gap: 8px;
  }
.oma-origin-cards-{{ owid }} .cards.is-grid .place {
  font-size: clamp(40px, 4.4vw, 60px);
  line-height: .9;
  }
.oma-origin-cards-{{ owid }} .cards.is-grid .facts {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding-top: 22px;
  }
.oma-origin-cards-{{ owid }} .cards.is-grid .fact {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  }
.oma-origin-cards-{{ owid }} .cards.is-grid .fact-label {
  flex: none;
  white-space: nowrap;
  }
.oma-origin-cards-{{ owid }} .cards.is-grid .fact-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  }
.oma-origin-cards-{{ owid }} .cards.is-grid .read-link {
  margin-top: 20px;
  font: 900 14.5px/1 var(--font-heading-family);
  color: {{ section.settings.accent_color }};
  }
{% endstyle %}
{%- liquid
  assign origin_blocks = section.blocks | where: 'type', 'origin_card'
  assign origin_count = 0
  for block in origin_blocks
    if block.settings.origin_reference != blank
      assign origin_count = origin_count | plus: 1
    endif
  endfor
-%}
<div class="oma-origin-cards-{{ owid }}">
  <div class="inner">
    <div class="head-row">
      <div class="intro">
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
        <h2 class="heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}<div class="body">{{ section.settings.body }}</div>{%- endif -%}
      </div>
      {%- if section.settings.show_cta and section.settings.cta_label != blank -%}
        <a class="cta" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}
    </div>

    <div class="cards {% if origin_count == 1 %}is-single{% else %}is-grid{% endif %}">
      {%- for block in origin_blocks -%}
        {%- liquid
          assign origin = block.settings.origin_reference
          if origin == blank
            continue
          endif

          assign card_tag = 'div'
          if origin.link != blank
            assign card_tag = 'a'
          endif
        -%}
        <{{ card_tag }} class="card" {% if card_tag == 'a' %}href="{{ origin.link }}"{% endif %}>
          <div class="cover">
            {%- if origin.cover.value != blank -%}
              <img
                src="{{ origin.cover.value | image_url: width: 900 }}"
                alt="{{ origin.place | escape }}"
                loading="lazy"
                width="{{ origin.cover.value.width }}"
                height="{{ origin.cover.value.height }}"
              >
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="card-body">
            {%- if origin_count == 1 -%}
              <div class="num-row"><span class="num">{{ section.settings.origin_number_prefix | escape }}01</span></div>
              <h3 class="place">{{ origin.place }}</h3>
              {%- if origin.tagline != blank -%}<p class="lead">{{ origin.tagline }}</p>{%- endif -%}
              {%- render 'origin-facts',
                origin: origin,
                producer_label: section.settings.producer_label,
                elevation_label: section.settings.elevation_label,
                process_label: section.settings.process_label,
                coming_soon_label: section.settings.coming_soon_label,
                show_coffees: true,
                coffees_label_singular: section.settings.coffees_label_singular,
                coffees_label_plural: section.settings.coffees_label_plural
              -%}
              {%- if card_tag == 'a' -%}<span class="visit">{{ section.settings.visit_label | escape }} {{ origin.place }} →</span>{%- endif -%}
            {%- else -%}
              <div class="num-row"><span class="num">{{ section.settings.origin_number_prefix | escape }}{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span></div>
              <h3 class="place">{{ origin.place }}</h3>
              {%- render 'origin-facts',
                origin: origin,
                producer_label: section.settings.producer_label,
                elevation_label: section.settings.elevation_label,
                process_label: section.settings.process_label,
                coming_soon_label: section.settings.coming_soon_label
              -%}
              {%- if card_tag == 'a' -%}<span class="read-link">{{ section.settings.read_label | escape }} →</span>{%- endif -%}
            {%- endif -%}
          </div>
        </{{ card_tag }}>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "OMA Origin Cards",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE FIELD GUIDE" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Where our coffee grows" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Every Omawild coffee is grown inside a working forest by a producer we buy from directly. The Field Guide has a page for each farm.</p>" },
    { "type": "header", "content": "Button" },
    { "type": "checkbox", "id": "show_cta", "label": "Show button", "default": true },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Open the Field Guide →" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "header", "content": "Card copy" },
    { "type": "text", "id": "origin_number_prefix", "label": "Card number prefix", "default": "Origin " },
    { "type": "text", "id": "producer_label", "label": "Producer fact label", "default": "PRODUCER" },
    { "type": "text", "id": "elevation_label", "label": "Elevation fact label", "default": "ELEVATION" },
    { "type": "text", "id": "process_label", "label": "Process fact label", "default": "PROCESS" },
    { "type": "text", "id": "coffees_label_singular", "label": "Coffees fact label (one coffee)", "default": "GROWN HERE" },
    { "type": "text", "id": "coffees_label_plural", "label": "Coffees fact label (multiple coffees)", "default": "COFFEES" },
    { "type": "text", "id": "coming_soon_label", "label": "Placeholder for a fact with no linked product data yet", "default": "Coming soon" },
    { "type": "text", "id": "visit_label", "label": "Feature-card button prefix", "default": "Visit" },
    { "type": "text", "id": "read_label", "label": "Grid-card link label", "default": "Read the story" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#FFE4E7" },
    { "type": "color", "id": "accent_color", "label": "Accent (headings, borders, facts)", "default": "#FF3F00" },
    { "type": "color", "id": "text_color", "label": "Body & fact value color", "default": "#00180C" },
    { "type": "color", "id": "hover_background", "label": "Card hover / image placeholder background", "default": "#FFE4E7" },
    { "type": "color", "id": "link_color", "label": "Link color (within the body)", "default": "#FF3F00" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "origin_card",
      "name": "Origin",
      "settings": [
        { "type": "metaobject", "id": "origin_reference", "metaobject_type": "origin", "label": "Origin" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OMA Origin Cards",
      "blocks": [
        { "type": "origin_card" },
        { "type": "origin_card" },
        { "type": "origin_card" }
      ]
    }
  ]
}
{% endschema %}
