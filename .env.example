# Copy this file to `.env` and fill in your own values.
#
#   cp .env.example .env
#
# `.env` is ignored by git AND by the Shopify CLI, so these stay local to you.
# Two people working against two different stores is normal here — that is the
# whole reason these live in an untracked file instead of in shopify.theme.toml.

# The store you push to, e.g. omawild.myshopify.com
SHOP_STORE=your-store.myshopify.com

# YOUR unpublished review theme on that store — never the live theme.
# Create it by duplicating the live theme in the Shopify admin; the ID is the
# number in the preview URL. See README.md → "Set up your review theme".
SHOP_THEME=000000000000
