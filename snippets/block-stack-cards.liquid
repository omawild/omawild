{%- assign omawild_id = block.id | replace: '_', '' | replace: '-', '' | downcase -%}
{%- assign label_tag = block.settings.label_tag | default: 'h3' -%}

{% style %}
  .section-{{ omawild_id }} {
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding-top: {{ block.settings.section_padding_top }}px;
    padding-bottom: {{ block.settings.section_padding_bottom }}px;
    display: block;
  }
  .container-{{ omawild_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin-left: auto;
    margin-right: auto;
    padding-left: {{ block.settings.mobile_padding_horizontal }}px;
    padding-right: {{ block.settings.mobile_padding_horizontal }}px;
    width: 100%;
  }
  .grid-{{ omawild_id }} { display: grid; grid-template-columns: 1fr; gap: 0; }
  .text-{{ omawild_id }} :is(h1, h2, h3, h4, h5, h6):not(.label-{{ omawild_id }}) {
    font-size: clamp({{ block.settings.heading_size | times: 0.6 }}px, 5vw + 10px, {{ block.settings.heading_size }}px) !important;
    line-height: 1.1 !important;
    color: {{ block.settings.heading_color }} !important;
    font-weight: 700;
    display: block;
    margin-top: 0 !important;
    margin-bottom: {{ block.settings.heading_margin_bottom }}px !important;
  }
  .text-{{ omawild_id }} em { font-style: normal !important; color: {{ block.settings.emphasis_color }} !important; }
  .text-{{ omawild_id }} p {
    font-size: clamp(16px, 1vw + 12px, {{ block.settings.text_size }}px) !important;    
    line-height: {{ block.settings.body_line_height }} !important;
    color: {{ block.settings.text_color }} !important;
    margin-top: 0 !important;
    margin-bottom: 20px !important;
  }
  .label-{{ omawild_id }}.label-{{ omawild_id }} {
    display: block !important;
    font-size: {{ block.settings.label_size }}px !important;
    color: {{ block.settings.label_color }} !important;
    text-transform: uppercase !important;
    letter-spacing: 0.15em !important;
    font-weight: 600 !important;
    line-height: 1.1 !important;
    margin-top: 0 !important;
    margin-bottom: {{ block.settings.label_margin_bottom }}px !important;
  }
  .stats-{{ omawild_id }} { display: flex; flex-direction: column; gap: {{ block.settings.stat_gap }}px; }
  .stat-card-{{ omawild_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    transition: transform 0.3s ease;
  }
  .stat-number-{{ omawild_id }} {
    font-size: clamp({{ block.settings.stat_number_size | times: 0.7 }}px, 4vw, {{ block.settings.stat_number_size }}px) !important;
    font-weight: 700;
    color: {{ block.settings.stat_number_color }};
    margin-bottom: 12px;
    line-height: 1;
  }
  .stat-label-{{ omawild_id }} {
    font-size: {{ block.settings.stat_label_size }}px;
    line-height: {{ block.settings.card_line_height }};
    color: {{ block.settings.stat_label_color }};
  }
  @media screen and (min-width: 750px) {
    .grid-{{ omawild_id }} { grid-template-columns: 1fr 1fr; gap: {{ block.settings.grid_gap }}px; align-items: start; }
  }
  @media screen and (max-width: 749px) {
    .text-{{ omawild_id }} { margin-bottom: {{ block.settings.mobile_content_gap }}px !important; }
  }
{% endstyle %}

<div class="section-{{ omawild_id }}" {{ block.shopify_attributes }}>
  <div class="container-{{ omawild_id }}">
    {% if block.settings.section_label != blank %}
      <{{ label_tag }} class="label-{{ omawild_id }}">{{ block.settings.section_label }}</{{ label_tag }}>
    {% endif %}
    <div class="grid-{{ omawild_id }}">
      <div class="text-{{ omawild_id }}">
        {{ block.settings.heading }}
        {{ block.settings.content }}
      </div>
      <div class="stats-{{ omawild_id }}">
        {% for i in (1..3) %}
          {% capture enabled_id %}stat_{{ i }}_enabled{% endcapture %}
          {% capture number_id %}stat_{{ i }}_number{% endcapture %}
          {% capture label_id %}stat_{{ i }}_label{% endcapture %}
          {% if block.settings[enabled_id] %}
            <div class="stat-card-{{ omawild_id }}">
              <div class="stat-number-{{ omawild_id }}">{{ block.settings[number_id] }}</div>
              <div class="stat-label-{{ omawild_id }}">{{ block.settings[label_id] }}</div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>