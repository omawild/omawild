{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-coffee-roast-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    padding: {{ block.settings.section_padding }}px {{ block.settings.desktop_side_padding }}px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    box-sizing: border-box;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    overflow: hidden;
  }

  .ai-coffee-roast-wrap-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    width: {{ block.settings.desktop_width_percent }}%;
    {% if block.settings.center_layout %}
      margin: 0 auto;
    {% else %}
      margin: 0;
    {% endif %}
  }

  .ai-coffee-roast-header-{{ ai_gen_id }} {
    margin-bottom: 40px;
  }

  .ai-coffee-roast-chapter-{{ ai_gen_id }} {
    font-size: {{ block.settings.chapter_font_size }}px;
    color: {{ block.settings.accent_color }};
    margin-bottom: 16px;
    font-weight: 400;
    letter-spacing: 0.5px;
  }

  .ai-coffee-roast-chapter-{{ ai_gen_id }} .ai-word-{{ ai_gen_id }} {
    display: inline-block;
    opacity: 0;
    filter: blur(10px);
  }

  .ai-coffee-roast-chapter-{{ ai_gen_id }}.ai-animated-{{ ai_gen_id }} .ai-word-{{ ai_gen_id }} {
    opacity: 1;
    filter: blur(0);
    transition: opacity 0.6s, filter 0.6s, transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .ai-coffee-roast-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 600;
    margin: 0;
    line-height: 1.2;
  }

  .ai-coffee-roast-title-{{ ai_gen_id }} .ai-word-wrap-{{ ai_gen_id }} {
    display: inline-block;
    white-space: nowrap;
  }

  .ai-coffee-roast-title-{{ ai_gen_id }} .ai-char-{{ ai_gen_id }} {
    display: inline-block;
    transform: translateY(100%);
    transition: transform 0.7s cubic-bezier(0.16, 0.9, 0.24, 1);
  }

  .ai-coffee-roast-title-{{ ai_gen_id }}.ai-animated-{{ ai_gen_id }} .ai-char-{{ ai_gen_id }} {
    transform: translateY(0);
  }

  .ai-coffee-roast-tabs-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .ai-coffee-roast-tab-{{ ai_gen_id }} {
    padding: 12px 24px;
    background-color: transparent;
    border: 1px solid {{ block.settings.tab_border_color }};
    color: {{ block.settings.text_color }};
    cursor: pointer;
    border-radius: {{ block.settings.tab_border_radius }}px;
    transition: all 0.3s ease;
    font-family: var(--font-body-family);
    font-weight: var(--font-body-weight);
    font-style: var(--font-body-style);
    font-size: {{ block.settings.tab_font_size }}px;
  }

  .ai-coffee-roast-tab-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.tab_hover_bg }};
  }

  .ai-coffee-roast-tab-{{ ai_gen_id }}.ai-active-{{ ai_gen_id }} {
    background-color: {{ block.settings.accent_color }};
    color: {{ block.settings.tab_active_text_color }};
    border-color: {{ block.settings.accent_color }};
  }

  .ai-coffee-roast-panel-{{ ai_gen_id }} {
    display: none;
  }

  .ai-coffee-roast-panel-{{ ai_gen_id }}.ai-active-{{ ai_gen_id }} {
    display: block;
  }

  .ai-coffee-roast-card-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: {{ block.settings.image_scale }}% 1fr;
    gap: 32px;
    align-items: center;
    padding: {{ block.settings.card_padding }}px;
    background-color: {{ block.settings.card_bg_color }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
  }

  .ai-coffee-roast-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: {{ block.settings.image_bg_color }};
  }

  .ai-coffee-roast-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-coffee-roast-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-coffee-roast-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  {% if block.settings.image_ratio == 'square' %}
    .ai-coffee-roast-image-wrapper-{{ ai_gen_id }} { aspect-ratio: 1 / 1; }
  {% elsif block.settings.image_ratio == 'portrait' %}
    .ai-coffee-roast-image-wrapper-{{ ai_gen_id }} { aspect-ratio: 3 / 4; }
  {% elsif block.settings.image_ratio == 'landscape' %}
    .ai-coffee-roast-image-wrapper-{{ ai_gen_id }} { aspect-ratio: 4 / 3; }
  {% elsif block.settings.image_ratio == 'wide' %}
    .ai-coffee-roast-image-wrapper-{{ ai_gen_id }} { aspect-ratio: 16 / 9; }
  {% endif %}

  .ai-coffee-roast-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-coffee-roast-type-badge-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
  }

  .ai-coffee-roast-type-{{ ai_gen_id }} {
    font-size: {{ block.settings.type_font_size }}px;
    font-weight: 500;
    margin: 0;
    padding: 6px 12px;
    background-color: {{ block.settings.accent_color }};
    color: {{ block.settings.tab_active_text_color }};
    border-radius: {{ block.settings.tag_border_radius }}px;
    text-transform: uppercase;
    letter-spacing: 1px;
    display: inline-block;
  }

  .ai-coffee-roast-name-wrap-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }

  .ai-coffee-roast-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_name_size }}px;
    font-weight: 600;
    margin: 0;
    line-height: 1.2;
  }

  .ai-coffee-roast-name-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }
  
  .ai-coffee-roast-name-{{ ai_gen_id }} a:hover {
    text-decoration: underline;
  }

  .ai-coffee-roast-price-{{ ai_gen_id }} {
    font-size: calc({{ block.settings.product_name_size }}px * 0.85);
    font-weight: 500;
    margin: 0;
    opacity: 0.85;
    white-space: nowrap;
  }

  .ai-coffee-roast-origin-{{ ai_gen_id }} {
    font-size: {{ block.settings.detail_font_size }}px;
    margin: 0;
    opacity: 0.7;
    margin-top: -4px;
  }

  .ai-coffee-roast-note-{{ ai_gen_id }} {
    font-size: {{ block.settings.detail_font_size }}px;
    line-height: 1.6;
    margin: 0;
    opacity: 0.9;
  }

  .ai-coffee-roast-tags-{{ ai_gen_id }} {
    font-size: {{ block.settings.tags_font_size }}px;
    margin: 0;
    padding-top: 16px;
    border-top: 1px solid {{ block.settings.divider_color }};
    opacity: 0.8;
    font-style: normal;
  }

  @media screen and (max-width: 749px) {
    .ai-coffee-roast-{{ ai_gen_id }} {
      padding-left: {{ block.settings.mobile_side_padding }}px;
      padding-right: {{ block.settings.mobile_side_padding }}px;
    }

    .ai-coffee-roast-wrap-{{ ai_gen_id }} { width: 100%; }

    .ai-coffee-roast-title-{{ ai_gen_id }} { font-size: calc({{ block.settings.title_font_size }}px * 0.7); }

    .ai-coffee-roast-chapter-{{ ai_gen_id }} { font-size: calc({{ block.settings.chapter_font_size }}px * 0.85); }

    .ai-coffee-roast-tabs-{{ ai_gen_id }} { gap: 8px; }

    .ai-coffee-roast-tab-{{ ai_gen_id }} {
      padding: 10px 16px;
      font-size: calc({{ block.settings.tab_font_size }}px * 0.9);
    }

    .ai-coffee-roast-name-wrap-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 8px;
    }

    .ai-coffee-roast-card-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: {{ block.settings.card_padding | times: 0.75 }}px;
    }
  }
{% endstyle %}

<coffee-roast-tabs-{{ ai_gen_id }} class="ai-coffee-roast-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-coffee-roast-wrap-{{ ai_gen_id }}">
    <div class="ai-coffee-roast-header-{{ ai_gen_id }}">
      {% if block.settings.chapter_text != blank %}
        <p class="ai-coffee-roast-chapter-{{ ai_gen_id }}" data-animate="blur">
          {{ block.settings.chapter_text }}
        </p>
      {% endif %}
      {% if block.settings.title != blank %}
        <h2 class="ai-coffee-roast-title-{{ ai_gen_id }}" data-animate="rise">
          {{ block.settings.title }}
        </h2>
      {% endif %}
    </div>

    {% comment %} Custom Merchant Populated Tabs {% endcomment %}
    <div class="ai-coffee-roast-tabs-{{ ai_gen_id }}">
      {% assign tab_count = 0 %}
      {% for i in (1..3) %}
        {% liquid
          assign product_key = 'product_' | append: i
          assign label_key = 'product_' | append: i | append: '_tab_label'
          
          assign selected_product = block.settings[product_key]
          assign tab_label = block.settings[label_key]
        %}
        {% if selected_product != blank %}
          {% assign tab_count = tab_count | plus: 1 %}
          <button
            class="ai-coffee-roast-tab-{{ ai_gen_id }} {% if tab_count == 1 %}ai-active-{{ ai_gen_id }}{% endif %}"
            data-tab="{{ i }}"
            aria-current="{% if tab_count == 1 %}true{% else %}false{% endif %}"
          >
            {% if tab_label != blank %}{{ tab_label }}{% else %}{{ selected_product.title }}{% endif %}
          </button>
        {% endif %}
      {% endfor %}
      
      {% if tab_count == 0 %}
        <button class="ai-coffee-roast-tab-{{ ai_gen_id }} ai-active-{{ ai_gen_id }}">Sample Roast</button>
      {% endif %}
    </div>

    <div class="ai-coffee-roast-panels-{{ ai_gen_id }}">
      {% assign panel_count = 0 %}
      {% for i in (1..3) %}
        {% liquid
          assign product_key = 'product_' | append: i
          assign type_key = 'product_' | append: i | append: '_type'
          assign origin_key = 'product_' | append: i | append: '_origin'
          assign note_key = 'product_' | append: i | append: '_note'
          assign tags_key = 'product_' | append: i | append: '_tags'
          
          assign selected_product = block.settings[product_key]
          assign product_type = block.settings[type_key]
          assign product_origin = block.settings[origin_key]
          assign product_note = block.settings[note_key]
          assign product_tags = block.settings[tags_key]
        %}
        
        {% if selected_product != blank %}
          {% assign panel_count = panel_count | plus: 1 %}
          <div
            class="ai-coffee-roast-panel-{{ ai_gen_id }} {% if panel_count == 1 %}ai-active-{{ ai_gen_id }}{% endif %}"
            data-panel="{{ i }}"
          >
            <div class="ai-coffee-roast-card-{{ ai_gen_id }}">
              <div class="ai-coffee-roast-image-wrapper-{{ ai_gen_id }}">
                {% if selected_product.featured_image %}
                  <img
                    src="{{ selected_product.featured_image | image_url: width: 800 }}"
                    alt="{{ selected_product.featured_image.alt | escape }}"
                    loading="lazy"
                    width="{{ selected_product.featured_image.width }}"
                    height="{{ selected_product.featured_image.height }}"
                    class="ai-coffee-roast-image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-coffee-roast-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-coffee-roast-info-{{ ai_gen_id }}">
                {% if product_type != blank %}
                  <div class="ai-coffee-roast-type-badge-{{ ai_gen_id }}">
                    <span class="ai-coffee-roast-type-{{ ai_gen_id }}">{{ product_type }}</span>
                  </div>
                {% endif %}
                
                <div class="ai-coffee-roast-name-wrap-{{ ai_gen_id }}">
                  <h3 class="ai-coffee-roast-name-{{ ai_gen_id }}">
                    <a href="{{ selected_product.url }}">{{ selected_product.title }}</a>
                  </h3>
                  {% if block.settings.show_price %}
                    <div class="ai-coffee-roast-price-{{ ai_gen_id }}">
                      {{ selected_product.price | money }}
                    </div>
                  {% endif %}
                </div>
                
                {% if product_origin != blank %}
                  <div class="ai-coffee-roast-origin-{{ ai_gen_id }}">{{ product_origin }}</div>
                {% endif %}
                
                {% if product_note != blank %}
                  <p class="ai-coffee-roast-note-{{ ai_gen_id }}">{{ product_note }}</p>
                {% endif %}
                
                {% if product_tags != blank %}
                  <div class="ai-coffee-roast-tags-{{ ai_gen_id }}">{{ product_tags }}</div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}

      {% if panel_count == 0 %}
        <div class="ai-coffee-roast-panel-{{ ai_gen_id }} ai-active-{{ ai_gen_id }}">
          <div class="ai-coffee-roast-card-{{ ai_gen_id }}">
            <div class="ai-coffee-roast-image-wrapper-{{ ai_gen_id }}">
              <div class="ai-coffee-roast-image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            </div>
            <div class="ai-coffee-roast-info-{{ ai_gen_id }}">
              <div class="ai-coffee-roast-type-badge-{{ ai_gen_id }}"><span class="ai-coffee-roast-type-{{ ai_gen_id }}">ORIGIN BLEND</span></div>
              <div class="ai-coffee-roast-name-wrap-{{ ai_gen_id }}">
                <h3 class="ai-coffee-roast-name-{{ ai_gen_id }}">Sample Roast Title</h3>
                {% if block.settings.show_price %}
                  <div class="ai-coffee-roast-price-{{ ai_gen_id }}">$18.00</div>
                {% endif %}
              </div>
              <div class="ai-coffee-roast-origin-{{ ai_gen_id }}">ETHIOPIA / YIRGACHEFFE</div>
              <p class="ai-coffee-roast-note-{{ ai_gen_id }}">A delicate, tea-like body with vibrant floral aromas of jasmine and fresh citrus. Features clean notes of bergamot and honeyed sweetness on the finish.</p>
              <div class="ai-coffee-roast-tags-{{ ai_gen_id }}">Washed / Heirloom Variety / 1750-2200m Masl</div>
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</coffee-roast-tabs-{{ ai_gen_id }}>

<script>
  (function() {
    if (customElements.get('coffee-roast-tabs-{{ ai_gen_id }}')) return;

    class CoffeeRoastTabs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.tabs = this.querySelectorAll('.ai-coffee-roast-tab-{{ ai_gen_id }}');
        this.panels = this.querySelectorAll('.ai-coffee-roast-panel-{{ ai_gen_id }}');
        this.chapterText = this.querySelector('[data-animate="blur"]');
        this.titleText = this.querySelector('[data-animate="rise"]');
        this.initialChapterText = '';
        this.initialTitleText = '';
      }

      connectedCallback() {
        if (this.chapterText) this.initialChapterText = this.chapterText.textContent.trim();
        if (this.titleText) this.initialTitleText = this.titleText.textContent.trim();

        this.setupTabs();
        this.setupAnimations();
        
        this.observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              if (this.chapterText) this.chapterText.classList.add('ai-animated-{{ ai_gen_id }}');
              if (this.titleText) this.titleText.classList.add('ai-animated-{{ ai_gen_id }}');
            } else {
              if (this.chapterText) this.chapterText.classList.remove('ai-animated-{{ ai_gen_id }}');
              if (this.titleText) this.titleText.classList.remove('ai-animated-{{ ai_gen_id }}');
            }
          });
        }, { threshold: 0.2 });

        this.observer.observe(this);
      }

      disconnectedCallback() {
        if (this.observer) this.observer.disconnect();
      }

      setupTabs() {
        this.tabs.forEach(tab => {
          tab.addEventListener('click', (e) => {
            e.stopPropagation();
            const tabIndex = tab.getAttribute('data-tab');
            if(tabIndex) this.switchTab(tabIndex);
          });
        });
      }

      switchTab(index) {
        this.tabs.forEach(tab => {
          const isActive = tab.getAttribute('data-tab') === index;
          tab.classList.toggle('ai-active-{{ ai_gen_id }}', isActive);
          tab.setAttribute('aria-current', isActive);
        });

        this.panels.forEach(panel => {
          const isActive = panel.getAttribute('data-panel') === index;
          panel.classList.toggle('ai-active-{{ ai_gen_id }}', isActive);
        });
      }

      setupAnimations() {
        if (this.chapterText && this.initialChapterText) {
          const words = this.initialChapterText.split(' ');
          this.chapterText.innerHTML = words.map((word, i) => {
            return `<span class="ai-word-{{ ai_gen_id }}" style="transition-delay: ${i * 40}ms">${word}</span>`;
          }).join(' ');
        }

        if (this.titleText && this.initialTitleText) {
          const words = this.initialTitleText.split(' ');
          let charIndex = 0;
          this.titleText.innerHTML = words.map(word => {
            const chars = word.split('').map((char) => {
              const delay = charIndex * 26;
              charIndex++;
              return `<span class="ai-char-{{ ai_gen_id }}" style="transition-delay: ${delay}ms">${char}</span>`;
            }).join('');
            return `<span class="ai-word-wrap-{{ ai_gen_id }}">${chars}</span>`;
          }).join(' ');
        }
      }
    }

    customElements.define('coffee-roast-tabs-{{ ai_gen_id }}', CoffeeRoastTabs{{ ai_gen_id }});
  })();
</script>