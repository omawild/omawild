{%- assign omawild_id = block.id | replace: '_', '' | replace: '-', '' | downcase -%}
{%- assign label_tag = block.settings.label_tag | default: 'h3' -%}

{% style %}
  .section-{{ omawild_id }} {
    width: 100%;
    padding-top: {{ block.settings.section_padding_top }}px;
    padding-bottom: {{ block.settings.section_padding_bottom }}px;
    display: flex;
    align-items: center; 
    justify-content: center;
    position: relative;
    background-color: {{ block.settings.background_color }};
    box-sizing: border-box;
    overflow: hidden;
    {% if block.settings.enable_min_height %}
      min-height: {{ block.settings.min_height_desktop }}px;
    {% else %}
      min-height: 0;
    {% endif %}
    
    {% if block.settings.background_image != blank %}
      background-image: url('{{ block.settings.background_image | image_url: width: 2000 }}');
      background-position: center;
      background-repeat: no-repeat;
      
      {% if block.settings.enable_parallax %}
        background-attachment: fixed;
        background-size: {{ block.settings.parallax_intensity | default: 100 }}% cover;
      {% else %}
        background-attachment: scroll;
        background-size: cover;
      {% endif %}
    {% endif %}
  }

  .section-{{ omawild_id }}::before {
    content: "";
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-color: #000000;
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  .container-{{ omawild_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin-left: auto; 
    margin-right: auto;
    padding-left: {{ block.settings.mobile_padding_horizontal }}px;
    padding-right: {{ block.settings.mobile_padding_horizontal }}px;
    width: 100%;
    position: relative;
    z-index: 2; 
  }

  .notice-card-{{ omawild_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding_vertical }}px {{ block.settings.card_padding_horizontal }}px;
    width: 100%;
    box-sizing: border-box;
    text-align: {{ block.settings.content_alignment }};
  }

  /* HEADING STYLES */
  .heading-wrapper-{{ omawild_id }} h1 { font-size: clamp({{ block.settings.heading_size | times: 0.8 }}px, 7vw + 10px, {{ block.settings.heading_size | times: 1.2 }}px) !important; }
  .heading-wrapper-{{ omawild_id }} h2 { font-size: clamp({{ block.settings.heading_size | times: 0.6 }}px, 5vw + 10px, {{ block.settings.heading_size }}px) !important; }
  .heading-wrapper-{{ omawild_id }} h3 { font-size: clamp({{ block.settings.heading_size | times: 0.5 }}px, 4vw + 10px, {{ block.settings.heading_size | times: 0.8 }}px) !important; }
  .heading-wrapper-{{ omawild_id }} :is(h4, h5, h6) { font-size: clamp({{ block.settings.heading_size | times: 0.4 }}px, 3vw + 10px, {{ block.settings.heading_size | times: 0.6 }}px) !important; }

  .heading-wrapper-{{ omawild_id }} :is(h1, h2, h3, h4, h5, h6):not(.label-{{ omawild_id }}) {
    margin-top: 0 !important;
    margin-bottom: {{ block.settings.heading_to_body_gap | default: 20 }}px !important;
    line-height: {{ block.settings.heading_line_height | default: 1.2 }} !important;
    color: {{ block.settings.heading_color }} !important;
  }

  /* BODY TEXT STYLE */
  .heading-wrapper-{{ omawild_id }} p {
    font-size: clamp(16px, 1.2vw + 12px, {{ block.settings.text_size }}px) !important;
    line-height: {{ block.settings.body_line_height }} !important;
    color: {{ block.settings.text_color }} !important;
    margin-top: 20px !important; 
    margin-bottom: 0px !important;
  }

  .heading-wrapper-{{ omawild_id }} :is(h1, h2, h3, h4, h5, h6) em { font-style: normal !important; color: {{ block.settings.emphasis_color }} !important; }

  .label-{{ omawild_id }}.label-{{ omawild_id }} {
    display: block !important;
    font-size: {{ block.settings.label_size }}px !important;
    color: {{ block.settings.label_color }} !important;
    text-transform: uppercase !important;
    letter-spacing: 0.15em !important;
    font-weight: 600 !important;
    line-height: 1.1 !important;
    margin-top: 0 !important;
    margin-bottom: {{ block.settings.label_margin_bottom }}px !important;
  }

  @media screen and (max-width: 749px) {
    .section-{{ omawild_id }} {
      padding-top: {{ block.settings.section_padding_top | times: 0.8 }}px;
      padding-bottom: {{ block.settings.section_padding_bottom | times: 0.8 }}px;
      background-attachment: scroll !important;
      background-size: cover !important;
      {% if block.settings.enable_min_height %}
        min-height: {{ block.settings.min_height_desktop | times: 0.7 | at_least: 350 }}px;
      {% endif %}
    }
    .notice-card-{{ omawild_id }} {
      padding: {{ block.settings.card_padding_vertical | times: 0.7 | at_least: 20 }}px {{ block.settings.card_padding_horizontal | times: 0.7 | at_least: 15 }}px;
    }
  }
{% endstyle %}

<div class="section-{{ omawild_id }}" {{ block.shopify_attributes }}>
  <div class="container-{{ omawild_id }}">
    <div class="notice-card-{{ omawild_id }}">
      <div class="heading-wrapper-{{ omawild_id }}">
        {% if block.settings.section_label != blank %}
          <{{ label_tag }} class="label-{{ omawild_id }}">{{ block.settings.section_label }}</{{ label_tag }}>
        {% endif %}
        {% if block.settings.heading != blank %}{{ block.settings.heading }}{% endif %}
        {% if block.settings.content != blank %}{{ block.settings.content }}{% endif %}
      </div>
    </div>
  </div>
</div>