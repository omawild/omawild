{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-sourcing-philosophy-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-sourcing-philosophy__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-sourcing-philosophy__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-sourcing-philosophy__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
    font-weight: 600;
  }

  .ai-sourcing-philosophy__subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.text_color }};
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .ai-sourcing-philosophy__content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 40px;
    align-items: center;
  }

  .ai-sourcing-philosophy__column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-sourcing-philosophy__visual-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-sourcing-philosophy__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-sourcing-philosophy__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-sourcing-philosophy__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-sourcing-philosophy__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-sourcing-philosophy__item-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 20px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: left;
  }

  .ai-sourcing-philosophy__item-{{ ai_gen_id }}:hover {
    background: {{ block.settings.card_hover_background }};
    border-color: {{ block.settings.card_hover_border_color }};
    transform: translateY(-2px);
  }

  .ai-sourcing-philosophy__item-{{ ai_gen_id }}.is-active {
    background: {{ block.settings.card_active_background }};
    border-color: {{ block.settings.card_active_border_color }};
  }

  .ai-sourcing-philosophy__item-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 8px;
    display: block;
  }

  .ai-sourcing-philosophy__item-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.card_text_color }};
    line-height: 1.5;
    margin: 0;
    display: block;
  }

  @media screen and (max-width: 989px) {
    .ai-sourcing-philosophy__content-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ai-sourcing-philosophy__visual-{{ ai_gen_id }} {
      order: -1;
      max-width: 400px;
      margin: 0 auto;
    }

    .ai-sourcing-philosophy__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-sourcing-philosophy__subtext-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtext_size }}px * 0.9);
    }
  }
{% endstyle %}

<sourcing-philosophy-{{ ai_gen_id }}
  class="ai-sourcing-philosophy-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-sourcing-philosophy__container-{{ ai_gen_id }}">
    <div class="ai-sourcing-philosophy__header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-sourcing-philosophy__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.subtext != blank %}
        <div class="ai-sourcing-philosophy__subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</div>
      {% endif %}
    </div>

    <div class="ai-sourcing-philosophy__content-{{ ai_gen_id }}">
      <div class="ai-sourcing-philosophy__column-{{ ai_gen_id }} ai-sourcing-philosophy__column--left-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          {% liquid
            assign title_key = 'value_' | append: i | append: '_title'
            assign text_key = 'value_' | append: i | append: '_text'
            assign enabled_key = 'value_' | append: i | append: '_enabled'
            
            assign title = block.settings[title_key]
            assign text = block.settings[text_key]
            assign enabled = block.settings[enabled_key]
          %}
          
          {% if enabled %}
            <button
              type="button"
              class="ai-sourcing-philosophy__item-{{ ai_gen_id }} {% if forloop.first %}is-active{% endif %}"
              data-value-index="{{ forloop.index0 }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            >
              {% if title != blank %}
                <strong class="ai-sourcing-philosophy__item-title-{{ ai_gen_id }}">{{ title }}</strong>
              {% endif %}
              {% if text != blank %}
                <span class="ai-sourcing-philosophy__item-text-{{ ai_gen_id }}">{{ text }}</span>
              {% endif %}
            </button>
          {% endif %}
        {% endfor %}
      </div>

      <div class="ai-sourcing-philosophy__visual-{{ ai_gen_id }}">
        {% if block.settings.center_image %}
          <img
            src="{{ block.settings.center_image | image_url: width: 800 }}"
            alt="{{ block.settings.center_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.center_image.width }}"
            height="{{ block.settings.center_image.height }}"
            class="ai-sourcing-philosophy__image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-sourcing-philosophy__image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-sourcing-philosophy__empty-state-{{ ai_gen_id }}">
              Next, add a center image
            </div>
          </div>
        {% endif %}
      </div>

      <div class="ai-sourcing-philosophy__column-{{ ai_gen_id }} ai-sourcing-philosophy__column--right-{{ ai_gen_id }}">
        {% for i in (4..6) %}
          {% liquid
            assign title_key = 'value_' | append: i | append: '_title'
            assign text_key = 'value_' | append: i | append: '_text'
            assign enabled_key = 'value_' | append: i | append: '_enabled'
            
            assign title = block.settings[title_key]
            assign text = block.settings[text_key]
            assign enabled = block.settings[enabled_key]
          %}
          
          {% if enabled %}
            <button
              type="button"
              class="ai-sourcing-philosophy__item-{{ ai_gen_id }}"
              data-value-index="{{ forloop.index | plus: 2 }}"
              aria-pressed="false"
            >
              {% if title != blank %}
                <strong class="ai-sourcing-philosophy__item-title-{{ ai_gen_id }}">{{ title }}</strong>
              {% endif %}
              {% if text != blank %}
                <span class="ai-sourcing-philosophy__item-text-{{ ai_gen_id }}">{{ text }}</span>
              {% endif %}
            </button>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</sourcing-philosophy-{{ ai_gen_id }}>

<script>
  (function() {
    class SourcingPhilosophy{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.items = this.querySelectorAll('.ai-sourcing-philosophy__item-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.items.forEach((item) => {
          item.addEventListener('click', () => {
            this.items.forEach((otherItem) => {
              otherItem.classList.remove('is-active');
              otherItem.setAttribute('aria-pressed', 'false');
            });

            item.classList.add('is-active');
            item.setAttribute('aria-pressed', 'true');
          });
        });
      }
    }

    customElements.define('sourcing-philosophy-{{ ai_gen_id }}', SourcingPhilosophy{{ ai_gen_id }});
  })();
</script>

