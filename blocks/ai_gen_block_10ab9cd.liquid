{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-coffee-roast-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px {{ block.settings.desktop_side_padding }}px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-coffee-roast-wrap-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    width: {{ block.settings.desktop_width_percent }}%;
    {% if block.settings.center_layout %}
      margin: 0 auto;
    {% else %}
      margin: 0;
    {% endif %}
  }

  .ai-coffee-roast-header-{{ ai_gen_id }} {
    margin-bottom: 40px;
  }

  .ai-coffee-roast-chapter-{{ ai_gen_id }} {
    font-size: {{ block.settings.chapter_font_size }}px;
    color: {{ block.settings.accent_color }};
    margin-bottom: 16px;
    font-weight: 400;
    letter-spacing: 0.5px;
  }

  .ai-coffee-roast-chapter-{{ ai_gen_id }} .ai-word-{{ ai_gen_id }} {
    display: inline-block;
    opacity: 0;
    filter: blur(10px);
  }

  .ai-coffee-roast-chapter-{{ ai_gen_id }}.ai-animated-{{ ai_gen_id }} .ai-word-{{ ai_gen_id }} {
    opacity: 1;
    filter: blur(0);
    transition: opacity 0.6s, filter 0.6s, transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .ai-coffee-roast-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 600;
    margin: 0;
    line-height: 1.2;
  }

  .ai-coffee-roast-title-{{ ai_gen_id }} .ai-word-wrap-{{ ai_gen_id }} {
    display: inline-block;
    white-space: nowrap;
  }

  .ai-coffee-roast-title-{{ ai_gen_id }} .ai-char-{{ ai_gen_id }} {
    display: inline-block;
    transform: translateY(100%);
    transition: transform 0.7s cubic-bezier(0.16, 0.9, 0.24, 1);
  }

  .ai-coffee-roast-title-{{ ai_gen_id }}.ai-animated-{{ ai_gen_id }} .ai-char-{{ ai_gen_id }} {
    transform: translateY(0);
  }

  .ai-coffee-roast-tabs-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .ai-coffee-roast-tab-{{ ai_gen_id }} {
    padding: 12px 24px;
    background-color: transparent;
    border: 1px solid {{ block.settings.tab_border_color }};
    color: {{ block.settings.text_color }};
    cursor: pointer;
    border-radius: {{ block.settings.tab_border_radius }}px;
    transition: all 0.3s ease;
    font-family: var(--font-body-family);
    font-weight: var(--font-body-weight);
    font-style: var(--font-body-style);
    font-size: {{ block.settings.tab_font_size }}px;
  }

  .ai-coffee-roast-tab-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.tab_hover_bg }};
  }

  .ai-coffee-roast-tab-{{ ai_gen_id }}.ai-active-{{ ai_gen_id }} {
    background-color: {{ block.settings.accent_color }};
    color: {{ block.settings.tab_active_text_color }};
    border-color: {{ block.settings.accent_color }};
  }

  .ai-coffee-roast-panel-{{ ai_gen_id }} {
    display: none;
  }

  .ai-coffee-roast-panel-{{ ai_gen_id }}.ai-active-{{ ai_gen_id }} {
    display: block;
  }

  .ai-coffee-roast-card-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: {{ block.settings.image_scale }}% 1fr;
    gap: 32px;
    align-items: center;
    padding: {{ block.settings.card_padding }}px;
    background-color: {{ block.settings.card_bg_color }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
  }

  .ai-coffee-roast-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: {{ block.settings.image_bg_color }};
  }

  .ai-coffee-roast-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-coffee-roast-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-coffee-roast-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  {% if block.settings.image_ratio == 'square' %}
    .ai-coffee-roast-image-wrapper-{{ ai_gen_id }} {
      aspect-ratio: 1 / 1;
    }
  {% elsif block.settings.image_ratio == 'portrait' %}
    .ai-coffee-roast-image-wrapper-{{ ai_gen_id }} {
      aspect-ratio: 3 / 4;
    }
  {% elsif block.settings.image_ratio == 'landscape' %}
    .ai-coffee-roast-image-wrapper-{{ ai_gen_id }} {
      aspect-ratio: 4 / 3;
    }
  {% elsif block.settings.image_ratio == 'wide' %}
    .ai-coffee-roast-image-wrapper-{{ ai_gen_id }} {
      aspect-ratio: 16 / 9;
    }
  {% endif %}

  .ai-coffee-roast-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-coffee-roast-type-badge-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
  }

  .ai-coffee-roast-type-{{ ai_gen_id }} {
    font-size: {{ block.settings.type_font_size }}px;
    font-weight: 500;
    margin: 0;
    padding: 6px 12px;
    background-color: {{ block.settings.accent_color }};
    color: {{ block.settings.tab_active_text_color }};
    border-radius: {{ block.settings.tag_border_radius }}px;
    text-transform: uppercase;
    letter-spacing: 1px;
    display: inline-block;
  }

  .ai-coffee-roast-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_name_size }}px;
    font-weight: 600;
    margin: 0;
    line-height: 1.2;
  }

  .ai-coffee-roast-origin-{{ ai_gen_id }} {
    font-size: {{ block.settings.detail_font_size }}px;
    margin: 0;
    opacity: 0.7;
  }

  .ai-coffee-roast-note-{{ ai_gen_id }} {
    font-size: {{ block.settings.detail_font_size }}px;
    line-height: 1.6;
    margin: 0;
    opacity: 0.9;
  }

  .ai-coffee-roast-tags-{{ ai_gen_id }} {
    font-size: {{ block.settings.tags_font_size }}px;
    margin: 0;
    padding-top: 16px;
    border-top: 1px solid {{ block.settings.divider_color }};
    opacity: 0.8;
    font-style: italic;
  }

  @media screen and (max-width: 749px) {
    .ai-coffee-roast-{{ ai_gen_id }} {
      padding-left: {{ block.settings.mobile_side_padding }}px;
      padding-right: {{ block.settings.mobile_side_padding }}px;
    }

    .ai-coffee-roast-wrap-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-coffee-roast-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_font_size }}px * 0.7);
    }

    .ai-coffee-roast-chapter-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.chapter_font_size }}px * 0.85);
    }

    .ai-coffee-roast-tabs-{{ ai_gen_id }} {
      gap: 8px;
    }

    .ai-coffee-roast-tab-{{ ai_gen_id }} {
      padding: 10px 16px;
      font-size: calc({{ block.settings.tab_font_size }}px * 0.9);
    }

    .ai-coffee-roast-card-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: {{ block.settings.card_padding | times: 0.75 }}px;
    }
  }
{% endstyle %}

<coffee-roast-tabs-{{ ai_gen_id }} class="ai-coffee-roast-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-coffee-roast-wrap-{{ ai_gen_id }}">
    <div class="ai-coffee-roast-header-{{ ai_gen_id }}">
      {% if block.settings.chapter_text != blank %}
        <p class="ai-coffee-roast-chapter-{{ ai_gen_id }}" data-animate="blur">
          {{ block.settings.chapter_text }}
        </p>
      {% endif %}
      {% if block.settings.title != blank %}
        <h2 class="ai-coffee-roast-title-{{ ai_gen_id }}" data-animate="rise">
          {{ block.settings.title }}
        </h2>
      {% endif %}
    </div>

    <div class="ai-coffee-roast-tabs-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign product_enabled_key = 'product_' | append: i | append: '_enabled'
          assign product_name_key = 'product_' | append: i | append: '_name'
          assign product_enabled = block.settings[product_enabled_key]
          assign product_name = block.settings[product_name_key]
        %}
        {% if product_enabled and product_name != blank %}
          <button
            class="ai-coffee-roast-tab-{{ ai_gen_id }} {% if forloop.first %}ai-active-{{ ai_gen_id }}{% endif %}"
            data-tab="{{ i }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            {{ product_name }}
          </button>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-coffee-roast-panels-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign product_enabled_key = 'product_' | append: i | append: '_enabled'
          assign product_image_key = 'product_' | append: i | append: '_image'
          assign product_name_key = 'product_' | append: i | append: '_name'
          assign product_origin_key = 'product_' | append: i | append: '_origin'
          assign product_type_key = 'product_' | append: i | append: '_type'
          assign product_note_key = 'product_' | append: i | append: '_note'
          assign product_tags_key = 'product_' | append: i | append: '_tags'
          
          assign product_enabled = block.settings[product_enabled_key]
          assign product_image = block.settings[product_image_key]
          assign product_name = block.settings[product_name_key]
          assign product_origin = block.settings[product_origin_key]
          assign product_type = block.settings[product_type_key]
          assign product_note = block.settings[product_note_key]
          assign product_tags = block.settings[product_tags_key]
        %}
        {% if product_enabled %}
          <div
            class="ai-coffee-roast-panel-{{ ai_gen_id }} {% if forloop.first %}ai-active-{{ ai_gen_id }}{% endif %}"
            data-panel="{{ i }}"
          >
            <div class="ai-coffee-roast-card-{{ ai_gen_id }}">
              <div class="ai-coffee-roast-image-wrapper-{{ ai_gen_id }}">
                {% if product_image %}
                  <img
                    src="{{ product_image | image_url: width: 800 }}"
                    alt="{{ product_image.alt | escape }}"
                    loading="lazy"
                    width="{{ product_image.width }}"
                    height="{{ product_image.height }}"
                    class="ai-coffee-roast-image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-coffee-roast-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-coffee-roast-info-{{ ai_gen_id }}">
                {% if product_type != blank %}
                  <div class="ai-coffee-roast-type-badge-{{ ai_gen_id }}">
                    <span class="ai-coffee-roast-type-{{ ai_gen_id }}">{{ product_type }}</span>
                  </div>
                {% endif %}
                {% if product_name != blank %}
                  <h3 class="ai-coffee-roast-name-{{ ai_gen_id }}">{{ product_name }}</h3>
                {% endif %}
                {% if product_origin != blank %}
                  <div class="ai-coffee-roast-origin-{{ ai_gen_id }}">{{ product_origin }}</div>
                {% endif %}
                {% if product_note != blank %}
                  <p class="ai-coffee-roast-note-{{ ai_gen_id }}">{{ product_note }}</p>
                {% endif %}
                {% if product_tags != blank %}
                  <div class="ai-coffee-roast-tags-{{ ai_gen_id }}">{{ product_tags }}</div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</coffee-roast-tabs-{{ ai_gen_id }}>

<script>
  (function() {
    class CoffeeRoastTabs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.tabs = this.querySelectorAll('.ai-coffee-roast-tab-{{ ai_gen_id }}');
        this.panels = this.querySelectorAll('.ai-coffee-roast-panel-{{ ai_gen_id }}');
        this.chapterText = this.querySelector('[data-animate="blur"]');
        this.titleText = this.querySelector('[data-animate="rise"]');
      }

      connectedCallback() {
        this.setupTabs();
        this.setupAnimations();
        this.observeVisibility();
      }

      setupTabs() {
        this.tabs.forEach(tab => {
          tab.addEventListener('click', () => {
            const tabIndex = tab.getAttribute('data-tab');
            this.switchTab(tabIndex);
          });
        });
      }

      switchTab(index) {
        this.tabs.forEach(tab => {
          const isActive = tab.getAttribute('data-tab') === index;
          tab.classList.toggle('ai-active-{{ ai_gen_id }}', isActive);
          tab.setAttribute('aria-current', isActive);
        });

        this.panels.forEach(panel => {
          const isActive = panel.getAttribute('data-panel') === index;
          panel.classList.toggle('ai-active-{{ ai_gen_id }}', isActive);
        });
      }

      setupAnimations() {
        if (this.chapterText) {
          const text = this.chapterText.textContent.trim();
          const words = text.split(' ');
          this.chapterText.innerHTML = words.map((word, i) => {
            return `<span class="ai-word-{{ ai_gen_id }}" style="transition-delay: ${i * 40}ms">${word}</span>`;
          }).join(' ');
        }

        if (this.titleText) {
          const text = this.titleText.textContent.trim();
          const words = text.split(' ');
          let charIndex = 0;
          this.titleText.innerHTML = words.map(word => {
            const chars = word.split('').map((char) => {
              const delay = charIndex * 26;
              charIndex++;
              return `<span class="ai-char-{{ ai_gen_id }}" style="transition-delay: ${delay}ms">${char}</span>`;
            }).join('');
            return `<span class="ai-word-wrap-{{ ai_gen_id }}">${chars}</span>`;
          }).join(' ');
        }
      }

      observeVisibility() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              if (this.chapterText) {
                this.chapterText.classList.add('ai-animated-{{ ai_gen_id }}');
              }
              if (this.titleText) {
                this.titleText.classList.add('ai-animated-{{ ai_gen_id }}');
              }
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.2 });

        observer.observe(this);
      }
    }

    customElements.define('coffee-roast-tabs-{{ ai_gen_id }}', CoffeeRoastTabs{{ ai_gen_id }});
  })();
</script>

